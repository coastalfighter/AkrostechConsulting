---
import '@/styles/tokens.css';
import '@/styles/base.css';
import Seo from '@/components/Seo.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Preloader from '@/components/Preloader.astro';
import { testimonials } from '@/data/reviews';
import {
  aggregateRatingSchema,
  breadcrumbSchema,
  canonical,
  graph,
  localBusinessSchema,
  organizationSchema,
  webPageSchema,
  websiteSchema,
  type Crumb,
  type JsonLd,
  type PageMeta,
} from '@/lib/seo';

interface Props extends PageMeta {
  /** Extra JSON-LD nodes for this page. */
  schema?: (JsonLd | null | undefined | false)[];
  breadcrumbs?: Crumb[];
  /** Show the branded preloader on a visitor's first page of the session. */
  preloader?: boolean;
  /** Extra props merged into this page's WebPage node. */
  webPage?: JsonLd;
}

const {
  schema = [],
  breadcrumbs,
  preloader = true,
  webPage = {},
  ...meta
} = Astro.props;

const rating = aggregateRatingSchema(testimonials);
const crumbId = `${canonical(meta.path)}#breadcrumb`;
const jsonLd = graph(
  organizationSchema(),
  websiteSchema(),
  localBusinessSchema({ rating }),
  webPageSchema(meta, breadcrumbs ? { breadcrumb: { '@id': crumbId }, ...webPage } : webPage),
  breadcrumbs && { '@id': crumbId, ...breadcrumbSchema(breadcrumbs) },
  ...schema,
);
---

<!doctype html>
<html lang="en-US" data-preloader={preloader ? 'true' : 'false'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0b0c0a" />
    <script is:inline>
      (() => {
        const d = document.documentElement;
        try {
          if (localStorage.getItem('ak-theme') === 'light') {
            d.dataset.theme = 'light';
            document.querySelector('meta[name="theme-color"]').content = '#f4f5ef';
          }
        } catch {}
        d.classList.add('js');
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        d.classList.add('motion-ready');
        // Failsafe: never leave content hidden if the motion bundle fails to load.
        setTimeout(() => { if (!window.__akMotion) d.classList.remove('motion-ready'); }, 6000);
        let first = false;
        try { first = !sessionStorage.getItem('ak-visited'); sessionStorage.setItem('ak-visited', '1'); } catch {}
        if (first && d.dataset.preloader === 'true') {
          d.classList.add('is-preloading');
          setTimeout(() => d.classList.remove('is-preloading'), 2000);
        }
      })();
    </script>
    <link rel="preload" href="/fonts/archivo-latin-wdth.woff2" as="font" type="font/woff2" crossorigin />
    <Seo meta={meta} schema={jsonLd} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Preloader />
    <div class="progress" aria-hidden="true"><span class="progress__bar" data-progress></span></div>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <div class="sr-only" aria-live="polite" data-announcer></div>
    <script>
      import '@/scripts/main';
    </script>
  </body>
</html>

<style is:global>
  main { display: block; }
  main:focus { outline: none; }
  .progress { position: fixed; inset: 0 0 auto; z-index: var(--z-progress); height: 2px; pointer-events: none; }
  .progress__bar { display: block; height: 100%; background: var(--accent); transform-origin: 0 50%; scale: 0 1; }
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .progress__bar { animation: progress linear both; animation-timeline: scroll(root block); }
    }
  }
  @keyframes progress { to { scale: 1 1; } }
</style>
