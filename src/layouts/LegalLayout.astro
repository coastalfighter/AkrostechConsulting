---
/**
 * Legal pages (Sample-3 LegalPage structure): a hero with the title and the date it was last
 * updated, then the page's instrument in its own section, then the full text as long-form
 * prose with a sticky contents list on desktop. Contents are read from the h2s of the rendered
 * text; any h2 without an id gets one, so every section can be linked.
 */
import BaseLayout from './BaseLayout.astro';
import Hero3D from '@/components/Hero3D.astro';
import Icon from '@/components/Icon.astro';
import { site } from '@/config/site';
import type { Crumb } from '@/lib/seo';

interface Props {
  title: string;
  description: string;
  path: string;
  heading: string;
  /** Second phrase of the headline, set back in tone. */
  quiet?: string;
  /** One-line summary under the heading. */
  lead: string;
  updated: string;
  crumbs: Crumb[];
  scene: 'shield' | 'index';
  /** The instrument section: heading, short intro, and the panel it sits on. */
  toolTitle: string;
  toolIntro: string;
  toolTone?: 'ink' | 'plate';
}
const { heading, quiet, lead, updated, crumbs, scene, toolTitle, toolIntro, toolTone = 'plate', ...meta } = Astro.props;

const slugify = (t: string) =>
  t
    .toLowerCase()
    .replace(/<[^>]+>/g, '')
    .replace(/&[a-z#0-9]+;/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');

const raw = await Astro.slots.render('default');
const toc: { id: string; label: string }[] = [];
const html = raw.replace(/<h2([^>]*)>([\s\S]*?)<\/h2>/g, (_m, attrs: string, inner: string) => {
  const existing = attrs.match(/\sid="([^"]+)"/)?.[1];
  const id = existing ?? slugify(inner);
  toc.push({ id, label: inner.replace(/<[^>]+>/g, '').trim() });
  return existing ? `<h2${attrs}>${inner}</h2>` : `<h2${attrs} id="${id}">${inner}</h2>`;
});
const updatedLabel = new Intl.DateTimeFormat('en-US', { dateStyle: 'long', timeZone: 'UTC' }).format(new Date(updated));
---

<BaseLayout {...meta} image="/og/legal.png" breadcrumbs={crumbs} preloader={false}>
  <Hero3D scene={scene} labelledby="legal-title" crumbs={crumbs} hint={scene === 'shield' ? 'Drag to turn it. Press to lock it.' : 'Move across the clauses. Press to ripple.'} wide>
    <h1 class="hero__title" id="legal-title">{heading}{quiet && <> <span class="quiet">{quiet}</span></>}</h1>
    <p class="hero__lead">{lead}</p>
    <dl class="legal__meta">
      <div><dt>Last updated</dt><dd><time datetime={updated}>{updatedLabel}</time></dd></div>
      <div><dt>Sections</dt><dd class="tabular">{toc.length}</dd></div>
      <div><dt>Questions</dt><dd><a class="link" href={`mailto:${site.email}`}>{site.email}</a></dd></div>
    </dl>
  </Hero3D>

  <section class="section legal-tool" aria-labelledby="legal-tool-title">
    <div class="wrap">
      <div class="section-head grid">
        <h2 class="h2" id="legal-tool-title" data-split>{toolTitle}</h2>
        <p data-reveal>{toolIntro}</p>
      </div>
      <div class:list={['legal-tool__panel', toolTone === 'ink' ? 'ink-plate band' : 'legal-tool__panel--open']}>
        <slot name="instrument" />
      </div>
    </div>
  </section>

  <section class="section section--flush-top legal" aria-labelledby="legal-text-title">
    <div class="wrap grid legal__grid">
      <nav class="legal__toc c-3" aria-labelledby="legal-toc-title">
        <h2 class="legal__toc-title" id="legal-text-title"><span id="legal-toc-title">Contents</span><span class="sr-only">: {heading.replace(/\.$/, '')}, full text</span></h2>
        <ol role="list">
          {
            toc.map((t) => (
              <li>
                <a href={`#${t.id}`} data-toc={t.id}>
                  {t.label}
                </a>
              </li>
            ))
          }
        </ol>
        <a class="more legal__top" href="#main">Back to top <Icon name="arrow-right" /></a>
      </nav>
      <div class="prose legal__body c-7 s-5">
        <p class="legal__stamp small">
          Last updated <time datetime={updated}>{updatedLabel}</time>
        </p>
        <Fragment set:html={html} />
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Mark the contents entry for the section being read.
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-toc]');
  const heads = [...links].map((a) => document.getElementById(a.dataset.toc ?? '')).filter((h): h is HTMLElement => h !== null);
  if (links.length && 'IntersectionObserver' in window) {
    const set = (id: string) => links.forEach((a) => a.toggleAttribute('aria-current', a.dataset.toc === id));
    const io = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
        if (visible) set(visible.target.id);
      },
      { rootMargin: '-20% 0px -65% 0px' },
    );
    heads.forEach((h) => io.observe(h));
  }
</script>

<style>
  .legal__meta { display: grid; max-width: 32rem; border-top: 1px solid var(--rule); }
  .legal__meta div { display: grid; grid-template-columns: 8rem 1fr; gap: var(--s-4); padding-block: var(--s-3); border-bottom: 1px solid var(--rule); align-items: baseline; }
  .legal__meta dt { color: var(--ink-2); font-size: var(--t-small); }
  .legal__meta dd { font-weight: 600; overflow-wrap: anywhere; }

  .legal-tool__panel { padding: clamp(1.25rem, 0.8rem + 2.4vw, 3rem); border-radius: calc(var(--radius) * 1.6); }

  .legal__grid { row-gap: var(--s-7); align-items: start; }
  .legal__toc { display: grid; gap: var(--s-4); }
  @media (min-width: 64rem) { .legal__toc { position: sticky; top: calc(var(--header-h) + var(--s-5)); } }
  .legal__toc-title { font-size: 1.125rem; font-weight: 650; letter-spacing: -0.01em; }
  .legal__toc ol { border-top: 1px solid var(--rule-strong); }
  .legal__toc li { border-bottom: 1px solid var(--rule); }
  .legal__toc ol a {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0.4rem 0 0.4rem 1.25rem;
    color: var(--ink-2);
    font-size: var(--t-small);
    font-weight: 550;
    text-decoration: none;
    transition: color var(--t-ui) ease;
  }
  .legal__toc ol a::before { content: ''; position: absolute; left: 0; top: 50%; width: 0.55rem; height: 0.55rem; margin-top: -0.275rem; border-radius: 50%; border: 1.5px solid var(--ink-3); transition: background-color var(--t-ui) ease, border-color var(--t-ui) ease; }
  .legal__toc ol a[aria-current] { color: var(--ink); font-weight: 650; }
  .legal__toc ol a[aria-current]::before { background: var(--mark); border-color: var(--ink); }
  @media (hover: hover) and (pointer: fine) { .legal__toc ol a:hover { color: var(--ink); } }
  @media (max-width: 63.99rem) {
    .legal__toc ol { display: grid; grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr)); column-gap: var(--gutter); }
    .legal__top { display: none; }
  }
  .legal__stamp { color: var(--ink-2); padding: 0.4rem 0.9rem; border-radius: var(--radius-pill); background: var(--plate-2); justify-self: start; display: inline-block; }
  .legal__body { line-height: 1.72; }
  .legal__body :global(h2) { scroll-margin-top: calc(var(--header-h) + var(--s-5)); padding-top: var(--s-5); border-top: 1px solid var(--rule); font-size: clamp(1.5rem, 1.2rem + 0.9vw, 2rem); }
  .legal__body :global(h3) { font-size: 1.2rem; }
  .legal__body > :global(p:nth-child(2)) { font-size: var(--t-lead); line-height: 1.55; margin-top: var(--s-5); }
</style>
