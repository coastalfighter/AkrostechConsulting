---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import ShiftDial from '@/components/heroes/ShiftDial.astro';
import Photo from '@/components/Photo.astro';
import Compare from '@/components/Compare.astro';
import WorkCard from '@/components/WorkCard.astro';
import PostCard from '@/components/PostCard.astro';
import Faq from '@/components/Faq.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import { site } from '@/config/site';
import { pages } from '@/data/pages';
import { services, serviceHref } from '@/data/services';
import { servicePhoto } from '@/data/photos';
import { work } from '@/data/work';
import { commitments, teamRoles, vetting, generalFaqs } from '@/data/company';
import { getPosts } from '@/lib/blog';
import { faqSchema } from '@/lib/seo';

const posts = (await getPosts()).slice(0, 3);
const featuredWork = [work[0], work[3], work[4]].filter((w): w is (typeof work)[number] => Boolean(w));
const f = site.figures;

const steps = [
  { when: 'Day 0', title: 'A 30-minute call', body: 'You list the work, the tools and the hours. We listen for what a good week looks like.' },
  { when: 'Day 1', title: 'A shortlist', body: 'Two or three vetted professionals who have done this exact work, with samples you can review.' },
  { when: 'Day 2', title: 'Work starts', body: 'Access set up, procedures drafted, first tasks closed on day one in your tools.' },
  { when: 'Every Friday', title: 'A written report', body: 'What was done, what is waiting on you, what changes next. Written by their team lead.' },
];

const compareRows = [
  { label: 'Time to a shortlist', a: 'Weeks of job posts, screening and interviews', b: `${f.matchHours} hours, vetted and with work samples` },
  { label: 'Time to start', a: 'Notice periods, then onboarding', b: `Working in your tools within ${f.onboardingHours} hours` },
  { label: 'Quality review', a: 'You check the work yourself', b: 'A team lead checks it before it reaches you' },
  { label: 'When someone leaves', a: 'Start hiring again from zero', b: 'A vetted replacement, trained on your written SOPs' },
  { label: 'Know-how', a: 'In one person’s head', b: 'Written procedures your company owns' },
  { label: 'Cost', a: 'Salary, benefits, payroll taxes, equipment, desk', b: 'One monthly fee, no placement fee' },
];
---

<BaseLayout {...pages.home} image="/og/home.png" schema={[faqSchema(generalFaqs)]}>
  <Hero labelledby="home-title" split="5-7">
    <h1 class="h1 hero__title" id="home-title">
      Offshore talent. <span class="accent">Onshore quality.</span>
    </h1>
    <p class="hero__lead">
      Vetted virtual assistants, recruiters, accountants, legal assistants and web developers in India, working your U.S. business day. Shortlisted
      in {f.matchHours} hours, onboarded in {f.onboardingHours}.
    </p>
    <div class="actions">
      <a class="btn btn--primary" href={site.calendly} target="_blank" rel="noopener">
        Book a discovery call <Icon name="arrow-up-right" class="btn__arrow" />
      </a>
      <a class="btn btn--ghost" href="/services">Explore services <Icon name="arrow-right" class="btn__arrow btn__arrow--right" /></a>
    </div>
    <ShiftDial slot="instrument" />

    <div slot="strip" class="strip ruled">
      <div class="module module--flex lime strip__lime">
        <p class="figure">{f.onboardingHours}h</p>
        <p class="strip__text">From the first call to a specialist working inside your tools.</p>
      </div>
      <div class="strip__photo">
        <Photo name="team-laptops" priority={false} fill sizes="(min-width: 64rem) 40vw, 100vw" focal="50% 40%" />
      </div>
      <div class="module module--flex">
        <p class="figure"><span data-count>{f.professionals}</span>+</p>
        <p class="strip__text">Vetted professionals across five practices.</p>
      </div>
      <div class="module module--flex">
        <p class="figure"><span data-count>{f.accuracy}</span>%</p>
        <p class="strip__text">Task accuracy, checked by a team lead before work reaches you.</p>
      </div>
    </div>
  </Hero>

  <!-- Practices: hover a row to isolate it; the photo module follows -->
  <section class="section practices" aria-labelledby="practices-title">
    <div class="wrap">
      <div class="section-head grid">
        <h2 class="h2" id="practices-title" data-split>Five practices. One standard.</h2>
        <p data-reveal>
          Every practice runs the same way: vetted people, a team lead on every pod, written procedures and a weekly report. Hire one specialist or
          build a team across all five.
        </p>
      </div>
      <div class="practices__grid grid">
        <ul class="practices__list c-7" role="list">
          {
            services.map((s, i) => (
              <li class="practice" style={`--i:${i}`} data-practice={i}>
                <a class="practice__link" href={serviceHref(s.slug)}>
                  <span class="practice__name">
                    {s.name}
                    {s.isNew && <span class="practice__new">New</span>}
                  </span>
                  <span class="practice__summary">{s.summary}</span>
                  <span class="practice__meta">{s.startsIn}</span>
                  <Icon name="arrow-up-right" class="icon practice__arrow" />
                </a>
              </li>
            ))
          }
        </ul>
        <div class="practices__frame c-5" aria-hidden="true">
          {services.map((s, i) => <Photo name={servicePhoto[s.slug]} alt="" fill class={`practices__photo practices__photo--${i}`} sizes="(min-width: 64rem) 36vw, 1px" />)}
        </div>
      </div>
    </div>
  </section>

  <!-- Photograph and headline across a seam -->
  <section class="seam" aria-labelledby="seam-title">
    <div class="wrap grid seam__grid">
      <div class="seam__photo c-8">
        <Photo name="open-office" alt="A large open-plan office with rows of desks" ratio="16 / 10" sizes="(min-width: 64rem) 66vw, 100vw" reveal="clip" />
      </div>
      <div class="seam__copy c-6 s-7">
        <h2 class="seam__title" id="seam-title" data-split>Most companies run out of hours before they run out of work.</h2>
        <p class="seam__text" data-reveal>
          We give you the hours back: trained people in India who work your day, use your tools, follow your playbook and report to you every week.
          You manage outcomes. Their team lead manages the rest.
        </p>
        <a class="more" href="/about" data-reveal>How we work <Icon name="arrow-right" /></a>
      </div>
    </div>
  </section>

  <!-- Local hire vs Akrostech: drag the seam -->
  <section class="section" aria-labelledby="compare-title">
    <div class="wrap">
      <div class="section-head grid">
        <h2 class="h2" id="compare-title" data-split>The same role, two ways to fill it.</h2>
        <p data-reveal>Drag the divider to compare what changes when the role is filled by an Akrostech specialist instead of a local hire.</p>
      </div>
      <Compare id="compare-home" aTitle="A local hire" bTitle="Akrostech" rows={compareRows} />
    </div>
  </section>

  <!-- How it starts -->
  <section class="section section--flush-top" aria-labelledby="steps-title">
    <div class="wrap">
      <div class="section-head grid">
        <h2 class="h2" id="steps-title" data-split>From first call to first report in a week.</h2>
        <p data-reveal>No recruitment cycle, no notice period. Most roles are working in your tools two days after the call.</p>
      </div>
      <ol class="steps ruled" role="list" data-reveal-group>
        {
          steps.map((s, i) => (
            <li class:list={['module module--flex step', { lime: i === 2 }]} data-reveal>
              <p class="label step__when">{s.when}</p>
              <h3 class="h3">{s.title}</h3>
              <p class="step__body">{s.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Commitments and vetting: the controls, shown not asserted -->
  <section class="section plate" aria-labelledby="controls-title">
    <div class="wrap">
      <div class="section-head grid">
        <h2 class="h2" id="controls-title" data-split>The controls behind every engagement.</h2>
        <p data-reveal>Six commitments written into every engagement letter, whether you hire one assistant or a team of ten.</p>
      </div>
      <div class="controls grid">
        <ul class="controls__list ruled ruled--plate c-8" role="list" data-reveal-group>
          {
            commitments.map((c) => (
              <li class="module module--flex control" data-reveal>
                <p class="control__figure">{c.figure}</p>
                <h3 class="control__title">{c.title}</h3>
                <p class="control__body">{c.body}</p>
              </li>
            ))
          }
        </ul>
        <div class="controls__vetting c-4">
          <Photo name="pair-at-laptop" ratio="4 / 3" sizes="(min-width: 64rem) 30vw, 100vw" reveal="clip" />
          <h3 class="h3 vetting__title">Five stages before you meet anyone</h3>
          <ol class="vetting" role="list">
            {
              vetting.map((v) => (
                <li class="vetting__item">
                  <span class="vetting__name">{v.title}</span>
                  <span class="vetting__body">{v.body}</span>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </div>
  </section>

  <!-- The chain of people -->
  <section class="section" aria-labelledby="chain-title">
    <div class="wrap">
      <div class="section-head grid">
        <h2 class="h2" id="chain-title" data-split>Who you work with, by name.</h2>
        <p data-reveal>
          A U.S. client partner owns the engagement, a delivery lead owns quality, a team lead reviews the work, and the specialists do it. One
          chain, every name known.
        </p>
      </div>
      <ol class="chain" role="list" data-reveal-group>
        {
          teamRoles.map((r) => (
            <li class="chain__item" data-reveal>
              <span class="chain__node" aria-hidden="true" />
              <h3 class="h3">{r.role}</h3>
              <p class="label chain__where">{r.practice}</p>
              <p class="chain__body">{r.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Work -->
  <section class="section section--flush-top" aria-labelledby="work-title">
    <div class="wrap">
      <div class="section-head grid">
        <h2 class="h2" id="work-title" data-split>Work, planned in the open.</h2>
        <p data-reveal>Engagement blueprints: how we staff, start and measure each kind of engagement. Plans, not invented case studies.</p>
      </div>
      <div class="cards grid" data-reveal-group>
        {featuredWork.map((w) => <div class="c-4" data-reveal><WorkCard item={w} /></div>)}
      </div>
      <a class="more section-more" href="/work">All eight blueprints <Icon name="arrow-right" /></a>
    </div>
  </section>

  <!-- Insights -->
  <section class="section section--flush-top" aria-labelledby="posts-title">
    <div class="wrap">
      <div class="section-head grid">
        <h2 class="h2" id="posts-title" data-split>Field notes.</h2>
        <p data-reveal>Practical guides on delegating, hiring, offshore bookkeeping, legal process outsourcing and fast websites.</p>
      </div>
      <div class="cards grid" data-reveal-group>
        {posts.map((p) => <div class="c-4" data-reveal><PostCard post={p} /></div>)}
      </div>
      <a class="more section-more" href="/blog">All articles <Icon name="arrow-right" /></a>
    </div>
  </section>

  <Faq faqs={generalFaqs} name="home" heading="Questions buyers ask first" intro="Straight answers on cost, security, hours and what happens if someone leaves." />

  <CtaBand />
</BaseLayout>

<style>
  /* ---- Hero strip ---- */
  .strip { grid-template-columns: 1fr; }
  @media (min-width: 40rem) { .strip { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 64rem) { .strip { grid-template-columns: 3fr 4fr 2.5fr 2.5fr; } }
  .strip .module { min-height: 9rem; gap: var(--s-4); justify-content: space-between; }
  @media (min-width: 64rem) { .strip .module { min-height: 13rem; } }
  .strip__lime .figure { font-size: clamp(3.5rem, 2rem + 5vw, 6rem); }
  .strip .figure { font-size: clamp(2.5rem, 1.6rem + 2vw, 3.5rem); white-space: nowrap; }
  .strip__text { max-width: 28ch; font-size: var(--t-small); color: var(--ink-2); }
  .strip__lime .strip__text { font-size: 1.0625rem; font-weight: 550; }
  .strip__photo { min-height: 14rem; }
  @media (min-width: 40rem) and (max-width: 63.99rem) { .strip__photo { order: 4; } }

  /* ---- Practices ---- */
  .practices__grid { row-gap: var(--s-6); }
  .practices__list { border-top: 1px solid var(--rule-strong); }
  .practice { border-bottom: 1px solid var(--rule); transition: opacity var(--t-ui) ease; }
  .practice__link {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--s-2) var(--s-5);
    padding: var(--s-5) 0;
    text-decoration: none;
  }
  .practice__name { font-size: clamp(1.5rem, 1rem + 1.8vw, 2.5rem); font-weight: 750; font-stretch: 125%; letter-spacing: -0.02em; line-height: 1.02; text-transform: uppercase; transition: color var(--t-ui) ease; }
  .practice__new { display: inline-block; margin-left: 0.5em; padding: 0.15em 0.45em; vertical-align: middle; background: var(--accent); color: var(--accent-ink); font-size: 0.75rem; letter-spacing: 0.06em; font-stretch: 112%; }
  .practice__summary { grid-column: 1; color: var(--ink-2); max-width: 54ch; }
  .practice__meta { grid-column: 1; font-size: 0.875rem; font-weight: 650; color: var(--accent-text); }
  .practice__arrow { grid-column: 2; grid-row: 1; width: 2rem; height: 2rem; transition: transform var(--t-ui) var(--ease-out), color var(--t-ui) ease; }
  @media (hover: hover) and (pointer: fine) {
    .practices__list:has(.practice:hover) .practice:not(:hover) { opacity: 0.35; }
    .practice:hover .practice__arrow { transform: translate(4px, -4px); color: var(--accent-text); }
  }
  .practices__list:has(.practice__link:focus-visible) .practice:not(:has(:focus-visible)) { opacity: 0.35; }
  .practices__frame { display: none; }
  @media (min-width: 64rem) {
    .practices__frame { display: grid; position: sticky; top: calc(var(--header-h) + var(--s-5)); align-self: start; aspect-ratio: 4 / 5; }
    .practices__frame > :global(.photo) { grid-area: 1 / 1; clip-path: inset(100% 0 0 0); transition: clip-path 560ms var(--ease-in-out); }
    .practices__frame > :global(.practices__photo--0) { clip-path: inset(0); }
    .practices__grid:has(.practice:hover) :global(.practices__photo--0) { clip-path: inset(100% 0 0 0); }
    .practices__grid:has([data-practice='0']:is(:hover, :focus-within)) :global(.practices__photo--0),
    .practices__grid:has([data-practice='1']:is(:hover, :focus-within)) :global(.practices__photo--1),
    .practices__grid:has([data-practice='2']:is(:hover, :focus-within)) :global(.practices__photo--2),
    .practices__grid:has([data-practice='3']:is(:hover, :focus-within)) :global(.practices__photo--3),
    .practices__grid:has([data-practice='4']:is(:hover, :focus-within)) :global(.practices__photo--4) { clip-path: inset(0); }
  }

  /* ---- Seam: photo and headline across the join ---- */
  .seam { padding-block: var(--s-6) var(--s-9); }
  .seam__grid { row-gap: 0; }
  .seam__photo { grid-row: 1; }
  @media (min-width: 64rem) { .seam__photo { grid-column: 1 / span 8; } .seam__copy { grid-column: 7 / span 6; } }
  .seam__copy {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--s-5);
    align-content: start;
    padding: var(--s-6) var(--module-pad) 0 0;
    background: var(--ground);
  }
  @media (min-width: 64rem) {
    .seam__copy { grid-row: 1; align-self: end; margin-bottom: calc(var(--s-8) * -1); padding: var(--module-pad); border-top: 6px solid var(--accent); }
  }
  .seam__title { font-size: clamp(1.875rem, 1rem + 2.4vw, 3rem); font-stretch: 125%; line-height: 1; letter-spacing: -0.025em; text-transform: uppercase; }
  .seam__text { color: var(--ink-2); font-size: var(--t-lead); line-height: 1.45; max-width: 44ch; }

  /* ---- Steps ---- */
  .steps { grid-template-columns: 1fr; }
  @media (min-width: 40rem) { .steps { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 64rem) { .steps { grid-template-columns: repeat(4, 1fr); } }
  .step { gap: var(--s-4); }
  @media (min-width: 64rem) { .step { min-height: 16rem; } }
  .step__when { color: var(--ink-2); }
  .step__body { color: var(--ink-2); margin-top: auto; }

  /* ---- Controls ---- */
  .controls { row-gap: var(--s-7); }
  .controls__list { grid-template-columns: 1fr; }
  @media (min-width: 40rem) { .controls__list { grid-template-columns: repeat(2, 1fr); } }
  .control { gap: var(--s-3); }
  @media (min-width: 64rem) { .control { min-height: 15rem; } }
  .control__figure { font-size: clamp(2.25rem, 1.5rem + 2vw, 3.25rem); font-weight: 750; font-stretch: 125%; line-height: 1; color: var(--accent-text); letter-spacing: -0.02em; }
  .control__title { font-size: 1.1875rem; font-stretch: 112%; line-height: 1.2; margin-top: auto; }
  .control__body { color: var(--ink-2); font-size: var(--t-small); }
  .controls__vetting { display: grid; gap: var(--s-5); align-content: start; }
  .vetting { display: grid; border-top: 1px solid var(--rule-strong); }
  .vetting__item { display: grid; gap: var(--s-1); padding-block: var(--s-4); border-bottom: 1px solid var(--rule); }
  .vetting__name { font-weight: 700; font-stretch: 112%; }
  .vetting__body { color: var(--ink-2); font-size: var(--t-small); }

  /* ---- Chain ---- */
  .chain { display: grid; gap: var(--s-7) var(--gutter); position: relative; }
  @media (min-width: 64rem) {
    .chain { grid-template-columns: repeat(4, 1fr); }
    .chain::before { content: ''; position: absolute; top: 0.75rem; left: 0.75rem; right: 0; height: 2px; background: var(--accent); }
  }
  .chain__item { position: relative; display: grid; gap: var(--s-3); align-content: start; padding-left: 2.5rem; }
  @media (min-width: 64rem) { .chain__item { padding-left: 0; padding-top: 3rem; } }
  .chain__node { position: absolute; left: 0; top: 0; width: 1.5rem; height: 1.5rem; background: var(--ground); border: 2px solid var(--accent); }
  .chain__item:first-child .chain__node { background: var(--accent); }
  .chain__where { color: var(--accent-text); }
  .chain__body { color: var(--ink-2); }

  .cards { row-gap: var(--s-7); }
  .section-more { margin-top: var(--s-6); }
</style>
