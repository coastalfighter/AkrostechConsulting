---
/**
 * Homepage, in the Sample-3 order (one idea per section): the promise, proof, what we do,
 * how the hours work, how we start, what is included, who it is for, how we compare,
 * questions, contact. The hero carries the generative field; the interactive instruments
 * (service index, live shift dial, comparison divider, audience tabs) sit in the body.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero3D from '@/components/Hero3D.astro';
import ShiftDial from '@/components/instruments/ShiftDial.astro';
import Photo from '@/components/Photo.astro';
import Compare from '@/components/Compare.astro';
import Faq from '@/components/Faq.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import { site } from '@/config/site';
import { pages } from '@/data/pages';
import { services, serviceHref, serviceBySlug } from '@/data/services';
import { servicePhoto } from '@/data/photos';
import { audiences, comparison, features, homeFaqs, processSteps, sharedDay, tools } from '@/data/home';
import { faqSchema } from '@/lib/seo';

const f = site.figures;
const stats = [
  { value: f.professionals, suffix: '+', label: 'Vetted professionals' },
  { value: f.projects, suffix: '+', label: 'Projects running' },
  { value: f.accuracy, suffix: '%', label: 'Task accuracy rate' },
  { value: f.onboardingHours, suffix: 'h', label: 'Onboarding time' },
];
// The new service first, as on the Sample-3 index.
const ordered = [...services].sort((a, b) => Number(Boolean(b.isNew)) - Number(Boolean(a.isNew)));
const faqs = homeFaqs.map((x) => ({ q: x.q, a: x.a }));
const clock = (hoursAfterNine: number) => {
  const m = 9 * 60 + Math.round(hoursAfterNine * 60);
  const h = Math.floor(m / 60);
  return `${h % 12 === 0 ? 12 : h % 12}:${String(m % 60).padStart(2, '0')} ${h < 12 ? 'am' : 'pm'}`;
};
---

<BaseLayout {...pages.home} image="/og/home.png" schema={[faqSchema(faqs)]}>
  <Hero3D scene="globe" labelledby="home-title" hint="Drag to turn the planet. Times are live.">
    <h1 class="hero__title" id="home-title">Your team in India. <span class="quiet">Working your U.S. hours.</span></h1>
    <p class="hero__lead">Vetted specialists for admin, hiring, accounting, legal and web. Live on your calls and ready in 48 hours.</p>
    <div class="actions">
      <a class="btn btn--primary" href={site.calendly} target="_blank" rel="noopener">Book a call <Icon name="arrow-up-right" class="btn__arrow" /></a>
      <a class="btn btn--ghost" href="/contact">Get a proposal <Icon name="arrow-right" class="btn__arrow btn__arrow--right" /></a>
    </div>
    <p class="hero-note small muted">Built for startups, scaled by enterprises, trusted by leaders.</p>
  </Hero3D>

  <!-- Proof -->
  <section class="proof" aria-labelledby="proof-title">
    <div class="wrap">
      <h2 class="sr-only" id="proof-title">Akrostech by the numbers</h2>
      <dl class="proof__list" data-reveal-group>
        {
          stats.map((s) => (
            <div class="proof__item" data-reveal>
              <dt>{s.label}</dt>
              <dd class="figure"><span data-count>{s.value}</span>{s.suffix}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Services index: hover or focus a row; the photo follows -->
  <section class="section" aria-labelledby="services-title">
    <div class="wrap">
      <div class="section-head grid">
        <h2 class="h2" id="services-title" data-split>Five services. One accountable partner.</h2>
        <p data-reveal>A dedicated specialist for each function, on your hours, with a team lead behind every one.</p>
      </div>
      <div class="sindex grid">
        <ul class="sindex__list c-7" role="list">
          {
            ordered.map((s, i) => (
              <li class="sindex__row" data-row={i}>
                <a class="sindex__link" href={serviceHref(s.slug)}>
                  <span class="sindex__name">
                    {s.name}
                    {s.isNew && <span class="badge">New</span>}
                  </span>
                  <span class="sindex__sum">{s.summary}</span>
                  <span class="sindex__facts small">
                    <span>
                      <span class="muted">Starts in </span>
                      {s.facts.startsIn}
                    </span>
                    <span>
                      <span class="muted">Saves </span>
                      {s.facts.savings}
                    </span>
                  </span>
                  <span class="sindex__go" aria-hidden="true">
                    <Icon name="arrow-up-right" />
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
        <div class="sindex__frame c-5" aria-hidden="true">
          {ordered.map((s, i) => <Photo name={servicePhoto[s.slug]} alt="" fill class={`sindex__photo sindex__photo--${i}`} sizes="(min-width: 64rem) 34vw, 1px" />)}
        </div>
      </div>
    </div>
  </section>

  <!-- Same hours, different sky: the live shift dial -->
  <section class="section section--flush-top" aria-labelledby="sky-title">
    <div class="wrap">
      <div class="sky ink-plate band">
        <div class="sky__head">
          <h2 class="h2" id="sky-title" data-split>Same hours. Different sky.</h2>
          <p class="sky__lead">
            When New York starts work, the sun is setting in India and your team is starting its shift. Drag the handles to set your day and see
            theirs, live.
          </p>
        </div>
        <div class="sky__body">
          <div class="sky__dial"><ShiftDial /></div>
          <div class="sky__day">
            <p class="sky__day-head small"><span>A shared day, ET</span><span class="muted">Illustrative</span></p>
            <ol class="sky__list" role="list">
              {
                sharedDay.map((t) => (
                  <li class="sky__item">
                    <span class="sky__time tabular">{clock(t.at)}</span>
                    <span class="sky__what">
                      <strong>{t.title}</strong>
                      <span class="muted">{t.detail}</span>
                    </span>
                  </li>
                ))
              }
            </ol>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="section section--flush-top" aria-labelledby="how-title">
    <div class="wrap">
      <div class="section-head grid">
        <h2 class="h2" id="how-title" data-split>From first call to a working team in 48 hours.</h2>
        <p data-reveal>The same four steps on every engagement, so you always know what happens next.</p>
      </div>
      <ol class="steps" role="list" data-reveal-group>
        {
          processSteps.map((s, i) => (
            <li class:list={['step', { 'step--now': i === 2 }]} data-reveal>
              <span class="step__dot" aria-hidden="true" />
              <span class="step__dur tabular">{s.duration}</span>
              <h3 class="h3">{s.title}</h3>
              <p class="muted">{s.detail}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- What every engagement includes -->
  <section class="section section--flush-top" aria-labelledby="features-title">
    <div class="wrap">
      <div class="section-head grid">
        <h2 class="h2" id="features-title" data-split>Your tools. Our team. Everything built in.</h2>
        <p data-reveal>No new software, contracts or management overhead. It comes with every engagement.</p>
      </div>
      <div class="bento" data-reveal-group>
        <div class="bento__stack panel" data-reveal>
          <div class="bento__stack-copy">
            <h3 class="h3">Works inside your stack</h3>
            <p class="muted">Your CRM, books and storefront, with your logins, permissions and SOPs.</p>
          </div>
          <ul class="bento__tools" role="list">{tools.map((t) => <li class="chip">{t}</li>)}</ul>
        </div>
        {
          features.map((ft, i) => (
            <div class:list={['bento__cell', `bento__cell--${i}`, i === 0 ? 'violet' : 'panel']} data-reveal>
              <h3 class="h3">{ft.title}</h3>
              <p class={i === 0 ? undefined : 'muted'}>{ft.description}</p>
            </div>
          ))
        }
        <div class="bento__photo" data-reveal>
          <Photo name="svc-accounting-work" alt="Quality dashboards on a laptop screen" fill sizes="(min-width: 64rem) 22vw, 100vw" />
        </div>
      </div>
    </div>
  </section>

  <!-- Who we serve: tabs -->
  <section class="section section--flush-top" aria-labelledby="audiences-title">
    <div class="wrap">
      <div class="section-head grid">
        <h2 class="h2" id="audiences-title" data-split>Built for the teams that run your business.</h2>
        <p data-reveal>Pick the team you lead and see what you could hand off this week.</p>
      </div>
      <div class="tabs" data-tabs>
        <div class="tabs__list" role="tablist" aria-label="Who we work with">
          {
            audiences.map((a, i) => (
              <button class="tabs__tab" role="tab" type="button" id={`aud-tab-${i}`} aria-controls={`aud-panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
                {a.title}
              </button>
            ))
          }
        </div>
        {
          audiences.map((a, i) => {
            const svc = serviceBySlug(a.service);
            return (
              <div class="tabs__panel panel" role="tabpanel" id={`aud-panel-${i}`} aria-labelledby={`aud-tab-${i}`} hidden={i !== 0} tabindex="0">
                <div class="tabs__copy">
                  <p class="tabs__summary">{a.summary}</p>
                  <ul class="ticks" role="list">
                    {a.tasks.map((t) => (
                      <li>{t}</li>
                    ))}
                  </ul>
                  <a class="more" href={serviceHref(a.service)}>
                    See {svc?.name ?? 'the service'} <Icon name="arrow-right" />
                  </a>
                </div>
                <div class="tabs__photo">
                  <Photo name={servicePhoto[a.service]} fill sizes="(min-width: 64rem) 40vw, 100vw" />
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- Comparison -->
  <section class="section section--flush-top" aria-labelledby="compare-title">
    <div class="wrap">
      <div class="section-head grid">
        <h2 class="h2" id="compare-title" data-split>Three ways to add capacity. One clear choice.</h2>
        <p data-reveal>The same seat filled three ways. Switch the option on the left and drag the divider to compare speed, coverage, quality and risk.</p>
      </div>
      <Compare id="compare-home" columns={comparison.columns} rows={comparison.rows.map((r) => ({ label: r.label, values: r.values }))} />
      <div class="compare-foot">
        <a class="btn btn--primary" href="/contact">Get a proposal <Icon name="arrow-right" class="btn__arrow btn__arrow--right" /></a>
        <p class="small muted">Pricing depends on role, seniority and scope. We confirm it after a 30-minute discovery call.</p>
      </div>
    </div>
  </section>

  <Faq faqs={faqs} name="home" heading="Questions we hear every week." intro="Straight answers about offshore teams, U.S. hours, security and cost." />

  <CtaBand />
</BaseLayout>

<script>
  /** Accessible tabs: arrow keys move between tabs, Home/End jump, selection follows focus. */
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (tab: HTMLButtonElement, focus = true) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(t.getAttribute('aria-controls') ?? '');
        if (panel) panel.hidden = !on;
      });
      if (focus) tab.focus();
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab, false));
      tab.addEventListener('keydown', (e) => {
        const map: Record<string, number> = { ArrowRight: i + 1, ArrowDown: i + 1, ArrowLeft: i - 1, ArrowUp: i - 1, Home: 0, End: tabs.length - 1 };
        const next = map[e.key];
        if (next === undefined) return;
        e.preventDefault();
        select(tabs[(next + tabs.length) % tabs.length]!);
      });
    });
  });
</script>

<style>
  .hero-note { max-width: 36ch; }

  /* ---- Proof ---- */
  .proof { padding-block: var(--s-6) var(--s-8); }
  .proof__list { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--s-6) var(--gutter); padding-top: var(--s-6); border-top: 1px solid var(--rule); }
  @media (min-width: 64rem) { .proof__list { grid-template-columns: repeat(4, 1fr); } }
  .proof__item { display: flex; flex-direction: column-reverse; gap: var(--s-2); }
  .proof__item dt { color: var(--ink-2); font-weight: 500; }
  .proof__item .figure { font-size: clamp(2.6rem, 1.6rem + 3.4vw, 4.25rem); }

  /* ---- Services index ---- */
  .sindex { row-gap: var(--s-6); }
  .sindex__list { border-top: 1px solid var(--rule); }
  .sindex__row { border-bottom: 1px solid var(--rule); transition: opacity var(--t-ui) ease; }
  .sindex__link { position: relative; display: grid; grid-template-columns: 1fr auto; gap: var(--s-2) var(--s-5); padding: var(--s-5) 0; text-decoration: none; }
  .sindex__name { display: inline-flex; flex-wrap: wrap; align-items: center; gap: var(--s-3); font-family: var(--font-display); font-size: clamp(1.6rem, 1.15rem + 1.5vw, 2.4rem); font-weight: 700; letter-spacing: -0.03em; line-height: 1.05; transition: transform 500ms var(--ease-out); }
  .sindex__sum { grid-column: 1; color: var(--ink-2); max-width: 52ch; }
  .sindex__facts { grid-column: 1; display: flex; flex-wrap: wrap; gap: var(--s-1) var(--s-6); font-weight: 600; }
  .sindex__go { grid-column: 2; grid-row: 1; display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: 50%; border: 1px solid var(--rule-strong); transition: background-color var(--t-ui) ease, border-color var(--t-ui) ease, transform var(--t-ui) var(--ease-out); }
  @media (hover: hover) and (pointer: fine) {
    .sindex__list:has(.sindex__row:hover) .sindex__row:not(:hover) { opacity: 0.4; }
    .sindex__row:hover .sindex__name { transform: translateX(6px); }
    .sindex__row:hover .sindex__go { background: var(--mark); border-color: var(--mark); color: var(--mark-ink); transform: rotate(45deg); }
  }
  .sindex__list:has(.sindex__link:focus-visible) .sindex__row:not(:has(:focus-visible)) { opacity: 0.4; }
  .sindex__frame { display: none; }
  @media (min-width: 64rem) {
    .sindex__frame { display: grid; position: sticky; top: calc(var(--header-h) + var(--s-5)); align-self: start; aspect-ratio: 4 / 5; }
    .sindex__frame > :global(.photo) { grid-area: 1 / 1; clip-path: inset(100% 0 0 0 round var(--radius)); transition: clip-path 560ms var(--ease-in-out); }
    .sindex__frame > :global(.sindex__photo--0) { clip-path: inset(0 round var(--radius)); }
    .sindex:has(.sindex__row:hover) :global(.sindex__photo--0) { clip-path: inset(100% 0 0 0 round var(--radius)); }
    .sindex:has([data-row='0']:is(:hover, :focus-within)) :global(.sindex__photo--0),
    .sindex:has([data-row='1']:is(:hover, :focus-within)) :global(.sindex__photo--1),
    .sindex:has([data-row='2']:is(:hover, :focus-within)) :global(.sindex__photo--2),
    .sindex:has([data-row='3']:is(:hover, :focus-within)) :global(.sindex__photo--3),
    .sindex:has([data-row='4']:is(:hover, :focus-within)) :global(.sindex__photo--4) { clip-path: inset(0 round var(--radius)); }
  }

  /* ---- Same hours, different sky ---- */
  .sky { display: grid; gap: var(--s-7); padding: clamp(1.5rem, 1rem + 3vw, 4rem); border-radius: calc(var(--radius) * 1.6); }
  .sky__head { display: grid; gap: var(--s-4); max-width: 46rem; }
  .sky__lead { color: var(--ink-2); font-size: var(--t-lead); line-height: 1.5; }
  .sky__body { display: grid; gap: var(--s-7); }
  @media (min-width: 64rem) { .sky__body { grid-template-columns: 1.35fr 1fr; align-items: start; } }
  .sky__day { display: grid; gap: var(--s-4); }
  .sky__day-head { display: flex; justify-content: space-between; font-weight: 600; padding-bottom: var(--s-3); border-bottom: 1px solid var(--rule); }
  .sky__list { display: grid; }
  .sky__item { display: grid; grid-template-columns: 5.5rem 1fr; gap: var(--s-4); padding-block: var(--s-4); border-bottom: 1px solid var(--rule); }
  .sky__time { font-weight: 700; color: var(--accent-text); }
  .sky__what { display: grid; gap: 0.1rem; }

  /* ---- Steps ---- */
  .steps { position: relative; display: grid; gap: var(--s-6) var(--gutter); }
  @media (min-width: 64rem) {
    .steps { grid-template-columns: repeat(4, 1fr); }
    .steps::before { content: ''; position: absolute; top: 0.6rem; left: 0; right: 0; height: 2px; background: var(--rule-strong); }
  }
  .step { position: relative; display: grid; gap: var(--s-3); align-content: start; padding-left: 2.25rem; }
  @media (min-width: 64rem) { .step { padding-left: 0; padding-top: 2.75rem; } }
  .step__dot { position: absolute; left: 0; top: 0; width: 1.25rem; height: 1.25rem; border-radius: 50%; background: var(--ground); border: 2px solid var(--ink); }
  .step--now .step__dot { background: var(--mark); border-color: var(--ink); }
  .step__dur { font-weight: 700; color: var(--ink-2); }

  /* ---- Bento ---- */
  .bento { display: grid; gap: var(--s-4); }
  @media (min-width: 48rem) { .bento { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 64rem) { .bento { grid-template-columns: repeat(4, 1fr); } }
  .bento > * { min-width: 0; }
  .bento__stack, .bento__cell { display: grid; gap: var(--s-3); align-content: start; padding: var(--module-pad); border-radius: var(--radius); }
  .bento__stack-copy { display: grid; gap: var(--s-3); }
  .bento__photo { min-height: 14rem; }
  /* Four columns: the stack fills a 2×2 block; six guarantees and a photo fill the rest exactly. */
  @media (min-width: 64rem) {
    .bento__stack { grid-column: 1 / span 2; grid-row: 1 / span 2; align-content: space-between; }
    .bento__cell--0 { grid-column: 3 / span 2; grid-row: 1; }
    .bento__cell--1 { grid-column: 3; grid-row: 2; }
    .bento__cell--2 { grid-column: 4; grid-row: 2; }
    .bento__cell--3 { grid-column: 1 / span 2; grid-row: 3; }
    .bento__cell--4 { grid-column: 3; grid-row: 3; }
    .bento__cell--5 { grid-column: 1 / span 3; grid-row: 4; }
    .bento__photo { grid-column: 4; grid-row: 3 / span 2; }
  }
  .bento__tools { display: flex; flex-wrap: wrap; gap: var(--s-2); margin-top: var(--s-5); }

  /* ---- Tabs ---- */
  .tabs { display: grid; gap: var(--s-5); }
  .tabs__list { display: flex; flex-wrap: wrap; gap: var(--s-2); }
  .tabs__tab {
    min-height: 44px;
    padding: 0.55rem 1.1rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--rule-strong);
    font-weight: 600;
    transition: background-color var(--t-ui) ease, color var(--t-ui) ease, border-color var(--t-ui) ease, transform var(--t-press) var(--ease-out);
  }
  .tabs__tab:active { transform: scale(0.97); }
  .tabs__tab[aria-selected='true'] { background: var(--ink); color: var(--ground); border-color: var(--ink); }
  @media (hover: hover) and (pointer: fine) { .tabs__tab:hover:not([aria-selected='true']) { border-color: var(--ink); } }
  .tabs__panel { display: grid; gap: var(--s-6); padding: var(--module-pad); }
  .tabs__panel[hidden] { display: none; }
  @media (min-width: 48rem) { .tabs__panel { grid-template-columns: 1.1fr 0.9fr; } }
  .tabs__copy { display: grid; gap: var(--s-5); align-content: start; }
  .tabs__summary { font-family: var(--font-display); font-size: clamp(1.4rem, 1.1rem + 1vw, 2rem); line-height: 1.15; letter-spacing: -0.025em; }
  .tabs__photo { min-height: 16rem; }

  .compare-foot { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-4) var(--s-6); margin-top: var(--s-6); }
</style>
