---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import EngagementTimeline from '@/components/heroes/EngagementTimeline.astro';
import Photo from '@/components/Photo.astro';
import WorkCard from '@/components/WorkCard.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import { serviceBySlug, serviceHref } from '@/data/services';
import { photoFor } from '@/data/photos';
import { work, type WorkItem } from '@/data/work';
import { canonical, ids } from '@/lib/seo';
import { site } from '@/config/site';

export const getStaticPaths = (() =>
  work.map((w, i) => ({
    params: { slug: w.slug },
    props: { item: w, prev: work[(i - 1 + work.length) % work.length]!, next: work[(i + 1) % work.length]! },
  }))) satisfies GetStaticPaths;

interface Props {
  item: WorkItem;
  prev: WorkItem;
  next: WorkItem;
}
const { item: w, prev, next } = Astro.props;
const service = serviceBySlug(w.service)!;
const path = `/work/${w.slug}`;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Work', path: '/work' },
  { name: w.title, path },
];
const isCase = w.kind === 'case-study';
const kindLabel = isCase ? 'Case study' : 'Blueprint';
const creativeWork = {
  '@type': isCase ? 'Article' : 'CreativeWork',
  '@id': `${canonical(path)}#work`,
  headline: w.title,
  name: w.title,
  description: w.meta.description,
  about: { '@type': 'Service', name: service.name, url: canonical(serviceHref(service.slug)) },
  author: { '@id': ids.organization },
  publisher: { '@id': ids.organization },
  image: canonical(`/og/work-${w.slug}.png`),
  genre: isCase ? 'Case study' : 'Engagement blueprint',
};

// Related: other blueprints in the same practice first, then the neighbours.
const related = [
  ...work.filter((x) => x.slug !== w.slug && x.service === w.service),
  ...[next, prev].filter((x) => x.slug !== w.slug && x.service !== w.service),
  ...work.filter((x) => x.slug !== w.slug && x.service !== w.service),
]
  .filter((x, i, arr) => arr.findIndex((y) => y.slug === x.slug) === i)
  .slice(0, 3);
const photo = photoFor(w.art, w.variant);
const secondPhoto = photoFor(w.art, w.variant + 1);
---

<BaseLayout {...w.meta} path={path} image={`/og/work-${w.slug}.png`} breadcrumbs={crumbs} schema={[creativeWork]}>
  <article>
    <Hero labelledby="cs-title" split="5-7" crumbs={crumbs} class="cs-hero">
      <h1 class="cs__title" id="cs-title">{w.title}</h1>
      <p class="hero__lead">{w.summary}</p>
      <ul class="chips cs__tags" role="list" aria-label="About this page">
        <li class:list={['chip cs__kind', { 'cs__kind--case': isCase }]}>{isCase ? 'Case study' : 'Engagement blueprint'}</li>
        <li><a class="chip cs__practice" href={serviceHref(service.slug)}>{service.name}</a></li>
        <li class="chip">{w.industry}</li>
      </ul>
      <div class="actions">
        <a class="btn btn--primary" href={site.calendly} target="_blank" rel="noopener">
          Plan one like this <Icon name="arrow-up-right" class="btn__arrow" />
        </a>
        <a class="btn btn--ghost" href="#approach-title">Read the approach <Icon name="arrow-right" class="btn__arrow btn__arrow--right" /></a>
      </div>
      <EngagementTimeline slot="instrument" item={w} />

      <div slot="strip" class="strip ruled">
        <div class="strip__photo">
          <Photo name={photo} alt="" fill priority={false} sizes="(min-width: 64rem) 34vw, 100vw" caption={kindLabel} />
        </div>
        <dl class="module strip__facts">
          <div><dt class="label">Practice</dt><dd>{service.name}</dd></div>
          <div><dt class="label">Industry</dt><dd>{w.industry}</dd></div>
          <div><dt class="label">Format</dt><dd>{w.format}</dd></div>
          <div><dt class="label">Team</dt><dd>{w.team}</dd></div>
          <div><dt class="label">Duration</dt><dd>{w.duration}</dd></div>
        </dl>
        {
          isCase ? (
            <div class="module module--flex lime strip__note">
              <p class="strip__note-title">Case study</p>
              <p>Published with the written permission of {w.client ?? 'the client'}.</p>
            </div>
          ) : (
            <div class="module module--flex lime strip__note">
              <p class="strip__note-title">Blueprint</p>
              <p class="cs__disclaimer">
                This is a worked plan showing how we would staff and run this kind of engagement. It is not a report of a specific client’s results.
              </p>
            </div>
          )
        }
      </div>
    </Hero>

    {
      isCase && w.outcomes && (
        <section class="section section--flush-top" aria-labelledby="outcomes-title">
          <div class="wrap">
            <h2 class="sr-only" id="outcomes-title">Outcomes</h2>
            <dl class="outcomes ruled">
              {w.outcomes.map((o) => (
                <div class="module module--flex">
                  <dd class="figure">{o.figure}</dd>
                  <dt class="outcomes__label">{o.label}</dt>
                </div>
              ))}
            </dl>
          </div>
        </section>
      )
    }

    <!-- Situation -->
    <section class="section seam-sit" aria-labelledby="situation-title">
      <div class="wrap grid sit__grid">
        <div class="sit__copy c-7">
          <h2 class="h2" id="situation-title" data-split>The situation</h2>
          <p class="sit__lead" data-reveal>{w.situation}</p>
          {isCase && w.client && <p class="label sit__client">Client: {w.client}</p>}
        </div>
        <div class="sit__photo c-4 s-9">
          <Photo name={secondPhoto} ratio="4 / 5" sizes="(min-width: 64rem) 30vw, 100vw" reveal="clip" />
        </div>
      </div>
    </section>

    <!-- Approach -->
    <section class="section plate" aria-labelledby="approach-title">
      <div class="wrap">
        <div class="section-head grid">
          <h2 class="h2" id="approach-title" data-split>The approach</h2>
          <p data-reveal>{w.approach.length} phases, run by {w.team.toLowerCase()}. {w.duration}.</p>
        </div>
        <ol class="approach ruled ruled--plate" role="list" data-reveal-group style={`--n:${w.approach.length}`}>
          {
            w.approach.map((a, i) => (
              <li class:list={['module module--flex approach__step', { lime: i === w.approach.length - 1 }]} data-reveal>
                <h3 class="approach__title">{a.title}</h3>
                <p class="approach__body">{a.body}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- Deliverables, measures, tools -->
    <section class="section" aria-labelledby="spec-title">
      <div class="wrap">
        <div class="section-head grid">
          <h2 class="h2" id="spec-title" data-split>The specification</h2>
          <p data-reveal>What you receive, what would be measured, and the tools the team works in.</p>
        </div>
        <div class="grid spec-grid">
          <div class="c-5 spec-block">
            <h3 class="h3">What you receive</h3>
            <ul class="ticks spec-list" role="list">
              {w.deliverables.map((d) => <li>{d}</li>)}
            </ul>
          </div>
          <div class="c-7 spec-block">
            <h3 class="h3">What we measure</h3>
            <table class="measures">
              <caption class="sr-only">Measures for this {isCase ? 'case study' : 'blueprint'}</caption>
              <thead>
                <tr>
                  <th scope="col" class="label">Measure</th>
                  <th scope="col" class="label">Reported in</th>
                  <th scope="col" class="label">Result</th>
                </tr>
              </thead>
              <tbody>
                {
                  w.measures.map((m) => (
                    <tr>
                      <th scope="row">{m}</th>
                      <td>Weekly report</td>
                      <td class="measures__result">{isCase ? 'See outcomes' : 'Not claimed: blueprint'}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
            <p class="small measures__note">
              {isCase ? 'Figures are published with the client’s permission.' : 'These are the numbers a client partner would review with you. A blueprint reports no results.'}
            </p>
          </div>
          <div class="c-12 spec-block tools">
            <h3 class="h3">Tools</h3>
            <ul class="chips" role="list">
              {w.tools.map((t) => <li class="chip">{t}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </section>

    {
      isCase && w.quote && (
        <section class="section section--flush-top" aria-label="Client quote">
          <div class="wrap grid">
            <blockquote class="quote c-9">
              <p>{w.quote.text}</p>
              <footer class="label">
                {w.quote.name}, {w.quote.role}
              </footer>
            </blockquote>
          </div>
        </section>
      )
    }

    <!-- Related -->
    <section class="section section--flush-top" aria-labelledby="related-title">
      <div class="wrap">
        <div class="section-head grid">
          <h2 class="h2" id="related-title" data-split>Related blueprints</h2>
          <p data-reveal>More engagements in {service.shortName.toLowerCase()} and across the other practices.</p>
        </div>
        <div class="grid related" data-reveal-group>
          {related.map((r) => <div class="c-4 t-4" data-reveal><WorkCard item={r} /></div>)}
        </div>
        <nav class="cs-nav ruled" aria-label="More blueprints">
          <a class="module cs-nav__link" href={`/work/${prev.slug}`} rel="prev">
            <span class="label cs-nav__dir"><Icon name="arrow-left" /> Previous</span>
            <span class="cs-nav__title">{prev.title}</span>
          </a>
          <a class="module cs-nav__link cs-nav__link--next" href={`/work/${next.slug}`} rel="next">
            <span class="label cs-nav__dir">Next <Icon name="arrow-right" /></span>
            <span class="cs-nav__title">{next.title}</span>
          </a>
        </nav>
      </div>
    </section>
  </article>

  <CtaBand
    heading="Want an engagement like this?"
    line={`A ${service.shortName.toLowerCase()} specialist can start within days of a discovery call.`}
    photo={photoFor(w.art, w.variant + 2)}
    photoAlt=""
  />
</BaseLayout>

<style>
  /* ---- Hero ---- */
  .cs__title {
    font-size: clamp(2rem, 1.1rem + 2.6vw, 3.75rem);
    font-weight: 750;
    font-stretch: var(--wide);
    line-height: 0.98;
    letter-spacing: -0.025em;
    text-transform: uppercase;
    max-width: 18ch;
  }
  .cs__tags { gap: var(--s-2); }
  .cs__kind { background: var(--field); color: var(--field-ink); border-color: var(--field); font-weight: 700; }
  .cs__practice { text-decoration: none; min-height: 44px; }
  @media (hover: hover) and (pointer: fine) { .cs__practice:hover { border-color: var(--ink); } }

  .strip { grid-template-columns: 1fr; }
  @media (min-width: 40rem) { .strip { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 64rem) { .strip { grid-template-columns: 4fr 5fr 3.5fr; } }
  .strip__photo { min-height: 16rem; }
  @media (min-width: 40rem) and (max-width: 63.99rem) { .strip__note { grid-column: 1 / -1; } }
  .strip__facts { display: grid; gap: 0; margin: 0; align-content: start; }
  .strip__facts div { display: grid; grid-template-columns: 7rem 1fr; gap: var(--s-4); padding-block: var(--s-3); border-bottom: 1px solid var(--rule); }
  .strip__facts div:last-child { border-bottom: 0; }
  .strip__facts dt { color: var(--ink-2); padding-top: 0.2rem; }
  .strip__facts dd { font-weight: 600; }
  .strip__note { gap: var(--s-4); justify-content: space-between; }
  .strip__note-title { font-size: clamp(1.375rem, 1rem + 0.9vw, 1.75rem); font-weight: 750; font-stretch: var(--wide); text-transform: uppercase; line-height: 1; letter-spacing: -0.02em; }

  .outcomes { grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); margin: 0; }
  .outcomes .module { gap: var(--s-4); }
  .outcomes__label { color: var(--ink-2); }

  /* ---- Situation ---- */
  .sit__grid { row-gap: var(--s-7); align-items: end; }
  .sit__copy { display: grid; gap: var(--s-6); padding-top: var(--s-5); border-top: 1px solid var(--rule-strong); }
  .sit__lead { font-size: clamp(1.375rem, 1rem + 1.4vw, 2.25rem); font-weight: 600; font-stretch: var(--semi-wide); line-height: 1.22; letter-spacing: -0.015em; max-width: 34ch; }
  .sit__client { color: var(--ink-2); }

  /* ---- Approach ---- */
  .approach { grid-template-columns: 1fr; }
  @media (min-width: 40rem) { .approach { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 64rem) { .approach { grid-template-columns: repeat(var(--n), 1fr); } }
  .approach__step { gap: var(--s-4); }
  @media (min-width: 64rem) { .approach__step { min-height: 15rem; } }
  .approach__title { font-size: clamp(1.25rem, 1.1rem + 0.5vw, 1.5rem); font-stretch: var(--wide); line-height: 1.12; letter-spacing: -0.01em; }
  .approach__body { color: var(--ink-2); font-size: var(--t-small); }

  /* ---- Specification ---- */
  .spec-grid { row-gap: var(--s-8); }
  .spec-block { display: grid; gap: var(--s-5); align-content: start; }
  .spec-list { border-top: 1px solid var(--rule-strong); padding-top: var(--s-5); font-weight: 550; }
  .measures { border-top: 1px solid var(--rule-strong); font-size: var(--t-small); }
  .measures th, .measures td { text-align: left; padding: var(--s-3) var(--s-4) var(--s-3) 0; border-bottom: 1px solid var(--rule); vertical-align: top; }
  .measures thead th { color: var(--ink-2); padding-block: var(--s-3); }
  .measures tbody th { font-weight: 650; font-size: 1rem; }
  .measures td { color: var(--ink-2); white-space: nowrap; }
  .measures td.measures__result { color: var(--accent-text); font-weight: 600; }
  @media (max-width: 40rem) {
    .measures thead { display: none; }
    .measures tr { display: grid; grid-template-columns: 1fr auto; padding-block: var(--s-3); border-bottom: 1px solid var(--rule); }
    .measures th, .measures td { border: 0; padding: 0.15rem 0; }
    .measures tbody th { grid-column: 1 / -1; }
  }
  .measures__note { color: var(--ink-2); }
  .tools { padding-top: var(--s-5); border-top: 1px solid var(--rule); }

  .quote { border-top: 6px solid var(--accent); padding-top: var(--s-6); display: grid; gap: var(--s-5); }
  .quote p { font-size: clamp(1.5rem, 1rem + 1.8vw, 2.75rem); font-weight: 650; font-stretch: var(--semi-wide); line-height: 1.15; letter-spacing: -0.02em; }
  .quote footer { color: var(--ink-2); }

  /* ---- Related ---- */
  .related { row-gap: var(--s-8); }
  .cs-nav { grid-template-columns: 1fr; margin-top: var(--s-8); }
  @media (min-width: 40rem) { .cs-nav { grid-template-columns: 1fr 1fr; } }
  .cs-nav__link { display: grid; gap: var(--s-3); text-decoration: none; transition: background-color var(--t-ui) ease, color var(--t-ui) ease; }
  .cs-nav__link--next { text-align: right; justify-items: end; }
  .cs-nav__dir { display: inline-flex; align-items: center; gap: var(--s-2); color: var(--ink-2); }
  .cs-nav__title { font-size: clamp(1.125rem, 1rem + 0.6vw, 1.5rem); font-weight: 700; font-stretch: var(--semi-wide); line-height: 1.2; max-width: 30ch; }
  @media (hover: hover) and (pointer: fine) {
    .cs-nav__link:hover { background: var(--field); color: var(--field-ink); --ink-2: var(--field-ink-2); }
  }
  @media (max-width: 39.99rem) { .cs-nav__link--next { text-align: left; justify-items: start; } }
</style>
