---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import WorkBoard from '@/components/heroes/WorkBoard.astro';
import WorkCard from '@/components/WorkCard.astro';
import Photo from '@/components/Photo.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import { site } from '@/config/site';
import { pages } from '@/data/pages';
import { services } from '@/data/services';
import { work } from '@/data/work';
import { canonical } from '@/lib/seo';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Work', path: '/work' },
];
const filters = [{ slug: 'all', label: 'All work' }, ...services.map((s) => ({ slug: s.slug, label: s.shortName }))];
const itemList = {
  '@type': 'ItemList',
  name: 'Engagement blueprints',
  itemListElement: work.map((w, i) => ({ '@type': 'ListItem', position: i + 1, url: canonical(`/work/${w.slug}`), name: w.title })),
};
const formats = (['Specialist', 'Pod', 'Project'] as const).map((f) => ({ f, n: work.filter((w) => w.format === f).length }));

const anatomy = [
  { title: 'The situation', body: 'The kind of company, the work that slips and why. Written from the problems buyers bring to discovery calls.' },
  { title: 'The team and format', body: 'Who is on the engagement, which U.S. hours they keep and whether it is one specialist, a pod or a fixed project.' },
  { title: 'The first weeks', body: 'The approach step by step, from read-only shadowing to owning the function.' },
  { title: 'What you receive', body: 'The written deliverables: procedures, trackers, reports and the systems they live in.' },
  { title: 'What we would measure', body: 'The numbers a client partner would review with you. Measures, not claimed results.' },
];
---

<BaseLayout {...pages.work} image="/og/work.png" breadcrumbs={crumbs} schema={[itemList]} webPage={{ '@type': ['WebPage', 'CollectionPage'] }}>
  <Hero labelledby="work-title" split="5-7" crumbs={crumbs}>
    <h1 class="h1 hero__title" id="work-title">Work, planned <span class="accent">in the open.</span></h1>
    <p class="hero__lead">
      Engagement blueprints show exactly how we staff, start and measure each kind of engagement: who is on the team, what happens in the first
      weeks, what you receive and what we track. Filter by practice.
    </p>
    <div class="actions">
      <a class="btn btn--primary" href={site.calendly} target="_blank" rel="noopener">
        Plan your engagement <Icon name="arrow-up-right" class="btn__arrow" />
      </a>
      <a class="btn btn--ghost" href="#blueprints-title">All {work.length} blueprints <Icon name="arrow-right" class="btn__arrow btn__arrow--right" /></a>
    </div>
    <WorkBoard slot="instrument" />

    <div slot="strip" class="strip ruled">
      <div class="module module--flex lime">
        <p class="figure">{work.length}</p>
        <p class="strip__text">Blueprints across five practices. Plans, not invented case studies.</p>
      </div>
      {
        formats.map((x) => (
          <div class="module module--flex">
            <p class="figure">{x.n}</p>
            <p class="strip__text">
              {x.f === 'Specialist' ? 'Single-specialist engagement' : x.f === 'Pod' ? 'Pods with their own team lead' : 'Fixed-scope projects'}
            </p>
          </div>
        ))
      }
    </div>
  </Hero>

  <section class="section wk" aria-labelledby="blueprints-title" data-filter-root>
    <div class="wrap">
      <div class="section-head grid">
        <h2 class="h2" id="blueprints-title" data-split>Every blueprint, by practice.</h2>
        <p data-reveal>Each one is a worked plan for a kind of engagement we run. Choose a practice to narrow the list; the board above follows.</p>
      </div>

      <div class="wk__bar">
        <div class="chips" role="group" aria-label="Filter by practice">
          {
            filters.map((f, i) => (
              <button class="chip wk__filter" type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-filter={f.slug}>
                <span data-filter-label>{f.label}</span>
                <span class="wk__count">{f.slug === 'all' ? work.length : work.filter((w) => w.service === f.slug).length}</span>
              </button>
            ))
          }
        </div>
        <p class="wk__status small" role="status" aria-live="polite" data-filter-status>Showing all {work.length} blueprints</p>
      </div>

      <ul class="wk__grid grid" role="list">
        {
          work.map((w) => (
            <li class="wk__item c-4 t-4" data-service={w.service}>
              <WorkCard item={w} />
            </li>
          ))
        }
      </ul>
      <p class="wk__empty module plate" hidden data-filter-empty>No blueprints for this practice yet. Ask us how we would run it.</p>
    </div>
  </section>

  <!-- What a blueprint is -->
  <section class="section plate anatomy" aria-labelledby="anatomy-title">
    <div class="wrap grid anatomy__grid">
      <div class="anatomy__photo c-5">
        <Photo name="desk-overhead" ratio="4 / 5" sizes="(min-width: 64rem) 36vw, 100vw" reveal="clip" />
      </div>
      <div class="anatomy__copy c-6 s-7">
        <h2 class="h2" id="anatomy-title" data-split>What a blueprint is, and is not.</h2>
        <p class="anatomy__lead" data-reveal>
          A blueprint is the plan a client partner would put in front of you after a discovery call: the team, the first weeks, the deliverables and the
          measures. It is how we run each kind of engagement, written down.
        </p>
        <dl class="anatomy__list">
          {
            anatomy.map((a) => (
              <div data-reveal>
                <dt>{a.title}</dt>
                <dd>{a.body}</dd>
              </div>
            ))
          }
        </dl>
        <div class="anatomy__note lime module" data-reveal>
          <p class="anatomy__note-title">Case studies, with permission</p>
          <p class="wk__note">
            Blueprints are worked plans built from how we run each kind of engagement. Client names and results are published only with written
            permission. Real case studies will be added here as clients approve them, clearly marked as case studies.
          </p>
        </div>
      </div>
    </div>
  </section>

  <CtaBand heading="Your plan, drawn on the call." line="Tell us about the work you want to hand off. We will sketch the blueprint for your engagement on the call." photo="team-table" />
</BaseLayout>

<script>
  interface WorkFilterDetail {
    slug: string;
    source: string;
  }
  document.querySelectorAll<HTMLElement>('[data-filter-root]').forEach((root) => {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const items = [...root.querySelectorAll<HTMLElement>('[data-service]')];
    const status = root.querySelector<HTMLElement>('[data-filter-status]');
    const empty = root.querySelector<HTMLElement>('[data-filter-empty]');
    let current = 'all';

    const apply = (slug: string, push: boolean): void => {
      current = slug;
      let shown = 0;
      const run = (): void => {
        items.forEach((item) => {
          const on = slug === 'all' || item.dataset.service === slug;
          item.hidden = !on;
          if (on) shown++;
        });
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === slug)));
        const label = buttons.find((b) => b.dataset.filter === slug)?.querySelector('[data-filter-label]')?.textContent?.trim() ?? '';
        if (status) status.textContent = slug === 'all' ? `Showing all ${shown} blueprints` : `Showing ${shown} ${label.toLowerCase()} blueprint${shown === 1 ? '' : 's'}`;
        if (empty) empty.hidden = shown > 0;
      };
      const doc = document as Document & { startViewTransition?: (cb: () => void) => unknown };
      if (push && doc.startViewTransition && !matchMedia('(prefers-reduced-motion: reduce)').matches) doc.startViewTransition(run);
      else run();
      if (push) {
        const url = new URL(location.href);
        if (slug === 'all') url.searchParams.delete('service');
        else url.searchParams.set('service', slug);
        history.replaceState(null, '', url);
      }
    };

    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        const slug = b.dataset.filter ?? 'all';
        apply(slug, true);
        document.dispatchEvent(new CustomEvent<WorkFilterDetail>('work:filter', { detail: { slug, source: 'grid' } }));
      }),
    );
    // The hero board shares the filter.
    document.addEventListener('work:filter', (e) => {
      const detail = (e as CustomEvent<WorkFilterDetail>).detail;
      if (detail.source === 'grid' || detail.slug === current) return;
      apply(detail.slug, true);
    });
    const initial = new URL(location.href).searchParams.get('service');
    if (initial && buttons.some((b) => b.dataset.filter === initial)) apply(initial, false);
  });
</script>

<style>
  /* ---- Hero strip ---- */
  .strip { grid-template-columns: repeat(3, 1fr); }
  @media (min-width: 64rem) { .strip { grid-template-columns: 4fr 3fr 3fr 3fr; } }
  .strip .module { min-height: 8rem; gap: var(--s-4); justify-content: space-between; }
  .strip .lime { grid-column: 1 / -1; }
  @media (min-width: 64rem) { .strip .lime { grid-column: auto; } .strip .module { min-height: 11rem; } }
  .strip .figure { font-size: clamp(2.5rem, 1.6rem + 2vw, 3.5rem); }
  .strip .lime .figure { font-size: clamp(3.5rem, 2rem + 4vw, 5.5rem); }
  .strip__text { max-width: 28ch; font-size: var(--t-small); color: var(--ink-2); }
  @media (max-width: 39.99rem) { .strip .module:not(.lime) { padding: var(--s-4) var(--s-3); } .strip .module:not(.lime) .strip__text { font-size: 0.8125rem; } }
  .strip .lime .strip__text { font-size: 1.0625rem; font-weight: 550; }

  /* ---- Blueprint grid ---- */
  .wk__bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--s-4); padding-block: var(--s-4); margin-bottom: var(--s-7); border-block: 1px solid var(--rule); }
  .wk__count { font-variant-numeric: tabular-nums; color: var(--ink-3); font-weight: 650; }
  .wk__filter[aria-pressed='true'] .wk__count { color: inherit; opacity: 0.7; }
  .wk__status { color: var(--ink-2); }
  :global(html:not(.js)) .wk__bar .chips { display: none; }
  .wk__grid { row-gap: var(--s-8); }
  .wk__item { view-transition-class: card; }
  .wk__item:nth-child(1) { view-transition-name: wk-1; } .wk__item:nth-child(2) { view-transition-name: wk-2; }
  .wk__item:nth-child(3) { view-transition-name: wk-3; } .wk__item:nth-child(4) { view-transition-name: wk-4; }
  .wk__item:nth-child(5) { view-transition-name: wk-5; } .wk__item:nth-child(6) { view-transition-name: wk-6; }
  .wk__item:nth-child(7) { view-transition-name: wk-7; } .wk__item:nth-child(8) { view-transition-name: wk-8; }
  :global(::view-transition-group(.card)) { animation-duration: 280ms; animation-timing-function: var(--ease-out); }
  .wk__empty { margin-top: var(--s-6); }

  /* ---- Anatomy ---- */
  .anatomy__grid { row-gap: var(--s-7); }
  @media (min-width: 64rem) { .anatomy__photo { position: sticky; top: calc(var(--header-h) + var(--s-6)); align-self: start; } }
  .anatomy__copy { display: grid; gap: var(--s-6); align-content: start; }
  .anatomy__lead { color: var(--ink-2); font-size: var(--t-lead); line-height: 1.45; max-width: 46ch; }
  .anatomy__list { display: grid; border-top: 1px solid var(--rule-strong); }
  .anatomy__list > div { display: grid; gap: var(--s-2) var(--gutter); padding-block: var(--s-4); border-bottom: 1px solid var(--rule); }
  @media (min-width: 40rem) { .anatomy__list > div { grid-template-columns: 13rem 1fr; } }
  .anatomy__list dt { font-weight: 700; font-stretch: var(--semi-wide); }
  .anatomy__list dd { color: var(--ink-2); }
  .anatomy__note { display: grid; gap: var(--s-3); }
  .anatomy__note-title { font-size: 1.25rem; font-weight: 750; font-stretch: var(--wide); text-transform: uppercase; line-height: 1.1; }
  .wk__note { color: var(--ink-2); max-width: 60ch; }
</style>
