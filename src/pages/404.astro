---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import WrongTurn from '@/components/heroes/WrongTurn.astro';
import Icon from '@/components/Icon.astro';
import { pages } from '@/data/pages';
import { services, serviceHref } from '@/data/services';
import { webSubServices } from '@/data/webdev';
import { work } from '@/data/work';
import { locations } from '@/data/locations';
import { getPosts, postHref } from '@/lib/blog';
import type { SearchEntry } from '@/lib/fuzzy';

const posts = await getPosts();

const links = [
  { href: '/', label: 'Home', body: 'Start again from the top.' },
  { href: '/services', label: 'Services', body: 'Five practices on your U.S. hours.' },
  { href: '/work', label: 'Work', body: 'How we staff and run engagements.' },
  { href: '/blog', label: 'Insights', body: 'Guides on outsourcing and the web.' },
  { href: '/contact', label: 'Contact', body: 'Talk to a client partner.' },
];

/** Every page on the site, grouped as the site map shows them. Built at build time. */
const groups: { name: string; entries: SearchEntry[] }[] = [
  {
    name: 'Practices',
    entries: [
      { title: 'All services', path: '/services', group: 'Practices', keywords: 'outsourcing offshore staffing practices' },
      ...services.map((s) => ({
        title: s.name,
        path: serviceHref(s.slug),
        group: 'Practices',
        keywords: [
          s.shortName,
          ...s.capabilities.map((c) => c.title),
          ...s.tools,
          ...(s.slug === 'website-development' ? [...webSubServices.map((w) => w.title), ...webSubServices.flatMap((w) => w.stack)] : []),
        ].join(' '),
      })),
    ],
  },
  {
    name: 'Blueprints',
    entries: [
      { title: 'All engagement blueprints', path: '/work', group: 'Blueprints', keywords: 'work portfolio case studies examples' },
      ...work.map((w) => ({ title: w.title, path: `/work/${w.slug}`, group: 'Blueprints', keywords: `${w.industry} ${w.format} ${w.tools.join(' ')}` })),
    ],
  },
  {
    name: 'Field notes',
    entries: [
      { title: 'All articles', path: '/blog', group: 'Field notes', keywords: 'blog insights articles guides' },
      ...posts.map((p) => ({ title: p.data.title, path: postHref(p), group: 'Field notes', keywords: `${p.data.category} ${p.data.tags.join(' ')}` })),
    ],
  },
  {
    name: 'Locations',
    entries: [
      { title: 'Service areas', path: '/locations', group: 'Locations', keywords: 'locations cities offices' },
      ...locations.map((l) => ({ title: `${l.city}, ${l.region}`, path: `/locations/${l.slug}`, group: 'Locations', keywords: `${l.regionName} ${l.isHeadquarters ? 'headquarters office' : ''}` })),
    ],
  },
  {
    name: 'Company',
    entries: [
      { title: 'Home', path: '/', group: 'Company', keywords: 'homepage start' },
      { title: 'About Akrostech', path: '/about', group: 'Company', keywords: 'company mission team values people' },
      { title: 'Contact', path: '/contact', group: 'Company', keywords: 'book call email phone enquiry address calendly' },
      { title: 'Privacy policy', path: '/privacy', group: 'Company', keywords: 'data cookies gdpr ccpa' },
      { title: 'Terms and conditions', path: '/terms', group: 'Company', keywords: 'legal terms of use' },
    ],
  },
];
const entries = groups.flatMap((g) => g.entries);
const starters: SearchEntry[] = links.map((l) => ({ title: l.label, path: l.href, group: 'Start here', body: l.body }));
---

<BaseLayout {...pages.notFound} noindex preloader={false}>
  <Hero labelledby="nf-title" split="5-7">
    <h1 class="h1 hero__title" id="nf-title">Nobody’s on shift for <span class="accent">this page.</span></h1>
    <p class="hero__lead">
      Error 404: the page you asked for has moved or never existed. Everything else is open for business. Find it by name, or pick up from the site map.
    </p>
    <div class="actions">
      <a class="btn btn--primary" href="/">Back to the homepage <Icon name="arrow-right" class="btn__arrow btn__arrow--right" /></a>
      <a class="btn btn--ghost" href="/contact">Talk to a client partner <Icon name="arrow-right" class="btn__arrow btn__arrow--right" /></a>
    </div>
    <WrongTurn slot="instrument" entries={entries} starters={starters} />
  </Hero>

  <section class="section section--flush-top" aria-labelledby="map-title">
    <div class="wrap">
      <div class="section-head grid">
        <h2 class="h2" id="map-title">Every page, on one sheet.</h2>
        <p>
          {entries.length} pages across five practices, {work.length} blueprints, {posts.length} articles and three service areas. Looking for a service?
          {
            services.map((s, i) => (
              <>
                <a class="link" href={serviceHref(s.slug)}>{s.shortName}</a>{i < services.length - 1 ? ', ' : '.'}
              </>
            ))
          }
        </p>
      </div>
      <nav class="sitemap ruled" aria-labelledby="map-title">
        {
          groups.map((g) => (
            <div class="module sitemap__group">
              <h3 class="label sitemap__name">
                {g.name} <span class="sitemap__n">{g.entries.length}</span>
              </h3>
              <ul role="list">
                {g.entries.map((e, i) => (
                  <li>
                    <a class:list={['sitemap__link', { 'is-index': i === 0 }]} href={e.path}>
                      {e.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  .sitemap { grid-template-columns: 1fr; }
  @media (min-width: 40rem) { .sitemap { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64rem) { .sitemap { grid-template-columns: 1fr 1fr 1.2fr 0.8fr 0.8fr; } }
  @media (min-width: 40rem) and (max-width: 63.99rem) { .sitemap__group:last-child { grid-column: 1 / -1; } }
  .sitemap__group { display: grid; gap: var(--s-4); align-content: start; }
  .sitemap__name { display: flex; justify-content: space-between; color: var(--accent-text); }
  .sitemap__n { color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .sitemap ul { border-top: 1px solid var(--rule-strong); }
  .sitemap li { border-bottom: 1px solid var(--rule); }
  .sitemap__link { display: flex; align-items: center; min-height: 44px; padding-block: 0.45rem; font-size: var(--t-small); line-height: 1.3; text-decoration: none; color: var(--ink-2); transition: color var(--t-ui) ease; }
  .sitemap__link.is-index { color: var(--ink); font-weight: 650; font-stretch: 112%; }
  @media (hover: hover) and (pointer: fine) { .sitemap__link:hover { color: var(--ink); text-decoration: underline; text-decoration-color: var(--accent); text-decoration-thickness: 2px; } }
</style>
