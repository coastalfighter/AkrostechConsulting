---
/**
 * The four staffing service pages, in the Sample-3 order: hero (the service's own field), the
 * specialist on shift, why teams choose the service, the service's instrument, what the team
 * takes on, the process, guides, questions, the other teams and the call. Website development
 * has its own page.
 */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import FieldHero from '@/components/FieldHero.astro';
import InboxTriage from '@/components/instruments/InboxTriage.astro';
import HiringFunnel from '@/components/instruments/HiringFunnel.astro';
import LedgerReconcile from '@/components/instruments/LedgerReconcile.astro';
import ClauseAbstract from '@/components/instruments/ClauseAbstract.astro';
import TrailSteps from '@/components/TrailSteps.astro';
import Photo from '@/components/Photo.astro';
import PostCard from '@/components/PostCard.astro';
import Faq from '@/components/Faq.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import { site } from '@/config/site';
import { services, serviceHref, staffingServices } from '@/data/services';
import { servicePhoto, serviceSecondPhoto } from '@/data/photos';
import { serviceMedia } from '@/data/serviceMedia';
import { getPosts } from '@/lib/blog';
import { faqSchema, serviceSchema } from '@/lib/seo';

export const getStaticPaths = (() => staffingServices.map((s) => ({ params: { slug: s.slug }, props: { service: s } }))) satisfies GetStaticPaths;

type Props = { service: (typeof staffingServices)[number] };

const { service: s } = Astro.props;
const media = serviceMedia[s.slug];
const path = serviceHref(s.slug);
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services' },
  { name: s.name, path },
];

const scenes = { 'virtual-assistance': 'lanes', recruitment: 'funnel', accounting: 'ledger', legal: 'document' } as const;
const scene = scenes[s.slug as keyof typeof scenes];
const instruments = { 'virtual-assistance': InboxTriage, recruitment: HiringFunnel, accounting: LedgerReconcile, legal: ClauseAbstract } as const;
const Instrument = instruments[s.slug as keyof typeof instruments];

const proposal = `/contact?service=${s.slug}`;
const proof = ['Vetted and NDA-backed', 'Works your U.S. hours', `Starts in ${s.facts.startsIn}`];
const facts = [
  { key: 'Best for', value: s.facts.bestFor },
  { key: 'Get started in', value: s.facts.startsIn },
  { key: 'Cost savings', value: s.facts.savings },
];
const initials = media.role
  .replace('Dedicated ', '')
  .split(' ')
  .map((w) => w[0]?.toUpperCase())
  .join('')
  .slice(0, 2);

const guides = (await getPosts()).filter((p) => p.data.service === s.slug).slice(0, 3);
const others = services.filter((o) => o.slug !== s.slug);
const faqs = s.faqs.map((f) => ({ q: f.q, a: f.a }));
---

<BaseLayout {...s.meta} path={path} image={media.og} breadcrumbs={crumbs} schema={[serviceSchema(s), faqSchema(faqs)]}>
  <FieldHero scene={scene} labelledby="service-title" crumbs={crumbs} wide>
    <h1 class="fhero__title" id="service-title">{media.title[0]} <span class="quiet">{media.title[1]}</span></h1>
    <p class="fhero__lead">{s.summary}</p>
    <ul class="proof" role="list" aria-label="Why teams choose this service">
      {
        proof.map((p) => (
          <li>
            <span class="proof__tick" aria-hidden="true">
              <Icon name="check" />
            </span>
            {p}
          </li>
        ))
      }
    </ul>
    <div class="actions">
      <a class="btn btn--primary" href={proposal}>Get a proposal <Icon name="arrow-right" class="btn__arrow btn__arrow--right" /></a>
      <a class="btn btn--ghost" href={site.calendly} target="_blank" rel="noopener">Book a call <Icon name="arrow-up-right" class="btn__arrow" /></a>
    </div>
    <dl slot="after" class="facts">
      {
        facts.map((f) => (
          <div class="facts__item">
            <dt>{f.key}</dt>
            <dd>{f.value}</dd>
          </div>
        ))
      }
    </dl>
  </FieldHero>

  <!-- The specialist on shift -->
  <section class="section section--flush-top" aria-labelledby="shift-title">
    <div class="wrap grid shift">
      <div class="shift__media c-5">
        <Photo name={servicePhoto[s.slug]} ratio="4 / 5" sizes="(min-width: 64rem) 38vw, 100vw" reveal="clip" />
        <div class="shift__card">
          <span class="shift__avatar" aria-hidden="true">{initials}</span>
          <span class="shift__who">
            <span class="shift__role">{media.role}</span>
            <span class="live small">On shift · your U.S. hours</span>
          </span>
        </div>
      </div>
      <div class="shift__copy c-6 s-7">
        <h2 class="h2" id="shift-title" data-split>{media.role}. On your hours.</h2>
        <p class="shift__intro" data-reveal>{s.intro}</p>
        <div class="today panel" data-reveal>
          <p class="today__head small">
            <span>Today on shift</span>
            <span class="muted">Illustrative</span>
          </p>
          <ul class="today__list" role="list">
            {
              media.today.map((t) => (
                <li>
                  <span class="today__box" aria-hidden="true">
                    <Icon name="check" />
                  </span>
                  {t}
                </li>
              ))
            }
          </ul>
        </div>
        <p class="shift__note small muted" data-reveal>NDA on every engagement · team-lead QA</p>
      </div>
    </div>
  </section>

  <!-- Why teams choose this service -->
  <section class="section section--flush-top" aria-labelledby="benefits-title">
    <div class="wrap">
      <div class="section-head grid">
        <h2 class="h2" id="benefits-title" data-split>Why U.S. teams choose our {media.teamNoun}.</h2>
      </div>
      <ul class="why" role="list" data-reveal-group>
        {
          s.benefits.map((b, i) => (
            <li class:list={['why__cell', `why__cell--${i}`, i === 0 ? 'violet' : 'panel']} data-reveal>
              <h3 class="why__title">{b.title}</h3>
              <p class={i === 0 ? undefined : 'muted'}>{b.description}</p>
            </li>
          ))
        }
        <li class="why__photo" data-reveal aria-hidden="true">
          <Photo name={media.benefitsPhoto} alt="" fill sizes="(min-width: 64rem) 24vw, 100vw" />
        </li>
      </ul>
    </div>
  </section>

  <!-- The instrument -->
  <section class="section section--flush-top" aria-labelledby="try-title">
    <div class="wrap">
      <div class="try ink-plate band">
        <div class="try__head">
          <h2 class="h2" id="try-title">{media.instrument.title[0]} <span class="quiet">{media.instrument.title[1]}</span></h2>
          <p class="try__lead">{media.instrument.intro}</p>
        </div>
        <div class="try__body">
          <Instrument />
        </div>
      </div>
    </div>
  </section>

  <!-- What the team takes on -->
  <section class="section" aria-labelledby="offerings-title">
    <div class="wrap grid offer">
      <div class="offer__intro c-5">
        <h2 class="h2" id="offerings-title" data-split>{media.offeringsTitle}</h2>
        <p class="offer__lead" data-reveal>An extension of your in-house team that works in your tools, follows your SOPs and reports on your schedule.</p>
        <div data-reveal>
          <a class="btn btn--ghost" href={proposal}>Discuss your needs <Icon name="arrow-right" class="btn__arrow btn__arrow--right" /></a>
        </div>
        <div class="offer__photo">
          <Photo name={serviceSecondPhoto[s.slug]} ratio="4 / 3" sizes="(min-width: 64rem) 36vw, 100vw" reveal="clip" />
        </div>
      </div>
      <ul class="offer__list ruled ruled--plate c-7 s-6" role="list" data-reveal-group>
        {
          s.offerings.map((o) => (
            <li class="module offer__item" data-reveal>
              <span class="offer__bar" aria-hidden="true" />
              <h3 class="offer__title">{o.title}</h3>
              <p class="muted">{o.description}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Process -->
  <section class="section section--flush-top" aria-labelledby="process-title">
    <div class="wrap">
      <div class="section-head grid">
        <h2 class="h2" id="process-title" data-split>A clear path from first call to results.</h2>
        <p data-reveal>Every step has an owner and a timeframe, so you always know what happens next.</p>
      </div>
      <TrailSteps steps={s.process} />
    </div>
  </section>

  {
    guides.length > 0 && (
      <section class="section section--flush-top" aria-labelledby="guides-title">
        <div class="wrap">
          <div class="guides__head">
            <h2 class="h2" id="guides-title" data-split>
              {s.name}, explained.
            </h2>
            <a class="more" href="/blog">
              All guides <Icon name="arrow-right" />
            </a>
          </div>
          <ul class="guides" role="list" data-reveal-group>
            {guides.map((p) => (
              <li data-reveal>
                <PostCard post={p} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <Faq faqs={faqs} name={s.slug} heading="Questions, answered." intro={`Something else on your mind? Email ${site.email}.`} />

  <!-- The other teams -->
  <section class="section section--flush-top" aria-labelledby="related-title">
    <div class="wrap">
      <h2 class="h2 related__title" id="related-title" data-split>Explore our other teams.</h2>
      <ul class="related" role="list" data-reveal-group>
        {
          others.map((o) => (
            <li class="related__card" data-reveal>
              <Photo name={servicePhoto[o.slug]} alt="" ratio="4 / 3" sizes="(min-width: 64rem) 22vw, (min-width: 40rem) 45vw, 100vw" />
              <div class="related__body">
                <h3 class="related__name">
                  <a class="stretch" href={serviceHref(o.slug)}>
                    {o.name}
                  </a>
                  {o.isNew && <span class="badge">New</span>}
                </h3>
                <p class="small muted">{o.summary}</p>
                <span class="related__go small" aria-hidden="true">
                  Starts in {o.facts.startsIn} <Icon name="arrow-up-right" />
                </span>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand photo={media.ctaPhoto} />
</BaseLayout>

<style>
  /* ---- Hero proof and facts ---- */
  .proof { display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-5); }
  .proof li { display: inline-flex; align-items: center; gap: var(--s-2); font-weight: 600; font-size: var(--t-small); }
  .proof__tick { display: grid; place-items: center; width: 1.35rem; height: 1.35rem; border-radius: 50%; background: var(--mark); color: var(--mark-ink); }
  .proof__tick :global(.icon) { width: 0.85rem; height: 0.85rem; stroke-width: 3; }
  .facts { display: grid; border-top: 1px solid var(--rule-strong); }
  @media (min-width: 48rem) { .facts { grid-template-columns: 2fr 1fr 1fr; } }
  .facts__item { display: grid; gap: var(--s-1); padding-block: var(--s-4); border-bottom: 1px solid var(--rule); }
  @media (min-width: 48rem) {
    .facts__item { border-bottom: 0; padding-right: var(--s-5); }
    .facts__item + .facts__item { border-left: 1px solid var(--rule); padding-left: var(--s-5); }
  }
  .facts dt { color: var(--ink-2); font-size: var(--t-small); font-weight: 500; }
  .facts dd { font-family: var(--font-display); font-size: clamp(1.35rem, 1.05rem + 1vw, 2rem); font-weight: 700; letter-spacing: -0.025em; line-height: 1.1; }

  /* ---- On shift ---- */
  .shift { row-gap: var(--s-7); align-items: center; }
  .shift__media { position: relative; padding-bottom: var(--s-6); }
  .shift__card {
    position: absolute;
    left: var(--s-4);
    right: var(--s-4);
    bottom: 0;
    display: flex;
    align-items: center;
    gap: var(--s-4);
    padding: var(--s-4);
    border-radius: var(--radius);
    background: var(--plate);
    border: 1px solid var(--rule);
  }
  @media (min-width: 40rem) { .shift__card { right: auto; left: calc(var(--s-6) * -0.5); max-width: 22rem; } }
  @media (max-width: 63.99rem) { .shift__card { left: var(--s-4); } }
  .shift__avatar { position: relative; display: grid; place-items: center; width: 3rem; height: 3rem; flex: none; border-radius: 50%; background: var(--carbon-950); color: var(--lime-400); font-family: var(--font-display); font-weight: 700; }
  .shift__who { display: grid; gap: 2px; }
  .shift__role { font-weight: 650; line-height: 1.25; }
  .shift__copy { display: grid; gap: var(--s-6); align-content: center; }
  .shift__intro { font-size: var(--t-lead); line-height: 1.5; color: var(--ink-2); max-width: 52ch; }
  .today { padding: var(--module-pad); display: grid; gap: var(--s-4); border-radius: calc(var(--radius) * 1.2); }
  .today__head { display: flex; justify-content: space-between; gap: var(--s-4); font-weight: 650; padding-bottom: var(--s-3); border-bottom: 1px solid var(--rule); }
  .today__list { display: grid; gap: var(--s-3); }
  @media (min-width: 40rem) { .today__list { grid-template-columns: 1fr 1fr; gap: var(--s-4) var(--s-5); } }
  .today__list li { display: flex; align-items: flex-start; gap: var(--s-3); font-weight: 550; line-height: 1.35; }
  .today__box { display: grid; place-items: center; width: 1.5rem; height: 1.5rem; flex: none; border-radius: 0.45rem; background: var(--mark); color: var(--mark-ink); }
  .today__box :global(.icon) { width: 0.95rem; height: 0.95rem; stroke-width: 3; }
  .shift__note { margin-top: calc(var(--s-3) * -1); }

  /* ---- Why: a bento, not a card grid ---- */
  .why { display: grid; gap: var(--s-4); }
  @media (min-width: 40rem) { .why { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .why__cell { display: grid; gap: var(--s-3); align-content: start; padding: var(--module-pad); border-radius: var(--radius); }
  .why__title { font-size: var(--t-h3); line-height: var(--lh-snug); letter-spacing: -0.015em; font-weight: 650; }
  .why__cell--0 { align-content: space-between; min-height: 14rem; }
  .why__cell--0 .why__title { font-size: clamp(1.8rem, 1.3rem + 1.8vw, 2.8rem); line-height: 1.02; letter-spacing: -0.03em; font-weight: 700; max-width: 14ch; }
  .why__cell--0 p { font-size: var(--t-lead); line-height: 1.45; max-width: 34ch; }
  .why__photo { min-height: 16rem; }
  @media (min-width: 40rem) and (max-width: 63.99rem) { .why__cell--0, .why__photo { grid-column: 1 / -1; } }
  @media (min-width: 64rem) {
    .why { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .why__cell--0 { grid-column: 1 / span 2; grid-row: 1 / span 2; }
    .why__cell--1 { grid-column: 3; grid-row: 1; }
    .why__photo { grid-column: 4; grid-row: 1 / span 2; }
    .why__cell--2 { grid-column: 3; grid-row: 2; }
    .why__cell--3 { grid-column: 1; grid-row: 3; }
    .why__cell--4 { grid-column: 2 / span 2; grid-row: 3; }
    .why__cell--5 { grid-column: 4; grid-row: 3; }
  }

  /* ---- Instrument plate ---- */
  .try { display: grid; gap: var(--s-7); padding: clamp(1.5rem, 1rem + 3vw, 4rem); border-radius: calc(var(--radius) * 1.6); }
  .try__head { display: grid; gap: var(--s-4); align-items: end; }
  @media (min-width: 64rem) { .try__head { grid-template-columns: 7fr 5fr; gap: var(--gutter); } }
  .try__lead { color: var(--ink-2); font-size: var(--t-lead); line-height: 1.5; max-width: 42ch; }
  .try__body { min-width: 0; }

  /* ---- Offerings ---- */
  .offer { row-gap: var(--s-7); }
  .offer__intro { display: grid; gap: var(--s-5); align-content: start; }
  @media (min-width: 64rem) { .offer__intro { position: sticky; top: calc(var(--header-h) + var(--s-5)); align-self: start; } }
  .offer__lead { color: var(--ink-2); font-size: var(--t-lead); line-height: 1.5; max-width: 40ch; }
  .offer__photo { margin-top: var(--s-3); }
  .offer__list { align-self: start; }
  @media (min-width: 40rem) { .offer__list { grid-template-columns: 1fr 1fr; } }
  .offer__item { display: grid; gap: var(--s-3); align-content: start; min-height: 12rem; }
  .offer__bar { display: block; width: 2rem; height: 4px; border-radius: 2px; background: var(--ink); transition: width 500ms var(--ease-out); }
  @media (hover: hover) and (pointer: fine) { .offer__item:hover .offer__bar { width: 4rem; } }
  .offer__title { font-size: var(--t-h3); line-height: var(--lh-snug); letter-spacing: -0.015em; font-weight: 650; }

  /* ---- Guides ---- */
  .guides__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: var(--s-4); margin-bottom: var(--s-7); }
  .guides { display: grid; gap: var(--s-7) var(--gutter); }
  @media (min-width: 40rem) { .guides { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64rem) { .guides { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

  /* ---- Related ---- */
  .related__title { margin-bottom: var(--s-7); }
  .related { display: grid; gap: var(--s-6) var(--gutter); }
  @media (min-width: 40rem) { .related { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64rem) { .related { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .related__card { position: relative; display: grid; gap: var(--s-4); align-content: start; }
  .related__card :global(.photo img) { transition: scale 600ms var(--ease-out); }
  .related__body { display: grid; gap: var(--s-2); }
  .related__name { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-2); font-size: 1.375rem; line-height: 1.15; letter-spacing: -0.02em; }
  .related__name a { text-decoration: none; }
  .related__name a:focus-visible { outline: none; }
  .related__card:has(a:focus-visible) { outline: 2px solid var(--focus); outline-offset: 6px; border-radius: var(--radius); }
  .related__go { display: inline-flex; align-items: center; gap: var(--s-2); font-weight: 650; margin-top: var(--s-1); }
  .related__go :global(.icon) { width: 1rem; height: 1rem; transition: transform var(--t-ui) var(--ease-out); }
  @media (hover: hover) and (pointer: fine) {
    .related__card:hover :global(.photo img) { scale: 1.03; }
    .related__card:hover .related__go :global(.icon) { transform: translate(3px, -3px); }
  }
</style>
