---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import InboxTriage from '@/components/instruments/InboxTriage.astro';
import HiringFunnel from '@/components/instruments/HiringFunnel.astro';
import LedgerReconcile from '@/components/instruments/LedgerReconcile.astro';
import ClauseAbstract from '@/components/instruments/ClauseAbstract.astro';
import Photo from '@/components/Photo.astro';
import Compare from '@/components/Compare.astro';
import WorkCard from '@/components/WorkCard.astro';
import Faq from '@/components/Faq.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import { site } from '@/config/site';
import { serviceBySlug, serviceHref, staffingServices, type Service } from '@/data/services';
import { servicePhoto, serviceSecondPhoto } from '@/data/photos';
import { work } from '@/data/work';
import { locations } from '@/data/locations';
import { faqSchema, serviceSchema } from '@/lib/seo';

export const getStaticPaths = (() => staffingServices.map((s) => ({ params: { slug: s.slug }, props: { service: s } }))) satisfies GetStaticPaths;

interface Props {
  service: Service;
}
const { service: s } = Astro.props;
const path = serviceHref(s.slug);
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services' },
  { name: s.name, path },
];
const blueprints = work.filter((w) => w.service === s.slug);
const fallback = work.filter((w) => w.service !== s.slug).slice(0, 2 - Math.min(2, blueprints.length));
const cases = [...blueprints, ...fallback].slice(0, 2);
const related = s.related.map((r) => serviceBySlug(r)).filter((r): r is Service => Boolean(r));
const f = site.figures;
/** "Recruitment (RPO)" reads "recruitment (RPO)" mid-sentence. */
const lowerShort = s.shortName.charAt(0).toLowerCase() + s.shortName.slice(1);

/** Each practice gets its own working instrument in the hero. */
const instruments = {
  'virtual-assistance': InboxTriage,
  'recruitment': HiringFunnel,
  'accounting': LedgerReconcile,
  'legal': ClauseAbstract,
} as const;
const Instrument = instruments[s.slug as keyof typeof instruments];
if (!Instrument) throw new Error(`No hero instrument for /services/${s.slug}`);

const compareRows = [
  { label: 'Time to a shortlist', a: 'Weeks of job posts, screening and interviews', b: `${f.matchHours} hours, vetted and with work samples` },
  { label: 'Time to start', a: 'Notice periods, then onboarding', b: s.startsIn },
  { label: 'Quality review', a: 'You check the work yourself', b: 'A team lead checks it before it reaches you' },
  { label: 'When someone leaves', a: 'Start hiring again from zero', b: 'A vetted replacement, trained on your written SOPs' },
  { label: 'Know-how', a: 'In one person’s head', b: 'Written procedures your company owns' },
  { label: 'Cost', a: 'Salary, benefits, payroll taxes, equipment, desk', b: `${s.saving}. One monthly fee, no placement fee` },
];
---

<BaseLayout {...s.meta} path={path} image={`/og/service-${s.slug}.png`} breadcrumbs={crumbs} schema={[serviceSchema(s), faqSchema(s.faqs)]}>
  <Hero labelledby="service-title" split="5-7" crumbs={crumbs}>
    <h1 class="h1 hero__title" id="service-title">
      {s.headline[0]} <span class="accent">{s.headline[1]}</span>
    </h1>
    <p class="hero__lead">{s.summary}</p>
    <div class="actions">
      <a class="btn btn--primary" href={site.calendly} target="_blank" rel="noopener">
        Book a discovery call <Icon name="arrow-up-right" class="btn__arrow" />
      </a>
      <a class="btn btn--ghost" href="#engage">How pricing works <Icon name="arrow-right" class="btn__arrow btn__arrow--right" /></a>
    </div>
    <Instrument slot="instrument" />

    <dl slot="strip" class="facts ruled">
      <div class="module module--flex">
        <dt class="label">Service</dt>
        <dd>{s.name}</dd>
      </div>
      <div class="module module--flex lime">
        <dt class="label">Starts</dt>
        <dd>{s.startsIn}</dd>
      </div>
      <div class="module module--flex">
        <dt class="label">Typical saving</dt>
        <dd>{s.saving}</dd>
      </div>
      <div class="module module--flex">
        <dt class="label">Hours</dt>
        <dd>ET, CT, MT or PT</dd>
      </div>
    </dl>
  </Hero>

  <!-- Intro: photograph and statement across the seam -->
  <section class="seam" aria-label="Overview">
    <div class="wrap grid seam__grid">
      <div class="seam__photo c-8">
        <Photo name={servicePhoto[s.slug]} ratio="16 / 10" sizes="(min-width: 64rem) 66vw, 100vw" reveal="clip" />
      </div>
      <div class="seam__copy c-6 s-7">
        <p class="seam__text" data-reveal>{s.intro}</p>
        <p class="seam__aud" data-reveal>
          <span class="label">Built for</span>
          <span>{s.audience}.</span>
        </p>
      </div>
    </div>
  </section>

  <!-- Capabilities -->
  <section class="section" aria-labelledby="caps-title">
    <div class="wrap">
      <div class="section-head grid">
        <h2 class="h2" id="caps-title" data-split>What we take on.</h2>
        <p data-reveal>Every capability is run to a written procedure, reviewed by a team lead and reported weekly.</p>
      </div>
      <ul class="caps" role="list" data-reveal-group>
        {
          s.capabilities.map((c) => (
            <li class="cap" data-reveal>
              <h3 class="cap__title">{c.title}</h3>
              <p class="cap__body">{c.body}</p>
              <ul class="cap__items" role="list" aria-label={`${c.title} includes`}>
                {c.items.map((it) => (
                  <li>{it}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Tasks -->
  <section class="section plate" aria-labelledby="tasks-title">
    <div class="wrap grid tasks">
      <div class="tasks__head c-4">
        <h2 class="h2" id="tasks-title" data-split>Tasks clients hand over first.</h2>
        <Photo name={serviceSecondPhoto[s.slug]} ratio="4 / 5" sizes="(min-width: 64rem) 30vw, 100vw" reveal="clip" class="tasks__photo" />
      </div>
      <ul class="tasks__list ticks c-7 s-6" role="list" data-reveal-group>
        {s.tasks.map((t) => <li data-reveal>{t}</li>)}
      </ul>
    </div>
  </section>

  <!-- Process -->
  <section class="section" aria-labelledby="steps-title">
    <div class="wrap">
      <div class="section-head grid">
        <h2 class="h2" id="steps-title" data-split>From call to first task.</h2>
        <p data-reveal>No recruitment cycle and no notice period. The first week is written down before it starts.</p>
      </div>
      <ol class="steps ruled" role="list" data-reveal-group>
        {
          s.process.map((p, i) => (
            <li class:list={['module module--flex step', { lime: i === 2 }]} data-reveal>
              <p class="label step__when">{p.when}</p>
              <h3 class="h3">{p.title}</h3>
              <p class="step__body">{p.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Tools -->
  <section class="section section--flush-top" aria-labelledby="tools-title">
    <div class="wrap">
      <div class="section-head grid">
        <h2 class="h2" id="tools-title" data-split>Inside the tools you already run.</h2>
        <p data-reveal>The tools we work in for {s.name.toLowerCase()}, through named accounts with least-privilege access, removed the day an engagement ends.</p>
      </div>
      <ul
        class="tools ruled"
        role="list"
        aria-label={`Tools used in ${s.name.toLowerCase()}`}
        style={`--fill-2:${2 - ((s.tools.length) % 2)};--fill-3:${3 - (s.tools.length % 3)};--fill-5:${5 - (s.tools.length % 5)}`}
        data-reveal-group
      >
        {s.tools.map((t) => <li class="tool" data-reveal>{t}</li>)}
        <li class="tool tool--more lime" data-reveal>Your stack is not listed? Ask on the call.</li>
      </ul>
    </div>
  </section>

  <!-- Local hire vs this practice -->
  <section class="section section--flush-top" aria-labelledby="compare-title">
    <div class="wrap">
      <div class="section-head grid">
        <h2 class="h2" id="compare-title" data-split>The same role, two ways to fill it.</h2>
        <p data-reveal>Drag the divider to compare a local hire with {s.name.toLowerCase()} from Akrostech.</p>
      </div>
      <Compare id={`compare-${s.slug}`} aTitle="A local hire" bTitle={s.shortName} rows={compareRows} />
    </div>
  </section>

  <!-- Blueprints -->
  <section class="section section--flush-top" aria-labelledby="cases-title">
    <div class="wrap">
      <div class="section-head grid">
        <h2 class="h2" id="cases-title" data-split>How it runs in practice.</h2>
        <p data-reveal>Engagement blueprints: how we staff, start and measure this kind of work. Plans, not invented case studies.</p>
      </div>
      <div class="cards grid" data-reveal-group>
        {cases.map((w) => <div class="c-6" data-reveal><WorkCard item={w} ratio="16 / 10" sizes="(min-width: 64rem) 50vw, 100vw" /></div>)}
      </div>
      <a class="more section-more" href="/work">All engagement blueprints <Icon name="arrow-right" /></a>
    </div>
  </section>

  <!-- Engagement and pricing -->
  <section class="section lime engage" id="engage" aria-labelledby="engage-title">
    <div class="wrap grid">
      <div class="engage__head c-5">
        <h2 class="engage__title" id="engage-title" data-split>One monthly fee.</h2>
        <p class="engage__text" data-reveal>
          You pay one predictable fee per person or project, set by role, hours and seniority. It includes the specialist, their team lead, quality
          checks, equipment and replacement from our bench. No placement fees, no long lock-in.
        </p>
        <a class="btn btn--primary engage__btn" href={site.calendly} target="_blank" rel="noopener" data-reveal>
          Get your monthly price <Icon name="arrow-up-right" class="btn__arrow" />
        </a>
      </div>
      <ul class="engage__models ruled c-6 s-7" role="list" data-reveal-group>
        {
          s.engagement.map((m) => (
            <li class="module engage__model" data-reveal>
              <h3 class="h3">{m.title}</h3>
              <p>{m.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Faq faqs={s.faqs} name={s.slug} heading={`${s.shortName}: questions`} intro={`Straight answers about ${s.name.toLowerCase()} with Akrostech.`} />

  <!-- Related practices and service areas -->
  <section class="section section--flush-top" aria-labelledby="related-title">
    <div class="wrap">
      <div class="section-head grid">
        <h2 class="h2" id="related-title" data-split>Often paired with.</h2>
        <p data-reveal>Five practices run one way, so adding a second is one more line on the same weekly report.</p>
      </div>
      <ul class="related ruled" role="list">
        {
          related.map((r) => (
            <li class="module module--flex rel">
              <h3 class="rel__name">
                <a class="stretch" href={serviceHref(r.slug)}>
                  {r.name}
                </a>
              </h3>
              <p class="rel__summary">{r.summary}</p>
              <p class="rel__meta">
                <span>{r.startsIn}</span>
                <Icon name="arrow-up-right" class="icon rel__arrow" />
              </p>
            </li>
          ))
        }
      </ul>
      <p class="geo">
        {s.geo} See our service areas:{' '}
        {
          locations.map((l, i) => (
            <><a class="link" href={`/locations/${l.slug}`}>{lowerShort} in {l.city}</a>{i < locations.length - 1 ? ', ' : '.'}</>
          ))
        }
      </p>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  /* ---- Hero strip: the facts ---- */
  .facts { grid-template-columns: 1fr 1fr; }
  @media (min-width: 64rem) { .facts { grid-template-columns: repeat(4, 1fr); } }
  .facts .module { gap: var(--s-3); min-height: 7.5rem; justify-content: space-between; }
  .facts dt { color: var(--ink-2); }
  .facts dd { font-size: clamp(1.0625rem, 0.95rem + 0.5vw, 1.375rem); font-weight: 700; font-stretch: 112%; line-height: 1.2; }

  /* ---- Seam ---- */
  .seam { padding-block: var(--s-6) var(--s-9); }
  .seam__grid { row-gap: 0; }
  .seam__photo { grid-row: 1; }
  .seam__copy { position: relative; z-index: 1; display: grid; gap: var(--s-5); align-content: start; padding: var(--s-6) var(--module-pad) 0 0; background: var(--ground); }
  @media (min-width: 64rem) {
    .seam__photo { grid-column: 1 / span 8; }
    .seam__copy { grid-column: 7 / span 6; grid-row: 1; align-self: end; margin-bottom: calc(var(--s-8) * -1); padding: var(--module-pad); border-top: 6px solid var(--accent); }
  }
  .seam__text { font-size: clamp(1.5rem, 1rem + 1.6vw, 2.375rem); font-stretch: 112%; font-weight: 650; line-height: 1.15; letter-spacing: -0.02em; text-wrap: pretty; }
  .seam__aud { display: grid; gap: var(--s-1); color: var(--ink-2); font-size: var(--t-lead); line-height: 1.4; }
  .seam__aud .label { color: var(--accent-text); }

  /* ---- Capabilities: ruled rows, the hovered one isolated ---- */
  .caps { border-top: 1px solid var(--rule-strong); }
  .cap { display: grid; gap: var(--s-3) var(--gutter); padding-block: var(--s-6); border-bottom: 1px solid var(--rule); transition: opacity var(--t-ui) ease; }
  @media (min-width: 64rem) { .cap { grid-template-columns: 4fr 5fr 3fr; align-items: start; } }
  .cap__title { font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.25rem); font-stretch: 125%; font-weight: 750; line-height: 1; letter-spacing: -0.02em; text-transform: uppercase; }
  .cap__body { color: var(--ink-2); font-size: 1.125rem; max-width: 48ch; }
  .cap__items { display: grid; border-top: 1px solid var(--rule-strong); }
  .cap__items li { padding-block: var(--s-2); border-bottom: 1px solid var(--rule); font-size: var(--t-small); font-weight: 600; }
  .cap__items li::before { content: ''; display: inline-block; width: 0.5rem; height: 0.5rem; margin-right: 0.6rem; background: var(--accent-text); vertical-align: 0.1em; }
  @media (hover: hover) and (pointer: fine) {
    .caps:has(.cap:hover) .cap:not(:hover) { opacity: 0.4; }
  }

  /* ---- Tasks ---- */
  .tasks { row-gap: var(--s-7); }
  .tasks__head { display: grid; gap: var(--s-6); align-content: start; }
  @media (min-width: 64rem) { .tasks__head { position: sticky; top: calc(var(--header-h) + var(--s-6)); align-self: start; } }
  .tasks__head :global(.tasks__photo) { max-width: 26rem; }
  .tasks__list { gap: 0; border-top: 1px solid var(--rule-strong); align-self: start; }
  @media (min-width: 40rem) { .tasks__list { grid-template-columns: 1fr 1fr; column-gap: var(--gutter); } }
  .tasks__list li { padding-block: var(--s-4); padding-left: 1.9rem; border-bottom: 1px solid var(--rule); font-size: 1.125rem; font-weight: 550; line-height: 1.35; }
  .tasks__list li::before { top: calc(var(--s-4) + 0.4em); }

  /* ---- Steps ---- */
  .steps { grid-template-columns: 1fr; }
  @media (min-width: 40rem) { .steps { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 64rem) { .steps { grid-template-columns: repeat(4, 1fr); } }
  .step { gap: var(--s-4); }
  @media (min-width: 64rem) { .step { min-height: 16rem; } }
  .step__when { color: var(--ink-2); }
  .step__body { color: var(--ink-2); margin-top: auto; }

  /* ---- Tools ---- */
  .tools { grid-template-columns: repeat(2, 1fr); }
  @media (min-width: 40rem) { .tools { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 64rem) { .tools { grid-template-columns: repeat(5, 1fr); } }
  .tool { display: flex; align-items: end; min-height: 6.5rem; padding: var(--s-4) var(--s-5); font-size: clamp(1rem, 0.9rem + 0.4vw, 1.25rem); font-weight: 700; font-stretch: 112%; line-height: 1.15; letter-spacing: -0.01em; }
  .tool--more { font-weight: 650; font-size: 1rem; grid-column: span var(--fill-2); }
  @media (min-width: 40rem) { .tool--more { grid-column: span var(--fill-3); } }
  @media (min-width: 64rem) { .tool--more { grid-column: span var(--fill-5); } }

  /* ---- Cards ---- */
  .cards { row-gap: var(--s-7); }
  .section-more { margin-top: var(--s-6); }

  /* ---- Engagement ---- */
  .engage .grid { row-gap: var(--s-7); }
  .engage__head { display: grid; gap: var(--s-5); align-content: start; }
  .engage__title { font-size: clamp(2.5rem, 1.25rem + 4vw, 5rem); font-stretch: 125%; font-weight: 750; line-height: 0.94; letter-spacing: -0.03em; text-transform: uppercase; }
  .engage__text { color: var(--ink-2); font-size: var(--t-lead); line-height: 1.45; max-width: 44ch; }
  .engage__btn { justify-self: start; }
  .engage__models { grid-template-columns: 1fr; background: var(--rule); border-color: var(--rule-strong); }
  .engage__models > * { background: var(--field); }
  .engage__model { display: grid; gap: var(--s-2); }
  .engage__model p { color: var(--ink-2); max-width: 52ch; }

  /* ---- Related ---- */
  .related { grid-template-columns: 1fr; }
  @media (min-width: 64rem) { .related { grid-template-columns: repeat(3, 1fr); } }
  .rel { gap: var(--s-4); min-height: 15rem; transition: background-color var(--t-ui) ease; }
  .rel__name { font-size: clamp(1.25rem, 1rem + 0.8vw, 1.625rem); font-stretch: 125%; font-weight: 750; line-height: 1.05; text-transform: uppercase; letter-spacing: -0.01em; }
  .rel__name a { text-decoration: none; }
  .rel__name a:focus-visible { outline: none; }
  .rel:has(a:focus-visible) { outline: 2px solid var(--focus); outline-offset: -2px; }
  .rel__summary { color: var(--ink-2); }
  .rel__meta { margin-top: auto; display: flex; justify-content: space-between; align-items: center; font-size: 0.875rem; font-weight: 650; color: var(--accent-text); }
  .rel__arrow { width: 1.75rem; height: 1.75rem; color: var(--ink); transition: transform var(--t-ui) var(--ease-out); }
  @media (hover: hover) and (pointer: fine) {
    .rel:hover { background: var(--plate); }
    .rel:hover .rel__arrow { transform: translate(4px, -4px); }
  }
  .geo { margin-top: var(--s-6); max-width: 66ch; color: var(--ink-2); }
  .geo a { color: var(--ink); }
</style>
