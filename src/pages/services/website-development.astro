---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import PageBuilder from '@/components/instruments/PageBuilder.astro';
import Photo from '@/components/Photo.astro';
import type { PhotoName } from '@/components/Photo.astro';
import WorkCard from '@/components/WorkCard.astro';
import Faq from '@/components/Faq.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import { site } from '@/config/site';
import { serviceBySlug, serviceHref, type Service } from '@/data/services';
import { pricingTiers, techStack, webFaqs, webProcess, webSubServices, type WebSubService } from '@/data/webdev';
import { work } from '@/data/work';
import { locations } from '@/data/locations';
import { faqSchema, serviceSchema } from '@/lib/seo';

const s = serviceBySlug('website-development')!;
const path = serviceHref(s.slug);
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services' },
  { name: s.name, path },
];
const builds = work.filter((w) => w.service === 'website-development');
const related = s.related.map((r) => serviceBySlug(r)).filter((r): r is Service => Boolean(r));
const usd = (n: number) => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 }).format(n);

const promises = [
  { figure: '100%', title: 'You own the code', body: 'The repository, hosting and domain are in your name from day one.' },
  { figure: 'Fixed', title: 'Fixed price after discovery', body: 'One week of discovery ends in a written scope and a price that does not move.' },
  { figure: '2.5 s', title: 'Core Web Vitals checked', body: 'LCP, INP and CLS measured on key templates before launch, with the report handed over.' },
  { figure: '301', title: 'Every URL accounted for', body: 'Redesigns ship with a tested redirect for every page that earns traffic or links.' },
  { figure: 'Weekly', title: 'A staging link every week', body: 'Click through real progress every week instead of waiting for a big reveal.' },
  { figure: '30 d', title: 'Thirty days of fixes', body: 'Anything that is not right after launch is fixed at no cost for thirty days.' },
];

const serviceNode = { ...serviceSchema(s, pricingTiers), hasOfferCatalog: {
  '@type': 'OfferCatalog',
  name: 'Website development services',
  itemListElement: webSubServices.map((w) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: w.title, description: w.summary } })),
} };

/**
 * Sub-service mosaic: ten ruled modules and four photographs placed on the 12-column grid.
 * Performance optimisation is the lime field: it is the promise the hero instrument demonstrates.
 */
type Cell = { kind: 'service'; item: WebSubService; span: number; lime?: boolean; lead?: boolean } | { kind: 'photo'; name: PhotoName; span: number; tall?: boolean; focal?: string };
const sub = (id: string) => webSubServices.find((w) => w.id === id)!;
const mosaic: Cell[] = [
  { kind: 'service', item: sub('custom-web-design'), span: 7, lead: true },
  { kind: 'photo', name: 'code-laptop', span: 5, focal: '50% 60%' },
  { kind: 'service', item: sub('ecommerce'), span: 4 },
  { kind: 'service', item: sub('cms-development'), span: 4 },
  { kind: 'service', item: sub('web-applications'), span: 4 },
  { kind: 'photo', name: 'developers', span: 4, tall: true, focal: '50% 40%' },
  { kind: 'service', item: sub('landing-pages'), span: 4 },
  { kind: 'service', item: sub('redesign-migration'), span: 4 },
  { kind: 'service', item: sub('pwa'), span: 4 },
  { kind: 'service', item: sub('maintenance-support'), span: 4 },
  { kind: 'service', item: sub('performance-optimization'), span: 5, lime: true },
  { kind: 'service', item: sub('api-integration'), span: 4 },
  { kind: 'photo', name: 'sticky-notes', span: 3, focal: '40% 50%' },
];

/** Process on a week ruler: Weeks 1–8, launch week, then ongoing care. */
const COLS = 10;
const spanOf = (when: string): [number, number] => {
  const m = when.match(/Weeks?\s+(\d+)(?:\s*[–-]\s*(\d+))?/);
  if (m) return [Number(m[1]), Number(m[2] ?? m[1])];
  if (/launch/i.test(when)) return [9, 9];
  return [10, 10];
};
const ruler = [...Array.from({ length: 8 }, (_, i) => `W${i + 1}`), 'Launch', 'Ongoing'];
---

<BaseLayout {...s.meta} path={path} image="/og/service-website-development.png" breadcrumbs={crumbs} schema={[serviceNode, faqSchema(webFaqs)]}>
  <Hero labelledby="wd-title" split="5-7" crumbs={crumbs}>
    <h1 class="h1 hero__title" id="wd-title">{s.headline[0]} <span class="accent">{s.headline[1]}</span></h1>
    <p class="hero__lead">
      Custom websites, online stores and web applications, designed and built by a senior team in India that works your U.S. hours. Fast, accessible, built
      to rank, and yours to keep.
    </p>
    <div class="actions">
      <a class="btn btn--primary" href={site.calendly} target="_blank" rel="noopener">
        Start a project <Icon name="arrow-up-right" class="btn__arrow" />
      </a>
      <a class="btn btn--ghost" href="#pricing">See pricing <Icon name="arrow-right" class="btn__arrow btn__arrow--right" /></a>
    </div>
    <PageBuilder slot="instrument" />

    <div slot="strip" class="wd-strip ruled">
      <div class="module module--flex lime wd-strip__lime">
        <p class="label">From</p>
        <p class="figure">{usd(pricingTiers[0]!.from)}</p>
        <p class="wd-strip__text">A focused five-page site, fixed in writing after discovery.</p>
      </div>
      <div class="wd-strip__photo">
        <Photo name="code-desk" alt="" fill sizes="(min-width: 64rem) 34vw, 100vw" focal="50% 55%" />
      </div>
      <dl class="module wd-strip__facts">
        <div><dt class="label">Discovery</dt><dd>{s.startsIn}</dd></div>
        <div><dt class="label">Typical saving</dt><dd>{s.saving}</dd></div>
        <div><dt class="label">Ownership</dt><dd>100% yours: code, hosting, domain</dd></div>
      </dl>
    </div>
  </Hero>

  <!-- Intro: the two jobs of a business website -->
  <section class="section wd-intro" aria-labelledby="wd-intro-title">
    <div class="wrap grid wd-intro__grid">
      <h2 class="wd-intro__title c-6" id="wd-intro-title" data-split>Found first. Chosen second.</h2>
      <div class="wd-intro__copy c-5 s-8">
        <p class="wd-intro__lede" data-reveal>{s.intro}</p>
        <p class="muted" data-reveal>
          Every build starts from your sales conversation: what buyers ask, what convinces them and what they need to see before they call. Then we engineer for
          speed, accessibility and search from the first line of code, not as a clean-up before launch.
        </p>
        <dl class="spec" data-reveal>
          <div><dt>Built for</dt><dd>{s.audience}</dd></div>
          <div><dt>Starts with</dt><dd>{s.startsIn}, ending in a fixed price</dd></div>
          <div><dt>Where</dt><dd>{s.geo}</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <!-- Sub-services: ten ruled modules and four photographs -->
  <section class="section section--flush-top" aria-labelledby="wd-services-title">
    <div class="wrap">
      <div class="section-head grid">
        <h2 class="h2" id="wd-services-title" data-split>Ten ways we build.</h2>
        <p data-reveal>From a single landing page to a client portal. Each one ships with the same standards: accessible, measured, documented and yours.</p>
      </div>
      <ul class="mosaic ruled" role="list">
        {
          mosaic.map((cell) =>
            cell.kind === 'photo' ? (
              <li class:list={['mosaic__photo', { 'mosaic__photo--tall': cell.tall }]} style={`--span:${cell.span}`} aria-hidden="true">
                <Photo name={cell.name} alt="" fill sizes="(min-width: 64rem) 40vw, 100vw" focal={cell.focal} reveal="clip" />
              </li>
            ) : (
              <li class:list={['module module--flex sub', { lime: cell.lime, 'sub--lead': cell.lead }]} style={`--span:${cell.span}`} id={cell.item.id}>
                <h3 class="sub__title">{cell.item.title}</h3>
                <p class="sub__summary">{cell.item.summary}</p>
                <p class="sub__body">{cell.item.body}</p>
                <div class="sub__foot">
                  <p class="label sub__key">You get</p>
                  <ul class="ticks sub__ticks" role="list">
                    {cell.item.deliverables.map((d) => (
                      <li>{d}</li>
                    ))}
                  </ul>
                  <p class="sub__stack">
                    <span class="label sub__key">Typical stack</span>
                    {cell.item.stack.join(' · ')}
                  </p>
                </div>
              </li>
            ),
          )
        }
      </ul>
    </div>
  </section>

  <!-- Tech stack -->
  <section class="section plate" aria-labelledby="stack-title">
    <div class="wrap">
      <div class="section-head grid">
        <h2 class="h2" id="stack-title" data-split>The stack, chosen per project.</h2>
        <p data-reveal>No single platform is right for every business. We pick the one your team can run, then build it properly.</p>
      </div>
      <div class="stack ruled ruled--plate" data-reveal-group>
        {
          techStack.map((g) => (
            <div class="module stack__group" data-reveal>
              <h3 class="label stack__name">{g.group}</h3>
              <ul class="stack__items" role="list">
                {g.items.map((t) => (
                  <li>{t}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Process on a week ruler -->
  <section class="section" aria-labelledby="wd-process-title">
    <div class="wrap">
      <div class="section-head grid">
        <h2 class="h2" id="wd-process-title" data-split>Six steps, no surprises.</h2>
        <p data-reveal>A staging link every week, so you see the site take shape and can steer it while it is cheap to change.</p>
      </div>
      <div class="gantt" style={`--cols:${COLS}`}>
        <div class="gantt__ruler" aria-hidden="true">
          <span class="gantt__corner label">Step</span>
          <span class="gantt__weeks">{ruler.map((r) => <span class="label">{r}</span>)}</span>
        </div>
        <ol class="gantt__rows" role="list" data-reveal-group>
          {
            webProcess.map((p) => {
              const [a, b] = spanOf(p.when);
              return (
                <li class="gantt__row" data-reveal>
                  <div class="gantt__step">
                    <p class="label gantt__when">{p.when}</p>
                    <h3 class="gantt__name">{p.title}</h3>
                    <p class="gantt__body">{p.body}</p>
                  </div>
                  <div class="gantt__track" aria-hidden="true">
                    <span class:list={['gantt__bar', { 'is-build': p.title === 'Build', 'is-open': b === COLS }]} style={`grid-column:${a} / ${b + 1}`} data-reveal="rule" />
                  </div>
                </li>
              );
            })
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- Portfolio (blueprints) -->
  <section class="section section--flush-top" aria-labelledby="wd-work-title">
    <div class="wrap">
      <div class="section-head grid">
        <h2 class="h2" id="wd-work-title" data-split>Builds, planned in detail.</h2>
        <p data-reveal>Engagement blueprints for web projects: how we would scope, staff and launch them. Plans, not invented case studies.</p>
      </div>
      <div class="cards grid" data-reveal-group>
        {builds.map((w) => <div class="c-4" data-reveal><WorkCard item={w} /></div>)}
      </div>
      <a class="more section-more" href="/work?service=website-development">All web blueprints <Icon name="arrow-right" /></a>
    </div>
  </section>

  <!-- Pricing -->
  <section class="section plate" id="pricing" aria-labelledby="pricing-title">
    <div class="wrap">
      <div class="section-head grid">
        <h2 class="h2" id="pricing-title" data-split>Clear starting prices.</h2>
        <p data-reveal>Your fixed price is set at the end of discovery, in writing. Hosting, platform fees and third-party licences are billed at cost.</p>
      </div>
      <ul class="tiers ruled ruled--plate" role="list" data-reveal-group>
        {
          pricingTiers.map((t) => (
            <li class:list={['module module--flex tier', { lime: t.featured }]} data-reveal>
              <div class="tier__head">
                <h3 class="tier__name">{t.name}</h3>
                {t.featured && <span class="tier__flag">Most chosen scope</span>}
              </div>
              <p class="tier__price">
                <span class="label tier__from">From</span>
                <span class="figure tier__figure">{usd(t.from)}</span>
              </p>
              <dl class="tier__facts">
                <div><dt class="label">Timeline</dt><dd>{t.timeline}</dd></div>
                <div><dt class="label">Best for</dt><dd>{t.bestFor}</dd></div>
              </dl>
              <ul class="ticks tier__list" role="list">
                {t.includes.map((inc) => (
                  <li>{inc}</li>
                ))}
              </ul>
              <a class:list={['btn btn--block tier__cta', t.featured ? 'btn--primary' : 'btn--ghost']} href={site.calendly} target="_blank" rel="noopener">
                Discuss {t.name} <Icon name="arrow-up-right" class="btn__arrow" />
              </a>
            </li>
          ))
        }
      </ul>
      <p class="tiers__care">
        <strong>Care plans</strong> for updates, backups, monitoring and monthly change hours are quoted with your build.
      </p>
    </div>
  </section>

  <!-- What every build includes -->
  <section class="section" aria-labelledby="wd-promises-title">
    <div class="wrap">
      <div class="section-head grid">
        <h2 class="h2" id="wd-promises-title" data-split>What every build includes.</h2>
        <p data-reveal>Six commitments in every website engagement letter, from a landing page to a portal.</p>
      </div>
      <ul class="promises ruled" role="list" data-reveal-group>
        {
          promises.map((p) => (
            <li class="module module--flex promise" data-reveal>
              <p class="promise__figure">{p.figure}</p>
              <h3 class="promise__title">{p.title}</h3>
              <p class="promise__body">{p.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Faq faqs={webFaqs} name="web" heading="Website questions" intro="Cost, timelines, platforms and SEO, answered plainly." />

  <section class="section section--flush-top" aria-labelledby="wd-related-title">
    <div class="wrap grid related">
      <div class="related__copy c-6">
        <h2 class="h2" id="wd-related-title" data-split>Pair it with a team.</h2>
        <p class="related__text" data-reveal>
          Many web clients add a <a class="link" href={serviceHref('virtual-assistance')}>virtual assistant</a> to keep content and listings current after launch.
          {s.geo} See{' '}
          {
            locations.map((l, i) => (
              <>
                <a class="link" href={`/locations/${l.slug}`}>web design in {l.city}</a>{i < locations.length - 1 ? ', ' : '.'}
              </>
            ))
          }
        </p>
      </div>
      <ul class="related__list c-5 s-8" role="list">
        {
          related.map((r) => (
            <li>
              <a class="related__link" href={serviceHref(r.slug)}>
                <span class="related__name">{r.name}</span>
                <span class="related__summary">{r.summary}</span>
                <Icon name="arrow-up-right" class="icon related__arrow" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand
    heading="Scope your site in one week."
    line="Thirty minutes to talk through your site. You leave knowing which tier fits and what discovery will cover."
    photo="pair-at-laptop"
  />
</BaseLayout>

<style>
  /* ---- Hero strip ---- */
  .wd-strip { grid-template-columns: 1fr; }
  @media (min-width: 40rem) { .wd-strip { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 64rem) { .wd-strip { grid-template-columns: 3fr 4fr 5fr; } }
  .wd-strip__lime { gap: var(--s-3); min-height: 11rem; }
  .wd-strip__lime .figure { font-size: clamp(2.75rem, 1.6rem + 2.4vw, 4rem); white-space: nowrap; }
  .wd-strip__text { margin-top: auto; max-width: 28ch; font-weight: 550; }
  .wd-strip__photo { min-height: 13rem; }
  .wd-strip__facts { display: grid; align-content: center; }
  .wd-strip__facts div { display: grid; grid-template-columns: 9rem 1fr; gap: var(--s-4); padding-block: var(--s-3); border-bottom: 1px solid var(--rule); }
  .wd-strip__facts div:last-child { border-bottom: 0; }
  .wd-strip__facts dt { color: var(--ink-2); padding-top: 0.2rem; }
  .wd-strip__facts dd { font-weight: 650; font-stretch: 112%; }
  @media (min-width: 40rem) and (max-width: 63.99rem) { .wd-strip__facts { grid-column: 1 / -1; } }
  @media (max-width: 30rem) { .wd-strip__facts div { grid-template-columns: 1fr; gap: var(--s-1); } }

  /* ---- Intro ---- */
  .wd-intro__grid { row-gap: var(--s-6); align-items: start; }
  .wd-intro__title { font-size: var(--t-display); font-stretch: 125%; line-height: var(--lh-display); letter-spacing: var(--track-display); text-transform: uppercase; }
  .wd-intro__copy { display: grid; gap: var(--s-5); }
  .wd-intro__lede { font-size: var(--t-lead); line-height: 1.45; font-weight: 500; }

  /* ---- Mosaic ---- */
  .mosaic { grid-template-columns: 1fr; }
  @media (min-width: 40rem) { .mosaic { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64rem) {
    .mosaic { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .mosaic > li { grid-column: span var(--span); }
    .mosaic__photo--tall { grid-row: span 2; }
  }
  .mosaic__photo { min-height: 16rem; }
  @media (min-width: 40rem) and (max-width: 63.99rem) { .sub--lead { grid-column: 1 / -1; } }
  .sub { gap: var(--s-3); }
  @media (min-width: 64rem) { .sub { min-height: 26rem; } }
  .sub__title { font-size: 1.3125rem; font-stretch: 112%; line-height: 1.2; letter-spacing: -0.01em; }
  .sub--lead .sub__title { font-size: var(--t-h3); font-stretch: 125%; }
  .sub__summary { font-weight: 600; line-height: 1.4; }
  .sub--lead .sub__summary { font-size: var(--t-lead); }
  .sub__body { color: var(--ink-2); font-size: var(--t-small); max-width: 62ch; }
  .sub__foot { margin-top: auto; padding-top: var(--s-5); display: grid; gap: var(--s-3); }
  .sub__key { color: var(--ink-2); }
  .sub__ticks { font-size: var(--t-small); gap: var(--s-2); }
  @media (min-width: 40rem) { .sub--lead .sub__ticks { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .sub__stack { display: grid; gap: var(--s-1); padding-top: var(--s-3); border-top: 1px solid var(--rule); font-size: var(--t-small); font-weight: 600; }

  /* ---- Stack ---- */
  .stack { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 40rem) { .stack { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 64rem) { .stack { grid-template-columns: repeat(5, minmax(0, 1fr)); } }
  .stack__group { display: grid; gap: var(--s-4); align-content: start; }
  .stack__name { color: var(--accent-text); }
  .stack__items li { padding-block: var(--s-2); border-top: 1px solid var(--rule); font-size: clamp(1rem, 0.9rem + 0.4vw, 1.25rem); font-weight: 650; font-stretch: 112%; }

  /* ---- Gantt ---- */
  .gantt { --label: 1fr; border-top: 1px solid var(--rule-strong); }
  @media (min-width: 64rem) { .gantt { --label: minmax(0, 4fr); } }
  .gantt__ruler, .gantt__row { display: grid; grid-template-columns: var(--label) minmax(0, 8fr); column-gap: var(--gutter); }
  .gantt__ruler { padding-block: var(--s-3); border-bottom: 1px solid var(--rule); color: var(--ink-2); }
  .gantt__weeks, .gantt__track { display: grid; grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); }
  .gantt__weeks span { padding-left: 0.35rem; border-left: 1px solid var(--rule); font-size: 0.6875rem; white-space: nowrap; overflow: hidden; text-overflow: clip; }
  .gantt__row { padding-block: var(--s-5); border-bottom: 1px solid var(--rule); align-items: center; }
  .gantt__step { display: grid; gap: var(--s-1); }
  .gantt__when { color: var(--accent-text); }
  .gantt__name { font-size: 1.25rem; font-stretch: 112%; line-height: 1.2; }
  .gantt__body { color: var(--ink-2); font-size: var(--t-small); max-width: 46ch; }
  .gantt__track { position: relative; height: 2.25rem; background-image: linear-gradient(90deg, var(--rule) 1px, transparent 1px); background-size: calc(100% / var(--cols)) 100%; }
  .gantt__bar { align-self: center; height: 1.25rem; background: var(--ink-2); }
  .gantt__bar.is-build { background: var(--field); height: 2.25rem; }
  .gantt__bar.is-open { background: repeating-linear-gradient(90deg, var(--ink-2) 0 8px, transparent 8px 12px); }
  @media (max-width: 63.99rem) {
    .gantt__ruler { display: none; }
    .gantt__row { grid-template-columns: 1fr; row-gap: var(--s-3); }
  }

  /* ---- Pricing ---- */
  .tiers { grid-template-columns: 1fr; }
  @media (min-width: 64rem) { .tiers { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .tier { gap: var(--s-5); }
  .tier__head { display: flex; justify-content: space-between; align-items: baseline; gap: var(--s-3); flex-wrap: wrap; }
  .tier__name { font-size: var(--t-h3); font-stretch: 125%; line-height: 1.1; text-transform: uppercase; }
  .tier__flag { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; padding: 0.2rem 0.5rem; border: 1px solid currentColor; }
  .tier__price { display: grid; gap: var(--s-2); }
  .tier__from { color: var(--ink-2); }
  .tier__figure { font-size: clamp(2.75rem, 1.8rem + 2.6vw, 4.25rem); }
  .tier__facts { display: grid; border-top: 1px solid var(--rule); }
  .tier__facts div { display: grid; grid-template-columns: 6.5rem 1fr; gap: var(--s-3); padding-block: var(--s-3); border-bottom: 1px solid var(--rule); }
  .tier__facts dt { color: var(--ink-2); padding-top: 0.15rem; }
  .tier__facts dd { font-size: var(--t-small); font-weight: 550; }
  .tier__list { font-size: var(--t-small); }
  .tier__cta { margin-top: auto; }
  .tiers__care { margin-top: var(--s-5); color: var(--ink-2); max-width: 60ch; }
  .tiers__care strong { color: var(--ink); }

  /* ---- Promises ---- */
  .promises { grid-template-columns: 1fr; }
  @media (min-width: 40rem) { .promises { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64rem) { .promises { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .promise { gap: var(--s-3); }
  @media (min-width: 64rem) { .promise { min-height: 15rem; } }
