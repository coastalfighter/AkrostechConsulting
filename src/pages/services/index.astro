---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import ServiceMatrix from '@/components/heroes/ServiceMatrix.astro';
import Photo from '@/components/Photo.astro';
import Faq from '@/components/Faq.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import { site } from '@/config/site';
import { pages } from '@/data/pages';
import { services, serviceHref } from '@/data/services';
import { servicePhoto, serviceSecondPhoto } from '@/data/photos';
import { webSubServices } from '@/data/webdev';
import { commitments, generalFaqs } from '@/data/company';
import { canonical, faqSchema, serviceSchema } from '@/lib/seo';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services' },
];

const itemList = {
  '@type': 'ItemList',
  name: 'Akrostech services',
  itemListElement: services.map((s, i) => ({ '@type': 'ListItem', position: i + 1, url: canonical(serviceHref(s.slug)), name: s.name })),
};

const highlights = (slug: string) =>
  slug === 'website-development'
    ? webSubServices.slice(0, 5).map((w) => w.title)
    : (services.find((s) => s.slug === slug)?.capabilities.map((c) => c.title) ?? []);

const models = [
  { title: 'One specialist', body: 'A dedicated professional on your hours, full-time or part-time, with a team lead reviewing their work.', best: 'Founders and small teams with one function to hand off.' },
  { title: 'A pod', body: 'Two to ten specialists and a lead who owns coverage, quality and the weekly report.', best: 'Recurring, high-volume work: support desks, hiring funnels, month-end close.' },
  { title: 'A fixed-scope project', body: 'A defined deliverable for a fixed fee and a finish date.', best: 'Backlogs, clean-ups, migrations and website builds.' },
];
const f = site.figures;
---

<BaseLayout {...pages.services} image="/og/services.png" breadcrumbs={crumbs} schema={[itemList, ...services.map((s) => serviceSchema(s)), faqSchema(generalFaqs)]}>
  <Hero labelledby="services-title" split="5-7" crumbs={crumbs}>
    <h1 class="h1 hero__title svc-title" id="services-title">
      Five practices. <span class="accent">One way of working.</span>
    </h1>
    <p class="hero__lead">
      Virtual assistance, recruitment, accounting, legal process outsourcing and website development, delivered by vetted professionals in India on
      your U.S. hours. Open any practice to see what it covers.
    </p>
    <div class="actions">
      <a class="btn btn--primary" href={site.calendly} target="_blank" rel="noopener">
        Book a discovery call <Icon name="arrow-up-right" class="btn__arrow" />
      </a>
      <a class="btn btn--ghost" href="#compare">Compare services <Icon name="arrow-right" class="btn__arrow btn__arrow--right" /></a>
    </div>
    <ServiceMatrix slot="instrument" />

    <div slot="strip" class="strip ruled">
      <div class="module module--flex lime">
        <p class="figure">{f.matchHours}h</p>
        <p class="strip__text">To a shortlist of vetted professionals, in any of the five practices.</p>
      </div>
      <div class="module module--flex">
        <p class="figure">{f.onboardingHours}h</p>
        <p class="strip__text">From the first call to a specialist working inside your tools.</p>
      </div>
      <div class="module module--flex">
        <p class="figure"><span data-count>{f.professionals}</span>+</p>
        <p class="strip__text">Vetted professionals on U.S. shifts: Eastern, Central, Mountain or Pacific.</p>
      </div>
      <div class="module module--flex">
        <p class="figure"><span data-count>{f.accuracy}</span>%</p>
        <p class="strip__text">Task accuracy, checked by a team lead before work reaches you.</p>
      </div>
    </div>
  </Hero>

  <!-- The five practices: photograph-led modules -->
  <section class="section practices" aria-labelledby="practices-title">
    <div class="wrap">
      <div class="section-head grid">
        <h2 class="h2" id="practices-title" data-split>Each practice, on one sheet.</h2>
        <p data-reveal>What each practice covers, when it starts, what it typically saves and who it is built for. Every one runs to the same standard.</p>
      </div>

      {
        services.map((s, i) => (
          <article class:list={['pm grid', { 'pm--flip': i % 2 === 1 }]} id={s.slug} aria-labelledby={`pm-${s.slug}`}>
            <div class="pm__photos">
              <Photo name={servicePhoto[s.slug]} ratio="4 / 3" sizes="(min-width: 64rem) 42vw, 100vw" reveal="clip" class="pm__main" />
              <Photo name={serviceSecondPhoto[s.slug]} alt="" ratio="3 / 4" sizes="(min-width: 64rem) 17vw, 30vw" class="pm__second" />
            </div>
            <div class="pm__copy">
              <h3 class="pm__name" id={`pm-${s.slug}`}>
                {s.name}
                {s.isNew && <span class="pm__new">New</span>}
              </h3>
              <p class="pm__summary">{s.summary}</p>
              <p class="pm__intro">{s.intro}</p>
              <dl class="spec pm__spec">
                <div>
                  <dt>Starts</dt>
                  <dd>{s.startsIn}</dd>
                </div>
                <div>
                  <dt>Typical saving</dt>
                  <dd>{s.saving}</dd>
                </div>
                <div>
                  <dt>Built for</dt>
                  <dd>{s.audience}</dd>
                </div>
              </dl>
              <a class="btn btn--ghost pm__btn" href={serviceHref(s.slug)}>
                Explore {s.shortName.charAt(0).toLowerCase() + s.shortName.slice(1)} <Icon name="arrow-right" class="btn__arrow btn__arrow--right" />
              </a>
            </div>
            <div class="pm__covers">
              <p class="label pm__covers-key">What it covers</p>
              <ul class="pm__list" role="list">
                {highlights(s.slug).map((h) => (
                  <li>
                    <Icon name="check" class="icon pm__check" />
                    {h}
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Comparison table -->
  <section class="section plate" id="compare" aria-labelledby="compare-title">
    <div class="wrap">
      <div class="section-head grid">
        <h2 class="h2" id="compare-title" data-split>Compare at a glance.</h2>
        <p data-reveal>When each practice starts, what it typically saves and who it is built for, on one sheet.</p>
      </div>
      <div class="cmp" role="region" aria-labelledby="compare-title" tabindex="0">
        <table class="cmp__table">
          <thead>
            <tr>
              <th scope="col" class="label">Service</th>
              <th scope="col" class="label">Starts</th>
              <th scope="col" class="label">Typical saving</th>
              <th scope="col" class="label">Built for</th>
              <th scope="col"><span class="sr-only">Link</span></th>
            </tr>
          </thead>
          <tbody>
            {
              services.map((s) => (
                <tr>
                  <th scope="row">
                    <a class="cmp__name" href={serviceHref(s.slug)}>
                      {s.name}
                    </a>
                  </th>
                  <td>{s.startsIn}</td>
                  <td class="cmp__saving">{s.saving}</td>
                  <td>{s.audience}</td>
                  <td class="cmp__go">
                    <a class="cmp__arrow" href={serviceHref(s.slug)} aria-label={`${s.name} details`}>
                      <Icon name="arrow-up-right" />
                    </a>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="cmp__note small">
        Savings compare a monthly Akrostech fee with the fully loaded cost of an equivalent local hire or U.S. agency. Your figure is confirmed after
        discovery.
      </p>
    </div>
  </section>

  <!-- Engagement models -->
  <section class="section" aria-labelledby="models-title">
    <div class="wrap">
      <div class="section-head grid">
        <h2 class="h2" id="models-title" data-split>Three ways to work with us.</h2>
        <p data-reveal>Every practice is bought the same three ways. Start with one person and grow into a pod when the work proves itself.</p>
      </div>
      <ul class="models ruled" role="list" data-reveal-group>
        {
          models.map((m, i) => (
            <li class:list={['module module--flex model', { lime: i === 1 }]} data-reveal>
              <h3 class="h3">{m.title}</h3>
              <p class="model__body">{m.body}</p>
              <p class="model__best">
                <span class="label">Best for</span>
                <span>{m.best}</span>
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Commitments -->
  <section class="section section--flush-top" aria-labelledby="commit-title">
    <div class="wrap">
      <div class="section-head grid">
        <h2 class="h2" id="commit-title" data-split>The same six commitments, in every practice.</h2>
        <p data-reveal>Written into every engagement letter, whether you hire one assistant or a team across all five practices.</p>
      </div>
      <div class="commit grid">
        <div class="commit__photo c-4">
          <Photo name="team-table" ratio="3 / 4" sizes="(min-width: 64rem) 30vw, 100vw" reveal="clip" />
        </div>
        <ul class="commit__list ruled c-8" role="list" data-reveal-group>
          {
            commitments.map((c) => (
              <li class="module module--flex commit__item" data-reveal>
                <p class="commit__fig">{c.figure}</p>
                <h3 class="commit__title">{c.title}</h3>
                <p class="commit__body">{c.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <Faq faqs={generalFaqs} name="services" intro="The questions we hear most before a first engagement." />
  <CtaBand />
</BaseLayout>

<style>
  .svc-title { font-size: clamp(2.5rem, 0.9rem + 3.6vw, 4.25rem); }

  /* ---- Hero strip ---- */
  .strip { grid-template-columns: 1fr; }
  @media (min-width: 40rem) { .strip { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 64rem) { .strip { grid-template-columns: repeat(4, 1fr); } }
  .strip .module { min-height: 9rem; gap: var(--s-4); justify-content: space-between; }
  .strip .figure { font-size: clamp(2.5rem, 1.6rem + 2vw, 3.5rem); white-space: nowrap; }
  .strip__text { max-width: 30ch; font-size: var(--t-small); color: var(--ink-2); }

  /* ---- Practice modules ---- */
  .pm { row-gap: var(--s-6); padding-block: var(--s-8); border-top: 1px solid var(--rule-strong); scroll-margin-top: var(--header-h); }
  .pm:first-of-type { border-top: 0; padding-top: 0; }
  .pm__copy { display: grid; gap: var(--s-5); align-content: start; }
  .pm__name { font-size: clamp(1.75rem, 1.1rem + 2vw, 3rem); font-stretch: 125%; font-weight: 750; line-height: 0.95; letter-spacing: -0.03em; text-transform: uppercase; }
  .pm__new { display: inline-block; margin-left: 0.4em; padding: 0.2em 0.5em; vertical-align: middle; background: var(--accent); color: var(--accent-ink); font-size: 0.8125rem; letter-spacing: 0.06em; font-stretch: 112%; line-height: 1.2; }
  .pm__summary { font-size: var(--t-lead); line-height: 1.4; font-weight: 550; max-width: 40ch; }
  .pm__intro { color: var(--ink-2); max-width: 52ch; }
  .pm__btn { justify-self: start; }
  .pm__covers { display: grid; gap: var(--s-4); align-content: start; }
  .pm__covers-key { color: var(--ink-2); }
  .pm__list { display: grid; border-top: 1px solid var(--rule-strong); }
  @media (min-width: 40rem) { .pm__list { grid-template-columns: 1fr 1fr; column-gap: var(--gutter); } }
  .pm__list li { display: flex; gap: var(--s-3); align-items: start; padding-block: var(--s-3); border-bottom: 1px solid var(--rule); font-weight: 550; }
  .pm__check { color: var(--accent-text); margin-top: 0.15em; }
  .pm__photos { display: grid; grid-template-columns: 5fr 2fr; gap: var(--s-3); align-items: end; }
  .pm__photos :global(.pm__second) { margin-bottom: var(--s-7); }
  @media (max-width: 39.99rem) { .pm__photos { grid-template-columns: 1fr; } .pm__photos :global(.pm__second) { display: none; } }
  @media (min-width: 64rem) {
    .pm { grid-template-rows: auto 1fr; }
    .pm__photos { grid-column: 1 / span 7; grid-row: 1; }
    .pm__covers { grid-column: 1 / span 7; grid-row: 2; }
    .pm__copy { grid-column: 8 / -1; grid-row: 1 / span 2; padding-left: var(--s-5); }
    .pm--flip .pm__photos { grid-column: 6 / -1; grid-template-columns: 2fr 5fr; }
    .pm--flip .pm__photos :global(.pm__second) { order: -1; }
    .pm--flip .pm__covers { grid-column: 6 / -1; }
    .pm--flip .pm__copy { grid-column: 1 / span 5; padding-left: 0; padding-right: var(--s-5); }
  }

  /* ---- Compare table ---- */
  .cmp { position: relative; overflow-x: auto; border-top: 1px solid var(--rule-strong); }
  .cmp:focus-visible { outline-offset: 4px; }
  .cmp__table { min-width: 48rem; }
  .cmp__table th, .cmp__table td { text-align: left; vertical-align: top; padding: var(--s-4) var(--s-4) var(--s-4) 0; border-bottom: 1px solid var(--rule); }
  .cmp__table thead th { color: var(--ink-2); padding-block: var(--s-3); }
  .cmp__name { font-size: 1.1875rem; font-weight: 750; font-stretch: 125%; text-transform: uppercase; letter-spacing: -0.01em; line-height: 1.1; text-decoration: none; }
  @media (hover: hover) and (pointer: fine) { .cmp__name:hover { text-decoration: underline; text-decoration-color: var(--accent); text-decoration-thickness: 2px; } }
  .cmp__table td { color: var(--ink-2); }
  .cmp__table .cmp__saving { color: var(--accent-text); font-weight: 650; }
  .cmp__go { width: 3rem; padding-right: 0 !important; }
  .cmp__arrow { display: grid; place-items: center; width: 44px; height: 44px; border: 1px solid var(--rule-strong); color: var(--ink); transition: background-color var(--t-ui) ease, color var(--t-ui) ease; }
  @media (hover: hover) and (pointer: fine) { .cmp__arrow:hover { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); } }
  .cmp__note { margin-top: var(--s-5); color: var(--ink-2); max-width: 70ch; }

  /* ---- Models ---- */
  .models { grid-template-columns: 1fr; }
  @media (min-width: 64rem) { .models { grid-template-columns: repeat(3, 1fr); } }
  .model { gap: var(--s-4); }
  @media (min-width: 64rem) { .model { min-height: 20rem; } }
  .model__body { color: var(--ink-2); max-width: 40ch; }
  .model__best { margin-top: auto; padding-top: var(--s-4); border-top: 1px solid var(--rule); display: grid; gap: var(--s-1); font-weight: 550; }
  .model__best .label { color: var(--ink-2); }

  /* ---- Commitments ---- */
  .commit { row-gap: var(--s-6); }
  .commit__list { grid-template-columns: 1fr; align-self: start; }
  @media (min-width: 40rem) { .commit__list { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 64rem) { .commit__list { grid-template-columns: repeat(3, 1fr); } }
  .commit__item { gap: var(--s-3); }
  @media (min-width: 64rem) { .commit__item { min-height: 14rem; } }
  .commit__fig { font-size: clamp(2rem, 1.5rem + 1.6vw, 3rem); font-weight: 750; font-stretch: 125%; line-height: 1; color: var(--accent-text); letter-spacing: -0.02em; }
  .commit__title { font-size: 1.125rem; font-stretch: 112%; line-height: 1.2; margin-top: auto; }
  .commit__body { color: var(--ink-2); font-size: var(--t-small); }
  @media (min-width: 64rem) { .commit__photo { position: sticky; top: calc(var(--header-h) + var(--s-5)); align-self: start; } }
</style>
