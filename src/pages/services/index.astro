---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Media from '@/components/Media.astro';
import Faq from '@/components/Faq.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import { site } from '@/config/site';
import { pages } from '@/data/pages';
import { services, serviceHref } from '@/data/services';
import { webSubServices } from '@/data/webdev';
import { generalFaqs } from '@/data/company';
import { canonical, faqSchema, serviceSchema } from '@/lib/seo';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services' },
];

const itemList = {
  '@type': 'ItemList',
  name: 'Akrostech services',
  itemListElement: services.map((s, i) => ({ '@type': 'ListItem', position: i + 1, url: canonical(serviceHref(s.slug)), name: s.name })),
};

const highlights = (slug: string) =>
  slug === 'website-development' ? webSubServices.slice(0, 5).map((w) => w.title) : (services.find((s) => s.slug === slug)?.capabilities.map((c) => c.title) ?? []);

const models = [
  { title: 'One specialist', body: 'A dedicated professional on your hours, full-time or part-time, with a team lead reviewing their work.', best: 'Founders and small teams with one function to hand off.' },
  { title: 'A pod', body: 'Two to ten specialists and a lead who owns coverage, quality and the weekly report.', best: 'Recurring, high-volume work: support desks, hiring funnels, month-end close.' },
  { title: 'A fixed-scope project', body: 'A defined deliverable for a fixed fee and a finish date.', best: 'Backlogs, clean-ups, migrations and website builds.' },
];
---

<BaseLayout {...pages.services} image="/og/services.png" breadcrumbs={crumbs} schema={[itemList, ...services.map((s) => serviceSchema(s)), faqSchema(generalFaqs)]}>
  <PageHero
    title={['Five practices.', 'One way of working.']}
    lede="Virtual assistance, recruitment, accounting, legal process outsourcing and website development, delivered by vetted professionals in India on your U.S. hours. Open any practice to see what it covers."
    crumbs={crumbs}
  >
    <Fragment slot="actions">
      <a class="btn" href={site.calendly} target="_blank" rel="noopener" data-magnetic>
        <span class="btn__label">Book a discovery call <Icon name="arrow-up-right" class="btn__arrow" /></span>
      </a>
      <a class="btn btn--ghost" href="#compare"><span class="btn__label">Compare services</span></a>
    </Fragment>
  </PageHero>

  <!-- Expandable services -->
  <section class="xs wrap" aria-label="Services">
    {
      services.map((s, i) => (
        <details class="xs__item" name="services" open={i === 0} id={s.slug}>
          <summary class="xs__summary">
            <h2 class="xs__name">{s.name}</h2>
            <span class="xs__meta">
              {s.isNew && <span class="xs__new">New</span>}
              {s.startsIn}
            </span>
            <span class="xs__toggle" aria-hidden="true" />
          </summary>
          <div class="xs__panel">
            <div class="xs__copy">
              <p class="xs__summary-text">{s.summary}</p>
              <p class="xs__intro">{s.intro}</p>
              <dl class="xs__facts">
                <div>
                  <dt>Starts</dt>
                  <dd>{s.startsIn}</dd>
                </div>
                <div>
                  <dt>Typical saving</dt>
                  <dd>{s.saving}</dd>
                </div>
                <div>
                  <dt>Built for</dt>
                  <dd>{s.audience}</dd>
                </div>
              </dl>
              <a class="btn btn--ink" href={serviceHref(s.slug)}>
                <span class="btn__label">
                  Explore {s.shortName.toLowerCase()} <Icon name="arrow-right" class="btn__arrow" />
                </span>
              </a>
            </div>
            <ul class="xs__list" role="list">
              {highlights(s.slug).map((h) => (
                <li>
                  <Icon name="check" class="icon xs__check" />
                  {h}
                </li>
              ))}
            </ul>
            <div class="xs__art">
              <Media id={`service-${s.slug}-portrait`} alt="" ratio="4 / 5" sizes="(min-width: 1024px) 24vw, 60vw" widths={[400, 640, 960]} />
            </div>
          </div>
        </details>
      ))
    }
  </section>

  <!-- Comparison -->
  <section class="compare wrap section" id="compare" aria-labelledby="compare-title">
    <h2 class="h2 compare__title" id="compare-title" data-split>Compare at a glance.</h2>
    <div class="compare__scroll" tabindex="0" role="region" aria-label="Service comparison table, scrolls horizontally on small screens">
      <table class="compare__table">
        <thead>
          <tr>
            <th scope="col">Service</th>
            <th scope="col">Starts</th>
            <th scope="col">Typical saving</th>
            <th scope="col">Built for</th>
            <th scope="col"><span class="sr-only">Link</span></th>
          </tr>
        </thead>
        <tbody>
          {
            services.map((s) => (
              <tr>
                <th scope="row">{s.name}</th>
                <td>{s.startsIn}</td>
                <td>{s.saving}</td>
                <td>{s.audience}</td>
                <td>
                  <a class="arrow-link" href={serviceHref(s.slug)} aria-label={`${s.name} details`}>
                    <Icon name="arrow-up-right" />
                  </a>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="compare__note">Savings compare a monthly Akrostech fee with the fully loaded cost of an equivalent local hire or U.S. agency. Your figure is confirmed after discovery.</p>
  </section>

  <!-- Engagement models -->
  <section class="models section" aria-labelledby="models-title">
    <div class="wrap">
      <h2 class="h1 models__title" id="models-title" data-split>Three ways to work with us.</h2>
      <ul class="models__grid" role="list" data-reveal-group>
        {
          models.map((m) => (
            <li class="models__card" data-reveal data-tilt="5">
              <h3 class="models__name">{m.title}</h3>
              <p>{m.body}</p>
              <p class="models__best">
                <strong>Best for:</strong> {m.best}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Faq faqs={generalFaqs} name="services" intro="The questions we hear most before a first engagement." />
  <CtaBand />
</BaseLayout>

<style>
  /* Expandable services */
  .xs { display: grid; gap: 6px; padding-bottom: var(--section-gap); interpolate-size: allow-keywords; }
  .xs__item { background: var(--bg-raised); transition: background-color var(--dur-base) var(--ease-out); scroll-margin-top: calc(var(--header-h) + 1rem); }
  .xs__item[open] { background: var(--surface); }
  .xs__summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: var(--space-m);
    padding: clamp(1.25rem, 2.5vw, 2rem) clamp(1.25rem, 2.5vw, 2.25rem);
    cursor: pointer;
    list-style: none;
  }
  .xs__summary::-webkit-details-marker { display: none; }
  .xs__summary:focus-visible { outline-offset: -4px; }
  .xs__name {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 0.9rem + 3.4vw, 4.5rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.045em;
    color: var(--ink-strong);
    transition: translate var(--dur-slow) var(--ease-out), color var(--dur-base);
  }
  .xs__summary:hover .xs__name { translate: 0.12em 0; color: var(--accent-text); }
  .xs__meta { display: inline-flex; align-items: center; gap: 0.75rem; color: var(--muted); font-size: var(--step--1); }
  .xs__new { padding: 0.15rem 0.5rem; background: var(--accent); color: var(--accent-ink); font-weight: 600; }
  .xs__toggle { position: relative; width: 2.75rem; height: 2.75rem; border-radius: 50%; box-shadow: inset 0 0 0 1.5px var(--ink-strong); transition: background-color var(--dur-fast), rotate var(--dur-slow) var(--ease-out); }
  .xs__toggle::before, .xs__toggle::after { content: ''; position: absolute; left: 30%; right: 30%; top: 50%; height: 2px; margin-top: -1px; background: var(--ink-strong); }
  .xs__toggle::after { rotate: 90deg; transition: rotate var(--dur-base) var(--ease-out); }
  .xs__item[open] .xs__toggle { background: var(--ink-strong); }
  .xs__item[open] .xs__toggle::before, .xs__item[open] .xs__toggle::after { background: var(--bg); }
  .xs__item[open] .xs__toggle::after { rotate: 0deg; }
  .xs__item::details-content { block-size: 0; overflow-y: clip; transition: block-size 600ms var(--ease-in-out), content-visibility 600ms allow-discrete; }
  .xs__item[open]::details-content { block-size: auto; }
  @media (prefers-reduced-motion: reduce) { .xs__item::details-content { transition: none; } }

  .xs__panel {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 4fr) minmax(0, 3fr);
    gap: var(--space-xl) var(--gutter);
    padding: 0 clamp(1.25rem, 2.5vw, 2.25rem) clamp(1.5rem, 3vw, 2.5rem);
  }
  .xs__summary-text { font-family: var(--font-display); font-size: var(--step-1); font-weight: 500; line-height: 1.25; letter-spacing: -0.02em; color: var(--ink-strong); max-width: 32ch; }
  .xs__intro { margin-top: var(--space-s); max-width: 50ch; }
  .xs__facts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-s); margin-block: var(--space-l); }
  .xs__facts dt { font-size: var(--step--1); color: var(--muted); }
  .xs__facts dd { font-weight: 600; color: var(--ink-strong); font-size: var(--step--1); }
  .xs__list { display: grid; gap: 0.75rem; align-content: start; font-size: var(--step-0); }
  .xs__list li { display: flex; gap: 0.6rem; align-items: start; }
  .xs__check { color: var(--accent-text); margin-top: 0.15em; }
  @media (max-width: 1023px) {
    .xs__panel { grid-template-columns: 1fr 1fr; }
    .xs__copy { grid-column: 1 / -1; }
  }
  @media (max-width: 599px) {
    .xs__summary { grid-template-columns: minmax(0, 1fr) auto; }
    .xs__meta { grid-column: 1; grid-row: 2; }
    .xs__toggle { grid-column: 2; grid-row: 1 / span 2; }
    .xs__panel { grid-template-columns: 1fr; }
    .xs__facts { grid-template-columns: 1fr; }
    .xs__art { max-width: 16rem; }
  }

  /* Compare */
  .compare__title { margin-bottom: var(--space-xl); }
  .compare__scroll { overflow-x: auto; }
  .compare__table { width: 100%; min-width: 46rem; font-size: var(--step-0); }
  .compare__table th, .compare__table td { padding: 1.1rem 1rem 1.1rem 0; text-align: left; vertical-align: top; border-bottom: 1px solid var(--line); }
  .compare__table thead th { font-size: var(--step--1); font-weight: 600; color: var(--muted); }
  .compare__table tbody th { font-family: var(--font-display); font-size: var(--step-1); font-weight: 600; letter-spacing: -0.02em; color: var(--ink-strong); }
  .compare__table tbody tr { transition: background-color var(--dur-fast); }
  .compare__table tbody tr:hover { background: var(--bg-raised); }
  .compare__note { margin-top: var(--space-m); font-size: var(--step--1); color: var(--muted); max-width: 70ch; }

  /* Models */
  .models { background: var(--field); color: var(--field-ink); }
  .models__title { color: var(--field-ink); margin-bottom: var(--space-2xl); max-width: 16ch; }
  .models__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gutter); }
  .models__card { display: grid; align-content: start; gap: var(--space-s); padding: clamp(1.5rem, 2.5vw, 2.25rem); background: rgb(0 0 0 / 0.16); min-height: 18rem; }
  .models__name { font-family: var(--font-display); font-size: var(--step-2); font-weight: 600; letter-spacing: -0.04em; line-height: 1; }
  .models__best { margin-top: auto; padding-top: var(--space-m); color: var(--field-muted); }
  .models__best strong { color: var(--field-ink); }
  @media (max-width: 1023px) {
    .models__grid { grid-template-columns: 1fr; }
    .models__card { min-height: auto; }
  }
</style>
