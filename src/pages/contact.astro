---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Faq from '@/components/Faq.astro';
import Icon from '@/components/Icon.astro';
import { site, fullAddress, mapsDirectionsUrl, mapsEmbedUrl, mapsPlaceUrl } from '@/config/site';
import { pages } from '@/data/pages';
import { contactFaqs } from '@/data/company';
import { locations } from '@/data/locations';
import { LIMITS, SERVICE_OPTIONS, TEAM_SIZES } from '@/lib/contact';
import { faqSchema, ids } from '@/lib/seo';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Contact', path: '/contact' },
];
const contactPage = { '@type': ['WebPage', 'ContactPage'], mainEntity: { '@id': ids.business } };
---

<BaseLayout {...pages.contact} image="/og/contact.png" breadcrumbs={crumbs} webPage={contactPage} schema={[faqSchema(contactFaqs)]}>
  <PageHero
    title={['Let’s talk', 'about your hours.']}
    lede="Tell us what you want to hand off. A client partner replies within one business day, or you can book a 30-minute discovery call right now."
    crumbs={crumbs}
  >
    <Fragment slot="actions">
      <a class="btn" href={site.calendly} target="_blank" rel="noopener" data-magnetic>
        <span class="btn__label">Book a call <Icon name="calendar" class="btn__arrow" /></span>
      </a>
      <a class="btn btn--ghost" href={`tel:${site.phoneE164}`} data-magnetic>
        <span class="btn__label"><Icon name="phone" /> {site.phone}</span>
      </a>
    </Fragment>
  </PageHero>

  <section class="ct wrap" id="enquiry" aria-labelledby="form-title">
    <div class="ct__form-wrap">
      <h2 class="h2" id="form-title" data-split>Send an enquiry.</h2>
      <p class="ct__intro" data-reveal>Fields marked with an asterisk are required. We never share your details.</p>

      <div class="ct__notice ct__notice--ok" role="status" hidden data-form-success>
        <Icon name="check" class="icon ct__notice-icon" />
        <div>
          <p class="ct__notice-title">Message received.</p>
          <p data-form-success-text>Thanks. A client partner will reply within one business day.</p>
        </div>
      </div>
      <div class="ct__notice ct__notice--err" role="alert" hidden data-form-error>
        <p data-form-error-text></p>
      </div>

      <form class="form" action="/api/contact" method="post" novalidate data-contact-form>
        <div class="form__grid">
          <label class="field">
            <input class="field__control" type="text" name="name" autocomplete="name" required minlength="2" maxlength={LIMITS.name} placeholder=" " aria-describedby="err-name" />
            <span class="field__label">Your name *</span>
            <span class="field__error" id="err-name" data-error="name">Please tell us your name.</span>
          </label>
          <label class="field">
            <input class="field__control" type="email" name="email" autocomplete="email" required maxlength={LIMITS.email} placeholder=" " inputmode="email" spellcheck="false" aria-describedby="err-email" />
            <span class="field__label">Work email *</span>
            <span class="field__error" id="err-email" data-error="email">Please enter a valid email, like name@company.com.</span>
          </label>
          <label class="field">
            <input class="field__control" type="text" name="company" autocomplete="organization" maxlength={LIMITS.company} placeholder=" " />
            <span class="field__label">Company</span>
          </label>
          <label class="field">
            <input class="field__control" type="tel" name="phone" autocomplete="tel" maxlength={LIMITS.phone} placeholder=" " pattern="[+()0-9 .\-]{7,30}" aria-describedby="err-phone" />
            <span class="field__label">Phone</span>
            <span class="field__error" id="err-phone" data-error="phone">Please use digits, spaces and + ( ) - only.</span>
          </label>
          <label class="field field--select">
            <select class="field__control" name="service" required aria-describedby="err-service">
              <option value="" disabled selected>Choose one</option>
              {SERVICE_OPTIONS.map((o) => <option value={o}>{o}</option>)}
            </select>
            <span class="field__label">What do you need? *</span>
            <span class="field__error" id="err-service" data-error="service">Please choose what you need help with.</span>
          </label>
          <label class="field field--select">
            <select class="field__control" name="teamSize">
              <option value="" selected>Not sure yet</option>
              {TEAM_SIZES.map((o) => <option value={o}>{o}</option>)}
            </select>
            <span class="field__label">Team size</span>
          </label>
          <label class="field form__full">
            <textarea class="field__control" name="message" required minlength={LIMITS.messageMin} maxlength={LIMITS.message} placeholder=" " rows="6" aria-describedby="err-message hint-message"></textarea>
            <span class="field__label">What would you like to hand off? *</span>
            <span class="field__error" id="err-message" data-error="message">A sentence or two helps us prepare: at least {LIMITS.messageMin} characters.</span>
            <span class="field__hint" id="hint-message">The tasks, the tools you use and the hours you need covered.</span>
          </label>
        </div>

        <div class="form__trap" aria-hidden="true">
          <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
        </div>
        <input type="hidden" name="elapsedMs" value="0" data-elapsed />

        <label class="check form__consent">
          <input type="checkbox" name="consent" required aria-describedby="err-consent" />
          <span>I agree that Akrostech may contact me about this enquiry, as described in the <a class="link link--static" href="/privacy">privacy policy</a>. *</span>
        </label>
        <span class="field__error form__consent-error" id="err-consent" data-error="consent">Please confirm we may contact you about this enquiry.</span>

        <div class="form__actions">
          <button class="btn form__submit" type="submit" data-magnetic data-submit>
            <span class="btn__label"><span data-submit-label>Send enquiry</span> <Icon name="arrow-up-right" class="btn__arrow" /></span>
            <span class="form__spinner" aria-hidden="true"></span>
          </button>
          <p class="form__alt">or email <a class="link link--static" href={`mailto:${site.email}`}>{site.email}</a></p>
        </div>
      </form>
    </div>

    <aside class="ct__side" aria-label="Contact details">
      <div class="ct__block" data-reveal>
        <h2 class="ct__label">Headquarters</h2>
        <address class="ct__addr">
          {site.legalName}<br />{site.address.street}<br />{site.address.locality}, {site.address.region} {site.address.postalCode}
        </address>
        <a class="arrow-link" href={mapsDirectionsUrl} target="_blank" rel="noopener"><Icon name="route" /> Driving directions</a>
      </div>
      <div class="ct__block" data-reveal>
        <h2 class="ct__label">Office hours</h2>
        <p class="ct__status" data-open-status hidden><span class="ct__dot" aria-hidden="true"></span><span data-open-text></span></p>
        <table class="ct__hours">
          <caption class="sr-only">Office hours, Eastern Time</caption>
          <tbody>
            <tr><th scope="row">Monday to Friday</th><td>9:00 am – 6:00 pm ET</td></tr>
            <tr><th scope="row">Saturday and Sunday</th><td>Closed</td></tr>
          </tbody>
        </table>
        <p class="ct__small">Your specialists work your own U.S. shift, Eastern, Central, Mountain or Pacific.</p>
      </div>
      <div class="ct__block" data-reveal>
        <h2 class="ct__label">Direct</h2>
        <ul role="list" class="ct__direct">
          <li><a class="link" href={`tel:${site.phoneE164}`}><Icon name="phone" /> {site.phone}</a></li>
          <li><a class="link" href={`mailto:${site.email}`}><Icon name="mail" /> {site.email}</a></li>
          <li><a class="link" href={site.socials.linkedin} target="_blank" rel="noopener"><Icon name="linkedin" /> LinkedIn</a></li>
        </ul>
      </div>
    </aside>
  </section>

  <!-- Map -->
  <section class="map section" aria-labelledby="map-title">
    <div class="wrap map__grid">
      <div class="map__text">
        <h2 class="h1" id="map-title" data-split>Find us in Wilmington.</h2>
        <p data-reveal>
          We are on Delaware Avenue (DE-52) in Wilmington, a few minutes from I-95 exit 7 and the Wilmington Amtrak station, with street parking on
          Delaware Avenue and the nearby side streets. Visits are by appointment.
        </p>
        <ul role="list" class="map__links">
          <li><a class="arrow-link" href={mapsDirectionsUrl} target="_blank" rel="noopener">Get directions <Icon name="arrow-up-right" /></a></li>
          <li><a class="arrow-link" href={mapsPlaceUrl} target="_blank" rel="noopener">Open in Google Maps <Icon name="arrow-up-right" /></a></li>
        </ul>
      </div>
      <div class="map__frame skeleton" data-map>
        <iframe
          title={`Map showing ${site.name} at ${fullAddress}`}
          src={mapsEmbedUrl}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
          width="800"
          height="600"></iframe>
      </div>
    </div>
  </section>

  <!-- Locations -->
  <section class="locs wrap section" aria-labelledby="locs-title">
    <h2 class="h2" id="locs-title" data-split>Where we work.</h2>
    <ul class="locs__grid" role="list" data-reveal-group>
      <li class="locs__card locs__card--dark" data-reveal>
        <p class="locs__kind">Delivery</p>
        <h3 class="locs__name">India</h3>
        <p>Specialists and team leads on fixed U.S. shifts.</p>
      </li>
      {
        locations.map((l) => (
          <li data-reveal>
            <a class="locs__card" href={`/locations/${l.slug}`}>
              <p class="locs__kind">{l.isHeadquarters ? 'Headquarters' : 'Service area'}</p>
              <h3 class="locs__name">
                {l.city}, {l.region}
              </h3>
              <p>{l.distance}</p>
              <Icon name="arrow-up-right" class="icon locs__arrow" />
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <Faq faqs={contactFaqs} name="contact" heading="Before you get in touch" />
</BaseLayout>

<script>
  import { validateContact, type ContactField } from '@/lib/contact';
  import { wallClock } from '@/lib/time';

  // Live open/closed status from the office hours (Eastern Time).
  const status = document.querySelector<HTMLElement>('[data-open-status]');
  if (status) {
    const w = wallClock('America/New_York', new Date());
    const minutes = w.hour * 60 + w.minute;
    const open = w.weekday >= 1 && w.weekday <= 5 && minutes >= 9 * 60 && minutes < 18 * 60;
    status.hidden = false;
    status.dataset.open = String(open);
    status.querySelector('[data-open-text]')!.textContent = open ? 'Open now in Wilmington' : 'Closed now: we reply next business morning';
  }

  // Map skeleton clears once the iframe has loaded.
  document.querySelectorAll<HTMLElement>('[data-map]').forEach((wrap) => {
    wrap.querySelector('iframe')?.addEventListener('load', () => wrap.classList.remove('skeleton'), { once: true });
  });

  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  if (form) {
    const started = Date.now();
    const success = document.querySelector<HTMLElement>('[data-form-success]')!;
    const errorBox = document.querySelector<HTMLElement>('[data-form-error]')!;
    const errorText = document.querySelector<HTMLElement>('[data-form-error-text]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const label = form.querySelector<HTMLElement>('[data-submit-label]')!;
    const elapsed = form.querySelector<HTMLInputElement>('[data-elapsed]')!;

    // Status from a no-JS round trip.
    const params = new URL(location.href).searchParams;
    if (params.get('sent') === '1') success.hidden = false;
    if (params.get('error')) {
      errorText.textContent = 'We could not send that. Please check the fields and try again, or email us directly.';
      errorBox.hidden = false;
    }
    // Preselect the service when arriving from a service page (?service=Website%20development).
    const wanted = params.get('service');
    const select = form.querySelector<HTMLSelectElement>('select[name="service"]');
    if (wanted && select) {
      const match = [...select.options].find((o) => o.value.toLowerCase() === wanted.toLowerCase());
      if (match) select.value = match.value;
    }

    const control = (name: string) => form.querySelector<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>(`[name="${name}"]`);
    const showErrors = (errors: Partial<Record<ContactField, string>>) => {
      form.querySelectorAll<HTMLElement>('[data-error]').forEach((el) => {
        const field = el.dataset.error as ContactField;
        const msg = errors[field];
        const input = control(field);
        if (msg) el.textContent = msg;
        input?.setAttribute('aria-invalid', msg ? 'true' : 'false');
        el.style.display = msg ? 'block' : '';
      });
    };

    // Keep aria-invalid in sync with :user-invalid as people move through the form.
    form.addEventListener('focusout', (e) => {
      const el = e.target as HTMLInputElement;
      if (el.matches?.('.field__control, input[type="checkbox"]')) el.setAttribute('aria-invalid', String(el.matches(':user-invalid')));
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      success.hidden = true;
      errorBox.hidden = true;
      elapsed.value = String(Date.now() - started);
      const data = Object.fromEntries(new FormData(form)) as Record<string, unknown>;
      data.consent = (form.querySelector('[name="consent"]') as HTMLInputElement).checked;

      const check = validateContact(data);
      if (!check.ok) {
        showErrors(check.errors);
        const first = Object.keys(check.errors)[0];
        if (first) control(first)?.focus();
        return;
      }
      showErrors({});

      submit.disabled = true;
      submit.classList.add('is-loading');
      label.textContent = 'Sending…';
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(data),
        });
        const body = (await res.json().catch(() => ({}))) as { ok?: boolean; message?: string; errors?: Partial<Record<ContactField, string>> };
        if (res.ok && body.ok) {
          form.reset();
          success.querySelector('[data-form-success-text]')!.textContent = body.message ?? 'Thanks. We will be in touch.';
          success.hidden = false;
          success.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'center' });
          success.focus?.();
        } else {
          if (body.errors) showErrors(body.errors);
          errorText.textContent = body.message ?? 'Something went wrong. Please try again or email us directly.';
          errorBox.hidden = false;
        }
      } catch {
        errorText.textContent = 'We could not reach the server. Check your connection, or email contact@akrostech.info.';
        errorBox.hidden = false;
      } finally {
        submit.disabled = false;
        submit.classList.remove('is-loading');
        label.textContent = 'Send enquiry';
      }
    });
  }
</script>

<style>
  .ct { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: var(--space-2xl) clamp(2rem, 6vw, 6rem); padding-block: var(--space-2xl) var(--section-gap); }
  .ct__intro { margin-block: var(--space-s) var(--space-l); color: var(--muted); }
  .form__grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-s) var(--space-s); }
  .form__full { grid-column: 1 / -1; }
  .form__trap { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; } /* taste-skill-ignore: honeypot, not a rule */
  .form__consent { margin-top: var(--space-m); }
  .form__consent input:user-invalid ~ span { color: var(--danger); }
  .form__consent-error { margin-left: 2rem; }
  .form__consent:has(input:user-invalid) + .form__consent-error { display: block; }
  .form__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-m); margin-top: var(--space-l); }
  .form__submit { min-width: 13rem; }
  .form__submit:disabled { cursor: progress; opacity: 0.85; }
  .form__spinner { position: absolute; right: 1rem; width: 1.1rem; height: 1.1rem; border-radius: 50%; border: 2px solid currentColor; border-right-color: transparent; opacity: 0; }
  .form__submit:global(.is-loading) .form__spinner { opacity: 1; animation: spin 700ms linear infinite; }
  .form__submit:global(.is-loading) .btn__arrow { opacity: 0; }
  @keyframes spin { to { rotate: 1turn; } }
  .form__alt { color: var(--muted); }
  @media (max-width: 599px) { .form__grid { grid-template-columns: 1fr; } .form__submit { width: 100%; } }

  .ct__notice { display: flex; gap: var(--space-s); align-items: start; padding: var(--space-m); margin-bottom: var(--space-l); }
  .ct__notice--ok { background: var(--field); color: var(--field-ink); }
  .ct__notice--err { background: light-dark(#f4dfd8, #3a1f18); color: var(--danger); font-weight: 500; }
  .ct__notice-icon { width: 1.5rem; height: 1.5rem; flex: none; }
  .ct__notice-title { font-family: var(--font-display); font-size: var(--step-1); font-weight: 600; }
  @media (prefers-reduced-motion: no-preference) {
    .ct__notice:not([hidden]) { animation: notice-in 500ms var(--ease-out); }
  }
  @keyframes notice-in { from { opacity: 0; translate: 0 -8px; } }

  .ct__side { display: grid; align-content: start; gap: var(--space-xl); padding-top: var(--space-s); }
  .ct__label { font-family: var(--font-text); font-size: var(--step--1); font-weight: 600; color: var(--muted); margin-bottom: var(--space-xs); }
  .ct__addr { font-style: normal; font-family: var(--font-display); font-size: var(--step-1); font-weight: 500; line-height: 1.3; color: var(--ink-strong); margin-bottom: var(--space-xs); }
  .ct__status { display: flex; align-items: center; gap: 0.6rem; font-weight: 600; color: var(--ink-strong); margin-bottom: var(--space-s); }
  .ct__dot { width: 0.65rem; height: 0.65rem; border-radius: 50%; background: var(--muted); }
  .ct__status[data-open='true'] .ct__dot { background: var(--accent); box-shadow: 0 0 0 4px color-mix(in oklab, var(--accent) 25%, transparent); }
  .ct__hours { width: 100%; font-size: var(--step--1); }
  .ct__hours th, .ct__hours td { padding: 0.55rem 0; text-align: left; border-bottom: 1px solid var(--line); font-weight: 500; }
  .ct__hours td { text-align: right; color: var(--ink-strong); }
  .ct__small { margin-top: var(--space-s); font-size: var(--step--1); color: var(--muted); }
  .ct__direct { display: grid; gap: 0.1rem; }
  .ct__direct a { display: inline-flex; align-items: center; gap: 0.6rem; min-height: 44px; color: var(--ink-strong); font-weight: 500; }
  @media (max-width: 1023px) { .ct { grid-template-columns: 1fr; } }

  .map { background: var(--surface); }
  .map__grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--space-2xl) var(--gutter); align-items: center; }
  .map__text { display: grid; gap: var(--space-m); }
  .map__text p { max-width: 46ch; }
  .map__links { display: flex; flex-wrap: wrap; gap: var(--space-l); }
  .map__frame { position: relative; aspect-ratio: 4 / 3; overflow: hidden; }
  .map__frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; filter: grayscale(0.35) contrast(1.05); }
  @media (max-width: 1023px) { .map__grid { grid-template-columns: 1fr; } }

  .locs__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--gutter); margin-top: var(--space-xl); }
  .locs__card { position: relative; display: grid; align-content: start; gap: var(--space-xs); height: 100%; min-height: 14rem; padding: clamp(1.25rem, 2.5vw, 1.75rem); background: var(--bg-raised); text-decoration: none; color: inherit; transition: background-color var(--dur-base), color var(--dur-base); }
  a.locs__card:hover { background: var(--inverse); color: var(--inverse-ink); }
  .locs__card--dark { background: var(--field); color: var(--field-ink); }
  .locs__kind { font-size: var(--step--1); font-weight: 600; opacity: 0.75; }
  .locs__name { font-family: var(--font-display); font-size: var(--step-1); font-weight: 600; letter-spacing: -0.02em; margin-bottom: auto; }
  .locs__arrow { position: absolute; right: 1.25rem; top: 1.25rem; }
  @media (max-width: 1023px) { .locs__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 599px) { .locs__grid { grid-template-columns: 1fr; } .locs__card { min-height: auto; } }
</style>
