---
/**
 * Contact, in the Sample-3 order: the ask and three channels, the enquiry form beside a sticky
 * "what happens next" timeline, a time that suits both sides (the call week instrument, key
 * `week`), the office and the U.S. hours we cover, questions. The form posts to /api/contact
 * with the same fields, names, honeypot and timing field as before; only its styling changed.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import FieldHero from '@/components/FieldHero.astro';
import CallWeek from '@/components/instruments/CallWeek.astro';
import Photo from '@/components/Photo.astro';
import Faq from '@/components/Faq.astro';
import Icon from '@/components/Icon.astro';
import { site, fullAddress, mapsDirectionsUrl, mapsEmbedUrl, mapsPlaceUrl } from '@/config/site';
import { pages } from '@/data/pages';
import { contactFaqs } from '@/data/company';
import { hubs, processSteps } from '@/data/home';
import { LIMITS, SERVICE_OPTIONS, TEAM_SIZES } from '@/lib/contact';
import { faqSchema, ids } from '@/lib/seo';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Contact', path: '/contact' },
];
const contactPage = { '@type': ['WebPage', 'ContactPage'], mainEntity: { '@id': ids.business } };

/** Our contact questions, then the Sample-3 ones they do not already cover. */
const faqs = [
  ...contactFaqs,
  { q: 'How soon can a team start?', a: 'Most roles are onboarded within about 48 hours of the discovery call, with access, SOPs and a first-week plan ready.' },
  { q: 'Which time zones do you cover?', a: 'Teams work your chosen U.S. time zone: EST, CST, MST or PST.' },
  {
    q: 'Is there a minimum commitment?',
    a: 'You can start with a single specialist and scale up or down as your needs change. We agree terms together after the discovery call.',
  },
];

const channels = [
  { icon: 'mail', label: 'Email us', value: site.email, note: 'Replies within one business day', href: `mailto:${site.email}` },
  { icon: 'phone', label: 'Call us', value: site.phone, note: 'U.S. business hours', href: `tel:${site.phoneE164}` },
  { icon: 'calendar', label: 'Book a call', value: '30-minute discovery call', note: 'Pick a time that suits you', href: site.calendly, external: true },
] as const;

const tips = ['The roles or tasks you want covered', 'Tools you use today (CRM, ATS, QuickBooks…)', 'Your time zone and ideal start date', 'What a great first month looks like'];
---

<BaseLayout {...pages.contact} image="/og/contact.png" breadcrumbs={crumbs} webPage={contactPage} schema={[faqSchema(faqs)]}>
  <FieldHero scene="relay" labelledby="contact-title" crumbs={crumbs} wide>
    <h1 class="fhero__title" id="contact-title">Tell us what’s slowing you down. <span class="quiet">We’ll staff the fix.</span></h1>
    <p class="fhero__lead">
      Share the work you want off your plate. Within one business day you’ll get a recommended team shape, a start date and clear next steps. No
      obligation.
    </p>
    <div class="actions">
      <a class="btn btn--primary" href="#enquiry">Request a proposal <Icon name="arrow-right" class="btn__arrow btn__arrow--right" /></a>
      <a class="btn btn--ghost" href={site.calendly} target="_blank" rel="noopener">Book a call <Icon name="calendar" class="btn__arrow" /></a>
    </div>

    <div slot="after" class="reach">
      <ul class="reach__channels" role="list" aria-label="Ways to reach us">
        {
          channels.map((c) => (
            <li>
              <a class="reach__card" href={c.href} {...('external' in c ? { target: '_blank', rel: 'noopener' } : {})}>
                <span class="reach__icon" aria-hidden="true">
                  <Icon name={c.icon} />
                </span>
                <span class="reach__text">
                  <span class="small muted">{c.label}</span>
                  <span class="reach__value">{c.value}</span>
                  <span class="small muted">{c.note}</span>
                </span>
                <span class="reach__go" aria-hidden="true">
                  <Icon name="arrow-up-right" />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <aside class="reach__status ink-plate" aria-label="Our availability">
        <p class="reach__live live is-off" data-open-status><span data-open-text>Office hours: {site.hoursLabel}</span></p>
        <dl class="reach__clocks" data-clocks hidden>
          <div><dt class="small muted">Wilmington, DE</dt><dd data-clock={site.timezone}></dd></div>
          <div><dt class="small muted">Delivery, India</dt><dd data-clock={site.deliveryTimezone}></dd></div>
        </dl>
        <p class="small muted reach__note"><Icon name="clock" /> A real person replies within one business day.</p>
      </aside>
    </div>
  </FieldHero>

  <!-- Enquiry form beside the sticky timeline -->
  <section class="section section--flush-top ct" id="enquiry" aria-labelledby="form-title">
    <div class="wrap grid ct__grid">
      <aside class="ct__side c-4" aria-label="What happens next">
        <div class="ct__next">
          <h2 class="h3">What happens next</h2>
          <ol class="ct__steps" role="list">
            {
              processSteps.map((step, i) => (
                <li class:list={['ct__step', { 'ct__step--first': i === 0 }]}>
                  <span class="ct__dot" aria-hidden="true" />
                  <span class="ct__step-head">
                    <strong>{step.title}</strong>
                    <span class="small muted tabular">{step.duration}</span>
                  </span>
                  <span class="small muted">{step.detail}</span>
                </li>
              ))
            }
          </ol>
        </div>
        <div class="ct__tips">
          <h2 class="ct__tips-title">Helpful to include</h2>
          <ul class="ticks small" role="list">{tips.map((t) => <li>{t}</li>)}</ul>
        </div>
        <div class="ct__am">
          <span class="ct__am-mark" aria-hidden="true">AM</span>
          <p class="small"><strong>Your account manager</strong><br /><span class="muted">Reads every enquiry and stays your single point of contact.</span></p>
        </div>
      </aside>

      <div class="ct__panel c-8">
        <div class="ct__bar small">
          <span>Proposal request</span>
          <span class="muted">About 2 minutes</span>
        </div>
        <div class="ct__body">
          <div class="ct__head">
            <h2 class="h2" id="form-title">Tell us what you need.</h2>
            <p class="ct__intro">Fields marked with an asterisk are required. We never share your details.</p>
            <div class="ready" data-ready>
              <p class="ready__row small" id="ready-label"><span>Proposal readiness</span><span class="tabular"><span data-ready-count>0</span>/5</span></p>
              <div class="ready__track" role="progressbar" aria-labelledby="ready-label" aria-valuemin="0" aria-valuemax="5" aria-valuenow="0" data-ready-bar>
                <span class="ready__fill"></span>
              </div>
            </div>
          </div>

          <div class="ct__notice ct__notice--ok lime" role="status" tabindex="-1" hidden data-form-success>
            <Icon name="check" class="icon ct__notice-icon" />
            <div>
              <p class="ct__notice-title">Message received.</p>
              <p data-form-success-text>Thanks. A client partner will reply within one business day.</p>
            </div>
          </div>
          <div class="ct__notice ct__notice--err" role="alert" hidden data-form-error>
            <p class="ct__notice-title">Not sent.</p>
            <p data-form-error-text></p>
          </div>

          <form class="form" action="/api/contact" method="post" novalidate data-contact-form>
            <div class="form__grid">
              <div class="input">
                <label class="input__label" for="ct-name">Your name *</label>
                <input class="input__control" id="ct-name" type="text" name="name" autocomplete="name" required minlength="2" maxlength={LIMITS.name} aria-describedby="err-name" />
                <span class="input__error" id="err-name" data-error="name">Please tell us your name.</span>
              </div>
              <div class="input">
                <label class="input__label" for="ct-email">Work email *</label>
                <input class="input__control" id="ct-email" type="email" name="email" autocomplete="email" required maxlength={LIMITS.email} inputmode="email" spellcheck="false" aria-describedby="err-email" />
                <span class="input__error" id="err-email" data-error="email">Please enter a valid email, like name@company.com.</span>
              </div>
              <div class="input">
                <label class="input__label" for="ct-company">Company</label>
                <input class="input__control" id="ct-company" type="text" name="company" autocomplete="organization" maxlength={LIMITS.company} />
              </div>
              <div class="input">
                <label class="input__label" for="ct-phone">Phone</label>
                <input class="input__control" id="ct-phone" type="tel" name="phone" autocomplete="tel" maxlength={LIMITS.phone} pattern="[+()0-9 .\-]{7,30}" aria-describedby="err-phone" />
                <span class="input__error" id="err-phone" data-error="phone">Please use digits, spaces and + ( ) - only.</span>
              </div>
              <div class="input">
                <label class="input__label" for="ct-service">What do you need? *</label>
                <select class="input__control" id="ct-service" name="service" required aria-describedby="err-service">
                  <option value="" disabled selected>Choose one</option>
                  {SERVICE_OPTIONS.map((o) => <option value={o}>{o}</option>)}
                </select>
                <span class="input__error" id="err-service" data-error="service">Please choose what you need help with.</span>
              </div>
              <div class="input">
                <label class="input__label" for="ct-team">Team size</label>
                <select class="input__control" id="ct-team" name="teamSize">
                  <option value="" selected>Not sure yet</option>
                  {TEAM_SIZES.map((o) => <option value={o}>{o}</option>)}
                </select>
              </div>
              <div class="input form__full">
                <label class="input__label" for="ct-message">What would you like to hand off? *</label>
                <textarea
                  class="input__control"
                  id="ct-message"
                  name="message"
                  required
                  minlength={LIMITS.messageMin}
                  maxlength={LIMITS.message}
                  rows="6"
                  aria-describedby="hint-message err-message"></textarea>
                <span class="input__hint" id="hint-message">The tasks, the tools you use and the hours you need covered.</span>
                <span class="input__error" id="err-message" data-error="message">A sentence or two helps us prepare: at least {LIMITS.messageMin} characters.</span>
              </div>
            </div>

            <div class="form__trap" aria-hidden="true">
              <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
            </div>
            <input type="hidden" name="elapsedMs" value="0" data-elapsed />

            <div class="input form__consent-wrap">
              <label class="check form__consent">
                <input type="checkbox" name="consent" required aria-describedby="err-consent" />
                <span>I agree that Akrostech may contact me about this enquiry, as described in the <a class="link" href="/privacy">privacy policy</a>. *</span>
              </label>
              <span class="input__error form__consent-error" id="err-consent" data-error="consent">Please confirm we may contact you about this enquiry.</span>
            </div>

            <div class="form__actions">
              <button class="btn btn--primary form__submit" type="submit" data-submit>
                <span data-submit-label>Send enquiry</span>
                <Icon name="arrow-up-right" class="btn__arrow" />
              </button>
              <p class="form__alt small">or email <a class="link" href={`mailto:${site.email}`}>{site.email}</a></p>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- Pick a time: the call week instrument -->
  <section class="section section--flush-top" aria-labelledby="book-title">
    <div class="wrap">
      <div class="book panel">
        <div class="book__copy">
          <h2 class="h2" id="book-title" data-split>Prefer to talk? Pick a time that suits both sides.</h2>
          <p class="book__lead">
            A 30-minute call with your account manager. Choose your time zone, pick an hour inside our office hours, and see the same moment in
            Wilmington and in India.
          </p>
          <ul class="ticks" role="list">
            {['The roles or tasks you want covered', 'How your hours and tools line up with ours', 'A clear next step, with no obligation'].map((t) => <li>{t}</li>)}
          </ul>
          <Photo name="two-women-laptop" ratio="4 / 3" sizes="(min-width: 64rem) 30vw, 100vw" reveal="clip" class="book__photo" />
        </div>
        <div class="book__week"><CallWeek /></div>
      </div>
    </div>
  </section>

  <!-- Office and coverage -->
  <section class="section" aria-labelledby="where-title">
    <div class="wrap">
      <div class="section-head grid">
        <h2 class="h2" id="where-title" data-split>Headquartered in Delaware. Delivering from India. Working your hours.</h2>
        <p data-reveal>Visits to Wilmington are by appointment. Your team works the U.S. hours you choose.</p>
      </div>
      <div class="where">
        <div class="where__map" data-map>
          <iframe
            title={`Map showing ${site.name} at ${fullAddress}`}
            src={mapsEmbedUrl}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
            width="800"
            height="600"></iframe>
        </div>
        <div class="where__hq panel">
          <h3 class="where__title"><Icon name="pin" /> U.S. headquarters</h3>
          <address class="where__addr">
            {site.legalName}<br />{site.address.street}<br />{site.address.locality}, {site.address.region} {site.address.postalCode}
          </address>
          <dl class="spec where__spec">
            <div><dt>By road</dt><dd>I-95, exit 7, then Delaware Avenue (DE-52)</dd></div>
            <div><dt>By rail</dt><dd>Wilmington Amtrak station</dd></div>
            <div><dt>Visits</dt><dd>By appointment, {site.hoursLabel}</dd></div>
          </dl>
          <div class="actions">
            <a class="btn btn--primary btn--small" href={mapsDirectionsUrl} target="_blank" rel="noopener">Get directions <Icon name="route" class="btn__arrow" /></a>
            <a class="btn btn--ghost btn--small" href={mapsPlaceUrl} target="_blank" rel="noopener">Open in Google Maps <Icon name="arrow-up-right" class="btn__arrow" /></a>
          </div>
        </div>
        <div class="where__hours panel">
          <h3 class="where__title"><Icon name="clock" /> Hours we cover</h3>
          <table class="where__table">
            <caption class="sr-only">U.S. time zones our teams cover</caption>
            <tbody>
              {
                hubs.map((h) => (
                  <tr>
                    <th scope="row">{h.zone}</th>
                    <td class="muted">{h.city}</td>
                    <td>Your 9–6</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
          <p class="small muted">Office in Wilmington: {site.hoursLabel}. Closed weekends.</p>
        </div>
        <div class="where__photo">
          <Photo name="office-hallway" fill sizes="(min-width: 64rem) 25vw, 100vw" />
        </div>
        <div class="where__direct lime">
          <h3 class="where__title">Direct lines</h3>
          <ul role="list" class="where__routes">
            <li><a class="where__route" href={`tel:${site.phoneE164}`}><Icon name="phone" /> {site.phone}</a></li>
            <li><a class="where__route" href={`mailto:${site.email}`}><Icon name="mail" /> {site.email}</a></li>
            <li><a class="where__route" href={site.socials.linkedin} target="_blank" rel="noopener"><Icon name="linkedin" /> LinkedIn</a></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <Faq faqs={faqs} name="contact" heading="Before you reach out." intro="How fast we reply, what the call covers and what to prepare." />
</BaseLayout>

<script>
  import { validateContact, type ContactField } from '@/lib/contact';
  import { formatClock, wallClock } from '@/lib/time';

  // Live open/closed status from the office hours (Eastern Time).
  const status = document.querySelector<HTMLElement>('[data-open-status]');
  if (status) {
    const w = wallClock('America/New_York', new Date());
    const minutes = w.hour * 60 + w.minute;
    const open = w.weekday >= 1 && w.weekday <= 5 && minutes >= 9 * 60 && minutes < 18 * 60;
    status.classList.toggle('is-off', !open);
    const text = status.querySelector('[data-open-text]');
    if (text) text.textContent = open ? 'Open now in Wilmington' : 'Closed now: we reply next business morning';
  }

  // Two clocks: Wilmington and the delivery team in India, refreshed each minute.
  const clocks = document.querySelector<HTMLElement>('[data-clocks]');
  if (clocks) {
    const paint = () => clocks.querySelectorAll<HTMLElement>('[data-clock]').forEach((el) => (el.textContent = formatClock(new Date(), el.dataset.clock ?? 'UTC')));
    paint();
    clocks.hidden = false;
    setInterval(paint, 30_000);
  }

  // Map frame: a plate until the iframe has loaded.
  document.querySelectorAll<HTMLElement>('[data-map]').forEach((wrap) => {
    wrap.querySelector('iframe')?.addEventListener('load', () => wrap.classList.add('is-loaded'), { once: true });
  });

  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const success = document.querySelector<HTMLElement>('[data-form-success]');
  const errorBox = document.querySelector<HTMLElement>('[data-form-error]');
  const errorText = document.querySelector<HTMLElement>('[data-form-error-text]');
  const submit = form?.querySelector<HTMLButtonElement>('[data-submit]');
  const label = form?.querySelector<HTMLElement>('[data-submit-label]');
  const elapsed = form?.querySelector<HTMLInputElement>('[data-elapsed]');

  if (form && success && errorBox && errorText && submit && label && elapsed) {
    const started = Date.now();

    // Status from a no-JS round trip.
    const params = new URL(location.href).searchParams;
    if (params.get('sent') === '1') success.hidden = false;
    if (params.get('error')) {
      errorText.textContent = 'We could not send that. Please check the fields and try again, or email us directly.';
      errorBox.hidden = false;
    }
    // Preselect the service when arriving from a service page (?service=website-development or ?service=Website%20development).
    const slugs: Record<string, string> = {
      'virtual-assistance': 'Virtual assistance',
      recruitment: 'Recruitment process outsourcing',
      accounting: 'Accounting assistance',
      legal: 'Legal process outsourcing',
      'website-development': 'Website development',
    };
    const wantedRaw = params.get('service');
    const wanted = wantedRaw ? (slugs[wantedRaw] ?? wantedRaw) : null;
    const select = form.querySelector<HTMLSelectElement>('select[name="service"]');
    if (wanted && select) {
      const match = [...select.options].find((o) => o.value.toLowerCase() === wanted.toLowerCase());
      if (match) select.value = match.value;
    }
    // Arriving from an engagement model: start the message with it.
    const model = params.get('model');
    const message = form.querySelector<HTMLTextAreaElement>('textarea[name="message"]');
    if (model && message && !message.value) message.value = `I’m interested in the ${model.slice(0, 60)} model. `;

    // Proposal readiness: the five things we need to send a proposal.
    const readyCount = document.querySelector<HTMLElement>('[data-ready-count]');
    const readyBar = document.querySelector<HTMLElement>('[data-ready-bar]');
    const readiness = () => {
      const v = (n: string) => (form.querySelector<HTMLInputElement>(`[name="${n}"]`)?.value ?? '').trim();
      const checks = [
        v('name').length > 1,
        /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v('email')),
        v('service') !== '',
        v('message').length >= 20,
        Boolean(form.querySelector<HTMLInputElement>('[name="consent"]')?.checked),
      ];
      const n = checks.filter(Boolean).length;
      if (readyCount) readyCount.textContent = String(n);
      if (readyBar) {
        readyBar.setAttribute('aria-valuenow', String(n));
        readyBar.style.setProperty('--ready', String(n / checks.length));
      }
    };
    form.addEventListener('input', readiness);
    form.addEventListener('change', readiness);
    readiness();

    const control = (name: string) => form.querySelector<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>(`[name="${name}"]`);
    const showErrors = (errors: Partial<Record<ContactField, string>>) => {
      form.querySelectorAll<HTMLElement>('[data-error]').forEach((el) => {
        const field = el.dataset.error as ContactField;
        const msg = errors[field];
        const input = control(field);
        if (msg) el.textContent = msg;
        input?.setAttribute('aria-invalid', msg ? 'true' : 'false');
        input?.closest('.input')?.classList.toggle('is-invalid', Boolean(msg));
        el.classList.toggle('is-shown', Boolean(msg));
      });
    };

    // Keep aria-invalid (and the field's error state) in sync with :user-invalid as people move through the form.
    form.addEventListener('focusout', (e) => {
      const el = e.target as HTMLInputElement;
      if (el.matches?.('.input__control, input[type="checkbox"]')) {
        const invalid = el.matches(':user-invalid');
        el.setAttribute('aria-invalid', String(invalid));
        el.closest('.input')?.classList.toggle('is-invalid', invalid);
      }
    });
    // Clear a field's error as soon as it becomes valid.
    form.addEventListener('input', (e) => {
      const el = e.target as HTMLInputElement;
      const wrap = el.closest?.('.input');
      if (wrap?.classList.contains('is-invalid') && el.checkValidity()) {
        wrap.classList.remove('is-invalid');
        el.setAttribute('aria-invalid', 'false');
        wrap.querySelector('[data-error]')?.classList.remove('is-shown');
      }
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      success.hidden = true;
      errorBox.hidden = true;
      elapsed.value = String(Date.now() - started);
      const data = Object.fromEntries(new FormData(form)) as Record<string, unknown>;
      data.consent = (form.querySelector('[name="consent"]') as HTMLInputElement).checked;

      const check = validateContact(data);
      if (!check.ok) {
        showErrors(check.errors);
        const first = Object.keys(check.errors)[0];
        if (first) control(first)?.focus();
        return;
      }
      showErrors({});

      submit.disabled = true;
      submit.setAttribute('aria-busy', 'true');
      form.setAttribute('aria-busy', 'true');
      label.textContent = 'Sending…';
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(data),
        });
        const body = (await res.json().catch(() => ({}))) as { ok?: boolean; message?: string; errors?: Partial<Record<ContactField, string>> };
        if (res.ok && body.ok) {
          form.reset();
          readiness();
          const text = success.querySelector('[data-form-success-text]');
          if (text) text.textContent = body.message ?? 'Thanks. We will be in touch.';
          success.hidden = false;
          success.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'center' });
          success.focus?.({ preventScroll: true });
        } else {
          if (body.errors) showErrors(body.errors);
          errorText.textContent = body.message ?? 'Something went wrong. Please try again or email us directly.';
          errorBox.hidden = false;
        }
      } catch {
        errorText.textContent = 'We could not reach the server. Check your connection, or email contact@akrostech.info.';
        errorBox.hidden = false;
      } finally {
        submit.disabled = false;
        submit.removeAttribute('aria-busy');
        form.removeAttribute('aria-busy');
        label.textContent = 'Send enquiry';
      }
    });
  }
</script>

<style>
  /* ---- Hero: channels and availability ---- */
  .reach { display: grid; gap: var(--s-4); }
  @media (min-width: 64rem) { .reach { grid-template-columns: minmax(0, 3fr) minmax(0, 1fr); } }
  .reach__channels { display: grid; gap: var(--s-4); }
  @media (min-width: 48rem) { .reach__channels { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .reach__card {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: var(--s-4);
    align-items: start;
    height: 100%;
    padding: var(--s-5);
    border-radius: var(--radius);
    background: var(--plate);
    border: 1px solid var(--rule);
    text-decoration: none;
    transition: border-color var(--t-ui) ease, transform var(--t-press) var(--ease-out);
  }
  .reach__card:active { transform: scale(0.98); }
  .reach__icon { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: 50%; background: var(--plate-2); }
  .reach__text { display: grid; gap: 0.15rem; min-width: 0; }
