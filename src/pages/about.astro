---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Media from '@/components/Media.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import { site, fullAddress } from '@/config/site';
import { pages } from '@/data/pages';
import { mission, vision, values, story, teamRoles, vetting } from '@/data/company';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'About', path: '/about' },
];
const storyArt = ['about-va', 'about-rpo', 'about-accounting', 'about-web'];

const year = [
  { when: 'Day 0', title: 'Discovery call', body: 'Thirty minutes to list the work, the tools, the hours and what good looks like.' },
  { when: 'Day 1', title: 'Shortlist', body: 'Two or three vetted professionals with relevant samples. You choose, or ask to meet more.' },
  { when: 'Day 2', title: 'First tasks closed', body: 'Access set up with named accounts, an NDA signed and the first recurring tasks done.' },
  { when: 'Week 1', title: 'Procedures written', body: 'Every task handed over becomes a written procedure that you approve and own.' },
  { when: 'Month 1', title: 'First review', body: 'Your client partner reviews quality, turnaround and scope with you, and agrees what to add next.' },
  { when: 'Quarter 1', title: 'A whole function', body: 'Most specialists own a complete function by now: the inbox, the close, the pipeline or the backlog.' },
  { when: 'Year 1', title: 'A team', body: 'Many clients add a second practice, or grow one specialist into a pod with its own lead.' },
];
---

<BaseLayout {...pages.about} image="/og/about.png" breadcrumbs={crumbs} webPage={{ '@type': ['WebPage', 'AboutPage'] }}>
  <PageHero
    title={['Offshore teams,', 'onshore standard.']}
    lede="Akrostech places vetted professionals in India on U.S. working hours, from our headquarters in Wilmington, Delaware. We exist so growing companies can add capacity without lowering the bar."
    crumbs={crumbs}
  />

  <!-- Scroll-driven story -->
  <section class="story" aria-labelledby="story-title" data-story>
    <div class="story__inner wrap">
      <div class="story__sticky" aria-hidden="true">
        <div class="story__frames">
          {
            storyArt.map((id, i) => (
              <div class="story__frame" data-frame={i}>
                <Media id={id} alt="" ratio="4 / 5" sizes="(min-width: 1024px) 40vw, 90vw" widths={[480, 800, 1200]} />
              </div>
            ))
          }
        </div>
      </div>
      <div class="story__chapters">
        <h2 class="sr-only" id="story-title">Our story</h2>
        {
          story.map((c, i) => (
            <article class="story__chapter" data-chapter={i}>
              <p class="story__when">{c.when}</p>
              <h3 class="story__title">{c.title}</h3>
              <p class="story__body">{c.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Mission and vision -->
  <section class="mv" aria-labelledby="mission-title">
    <div class="wrap mv__grid">
      <div class="mv__block">
        <h2 class="mv__label" id="mission-title">Mission</h2>
        <p class="mv__text" data-reveal>{mission}</p>
      </div>
      <div class="mv__block mv__block--vision">
        <h2 class="mv__label">Vision</h2>
        <p class="mv__text mv__text--small" data-reveal>{vision}</p>
      </div>
    </div>
  </section>

  <!-- Values as poster lines -->
  <section class="values section" aria-labelledby="values-title">
    <div class="wrap">
      <h2 class="h2 values__title" id="values-title" data-split>What we hold to.</h2>
      <ul class="values__list" role="list">
        {
          values.map((v) => (
            <li class="values__item" data-reveal>
              <h3 class="values__name">{v.title}</h3>
              <p class="values__body">{v.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Vetting -->
  <section class="vetting section" aria-labelledby="vetting-title">
    <div class="wrap vetting__grid">
      <div class="vetting__head">
        <h2 class="h2" id="vetting-title" data-split>Five checks before you meet anyone.</h2>
        <p class="vetting__intro" data-reveal>
          Most candidates do not make it through. The ones who do have passed a skills test, a language assessment, a background check, a paid work
          sample and an interview about judgment.
        </p>
      </div>
      <ol class="vetting__steps" role="list" data-reveal-group>
        {
          vetting.map((v, i) => (
            <li class="vetting__step" data-reveal>
              <span class="vetting__bar" style={`--w:${100 - i * 16}%`} aria-hidden="true" />
              <h3 class="vetting__name">{v.title}</h3>
              <p class="vetting__body">{v.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Team -->
  <section class="team section" aria-labelledby="team-title">
    <div class="wrap">
      <div class="team__head">
        <h2 class="h1" id="team-title" data-split>The people on your account.</h2>
        <p data-reveal>
          Every engagement has the same four roles. You always know who owns the relationship, who owns the quality and who does the work.
        </p>
      </div>
      <ul class="team__grid" role="list" data-reveal-group>
        {
          teamRoles.map((r, i) => (
            <li class="team__card" data-reveal data-tilt="4">
              <span class="team__index" aria-hidden="true">
                <svg viewBox="0 0 96 24" class="team__band">
                  {Array.from({ length: 12 }, (_, c) => (
                    <rect x={c * 8} y="0" width="7" height="24" class:list={{ on: c <= i * 3 + 2 }} />
                  ))}
                </svg>
              </span>
              <h3 class="team__role">{r.role}</h3>
              <p class="team__where">{r.practice}</p>
              <p class="team__body">{r.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- First-year timeline -->
  <section class="year section" aria-labelledby="year-title" data-timeline>
    <div class="wrap year__grid">
      <div class="year__head">
        <h2 class="h2" id="year-title" data-split>How an engagement grows.</h2>
        <p data-reveal>From a first call to a team, the same steps every time.</p>
      </div>
      <div class="year__track">
        <div class="year__rail" aria-hidden="true"><span data-timeline-line></span></div>
        <ol class="year__list" role="list">
          {
            year.map((y) => (
              <li class="year__item" data-timeline-step>
                <p class="year__when">{y.when}</p>
                <div>
                  <h3 class="year__title">{y.title}</h3>
                  <p class="year__body">{y.body}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- Locations -->
  <section class="places wrap section" aria-labelledby="places-title">
    <h2 class="sr-only" id="places-title">Where we are</h2>
    <div class="places__item" data-reveal>
      <p class="places__label">Headquarters</p>
      <p class="places__name">Wilmington, Delaware</p>
      <p class="places__body">{fullAddress}. Client partners, contracts and billing. Visits by appointment, {site.hoursLabel}.</p>
      <a class="arrow-link" href="/locations/wilmington-de">Wilmington service area <Icon name="arrow-up-right" /></a>
    </div>
    <div class="places__item" data-reveal>
      <p class="places__label">Delivery</p>
      <p class="places__name">India</p>
      <p class="places__body">Specialists and team leads working fixed shifts on Eastern, Central, Mountain or Pacific time.</p>
      <a class="arrow-link" href="/contact">Talk to a client partner <Icon name="arrow-up-right" /></a>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<script>
  // Story: swap the sticky frame as chapters cross the middle of the viewport.
  document.querySelectorAll<HTMLElement>('[data-story]').forEach((root) => {
    const frames = root.querySelectorAll<HTMLElement>('[data-frame]');
    const chapters = root.querySelectorAll<HTMLElement>('[data-chapter]');
    const set = (i: number) => {
      root.dataset.active = String(i);
      frames.forEach((f) => f.classList.toggle('is-active', Number(f.dataset.frame) === Math.min(i, frames.length - 1)));
      chapters.forEach((c) => c.classList.toggle('is-active', Number(c.dataset.chapter) === i));
    };
    set(0);
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => e.isIntersecting && set(Number((e.target as HTMLElement).dataset.chapter))),
      { rootMargin: '-45% 0px -45% 0px' },
    );
    chapters.forEach((c) => io.observe(c));
  });
</script>

<style>
  /* Story */
  .story { padding-block: var(--space-2xl) var(--section-gap); }
  .story__inner { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: var(--gutter) clamp(2rem, 8vw, 9rem); }
  .story__sticky { position: sticky; top: calc(var(--header-h) + 2rem); align-self: start; }
  .story__frames { display: grid; }
  .story__frame { grid-area: 1 / 1; opacity: 0; scale: 1.03; transition: opacity 700ms var(--ease-out), scale 1100ms var(--ease-out); }
  .story__frame.is-active { opacity: 1; scale: 1; }
  :global(html:not(.js)) .story__frame:first-child { opacity: 1; }
  .story__chapters { display: grid; gap: 30svh; padding-block: 10svh 30svh; }
  .story__chapter { --ch-ink: var(--muted); transition: translate 600ms var(--ease-out); }
  .story__chapter.is-active { --ch-ink: var(--ink-strong); translate: 0.5rem 0; }
  .story__chapter .story__title { color: var(--ch-ink); transition: color 600ms var(--ease-out); }
  :global(html:not(.js)) .story__chapter { --ch-ink: var(--ink-strong); }
  .story__when { font-weight: 600; color: var(--accent-text); margin-bottom: var(--space-xs); }
  .story__title { font-family: var(--font-display); font-size: var(--step-2); font-weight: 600; line-height: 1.04; letter-spacing: -0.035em; color: var(--ink-strong); }
  .story__body { margin-top: var(--space-m); max-width: 46ch; font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem); }
  @media (max-width: 1023px) {
    .story__inner { grid-template-columns: 1fr; }
    .story__sticky { position: relative; top: 0; max-width: 26rem; }
    .story__chapters { gap: var(--space-2xl); padding-block: var(--space-xl) 0; }
    .story__chapter { --ch-ink: var(--ink-strong); }
  }

  /* Mission and vision */
  .mv { background: var(--field); color: var(--field-ink); padding-block: var(--section-gap); }
  .mv__grid { display: grid; gap: var(--space-2xl); }
  .mv__label { font-family: var(--font-text); font-size: var(--step-0); font-weight: 600; color: var(--field-muted); margin-bottom: var(--space-m); }
  .mv__text { font-family: var(--font-display); font-size: clamp(1.75rem, 0.9rem + 3vw, 3.75rem); font-weight: 600; line-height: 1.04; letter-spacing: -0.04em; max-width: 26ch; }
  .mv__block--vision { justify-self: end; max-width: 40rem; }
  .mv__text--small { font-size: clamp(1.375rem, 1rem + 1.4vw, 2.25rem); line-height: 1.15; font-weight: 500; letter-spacing: -0.025em; }

  /* Values */
  .values__title { margin-bottom: var(--space-2xl); }
  .values__list { display: grid; }
  .values__item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 26rem);
    align-items: baseline;
    gap: var(--space-s) var(--gutter);
    padding-block: clamp(0.75rem, 1.5vw, 1.25rem);
  }
  .values__name {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 0.8rem + 5.6vw, 7rem);
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.05em;
    color: var(--ink-strong);
    transition: color var(--dur-base) var(--ease-out), translate var(--dur-slow) var(--ease-out);
  }
  .values__item:hover .values__name { color: var(--accent-text); translate: 0.08em 0; }
  .values__body { color: var(--ink); }
  @media (max-width: 1023px) {
    .values__item { grid-template-columns: 1fr; }
  }

  /* Vetting */
  .vetting { background: var(--surface); }
  .vetting__grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--space-2xl) var(--gutter); }
  .vetting__head { position: sticky; top: calc(var(--header-h) + 2rem); align-self: start; }
  .vetting__intro { margin-top: var(--space-m); max-width: 40ch; }
  .vetting__steps { display: grid; gap: var(--space-l); }
  .vetting__bar { display: block; width: var(--w); height: 0.75rem; background: var(--accent); margin-bottom: var(--space-s); }
  .vetting__name { font-family: var(--font-display); font-size: var(--step-1); font-weight: 600; letter-spacing: -0.02em; color: var(--ink-strong); }
  .vetting__body { margin-top: 0.4rem; max-width: 52ch; }
  @media (max-width: 1023px) {
    .vetting__grid { grid-template-columns: 1fr; }
    .vetting__head { position: static; }
  }

  /* Team */
  .team__head { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--space-m) var(--gutter); align-items: end; margin-bottom: var(--space-2xl); }
  .team__head h2 { grid-column: 1 / span 7; }
  .team__head p { grid-column: 9 / -1; }
  .team__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--gutter); }
  .team__card { display: grid; align-content: start; gap: 0.5rem; padding: clamp(1.25rem, 2vw, 1.75rem); background: var(--bg-raised); min-height: 20rem; transform-style: preserve-3d; }
  .team__band { width: 6rem; height: 1.5rem; margin-bottom: auto; }
  .team__band rect { fill: var(--surface-strong); }
  .team__band rect.on { fill: var(--accent); }
  .team__role { margin-top: var(--space-2xl); font-family: var(--font-display); font-size: var(--step-1); font-weight: 600; letter-spacing: -0.02em; color: var(--ink-strong); }
  .team__where { font-size: var(--step--1); color: var(--muted); }
  .team__body { margin-top: 0.4rem; }
  @media (max-width: 1023px) {
    .team__head h2, .team__head p { grid-column: 1 / -1; }
    .team__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 599px) {
    .team__grid { grid-template-columns: 1fr; }
    .team__card { min-height: auto; }
  }

  /* Year timeline */
  .year { background: var(--inverse); color: var(--inverse-ink); }
  .year__grid { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: var(--space-2xl) var(--gutter); }
  .year__head { position: sticky; top: calc(var(--header-h) + 2rem); align-self: start; }
  .year__head .h2 { color: var(--inverse-ink); }
  .year__head p { margin-top: var(--space-m); color: var(--inverse-muted); }
  .year__track { position: relative; padding-left: clamp(1.5rem, 3vw, 3rem); }
  .year__rail { position: absolute; left: 0; top: 0.6rem; bottom: 0.6rem; width: 3px; background: light-dark(var(--char-700), var(--sand-400)); }
  .year__rail span { display: block; width: 100%; height: 100%; background: var(--inverse-accent); transform-origin: 50% 0; }
  .year__list { display: grid; gap: var(--space-xl); }
  .year__item { display: grid; grid-template-columns: 7rem minmax(0, 1fr); gap: var(--gutter); transition: translate 500ms var(--ease-out); }
  .year__item:global(.is-active) { translate: 0.5rem 0; }
  .year__when { font-weight: 600; color: var(--inverse-accent); }
  .year__title { font-family: var(--font-display); font-size: var(--step-1); font-weight: 600; letter-spacing: -0.02em; }
  .year__body { margin-top: 0.35rem; color: var(--inverse-muted); max-width: 50ch; }
  @media (max-width: 1023px) {
    .year__grid { grid-template-columns: 1fr; }
    .year__head { position: static; }
    .year__item { grid-template-columns: 1fr; gap: 0.25rem; }
  }

  /* Places */
  .places { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-2xl) var(--gutter); }
  .places__label { font-weight: 600; color: var(--muted); }
  .places__name { font-family: var(--font-display); font-size: var(--step-3); font-weight: 600; line-height: 0.95; letter-spacing: -0.05em; color: var(--ink-strong); margin-block: var(--space-xs) var(--space-m); }
  .places__body { max-width: 40ch; margin-bottom: var(--space-s); }
  @media (max-width: 767px) {
    .places { grid-template-columns: 1fr; }
  }
</style>
