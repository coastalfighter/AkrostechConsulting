---
/**
 * About, in the Sample-3 order: who we are, the mission, three things that keep quality
 * consistent, five vetting filters, the team behind every client (with the org chain
 * instrument, key `org`), the figures, what we stand for, contact. The hero carries the
 * network field.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import FieldHero from '@/components/FieldHero.astro';
import OrgChain from '@/components/instruments/OrgChain.astro';
import Photo from '@/components/Photo.astro';
import type { PhotoName } from '@/components/Photo.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import { site } from '@/config/site';
import { pages } from '@/data/pages';
import { mission, pillars, teamStructure, values, vettingStages } from '@/data/about';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'About', path: '/about' },
];
const f = site.figures;
const stats = [
  { value: f.professionals, suffix: '+', label: 'Vetted professionals' },
  { value: f.projects, suffix: '+', label: 'Projects running' },
  { value: f.accuracy, suffix: '%', label: 'Task accuracy rate' },
  { value: f.onboardingHours, suffix: 'h', label: 'Onboarding time' },
];

/** The three layers of every Akrostech team, one stock portrait per role (not our staff). */
const roster: { role: string; note: string; photo: PhotoName }[] = [
  { role: teamStructure[0].role, note: 'Your single point of contact', photo: 'people-virtual-assistants' },
  { role: teamStructure[1].role, note: 'Daily QA and coaching', photo: 'people-recruiters' },
  { role: 'Specialists', note: 'VA, RPO, accounting, legal, web', photo: 'people-developers' },
];
/** Each vetting filter passes fewer people than the one before it: bar heights narrow. */
const narrowing = [100, 78, 58, 40, 24];
const { address } = site;
---

<BaseLayout {...pages.about} image="/og/about.png" breadcrumbs={crumbs} webPage={{ '@type': ['WebPage', 'AboutPage'] }}>
  <FieldHero scene="network" labelledby="about-title" crumbs={crumbs}>
    <h1 class="fhero__title" id="about-title">Global teams. <span class="quiet">Local impact.</span></h1>
    <p class="fhero__lead">
      Akrostech specializes in recruitment, virtual assistance, accounting, legal support and now website development. We help startups and enterprises
      scale while keeping quality, compliance and flexibility at the center.
    </p>
    <div class="actions">
      <a class="btn btn--primary" href="/services">Explore services <Icon name="arrow-right" class="btn__arrow btn__arrow--right" /></a>
      <a class="btn btn--ghost" href={site.calendly} target="_blank" rel="noopener">Book a call <Icon name="calendar" class="btn__arrow" /></a>
    </div>
    <figure slot="after" class="roster">
      <ul class="roster__list" role="list">
        {
          roster.map((m, i) => (
            <li class:list={['roster__item', `roster__item--${i}`]}>
              <Photo name={m.photo} alt="" ratio="4 / 5" sizes="(min-width: 64rem) 28vw, 33vw" />
              <p class="roster__role">{m.role}</p>
              <p class="small muted">{m.note}</p>
            </li>
          ))
        }
      </ul>
      <figcaption class="small muted roster__cap">Every client gets all three layers. Representative stock photography.</figcaption>
    </figure>
  </FieldHero>

  <!-- Mission: a lavender field with a photograph -->
  <section class="section section--flush-top" aria-labelledby="mission-title">
    <div class="wrap grid mission">
      <div class="mission__field violet c-8">
        <div class="mission__key">
          <h2 class="mission__title" id="mission-title">Our mission</h2>
          <p class="small">Why the name: akros (ἄκρος) is Greek for summit.</p>
        </div>
        <blockquote class="mission__quote" data-reveal>
          <p>{mission}</p>
        </blockquote>
      </div>
      <div class="mission__photo c-4">
        <Photo name="meeting-presentation" fill sizes="(min-width: 64rem) 30vw, 100vw" focal="50% 40%" reveal="clip" />
      </div>
    </div>
  </section>

  <!-- Three pillars as ruled poster lines -->
  <section class="section" aria-labelledby="model-title">
    <div class="wrap">
      <div class="section-head grid">
        <h2 class="h2" id="model-title" data-split>Three things that keep quality consistent.</h2>
        <p data-reveal>The same framework, a playbook you own, and a lead behind every specialist. On every engagement, in every practice.</p>
      </div>
      <ul class="pillars" role="list" data-reveal-group>
        {
          pillars.map((p) => (
            <li class="pillar grid" data-reveal>
              <h3 class="pillar__title c-4">{p.title}</h3>
              <p class="pillar__summary c-3">{p.summary}</p>
              <p class="pillar__detail muted c-4 s-9">{p.detail}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Vetting: five narrowing filters on an ink panel -->
  <section class="section section--flush-top" aria-labelledby="vetting-title">
    <div class="wrap">
      <div class="vet ink-plate">
        <div class="vet__head">
          <h2 class="h2" id="vetting-title" data-split>Five filters before anyone meets you.</h2>
          <p class="vet__lead">Every professional in our network of {f.professionals}+ is vetted for domain expertise, communication and reliability.</p>
        </div>
        <ol class="vet__stages" role="list" data-reveal-group>
          {
            vettingStages.map((v, i) => (
              <li class:list={['vet__stage', { 'vet__stage--last': i === vettingStages.length - 1 }]} data-reveal>
                <span class="vet__bar" style={`--h:${narrowing[i]}%`} aria-hidden="true" />
                <h3 class="vet__name">{v.title}</h3>
                <p class="small muted">{v.detail}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- Team structure, with the org chain instrument -->
  <section class="section" aria-labelledby="structure-title">
    <div class="wrap grid team">
      <div class="team__intro c-4">
        <h2 class="h2" id="structure-title" data-split>One dedicated professional. A whole team behind them.</h2>
        <p class="team__lead" data-reveal>Every specialist works inside a small team with a lead who reviews their work daily.</p>
        <ol class="team__levels" role="list">
          {
            teamStructure.map((t) => (
              <li>
                <strong>{t.role}</strong>
                <span class="muted">{t.description}</span>
              </li>
            ))
          }
        </ol>
        <Photo name="svc-virtual-assistance-work" ratio="16 / 10" sizes="(min-width: 64rem) 30vw, 100vw" reveal="clip" />
      </div>
      <div class="team__instrument c-8">
        <div class="team__instrument-head">
          <h3 class="h3">Who owns what, and who covers when someone is out.</h3>
          <p class="muted small">Pick a role to see what it owns. Then switch a specialist out for the day and watch the bench step in.</p>
        </div>
        <OrgChain />
      </div>
    </div>
  </section>

  <!-- Figures under a wide photograph -->
  <section class="section section--flush-top" aria-labelledby="figures-title">
    <div class="wrap">
      <h2 class="sr-only" id="figures-title">Akrostech by the numbers</h2>
      <div class="figs">
        <Photo name="office-lounge" ratio="21 / 9" sizes="100vw" focal="50% 60%" reveal="clip" class="figs__photo" />
        <dl class="figs__list" data-reveal-group>
          {
            stats.map((s) => (
              <div class="figs__item" data-reveal>
                <dt>{s.label}</dt>
                <dd class="figure"><span data-count>{s.value}</span>{s.suffix}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <!-- Values, with the two ends of the team -->
  <section class="section" aria-labelledby="values-title">
    <div class="wrap">
      <div class="section-head grid">
        <h2 class="h2" id="values-title" data-split>What we stand for.</h2>
        <p data-reveal>Four commitments that decide how the work is done, whatever the practice.</p>
      </div>
      <div class="vals" data-reveal-group>
        {
          values.map((v, i) => (
            <div class:list={['vals__cell', `vals__cell--${i}`, i === 0 ? 'lime' : 'panel']} data-reveal>
              <h3 class="h3">{v.title}</h3>
              <p class={i === 0 ? undefined : 'muted'}>{v.description}</p>
            </div>
          ))
        }
        <div class="vals__photo" data-reveal>
          <Photo name="team-table" fill sizes="(min-width: 64rem) 25vw, 100vw" />
        </div>
        <div class="vals__base ink-plate" data-reveal>
          <div class="vals__ends">
            <div>
              <p class="small muted">Headquarters</p>
              <p class="vals__place">Wilmington, Delaware</p>
              <address class="small muted">{address.street}, {address.locality}, {address.region} {address.postalCode}</address>
            </div>
            <span class="vals__link" aria-hidden="true"><span></span></span>
            <div>
              <p class="small muted">Delivery</p>
              <p class="vals__place">Teams in India</p>
              <p class="small muted">On your U.S. hours: EST, CST, MST or PST</p>
            </div>
          </div>
          <a class="more" href="/contact">Visit or get in touch <Icon name="arrow-right" /></a>
        </div>
      </div>
    </div>
  </section>

  <CtaBand photo="team-laptops" />
</BaseLayout>

<style>
  /* ---- Hero roster ---- */
  .roster { display: grid; gap: var(--s-5); }
  .roster__list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gutter); }
  .roster__item { display: grid; gap: var(--s-1); align-content: start; }
  .roster__item :global(.photo) { margin-bottom: var(--s-3); }
  @media (min-width: 64rem) { .roster__item--1 { translate: 0 var(--s-7); } .roster__cap { margin-top: var(--s-7); } }
  .roster__role { font-family: var(--font-display); font-weight: 700; font-size: clamp(1.05rem, 0.9rem + 0.6vw, 1.5rem); line-height: 1.15; letter-spacing: -0.02em; }

  /* ---- Mission ---- */
  .mission { row-gap: var(--s-4); }
  .mission__field { display: grid; gap: var(--s-7); padding: clamp(1.5rem, 1rem + 3vw, 4rem); border-radius: calc(var(--radius) * 1.6); }
  .mission__key { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--s-2) var(--s-5); align-items: baseline; padding-bottom: var(--s-4); border-bottom: 1px solid var(--rule-strong); }
  .mission__title { font-size: 1.25rem; letter-spacing: -0.01em; }
  .mission__quote p { font-family: var(--font-display); font-size: clamp(1.6rem, 1.1rem + 1.9vw, 3rem); font-weight: 600; line-height: 1.15; letter-spacing: -0.025em; max-width: 26ch; }
  .mission__photo { min-height: 18rem; }

  /* ---- Pillars ---- */
  .pillars { border-top: 1px solid var(--rule-strong); }
  .pillar { row-gap: var(--s-3); padding-block: var(--s-6); border-bottom: 1px solid var(--rule); align-items: baseline; }
  .pillar__title { font-size: clamp(1.75rem, 1.2rem + 1.8vw, 2.75rem); line-height: 1.05; letter-spacing: -0.03em; }
  .pillar__summary { font-weight: 650; font-size: 1.125rem; }

  /* ---- Vetting ---- */
  .vet { display: grid; gap: var(--s-7); padding: clamp(1.5rem, 1rem + 3vw, 4rem); border-radius: calc(var(--radius) * 1.6); }
  .vet__head { display: grid; gap: var(--s-4); }
  @media (min-width: 64rem) { .vet__head { grid-template-columns: 7fr 4fr; column-gap: var(--gutter); align-items: end; } }
  .vet__lead { color: var(--ink-2); font-size: var(--t-lead); line-height: 1.45; }
  .vet__stages { display: grid; gap: var(--s-5) var(--s-4); }
  @media (min-width: 40rem) { .vet__stages { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64rem) { .vet__stages { grid-template-columns: repeat(5, minmax(0, 1fr)); } }
  .vet__stage { display: grid; grid-template-rows: auto auto 1fr; gap: var(--s-2); align-content: start; }
  .vet__bar { position: relative; display: block; height: 3.5rem; margin-bottom: var(--s-3); border-radius: var(--radius-sm); background: var(--plate-2); overflow: hidden; }
  @media (min-width: 64rem) { .vet__bar { height: 11rem; } }
  .vet__bar::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: var(--h); border-radius: var(--radius-sm); background: var(--violet-300); }
  .vet__stage--last .vet__bar::after { background: var(--lime-400); }
  .vet__name { font-size: 1.25rem; line-height: 1.2; letter-spacing: -0.015em; font-weight: 650; }

  /* ---- Team ---- */
  .team { row-gap: var(--s-7); align-items: start; }
  .team__intro { display: grid; gap: var(--s-5); align-content: start; }
  .team__lead { color: var(--ink-2); font-size: var(--t-lead); line-height: 1.45; }
  .team__levels { display: grid; border-top: 1px solid var(--rule-strong); }
  .team__levels li { display: grid; gap: 0.15rem; padding-block: var(--s-3); border-bottom: 1px solid var(--rule); font-size: var(--t-small); }
  .team__levels strong { font-size: 1rem; }
  .team__instrument { display: grid; gap: var(--s-5); padding: var(--module-pad); border-radius: calc(var(--radius) * 1.6); }
  .team__instrument-head { display: grid; gap: var(--s-2); max-width: 46rem; }

  /* ---- Figures ---- */
  .figs { display: grid; gap: var(--s-6); }
  .figs :global(.figs__photo) { border-radius: calc(var(--radius) * 1.6); }
  @media (max-width: 39.99rem) { .figs :global(.figs__photo) { aspect-ratio: 4 / 3 !important; } }
  .figs__list { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--s-6) var(--gutter); }
  @media (min-width: 64rem) { .figs__list { grid-template-columns: repeat(4, 1fr); } }
  .figs__item { display: flex; flex-direction: column-reverse; gap: var(--s-2); padding-top: var(--s-4); border-top: 1px solid var(--rule-strong); }
  .figs__item dt { color: var(--ink-2); font-weight: 500; }
  .figs__item .figure { font-size: clamp(2.6rem, 1.6rem + 3.4vw, 4.25rem); }

  /* ---- Values ---- */
  .vals { display: grid; gap: var(--s-4); }
  @media (min-width: 48rem) { .vals { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64rem) {
    .vals { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .vals__cell--0 { grid-column: 1 / span 2; grid-row: 1; }
    .vals__cell--1 { grid-column: 3; grid-row: 1; }
    .vals__photo { grid-column: 4; grid-row: 1 / span 2; }
    .vals__cell--2 { grid-column: 1; grid-row: 2; }
    .vals__cell--3 { grid-column: 2 / span 2; grid-row: 2; }
    .vals__base { grid-column: 1 / -1; grid-row: 3; }
  }
  .vals > * { min-width: 0; }
  .vals__cell { display: grid; gap: var(--s-3); align-content: start; padding: var(--module-pad); border-radius: var(--radius); min-height: 12rem; }
  .vals__cell--0 { align-content: space-between; }
  .vals__cell--0 .h3 { font-size: clamp(1.75rem, 1.2rem + 1.6vw, 2.6rem); line-height: 1.05; letter-spacing: -0.03em; }
  .vals__photo { min-height: 16rem; }
  .vals__photo :global(.photo) { height: 100%; }
  .vals__base { display: grid; gap: var(--s-5); padding: var(--module-pad); border-radius: var(--radius); }
  @media (min-width: 64rem) { .vals__base { grid-template-columns: 1fr auto; align-items: end; } }
  .vals__ends { display: grid; gap: var(--s-4); align-items: center; }
  @media (min-width: 48rem) { .vals__ends { grid-template-columns: auto minmax(4rem, 1fr) auto; gap: var(--s-6); } }
  .vals__ends > div { display: grid; gap: 0.15rem; }
  .vals__place { font-family: var(--font-display); font-weight: 700; font-size: clamp(1.4rem, 1.1rem + 1vw, 2rem); line-height: 1.1; letter-spacing: -0.02em; }
  .vals__link { display: none; position: relative; height: 2px; background: repeating-linear-gradient(90deg, var(--lime-400) 0 8px, transparent 8px 14px); }
  @media (min-width: 48rem) { .vals__link { display: block; } }
  .vals__link span { position: absolute; inset: 0; }
  .vals__link span::before { content: ''; position: absolute; top: -5px; left: 0; width: 12px; height: 12px; border-radius: 50%; background: var(--lime-400); }
  @media (prefers-reduced-motion: no-preference) {
    .vals__link span { animation: travel 4s var(--ease-in-out) infinite alternate; }
  }
  @keyframes travel { to { translate: calc(100% - 12px) 0; } }
</style>
