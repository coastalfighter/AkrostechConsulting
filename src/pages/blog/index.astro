---
/**
 * Guides index, in the Sample-3 order: hero, all guides (the live finder, then the grid with the
 * newest guide in the lead slot), closing call to action. The hero carries the generative field;
 * the guide finder instrument sits in the body directly above the grid it filters.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero3D from '@/components/Hero3D.astro';
import ArticleSearch from '@/components/instruments/ArticleSearch.astro';
import GuideCard from '@/components/GuideCard.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import { site } from '@/config/site';
import { pages } from '@/data/pages';
import { categorySlug, formatDate, getPosts, postHref, readingMinutes } from '@/lib/blog';
import { canonical, ids } from '@/lib/seo';

const posts = await getPosts();
const latest = posts[0]!;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Blog', path: '/blog' },
];
const topics = new Set(posts.map((p) => p.data.category)).size;
const minutes = posts.reduce((n, p) => n + readingMinutes(p.body), 0);

const blogSchema = {
  '@type': 'Blog',
  '@id': `${canonical('/blog')}#blog`,
  name: `${site.legalName} guides`,
  url: canonical('/blog'),
  publisher: { '@id': ids.organization },
  blogPost: posts.map((p) => ({
    '@type': 'BlogPosting',
    headline: p.data.title,
    url: canonical(postHref(p)),
    datePublished: p.data.published.toISOString(),
    description: p.data.description,
  })),
};
const listSchema = {
  '@type': 'ItemList',
  '@id': `${canonical('/blog')}#list`,
  name: 'All guides',
  numberOfItems: posts.length,
  itemListElement: posts.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: canonical(postHref(p)), name: p.data.title })),
};
---

<BaseLayout
  {...pages.blog}
  image="/og/blog.png"
  breadcrumbs={crumbs}
  schema={[blogSchema, listSchema]}
  webPage={{ '@type': ['WebPage', 'CollectionPage'], mainEntity: { '@id': `${canonical('/blog')}#list` } }}
>
  <Hero3D scene="pages" hint="Drag to turn them. Press to riffle." labelledby="blog-title" crumbs={crumbs}>
    <h1 class="hero__title" id="blog-title">Guides for building <span class="quiet">lean, global teams.</span></h1>
    <p class="hero__lead">Practical guides on offshore talent, operations, hiring and websites, from the team that does the work every day.</p>
    <div class="actions">
      <a class="btn btn--primary" href="#guides">Browse all guides <Icon name="arrow-right" class="btn__arrow btn__arrow--right" /></a>
      <a class="btn btn--ghost" href="/rss.xml">RSS feed <Icon name="arrow-up-right" class="btn__arrow" /></a>
    </div>
    <dl class="bfacts" slot="after">
      <div><dt>Guides</dt><dd class="tabular">{posts.length}</dd></div>
      <div><dt>Services covered</dt><dd class="tabular">{topics}</dd></div>
      <div><dt>Minutes of reading</dt><dd class="tabular">{minutes}</dd></div>
      <div>
        <dt>Latest</dt>
        <dd><time datetime={latest.data.published.toISOString()}>{formatDate(latest.data.published)}</time></dd>
      </div>
    </dl>
  </Hero3D>

  <section class="section guides" id="guides" aria-labelledby="guides-title">
    <div class="wrap">
      <div class="section-head grid">
        <h2 class="h2" id="guides-title" data-split>All guides.</h2>
        <p data-reveal>
          Hiring virtual assistants, recruitment outsourcing, offshore bookkeeping, legal process outsourcing and fast business websites. Search by
          a word or filter by service.
        </p>
      </div>

      <ArticleSearch posts={posts} controls="guide-grid" />

      <p class="guides__status small" data-filter-status aria-hidden="true">Showing all {posts.length} guides, newest first.</p>

      <ul class="guides__grid" id="guide-grid" role="list">
        {
          posts.map((p, i) => (
            <li
              class:list={['guides__item', { 'is-lead': i === 0 }]}
              data-filter-item={p.id}
              data-cat={categorySlug(p.data.category)}
              data-text={`${p.data.title} ${p.data.description} ${p.data.tags.join(' ')} ${p.data.category}`}
            >
              <GuideCard
                post={p}
                priority={i === 0}
                sizes={i === 0 ? '(min-width: 64rem) 62vw, 100vw' : '(min-width: 64rem) 30vw, (min-width: 40rem) 50vw, 100vw'}
              />
            </li>
          ))
        }
      </ul>

      <div class="guides__empty panel" hidden data-filter-empty>
        <div class="guides__empty-copy">
          <p class="h3">No guide matches <span data-filter-empty-q>this filter</span> yet.</p>
          <p class="muted">Try a broader word or another service, or <a class="link" href="/contact">ask us the question directly</a>.</p>
        </div>
        <button class="btn btn--primary" type="button" data-filter-reset>Show every guide <Icon name="arrow-right" class="btn__arrow btn__arrow--right" /></button>
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  /* ---- Hero facts ---- */
  .bfacts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-5) var(--gutter); padding-top: var(--s-5); border-top: 1px solid var(--rule); }
  @media (min-width: 64rem) { .bfacts { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .bfacts div { display: flex; flex-direction: column-reverse; gap: var(--s-1); }
  .bfacts dt { color: var(--ink-2); font-size: var(--t-small); }
  .bfacts dd { font-family: var(--font-display); font-size: clamp(1.5rem, 1.1rem + 1.2vw, 2.25rem); font-weight: 700; letter-spacing: -0.03em; line-height: 1.05; }

  /* ---- Grid ---- */
  .guides__status { margin: var(--s-7) 0 var(--s-5); color: var(--ink-2); }
  .guides__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s-7) var(--gutter); align-items: start; }
  @media (min-width: 40rem) {
    .guides__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .guides__item.is-lead { grid-column: 1 / -1; }
  }
  @media (min-width: 64rem) {
    .guides__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .guides__item.is-lead { grid-column: span 2; grid-row: span 2; }
  }
  /* ---- Empty ---- */
  .guides__empty { display: grid; gap: var(--s-5); align-items: center; padding: var(--module-pad); }
  @media (min-width: 48rem) { .guides__empty { grid-template-columns: 1fr auto; } }
  .guides__empty-copy { display: grid; gap: var(--s-2); }
</style>
