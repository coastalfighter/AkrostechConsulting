---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ArticleOutline from '@/components/heroes/ArticleOutline.astro';
import Photo from '@/components/Photo.astro';
import PostCard from '@/components/PostCard.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import { site } from '@/config/site';
import { photoFor } from '@/data/photos';
import { formatDate, getPosts, postHref, readingMinutes, wordCount, type Post } from '@/lib/blog';
import { articleSchema, canonical } from '@/lib/seo';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, all: posts } }));
}) satisfies GetStaticPaths;

interface Props {
  post: Post;
  all: Post[];
}
const { post, all } = Astro.props;
const { Content, headings } = await render(post);
const d = post.data;
const path = postHref(post);
const url = canonical(path);
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Insights', path: '/blog' },
  { name: d.title, path },
];
const toc = headings.filter((h) => h.depth === 2);
const relatedIds = d.related.length ? d.related : [];
const related = [
  ...relatedIds.map((id) => all.find((p) => p.id === id)).filter((p): p is Post => Boolean(p)),
  ...all.filter((p) => p.id !== post.id && p.data.category === d.category),
  ...all.filter((p) => p.id !== post.id),
]
  .filter((p, i, arr) => p.id !== post.id && arr.findIndex((x) => x.id === p.id) === i)
  .slice(0, 3);
const minutes = readingMinutes(post.body);
const share = {
  linkedin: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`,
  x: `https://x.com/intent/post?url=${encodeURIComponent(url)}&text=${encodeURIComponent(d.title)}`,
  email: `mailto:?subject=${encodeURIComponent(d.title)}&body=${encodeURIComponent(`${d.excerpt}\n\n${url}`)}`,
};

// Reading time per section: split the source at its level-2 headings, in document order.
const WPM = 230;
const parts = (post.body ?? '').split(/^## .*$/m);
const introWords = wordCount(parts[0]);
const sectionWords = parts.slice(1).map((p) => wordCount(p));
const evenShare = Math.round((wordCount(post.body) - introWords) / Math.max(1, toc.length));
const sections = toc.map((h, i) => ({
  slug: h.slug,
  text: h.text,
  words: sectionWords.length === toc.length ? (sectionWords[i] ?? 0) : evenShare,
}));
---

<BaseLayout
  title={d.metaTitle}
  description={d.description}
  path={path}
  image={`/og/blog-${post.id}.png`}
  type="article"
  publishedTime={d.published.toISOString()}
  modifiedTime={(d.updated ?? d.published).toISOString()}
  breadcrumbs={crumbs}
  schema={[
    articleSchema({
      title: d.title,
      description: d.description,
      path,
      image: `/og/blog-${post.id}.png`,
      published: d.published,
      updated: d.updated,
      author: d.author,
      category: d.category,
      wordCount: wordCount(post.body),
    }),
  ]}
>
  <article class="art" aria-labelledby="article-title">
    <div class="gridlines" aria-hidden="true"><div>{Array.from({ length: 12 }, () => <span />)}</div></div>
    <div class="wrap art__wrap">
      <div class="art__crumbs"><Breadcrumbs items={crumbs} /></div>
      <div class="art__grid grid">
        <header class="art__head">
          <p class="art__cat"><a class="link link--quiet" href={`/blog?category=${d.category.toLowerCase().replace(/[^a-z]+/g, '-')}#articles`}>{d.category}</a></p>
          <h1 class="art__title" id="article-title">{d.title}</h1>
          <p class="art__excerpt">{d.excerpt}</p>
          <dl class="art__meta">
            <div><dt class="label">Author</dt><dd>{d.author}</dd></div>
            <div><dt class="label">Published</dt><dd><time datetime={d.published.toISOString()}>{formatDate(d.published)}</time></dd></div>
            {
              d.updated && (
                <div>
                  <dt class="label">Updated</dt>
                  <dd>
                    <time datetime={d.updated.toISOString()}>{formatDate(d.updated)}</time>
                  </dd>
                </div>
              )
            }
            <div><dt class="label">Reading time</dt><dd class="tabular">{minutes} min</dd></div>
          </dl>
        </header>

        <div class="art__main">
          {toc.length > 1 && <ArticleOutline sections={sections} introWords={introWords} totalMinutes={minutes} wpm={WPM} />}

          <div class="art__cover">
            <Photo name={photoFor(d.art, d.artVariant)} alt="" ratio="16 / 9" priority sizes="(min-width: 64rem) 62vw, 100vw" />
          </div>

          <div class="art__body prose" data-article-body>
            <Content />
          </div>

          <footer class="art__foot">
            <div class="art__about ruled">
              <div class="module module--flex">
                <p class="h3">About Akrostech</p>
                <p class="muted">
                  {site.name} places vetted professionals in India on U.S. working hours: virtual assistants, recruiters, accountants, legal support and web
                  developers. Headquartered in Wilmington, Delaware.
                </p>
                <a class="more" href="/services">Explore our services <Icon name="arrow-right" /></a>
              </div>
              <div class="module module--flex art__share">
                <p class="label">Share this article</p>
                <ul role="list" class="share">
                  <li><a class="share__btn" href={share.linkedin} target="_blank" rel="noopener" aria-label="Share on LinkedIn"><Icon name="linkedin" /></a></li>
                  <li>
                    <a class="share__btn" href={share.x} target="_blank" rel="noopener" aria-label="Share on X">
                      <svg viewBox="0 0 24 24" class="icon" aria-hidden="true"><path d="M4 4l16 16M20 4 4 20" stroke="currentColor" stroke-width="1.75" fill="none"></path></svg>
                    </a>
                  </li>
                  <li><a class="share__btn" href={share.email} aria-label="Share by email"><Icon name="mail" /></a></li>
                  <li>
                    <button class="share__btn" type="button" data-copy={url} aria-label="Copy link to this article">
                      <Icon name="route" />
                    </button>
                  </li>
                </ul>
                {d.updated && <p class="small muted">Last updated <time datetime={d.updated.toISOString()}>{formatDate(d.updated)}</time></p>}
              </div>
            </div>
          </footer>
        </div>
      </div>
    </div>
  </article>

  <section class="section keep" aria-labelledby="more-title">
    <div class="wrap">
      <div class="section-head grid">
        <h2 class="h2" id="more-title" data-split>Keep reading.</h2>
        <p data-reveal>More guides on the same work, chosen to follow this one.</p>
      </div>
      <ul class="keep__grid grid" role="list" data-reveal-group>
        {related.map((p) => <li class="c-4" data-reveal><PostCard post={p} /></li>)}
      </ul>
      <a class="more keep__all" href="/blog">All articles <Icon name="arrow-right" /></a>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const announcer = document.querySelector('[data-announcer]');
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? location.href);
        btn.classList.add('is-done');
        if (announcer) announcer.textContent = 'Link copied to clipboard';
        setTimeout(() => btn.classList.remove('is-done'), 1600);
      } catch {
        if (announcer) announcer.textContent = 'Could not copy the link. Copy it from the address bar.';
      }
    });
  });
</script>

<style>
  .art { position: relative; isolation: isolate; padding-top: calc(var(--header-h) + var(--s-5)); }
  .art__wrap { position: relative; z-index: 1; }
  .art__crumbs { margin-bottom: var(--s-4); }
  .art__crumbs :global(li:last-child span) { max-width: 28ch; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; display: block; line-height: 44px; }
  .art__grid { row-gap: var(--s-7); }

  .art__head { display: grid; gap: var(--s-5); align-content: start; padding-top: var(--s-5); }
  .art__cat { font-weight: 650; font-stretch: 112%; color: var(--accent-text); }
  .art__cat a { display: inline-flex; min-height: 44px; align-items: center; }
  .art__title {
    font-size: clamp(2rem, 1.1rem + 3.4vw, 4.5rem);
    font-stretch: 125%;
    font-weight: 750;
    line-height: 0.98;
    letter-spacing: -0.025em;
    text-transform: uppercase;
    max-width: 18ch;
  }
  .art__excerpt { font-size: var(--t-lead); line-height: 1.45; color: var(--ink-2); max-width: 52ch; }
  .art__meta { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1px solid var(--rule-strong); }
  @media (min-width: 40rem) { .art__meta { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .art__meta > div { display: grid; gap: var(--s-1); padding: var(--s-3) var(--s-4) var(--s-3) 0; border-bottom: 1px solid var(--rule); }
  .art__meta dt { color: var(--ink-2); }
  .art__meta dd { font-weight: 600; font-size: var(--t-small); }

  /* Flow layout below desktop, so the outline bar can stay sticky through the whole body. */
  .art__main { display: block; }
  .art__main > * + * { margin-top: var(--s-7); }
  .art__cover { margin-inline: calc(var(--margin) * -1); }
  @media (min-width: 40rem) { .art__cover { margin-inline: 0; } }
  .art__body { font-size: clamp(1.0625rem, 1rem + 0.25vw, 1.1875rem); }
  .art__body :global(h2) { scroll-margin-top: calc(var(--header-h) + var(--s-6)); }
  .art__body :global(h2:first-child) { margin-top: 0; }

  /* Desktop: the outline sits beside the title and stays beside the body as it scrolls. */
  @media (min-width: 64rem) {
    .art__main { display: contents; }
    .art__main > * + * { margin-top: 0; }
    .art__head { grid-column: 1 / span 8; grid-row: 1; }
    .art__main > :global(.ol) { grid-column: 9 / -1; grid-row: 1 / span 4; align-self: start; position: sticky; top: calc(var(--header-h) + var(--s-5)); margin-top: var(--s-5); }
    .art__cover { grid-column: 1 / span 8; grid-row: 2; }
    .art__body { grid-column: 1 / span 7; grid-row: 3; }
    .art__foot { grid-column: 1 / span 8; grid-row: 4; }
  }
  /* No outline (a short article): the reading column centres under the title. */
  .art__main:not(:has(.ol)) .art__body { max-width: var(--measure); }

  .art__foot { padding-bottom: var(--s-8); }
  .art__about { grid-template-columns: 1fr; }
  @media (min-width: 40rem) { .art__about { grid-template-columns: 3fr 2fr; } }
  .art__about .module { gap: var(--s-4); }
  .art__share .label { color: var(--ink-2); }
  .share { display: flex; flex-wrap: wrap; gap: var(--s-2); }
  .share__btn { display: grid; place-items: center; width: 44px; height: 44px; border: 1px solid var(--rule-strong); color: var(--ink); transition: transform var(--t-press) var(--ease-out), background-color var(--t-ui) ease, color var(--t-ui) ease, border-color var(--t-ui) ease; }
  .share__btn:active { transform: scale(0.97); }
  @media (hover: hover) and (pointer: fine) { .share__btn:hover { border-color: var(--ink); } }
  .share__btn:global(.is-done) { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }

  .keep__grid { row-gap: var(--s-7); }
  .keep__all { margin-top: var(--s-6); }
</style>
