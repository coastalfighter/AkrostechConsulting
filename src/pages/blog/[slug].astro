---
/**
 * Guide, in the Sample-3 order: hero (topics, title, description, author, date, reading time,
 * service), cover, the text with the reading outline beside it, questions, related guides,
 * the related service, previous and next guide, call to action.
 * The hero carries the generative field, seeded by the guide's slug.
 */
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero3D from '@/components/Hero3D.astro';
import ArticleOutline from '@/components/instruments/ArticleOutline.astro';
import Photo from '@/components/Photo.astro';
import GuideCard from '@/components/GuideCard.astro';
import Faq from '@/components/Faq.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import { serviceBySlug, serviceHref } from '@/data/services';
import { photoFor, servicePhoto } from '@/data/photos';
import { formatDate, getPosts, postHref, readingMinutes, relatedPosts, wordCount, type Post } from '@/lib/blog';
import { articleSchema, canonical, faqSchema } from '@/lib/seo';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, all: posts } }));
}) satisfies GetStaticPaths;

interface Props {
  post: Post;
  all: Post[];
}
const { post, all } = Astro.props;
const { Content, headings } = await render(post);
const d = post.data;
const path = postHref(post);
const url = canonical(path);
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Blog', path: '/blog' },
  { name: d.title, path },
];
const service = d.service ? serviceBySlug(d.service) : undefined;
const related = relatedPosts(post, all, 3);
// Covers for the related cards: never repeat this guide's cover or each other's.
const cover = photoFor(d.art, d.artVariant);
const usedPhotos = new Set<string>([cover]);
const relatedPhotos = related.map((p) => {
  const pick = [0, 1, 2, 3].map((k) => photoFor(p.data.art, p.data.artVariant + k)).find((name) => !usedPhotos.has(name)) ?? photoFor(p.data.art, p.data.artVariant);
  usedPhotos.add(pick);
  return pick;
});
const index = all.findIndex((p) => p.id === post.id);
const newer = index > 0 ? all[index - 1] : undefined;
const older = index < all.length - 1 ? all[index + 1] : undefined;
const minutes = readingMinutes(post.body);
const words = wordCount(post.body);
const faqs = d.faqs.map((f) => ({ q: f.question, a: f.answer }));

// Social card: the guide's own card when it has been generated, otherwise the blog card.
const ogOwn = `/og/blog-${post.id}.png`;
const ogImage = existsSync(join(process.cwd(), 'public', ogOwn)) ? ogOwn : '/og/blog.png';

const share = {
  linkedin: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`,
  x: `https://x.com/intent/post?url=${encodeURIComponent(url)}&text=${encodeURIComponent(d.title)}`,
  email: `mailto:?subject=${encodeURIComponent(d.title)}&body=${encodeURIComponent(`${d.description}\n\n${url}`)}`,
};

// Reading time per section: split the source at its level-2 headings, in document order.
const WPM = 230;
const toc = headings.filter((h) => h.depth === 2);
const parts = (post.body ?? '').split(/^## .*$/m);
const introWords = wordCount(parts[0]);
const sectionWords = parts.slice(1).map((p) => wordCount(p));
const evenShare = Math.round((words - introWords) / Math.max(1, toc.length));
const sections = toc.map((h, i) => ({
  slug: h.slug,
  text: h.text,
  words: sectionWords.length === toc.length ? (sectionWords[i] ?? 0) : evenShare,
}));

const schema = {
  ...articleSchema({
    title: d.title,
    description: d.description,
    path,
    image: ogImage,
    published: d.published,
    updated: d.updated,
    author: d.author,
    category: d.category,
    wordCount: words,
  }),
  keywords: [...d.keywords, ...d.tags].join(', '),
  ...(service ? { about: { '@type': 'Service', name: service.name, url: canonical(serviceHref(service.slug)) } } : {}),
};
---

<BaseLayout
  title={d.metaTitle}
  description={d.description}
  path={path}
  image={ogImage}
  type="article"
  publishedTime={d.published.toISOString()}
  modifiedTime={(d.updated ?? d.published).toISOString()}
  breadcrumbs={crumbs}
  schema={[schema, faqSchema(faqs)]}
>
  <Hero3D scene="pages" seed={post.id} hint="Drag to turn them. Press to riffle." wide labelledby="article-title" crumbs={crumbs} class="ahero">
    <ul class="ahero__tags" role="list" aria-label="Topics">
      {d.tags.map((t) => <li class="chip">{t}</li>)}
    </ul>
    <h1 class="ahero__title" id="article-title">{d.title}</h1>
    <p class="ahero__lead">{d.description}</p>
    <dl class="ahero__meta">
      <div><dt>Author</dt><dd>{d.author}</dd></div>
      <div><dt>Published</dt><dd><time datetime={d.published.toISOString()}>{formatDate(d.published)}</time></dd></div>
      <div><dt>Reading time</dt><dd class="tabular">{minutes} min</dd></div>
      <div>
        <dt>Service</dt>
        <dd>{service ? <a class="link" href={serviceHref(service.slug)}>{service.name}</a> : 'General'}</dd>
      </div>
    </dl>
    <div class="ahero__cover" slot="after">
      <Photo name={cover} alt="" fill priority sizes="(min-width: 100rem) 1500px, 100vw" />
    </div>
  </Hero3D>

  <article class="read" aria-labelledby="article-title">
    <div class="wrap">
      <div class="read__grid">
        {
          toc.length > 1 && (
            <div class="read__side">
              <ArticleOutline sections={sections} introWords={introWords} totalMinutes={minutes} wpm={WPM} />
            </div>
          )
        }

        <div class="read__main">
          <div class="read__body prose" data-article-body>
            <Content />
          </div>

          <footer class="read__foot">
            <div class="read__share">
              <p class="read__share-title">Share this guide</p>
              <ul role="list" class="share">
                <li><a class="share__btn" href={share.linkedin} target="_blank" rel="noopener" aria-label="Share on LinkedIn"><Icon name="linkedin" /></a></li>
                <li>
                  <a class="share__btn" href={share.x} target="_blank" rel="noopener" aria-label="Share on X">
                    <svg viewBox="0 0 24 24" class="icon" aria-hidden="true"><path d="M4 4l16 16M20 4 4 20" stroke="currentColor" stroke-width="1.75" fill="none"></path></svg>
                  </a>
                </li>
                <li><a class="share__btn" href={share.email} aria-label="Share by email"><Icon name="mail" /></a></li>
                <li>
                  <button class="share__btn" type="button" data-copy={url} aria-label="Copy link to this guide">
                    <Icon name="route" />
                  </button>
                </li>
              </ul>
            </div>
            <p class="small muted">
              Written by {d.author}.
              {
                d.updated ? (
                  <>
                    Last updated <time datetime={d.updated.toISOString()}>{formatDate(d.updated)}</time>.
                  </>
                ) : (
                  <>
                    Published <time datetime={d.published.toISOString()}>{formatDate(d.published)}</time>.
                  </>
                )
              }
            </p>
          </footer>
        </div>
      </div>
    </div>
  </article>

  {faqs.length > 0 && <Faq faqs={faqs} name={`faq-${post.id}`} heading="Frequently asked questions" />}

  <section class:list={['section keep', { 'section--flush-top': faqs.length > 0 }]} aria-labelledby="keep-title">
    <div class="wrap">
      <div class="section-head grid">
        <h2 class="h2" id="keep-title" data-split>Keep reading.</h2>
        <p data-reveal>Related guides on the same work{service ? ', and the service behind them' : ''}.</p>
      </div>

      <nav class="keep__related" aria-label="Related guides">
        <ul class="keep__grid" role="list" data-reveal-group>
          {
            related.map((p, i) => (
              <li data-reveal>
                <GuideCard post={p} photo={relatedPhotos[i]} />
              </li>
            ))
          }
        </ul>
      </nav>

      {
        service && (
          <aside class="svc violet" aria-label="Related service" data-reveal>
            <div class="svc__photo">
              <Photo name={servicePhoto[service.slug]} alt="" fill sizes="(min-width: 64rem) 30vw, 100vw" />
            </div>
            <div class="svc__copy">
              <h3 class="svc__name" id="svc-title">
                {service.name}
                {service.isNew && <span class="badge">New</span>}
              </h3>
              <p class="svc__sum">{service.summary}</p>
              <dl class="svc__facts">
                <div>
                  <dt>Starts in</dt>
                  <dd>{service.facts.startsIn}</dd>
                </div>
                <div>
                  <dt>Saves</dt>
                  <dd>{service.facts.savings}</dd>
                </div>
              </dl>
              <a class="btn btn--primary svc__go" href={serviceHref(service.slug)}>
                Explore the service <Icon name="arrow-right" class="btn__arrow btn__arrow--right" />
              </a>
            </div>
          </aside>
        )
      }

      {
        (older || newer) && (
          <nav class="pager" aria-label="More guides">
            {older ? (
              <a class="pager__link panel" href={postHref(older)} rel="prev">
                <span class="pager__dir small">
                  <Icon name="arrow-left" /> Previous guide
                </span>
                <span class="pager__title">{older.data.title}</span>
              </a>
            ) : (
              <span />
            )}
            {newer && (
              <a class="pager__link pager__link--next panel" href={postHref(newer)} rel="next">
                <span class="pager__dir small">
                  Next guide <Icon name="arrow-right" />
                </span>
                <span class="pager__title">{newer.data.title}</span>
              </a>
            )}
          </nav>
        )
      }
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const announcer = document.querySelector('[data-announcer]');
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? location.href);
        btn.classList.add('is-done');
        if (announcer) announcer.textContent = 'Link copied to clipboard';
        setTimeout(() => btn.classList.remove('is-done'), 1600);
      } catch {
        if (announcer) announcer.textContent = 'Could not copy the link. Copy it from the address bar.';
      }
    });
  });
</script>

<style>
  /* ---- Hero ---- */
  .ahero__tags { display: flex; flex-wrap: wrap; gap: var(--s-2); }
  .ahero__title {
    font-size: clamp(2.1rem, 1.2rem + 2.6vw, 3.75rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    max-width: 22ch;
  }
  .ahero__lead { font-size: var(--t-lead); line-height: 1.5; color: var(--ink-2); max-width: 52ch; }
  .ahero__meta { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-4) var(--gutter); padding-top: var(--s-5); border-top: 1px solid var(--rule); }
  @media (min-width: 40rem) { .ahero__meta { grid-template-columns: repeat(4, minmax(0, auto)); justify-content: start; column-gap: var(--s-7); } }
  .ahero__meta div { display: grid; gap: 0.15rem; align-content: start; }
  .ahero__meta dt { font-size: 0.875rem; color: var(--ink-2); }
  .ahero__meta dd { font-weight: 600; font-size: var(--t-small); }
  .ahero__cover { aspect-ratio: 16 / 10; border-radius: calc(var(--radius) * 1.6); overflow: hidden; }
  .ahero__cover :global(.photo) { height: 100%; border-radius: 0; }
  @media (min-width: 40rem) { .ahero__cover { aspect-ratio: 21 / 9; } }

  /* ---- Reading layout: flow below desktop so the outline bar stays sticky through the text ---- */
  .read { padding-bottom: var(--s-9); }
  .read__grid { display: block; }
  .read__side { margin-bottom: var(--s-7); display: contents; }
  .read__side > :global(.ol) { margin-bottom: var(--s-7); }
  @media (min-width: 64rem) {
    .read__grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); align-items: start; }
    .read__side { display: block; grid-column: 9 / -1; grid-row: 1; align-self: stretch; margin: 0; }
    .read__side > :global(.ol) { position: sticky; top: calc(var(--header-h) + var(--s-5)); margin: 0; }
    .read__main { grid-column: 1 / span 7; grid-row: 1; }
    .read__grid:not(:has(.read__side)) .read__main { grid-column: 3 / span 8; }
  }

  /* ---- Reading typography ---- */
  .read__body { max-width: 68ch; font-size: clamp(1.0625rem, 1rem + 0.25vw, 1.1875rem); line-height: 1.72; color: var(--ink); }
  .read__body > :global(p:first-child) { font-size: 1.2em; line-height: 1.55; letter-spacing: -0.005em; }
  .read__body :global(h2) { font-size: clamp(1.6rem, 1.2rem + 1.2vw, 2.25rem); line-height: 1.12; letter-spacing: -0.03em; margin-top: 2.4em; scroll-margin-top: calc(var(--header-h) + var(--s-6)); }
  .read__body :global(h3) { font-size: 1.3em; margin-top: 1.9em; }
  .read__body :global(h2 + *), .read__body :global(h3 + *) { margin-top: 0.7em; }
  .read__body :global(p), .read__body :global(li) { color: color-mix(in srgb, var(--ink) 88%, var(--ground)); }
  .read__body :global(strong) { color: var(--ink); }
  .read__body :global(ul), .read__body :global(ol) { padding-left: 1.3em; }
  .read__body :global(ul > li::marker) { color: var(--ink); }
  .read__body :global(ol > li::marker) { font-weight: 650; color: var(--ink-2); }
  .read__body :global(blockquote) { margin-block: 1.8em; padding: var(--s-5) var(--s-6); font-size: 1.15rem; line-height: 1.45; border-radius: var(--radius); }
  .read__body :global(blockquote p) { color: var(--second-ink); }
  .read__body :global(table) { margin-block: 1.8em; border: 1px solid var(--rule); border-radius: var(--radius-sm); font-size: 0.9375rem; line-height: 1.5; }
  .read__body :global(th), .read__body :global(td) { padding: 0.75em 1em; }
  .read__body :global(thead th) { background: var(--plate-2); white-space: normal; min-width: 8rem; }
  .read__body :global(tbody tr:last-child td) { border-bottom: 0; }
  .read__body :global(tbody td:first-child) { font-weight: 600; color: var(--ink); }
  /* The takeaways list closes most guides: set as a lavender (violet in dark) summary panel. */
  .read__body :global(h2#key-takeaways + ul) {
    list-style: none;
    padding: var(--s-5) var(--s-6);
    border-radius: var(--radius);
    background: var(--second);
    color: var(--second-ink);
    display: grid;
    gap: var(--s-3);
  }
  .read__body :global(h2#key-takeaways + ul li) { position: relative; padding-left: 1.6rem; color: var(--second-ink); margin: 0; }
  .read__body :global(h2#key-takeaways + ul li::before) {
    content: '';
    position: absolute;
    left: 0; top: 0.6em;
    width: 0.7rem; height: 0.7rem;
    background: currentColor;
    clip-path: polygon(0 50%, 35% 85%, 100% 10%, 100% 30%, 35% 100%, 0 68%);
  }

  .read__foot { display: grid; gap: var(--s-4); margin-top: var(--s-8); padding-top: var(--s-5); border-top: 1px solid var(--rule); max-width: 68ch; }
  .read__share { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--s-3) var(--s-5); }
  .read__share-title { font-weight: 650; }
  .share { display: flex; flex-wrap: wrap; gap: var(--s-2); }
  .share__btn { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; border: 1px solid var(--rule-strong); color: var(--ink); transition: transform var(--t-press) var(--ease-out), background-color var(--t-ui) ease, color var(--t-ui) ease, border-color var(--t-ui) ease; }
  .share__btn:active { transform: scale(0.94); }
  @media (hover: hover) and (pointer: fine) { .share__btn:hover { border-color: var(--ink); } }
  .share__btn:global(.is-done) { background: var(--mark); border-color: var(--mark); color: var(--mark-ink); }

  /* ---- Keep reading ---- */
  .keep__grid { display: grid; gap: var(--s-7) var(--gutter); }
  @media (min-width: 40rem) { .keep__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64rem) { .keep__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

  .svc { display: grid; margin-top: var(--s-8); border-radius: calc(var(--radius) * 1.6); overflow: hidden; }
  @media (min-width: 48rem) { .svc { grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); } }
  .svc__photo { min-height: 16rem; }
  .svc__photo :global(.photo) { height: 100%; border-radius: 0; }
  .svc__copy { display: grid; gap: var(--s-4); align-content: center; justify-items: start; padding: clamp(1.5rem, 1rem + 2.4vw, 3.5rem); }
  .svc__name { display: inline-flex; flex-wrap: wrap; align-items: center; gap: var(--s-3); font-size: var(--t-h2); line-height: var(--lh-heading); letter-spacing: var(--track-heading); }
  .svc__sum { font-size: var(--t-lead); line-height: 1.5; max-width: 46ch; }
  .svc__facts { display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-7); }
  .svc__facts div { display: grid; gap: 0.1rem; }
  .svc__facts dt { font-size: 0.875rem; color: var(--ink-2); }
  .svc__facts dd { font-weight: 650; }
  .svc__go { margin-top: var(--s-2); }

  .pager { display: grid; gap: var(--s-4); margin-top: var(--s-8); }
  @media (min-width: 48rem) { .pager { grid-template-columns: 1fr 1fr; } }
  .pager__link { display: grid; gap: var(--s-2); align-content: start; padding: var(--s-5) var(--s-6); text-decoration: none; transition: border-color var(--t-ui) ease, transform var(--t-press) var(--ease-out); }
  .pager__link:active { transform: scale(0.99); }
  .pager__link--next { text-align: right; justify-items: end; }
  .pager__dir { display: inline-flex; align-items: center; gap: var(--s-2); color: var(--ink-2); font-weight: 600; }
  .pager__dir :global(.icon) { width: 1.1em; height: 1.1em; transition: transform var(--t-ui) var(--ease-out); }
  .pager__title { font-family: var(--font-display); font-size: 1.25rem; font-weight: 650; line-height: 1.25; letter-spacing: -0.02em; }
  @media (hover: hover) and (pointer: fine) {
    .pager__link:hover { border-color: var(--ink); }
    .pager__link:hover .pager__dir :global(.icon) { transform: translateX(-4px); }
    .pager__link--next:hover .pager__dir :global(.icon) { transform: translateX(4px); }
  }
</style>
