---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Faq from '@/components/Faq.astro';
import CtaBand from '@/components/CtaBand.astro';
import ShiftPlanner from '@/components/ShiftPlanner.astro';
import Icon from '@/components/Icon.astro';
import { site, fullAddress, mapsDirectionsUrl } from '@/config/site';
import { locations, type Location } from '@/data/locations';
import { services, serviceHref } from '@/data/services';
import { canonical, faqSchema, ids } from '@/lib/seo';

export const getStaticPaths = (() => locations.map((l) => ({ params: { slug: l.slug }, props: { loc: l } }))) satisfies GetStaticPaths;

interface Props {
  loc: Location;
}
const { loc: l } = Astro.props;
const path = `/locations/${l.slug}`;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Service areas', path: '/locations' },
  { name: `${l.city}, ${l.region}`, path },
];
const others = locations.filter((x) => x.slug !== l.slug);
const mapSrc = l.isHeadquarters
  ? `https://www.google.com/maps?q=${encodeURIComponent(fullAddress)}&z=15&output=embed`
  : `https://www.google.com/maps?q=${encodeURIComponent(`${l.city}, ${l.regionName}`)}&z=11&output=embed`;
const directions = l.isHeadquarters
  ? mapsDirectionsUrl
  : `https://www.google.com/maps/dir/?api=1&origin=${encodeURIComponent(`${l.city}, ${l.region}`)}&destination=${encodeURIComponent(fullAddress)}`;

const areaNode = {
  '@type': 'Service',
  '@id': `${canonical(path)}#service`,
  name: `Offshore staffing and outsourcing in ${l.city}, ${l.region}`,
  serviceType: 'Business process outsourcing',
  provider: { '@id': ids.business },
  areaServed: {
    '@type': 'City',
    name: l.city,
    containedInPlace: { '@type': 'State', name: l.regionName },
    geo: { '@type': 'GeoCoordinates', latitude: l.geo.latitude, longitude: l.geo.longitude },
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: `Services in ${l.city}`,
    itemListElement: services.map((s) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: `${s.name} in ${l.city}`, url: canonical(serviceHref(s.slug)) } })),
  },
};
---

<BaseLayout {...l.meta} path={path} heroTone={l.isHeadquarters ? 'field' : 'default'} image={`/og/location-${l.slug}.png`} breadcrumbs={crumbs} schema={[areaNode, faqSchema(l.faqs)]}>
  <PageHero title={l.headline} lede={l.intro} crumbs={crumbs} tone={l.isHeadquarters ? 'field' : 'default'}>
    <Fragment slot="actions">
      <a class:list={['btn', { 'btn--light': l.isHeadquarters }]} href={site.calendly} target="_blank" rel="noopener" data-magnetic>
        <span class="btn__label">Book a call <Icon name="arrow-up-right" class="btn__arrow" /></span>
      </a>
      <a class="btn btn--ghost loc-ghost" href={directions} target="_blank" rel="noopener">
        <span class="btn__label"><Icon name="route" /> Directions</span>
      </a>
    </Fragment>
  </PageHero>

  <section class="loc wrap section" aria-labelledby="loc-body-title">
    <div class="loc__body">
      <h2 class="h2" id="loc-body-title" data-split>{`Offshore teams for ${l.city} businesses.`}</h2>
      <div class="loc__copy prose">
        {l.body.map((p) => <p data-reveal>{p}</p>)}
      </div>
    </div>
    <aside class="loc__card" aria-label="Contact details">
      <p class="loc__label">{l.isHeadquarters ? 'Our office' : 'Nearest office'}</p>
      <address class="loc__addr">{site.legalName}<br />{site.address.street}<br />{site.address.locality}, {site.address.region} {site.address.postalCode}</address>
      <p class="loc__label">Getting here</p>
      <p>{l.distance}</p>
      <p class="loc__label">Hours</p>
      <p>{site.hoursLabel}</p>
      <ul role="list" class="loc__direct">
        <li><a class="link" href={`tel:${site.phoneE164}`}><Icon name="phone" /> {site.phone}</a></li>
        <li><a class="link" href={`mailto:${site.email}`}><Icon name="mail" /> {site.email}</a></li>
      </ul>
    </aside>
  </section>

  <section class="ind section" aria-labelledby="ind-title">
    <div class="wrap">
      <h2 class="h1 ind__title" id="ind-title" data-split>{`Who we support in ${l.city}.`}</h2>
      <ul role="list" class="ind__grid" data-reveal-group>
        {
          l.industries.map((i) => (
            <li class="ind__item" data-reveal data-tilt="4">
              <h3 class="ind__name">{i.name}</h3>
              <p>{i.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="lsvc wrap section" aria-labelledby="lsvc-title">
    <h2 class="h2" id="lsvc-title" data-split>{`Services in ${l.city}, ${l.region}.`}</h2>
    <ul role="list" class="lsvc__list">
      {
        services.map((s) => (
          <li>
            <a class="lsvc__link" href={serviceHref(s.slug)}>
              <span class="lsvc__name">
                {s.name} in {l.city}
              </span>
              <span class="lsvc__meta">{s.startsIn}</span>
              <Icon name="arrow-up-right" class="icon" />
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <div class="wrap section planner-wrap">
    <ShiftPlanner id={`planner-${l.slug}`} />
  </div>

  <section class="lmap wrap section" aria-labelledby="lmap-title">
    <h2 class="sr-only" id="lmap-title">{`Map of ${l.city}`}</h2>
    <div class="lmap__frame skeleton" data-map>
      <iframe title={`Map of ${l.isHeadquarters ? `${site.name} in ` : ''}${l.city}, ${l.regionName}`} src={mapSrc} loading="lazy" referrerpolicy="no-referrer-when-downgrade" width="1200" height="600"></iframe>
    </div>
    <p class="lmap__others">
      Also serving{' '}
      {
        others.map((o, i) => (
          <>
            <a class="link link--static" href={`/locations/${o.slug}`}>
              {o.city}, {o.region}
            </a>
            {i < others.length - 1 ? ' and ' : ''}
          </>
        ))
      }{' '}
      and businesses across the United States.
    </p>
  </section>

  <Faq faqs={l.faqs} name={l.slug} heading={`${l.city} questions`} />
  <CtaBand />
</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>('[data-map]').forEach((wrap) => {
    wrap.querySelector('iframe')?.addEventListener('load', () => wrap.classList.remove('skeleton'), { once: true });
  });
</script>

<style>
  .loc-ghost { --btn-ink: currentColor; }
  .loc { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: var(--space-2xl) clamp(2rem, 6vw, 6rem); }
  .loc__copy { margin-top: var(--space-l); font-size: clamp(1.0625rem, 1rem + 0.25vw, 1.1875rem); }
  .loc__card { display: grid; align-content: start; gap: 0.35rem; padding: clamp(1.5rem, 2.5vw, 2rem); background: var(--surface); align-self: start; position: sticky; top: calc(var(--header-h) + 2rem); }
  .loc__label { margin-top: var(--space-s); font-size: var(--step--1); font-weight: 600; color: var(--muted); }
  .loc__label:first-child { margin-top: 0; }
  .loc__addr { font-style: normal; font-family: var(--font-display); font-size: var(--step-1); font-weight: 500; line-height: 1.3; color: var(--ink-strong); }
  .loc__direct { margin-top: var(--space-s); display: grid; }
  .loc__direct a { display: inline-flex; align-items: center; gap: 0.6rem; min-height: 44px; color: var(--ink-strong); font-weight: 500; }
  @media (max-width: 1023px) { .loc { grid-template-columns: 1fr; } .loc__card { position: static; } }

  .ind { background: var(--inverse); color: var(--inverse-ink); }
  .ind__title { color: var(--inverse-ink); margin-bottom: var(--space-2xl); max-width: 18ch; }
  .ind__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gutter); }
  .ind__item { display: grid; align-content: start; gap: var(--space-s); padding: clamp(1.5rem, 2.5vw, 2rem); background: light-dark(#262622, #cfc8b6); min-height: 16rem; }
  .ind__name { font-family: var(--font-display); font-size: var(--step-1); font-weight: 600; letter-spacing: -0.02em; }
  .ind__item p { color: var(--inverse-muted); }
  @media (max-width: 1023px) { .ind__grid { grid-template-columns: 1fr; } .ind__item { min-height: auto; } }

  .lsvc__list { display: grid; margin-top: var(--space-xl); }
  .lsvc__link { display: grid; grid-template-columns: minmax(0, 1fr) auto auto; align-items: center; gap: var(--space-m); min-height: 4.5rem; padding-block: var(--space-s); text-decoration: none; color: var(--ink-strong); box-shadow: inset 0 -1px 0 var(--line); transition: padding var(--dur-base) var(--ease-out), color var(--dur-fast); }
  .lsvc__link:hover { padding-left: var(--space-s); color: var(--accent-text); }
  .lsvc__name { font-family: var(--font-display); font-size: var(--step-1); font-weight: 600; letter-spacing: -0.02em; }
  .lsvc__meta { font-size: var(--step--1); color: var(--muted); }
  @media (max-width: 599px) { .lsvc__meta { display: none; } }

  .planner-wrap { padding-bottom: 0; }
  .lmap__frame { position: relative; aspect-ratio: 2 / 1; overflow: hidden; }
  .lmap__frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; filter: grayscale(0.35) contrast(1.05); }
  .lmap__others { margin-top: var(--space-m); color: var(--muted); }
  .lmap__others a { color: var(--ink-strong); }
  @media (max-width: 767px) { .lmap__frame { aspect-ratio: 4 / 5; } }
</style>
