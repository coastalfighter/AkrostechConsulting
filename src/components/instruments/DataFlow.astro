---
/**
 * Privacy hero instrument: the path an enquiry takes, from the visitor's browser through the
 * contact form, the serverless function (Vercel) and email delivery (Resend) to the Akrostech
 * inbox, with Calendly and Google Maps as third parties. Selecting a node lights its path,
 * dims the rest and shows what it handles, why and for how long, quoted from the policy below.
 * Server-rendered with the contact form selected; without JavaScript every node's panel shows.
 */
import { site } from '@/config/site';

export interface FlowNode {
  id: 'browser' | 'form' | 'vercel' | 'resend' | 'inbox' | 'calendly' | 'maps';
  name: string;
  who: string;
  party: 'you' | 'us' | 'processor' | 'third';
  handles: string;
  why: string;
  kept: string;
  /** Section of the policy the panel is drawn from. */
  ref: { id: string; label: string };
}

const nodes: FlowNode[] = [
  {
    id: 'browser',
    name: 'Your browser',
    who: 'Your device',
    party: 'you',
    handles: 'Two preferences: your light or dark theme choice, and whether you have seen the opening animation in this session.',
    why: 'To remember those choices. We do not use advertising cookies or sell personal information.',
    kept: 'In your browser. These never leave your device.',
    ref: { id: 'what-we-collect', label: 'What we collect' },
  },
  {
    id: 'form',
    name: 'Contact form',
    who: 'This website',
    party: 'us',
    handles: 'Your name and work email and, if you choose to give them, your company, phone number, the service you are interested in, your team size and your message.',
    why: 'To reply to your enquiry and arrange a discovery call. We rely on your consent, which you give when you submit the form and can withdraw at any time.',
    kept: 'Enquiries that do not lead to an engagement are deleted within 24 months of our last contact.',
    ref: { id: 'how-we-use-it', label: 'How we use it' },
  },
  {
    id: 'vercel',
    name: 'Serverless function',
    who: 'Vercel, our website host',
    party: 'processor',
    handles: 'Your enquiry on its way to us, and standard server logs: IP address, browser type, pages requested and timestamps.',
    why: 'To keep the site secure and working, prevent spam and fix problems. The site is served only over HTTPS.',
    kept: 'Server logs are kept for up to 90 days.',
    ref: { id: 'how-long-we-keep-it', label: 'How long we keep it' },
  },
  {
    id: 'resend',
    name: 'Email delivery',
    who: 'Resend, our email provider',
    party: 'processor',
    handles: 'Your enquiry, delivered as an email to our inbox.',
    why: 'To get your enquiry to the people who answer it, under a contract that requires the provider to protect it.',
    kept: 'No separate period is set in this policy. Where data is processed outside your state or country, appropriate safeguards are used where required.',
    ref: { id: 'who-we-share-it-with', label: 'Who we share it with' },
  },
  {
    id: 'inbox',
    name: 'Akrostech inbox',
    who: 'Akrostech, Wilmington, DE',
    party: 'us',
    handles: 'Your enquiry and, if you become a client, the records needed to prepare a proposal and deliver our services.',
    why: 'To reply, prepare a proposal and deliver our services, and to meet legal, accounting and tax obligations. Access is limited to staff who need it, with named accounts and multi-factor authentication.',
    kept: 'Enquiries: deleted within 24 months of our last contact if no engagement follows. Client records: for the engagement, then as long as tax and legal obligations require.',
    ref: { id: 'how-we-protect-it', label: 'How we protect it' },
  },
  {
    id: 'calendly',
    name: 'Calendly',
    who: 'Online scheduling',
    party: 'third',
    handles: 'The details you enter when you book a call, collected by Calendly under its own privacy policy and shared with us.',
    why: 'To book your discovery call.',
    kept: 'Calendly holds them under its own privacy policy.',
    ref: { id: 'what-we-collect', label: 'What we collect' },
  },
  {
    id: 'maps',
    name: 'Google Maps',
    who: 'Embedded map',
    party: 'third',
    handles: 'Google may set cookies and collect data when the map loads on our contact and location pages.',
    why: 'The map is embedded on our contact and location pages.',
    kept: 'Under Google’s privacy policy, not ours.',
    ref: { id: 'what-we-collect', label: 'What we collect' },
  },
];

const partyLabel: Record<FlowNode['party'], string> = { you: 'You', us: 'Akrostech', processor: 'Our provider', third: 'Third party' };
const chain = nodes.slice(0, 5);
const selected = 'form';
/** Main-chain index of each node; third parties hang off the browser. */
const paths: Record<FlowNode['id'], FlowNode['id'][]> = {
  browser: ['browser'],
  form: ['browser', 'form'],
  vercel: ['browser', 'form', 'vercel'],
  resend: ['browser', 'form', 'vercel', 'resend'],
  inbox: ['browser', 'form', 'vercel', 'resend', 'inbox'],
  calendly: ['browser', 'calendly', 'inbox'],
  maps: ['browser', 'maps'],
};
const lit = new Set(paths[selected]);
const node = (id: FlowNode['id']) => nodes.find((n) => n.id === id)!;
---

<div class="flow" data-instrument="flow" data-sel={selected} data-paths={JSON.stringify(paths)}>
  <div class="flow__map" role="group" aria-label="Where an enquiry goes: select a step">
    {
      chain.map((n, i) => (
        <>
          <button
            type="button"
            class:list={['flow__node', `flow__node--${n.party}`, { 'is-lit': lit.has(n.id), 'is-sel': n.id === selected }]}
            style={`grid-area:${n.id}`}
            aria-pressed={n.id === selected ? 'true' : 'false'}
            aria-controls={`flow-panel-${n.id}`}
            data-node={n.id}
          >
            <span class="label flow__party">{partyLabel[n.party]}</span>
            <span class="flow__name">{n.name}</span>
            <span class="flow__who">{n.who}</span>
          </button>
          {i < chain.length - 1 && (
            <span class:list={['flow__link', { 'is-lit': lit.has(chain[i + 1]!.id) && lit.has(n.id) }]} style={`grid-area:l${i + 1}`} data-link={chain[i + 1]!.id} data-from={n.id} aria-hidden="true">
              <i />
            </span>
          )}
        </>
      ))
    }

    <span class:list={['flow__bus', { 'is-lit': lit.has('calendly') }]} data-link="calendly" data-from="browser" aria-hidden="true">
      <span class="flow__bus-text flow__bus-text--a">You book a call</span>
      <span class="flow__bus-text flow__bus-text--b">Booking shared with us</span>
    </span>
    <span class:list={['flow__drop', { 'is-lit': lit.has('maps') }]} data-link="maps" data-from="browser" aria-hidden="true"><i /></span>
    <p class="label flow__tp" aria-hidden="true">Third parties, under their own policies</p>

    {
      [node('calendly'), node('maps')].map((n) => (
        <button
          type="button"
          class:list={['flow__node flow__node--third', { 'is-lit': lit.has(n.id), 'is-sel': n.id === selected }]}
          style={`grid-area:${n.id}`}
          aria-pressed="false"
          aria-controls={`flow-panel-${n.id}`}
          data-node={n.id}
        >
          <span class="label flow__party">{partyLabel[n.party]}</span>
          <span class="flow__name">{n.name}</span>
          <span class="flow__who">{n.who}</span>
        </button>
      ))
    }

    <p class="flow__legend" aria-hidden="true">
      <span><i class="flow__key"></i>Your enquiry, over HTTPS</span>
      <span><i class="flow__key flow__key--dash"></i>Third party, its own policy</span>
    </p>
  </div>

  <div class="flow__panels" aria-live="polite">
    {
      nodes.map((n) => (
        <section class:list={['flow__panel', { 'is-active': n.id === selected }]} id={`flow-panel-${n.id}`} data-panel={n.id} aria-label={n.name}>
          <header class="flow__panel-head">
            <p class="flow__panel-name">{n.name}</p>
            <p class="flow__panel-who">{n.who}</p>
          </header>
          <dl class="flow__facts">
            <div>
              <dt class="label">What it handles</dt>
              <dd>{n.handles}</dd>
            </div>
            <div>
              <dt class="label">Why</dt>
              <dd>{n.why}</dd>
            </div>
            <div class="flow__kept">
              <dt class="label">How long it’s kept</dt>
              <dd>{n.kept}</dd>
            </div>
          </dl>
          <a class="more flow__ref" href={`#${n.ref.id}`}>
            From the policy: {n.ref.label}
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" aria-hidden="true"><path d="M12 4v16M6 14l6 6 6-6" /></svg>
          </a>
        </section>
      ))
    }
  </div>
  <p class="flow__hint small muted">Select any step to see what it handles. Questions: <a class="link" href={`mailto:${site.email}`}>{site.email}</a></p>
</div>

<style>
  .flow { display: grid; gap: var(--s-5); --gap: 1.75rem; }

  /* ---- The map: phone layout first (one column), then the diagram ---- */
  .flow__map {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-areas:
      'browser browser'
      'l1 l1'
      'form form'
      'l2 l2'
      'vercel vercel'
      'l3 l3'
      'resend resend'
      'l4 l4'
      'inbox inbox'
      'tp tp'
      'calendly maps'
      'legend legend';
    column-gap: var(--s-2);
  }
  @media (min-width: 40rem) {
    .flow__map {
      grid-template-columns: repeat(4, minmax(0, 1fr) var(--gap)) minmax(0, 1fr);
      grid-template-rows: auto var(--gap) auto var(--gap) auto;
      grid-template-areas:
        '. . . . calendly . . . .'
        '. . . . . . . . .'
        'browser l1 form l2 vercel l3 resend l4 inbox'
        'lm . . . . . . . .'
        'maps . legend legend legend legend legend legend legend';
      column-gap: 0;
    }
  }

  .flow__node {
    position: relative;
    z-index: 1;
    display: grid;
    align-content: start;
    gap: 0.35rem;
    min-height: 44px;
    padding: var(--s-3);
    text-align: left;
    background: var(--ground);
    border: 1px solid var(--rule-strong);
    transition: transform var(--t-press) var(--ease-out), opacity var(--t-ui) ease, background-color var(--t-ui) ease, border-color var(--t-ui) ease, color var(--t-ui) ease;
  }
  @media (min-width: 40rem) { .flow__node { min-height: 7.5rem; } }
  .flow__node:active { transform: scale(0.97); }
  .flow__node--third { border-style: dashed; }
  .flow__party { color: var(--ink-3); font-size: 0.6875rem; }
  .flow__name { font-size: 1rem; font-weight: 700; font-stretch: 112%; line-height: 1.15; }
  .flow__who { font-size: 0.8125rem; color: var(--ink-2); line-height: 1.3; }
  @media (min-width: 40rem) { .flow__who { margin-top: auto; } }
  /* Isolate the selected path, dim the rest. */
  .flow[data-instrument-ready] .flow__node:not(.is-lit) { opacity: 0.55; }
  .flow__node.is-lit { border-color: var(--ink); border-style: solid; }
  .flow__node.is-sel {
    background: var(--field);
    border-color: var(--field);
    color: var(--field-ink);
    --ink-2: var(--field-ink-2);
    --ink-3: var(--field-ink-2);
  }
  @media (hover: hover) and (pointer: fine) { .flow__node:hover { opacity: 1 !important; border-color: var(--ink); } }

  /* Links: a hairline, with a lime line that draws over it when the path is lit. */
  .flow__link { position: relative; min-height: var(--gap); }
  .flow__link::before, .flow__link::after { content: ''; position: absolute; left: 50%; top: 0; bottom: 0; width: 1px; background: var(--rule-strong); }
  .flow__link::after { width: 3px; margin-left: -1px; background: var(--accent); transform-origin: 50% 0; transform: scaleY(0); transition: transform 240ms var(--ease-out); }
  .flow__link.is-lit::after { transform: scaleY(1); }
  .flow__link i { position: absolute; left: 50%; bottom: 0; width: 9px; height: 6px; margin-left: -4px; background: var(--rule-strong); clip-path: polygon(0 0, 100% 0, 50% 100%); transition: background-color var(--t-ui) ease; }
  .flow__link.is-lit i { background: var(--accent); }
  @media (min-width: 40rem) {
    .flow__link::before, .flow__link::after { left: 0; right: 0; top: 50%; bottom: auto; width: auto; height: 1px; }
    .flow__link::after { height: 3px; margin: -1px 0 0; transform-origin: 0 50%; transform: scaleX(0); }
    .flow__link.is-lit::after { transform: scaleX(1); }
    .flow__link i { left: auto; right: 0; top: 50%; bottom: auto; width: 6px; height: 9px; margin: -4px 0 0; clip-path: polygon(0 0, 100% 50%, 0 100%); }
  }
  /* Stagger the draw along the path. */
  .flow__link[data-link='vercel']::after { transition-delay: 60ms; }
  .flow__link[data-link='resend']::after { transition-delay: 120ms; }
  .flow__link[data-link='inbox']::after { transition-delay: 180ms; }

  .flow__bus, .flow__drop { display: none; }
  .flow__tp { grid-area: tp; padding: var(--s-5) 0 var(--s-2); color: var(--ink-2); }
  .flow__legend { grid-area: legend; display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-5); padding-top: var(--s-4); font-size: 0.8125rem; color: var(--ink-2); }
  .flow__key { display: inline-block; width: 1.75rem; height: 0; margin-right: 0.5rem; border-top: 1px solid var(--ink); vertical-align: middle; }
  .flow__key--dash { border-top-style: dashed; }

  @media (min-width: 40rem) {
    .flow__tp { display: none; }
    .flow__legend { align-self: end; justify-content: flex-end; padding-top: 0; }
    /* The bus: from the browser, up and over to Calendly, then down to the inbox. */
    .flow__bus { display: block; position: relative; grid-row: 1 / 3; grid-column: 1 / -1; pointer-events: none; }
    .flow__bus::before {
      content: '';
      position: absolute;
      top: calc((100% - var(--gap)) / 2);
      bottom: 0;
      left: calc((100% - 4 * var(--gap)) / 10);
      right: calc((100% - 4 * var(--gap)) / 10);
      border: 1px dashed var(--rule-strong);
      border-bottom: 0;
      transition: border-color var(--t-ui) ease;
    }
    .flow__bus.is-lit::before { border: 2px solid var(--accent); border-bottom: 0; }
    .flow__bus-text { position: absolute; top: calc((100% - var(--gap)) / 2 - 1.35rem); font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--ink-3); white-space: nowrap; }
    .flow__bus-text--a { left: calc((100% - 4 * var(--gap)) / 10 + 0.5rem); }
    .flow__bus-text--b { right: calc((100% - 4 * var(--gap)) / 10 + 0.5rem); }
    .flow__bus.is-lit .flow__bus-text { color: var(--ink); }
    .flow__drop { display: block; position: relative; grid-area: lm; }
    .flow__drop::before { content: ''; position: absolute; left: 50%; top: 0; bottom: 0; border-left: 1px dashed var(--rule-strong); }
    .flow__drop.is-lit::before { border-left: 2px solid var(--accent); }
    .flow__node[data-node='calendly'], .flow__node[data-node='maps'] { min-height: 5.5rem; }
  }
  @media (min-width: 40rem) and (max-width: 52rem) { .flow__bus-text { display: none; } }

  /* ---- Panels ---- */
  .flow__panel { display: grid; gap: var(--s-4); border-top: 1px solid var(--rule-strong); padding-top: var(--s-4); }
  .flow__panel + .flow__panel { margin-top: var(--s-6); }
  :global(html.js) .flow__panel:not(.is-active) { display: none; }
  :global(html.js) .flow__panel + .flow__panel { margin-top: 0; }
  .flow__panel-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--s-1) var(--s-4); }
  .flow__panel-name { font-size: var(--t-h3); font-weight: 750; font-stretch: 125%; line-height: 1.1; text-transform: uppercase; letter-spacing: -0.01em; }
  .flow__panel-who { color: var(--ink-2); font-size: var(--t-small); }
  .flow__facts { display: grid; gap: 1px; background: var(--rule); border: 1px solid var(--rule); }
  @media (min-width: 40rem) { .flow__facts { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .flow__facts > div { display: grid; align-content: start; gap: var(--s-2); padding: var(--s-4); background: var(--plate); }
  .flow__facts dt { color: var(--ink-2); }
  .flow__facts dd { font-size: var(--t-small); line-height: 1.5; }
  .flow__facts > .flow__kept { background: var(--plate-2); }
  .flow__kept dd { font-weight: 600; }
  @media (prefers-reduced-motion: no-preference) {
    .flow__panel.is-active { animation: flow-in 260ms var(--ease-out); }
  }
  @keyframes flow-in { from { opacity: 0; transform: translateY(6px); } }
  .flow__ref { justify-self: start; font-size: var(--t-small); }
  .flow__hint { max-width: none; }
  :global(html:not(.js)) .flow__hint { display: none; }
</style>
