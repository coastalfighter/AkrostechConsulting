---
/**
 * 404 hero instrument: the wrong turn. The requested address is drawn as a route whose
 * segments are checked against the real site; the first segment that leads nowhere is shown
 * broken. Beside it, a type-to-find box searches every page on the site (built here, at build
 * time, from the data files) with fuzzy scoring and keyboard-navigable results. The closest
 * match to the broken address is offered first. Without JavaScript the box searches articles.
 */
import type { SearchEntry } from '@/lib/fuzzy';

interface Props {
  entries: SearchEntry[];
  /** Shown before the visitor types: the old 404 shortcuts. */
  starters: SearchEntry[];
}

const { entries, starters } = Astro.props;
const known = entries.map((e) => e.path);
---

<div class="wt" data-instrument="lost">
  <div class="wt__route-box">
    <div class="wt__route-head">
      <p class="label wt__key">Requested route</p>
      <p class="label wt__status"><span class="wt__code">404</span> No page at this address</p>
    </div>
    <ol class="wt__route" role="list" data-route aria-label="The address you followed, segment by segment">
      <li class="wt__seg wt__seg--root"><span class="wt__seg-name">akrosstech.com</span><span class="wt__seg-state">Home exists</span></li>
      <li class="wt__seg wt__seg--broken">
        <span class="wt__seg-name" data-broken-name>the page you followed</span><span class="wt__seg-state">Not found</span>
      </li>
    </ol>
    <p class="wt__suggest" data-suggest hidden>
      <span class="label wt__key">Closest page</span>
      <a class="wt__suggest-link" href="/" data-suggest-link><span data-suggest-title>Home</span> <span class="wt__suggest-path" data-suggest-path>/</span></a>
    </p>
  </div>

  <div class="wt__find">
    <form class="wt__form" action="/blog" method="get" role="search" data-find>
      <label class="input">
        <span class="input__label">Find a page by name</span>
        <span class="wt__field">
          <svg class="icon wt__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
          <input
            class="input__control wt__input"
            type="search"
            name="q"
            autocomplete="off"
            spellcheck="false"
            enterkeyhint="go"
            placeholder="Try “bookkeeping” or “Shopify”"
            data-input
          />
        </span>
      </label>
    </form>
    <div class="wt__results-head">
      <p class="label wt__key" data-results-label>Start from here</p>
      <p class="label wt__count" data-results-count aria-live="polite"></p>
    </div>
    <ul class="wt__results" role="list" id="wt-results" data-results>
      {
        starters.map((e) => (
          <li class="wt__result">
            <a class="wt__result-link" href={e.path}>
              <span class="label wt__result-group">{e.group}</span>
              <span class="wt__result-title">{e.title}</span>
              <span class="wt__result-body">{e.body ?? e.path}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="wt__keys small muted" aria-hidden="true"><kbd>↑</kbd><kbd>↓</kbd> to move, <kbd>Enter</kbd> to open</p>
  </div>

  <script type="application/json" data-pages set:html={JSON.stringify({ entries, starters, known })} />
</div>

<style is:global>
  .wt { display: grid; gap: var(--s-5); }

  /* ---- Route ---- */
  .wt__route-box { display: grid; gap: var(--s-4); padding: var(--s-5); border: 1px solid var(--rule-strong); background: var(--plate); }
  .wt__route-head { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--s-2) var(--s-4); }
  .wt__key { color: var(--ink-2); }
  .wt__status { color: var(--danger); display: inline-flex; align-items: center; gap: var(--s-2); }
  .wt__code { padding: 0.1rem 0.4rem; border: 1px solid currentColor; font-variant-numeric: tabular-nums; }

  .wt__route { display: flex; flex-wrap: wrap; align-items: stretch; row-gap: var(--s-3); }
  .wt__seg { position: relative; display: grid; gap: 0.2rem; padding: 0.6rem 0.8rem; border: 1px solid var(--ink); background: var(--ground); max-width: 100%; }
  .wt__seg + .wt__seg { margin-left: 2.25rem; }
  /* Connector to the previous segment. */
  .wt__seg + .wt__seg::before { content: ''; position: absolute; right: 100%; top: 50%; width: 2.25rem; border-top: 2px solid var(--ink); }
  .wt__seg-name { font-weight: 700; font-stretch: 112%; overflow-wrap: anywhere; font-variant-numeric: tabular-nums; }
  .wt__seg-state { font-size: 0.6875rem; font-weight: 650; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-2); }
  .wt__seg--root { background: var(--field); border-color: var(--field); color: var(--field-ink); }
  .wt__seg--root .wt__seg-state { color: var(--field-ink-2); }
  .wt__seg--broken { border: 1px dashed var(--danger); background: transparent; }
  .wt__seg--broken .wt__seg-name { text-decoration: line-through; text-decoration-color: var(--danger); text-decoration-thickness: 2px; }
  .wt__seg--broken .wt__seg-state { color: var(--danger); }
  /* The break: the line stops short and a cross marks where the route gives out. */
  .wt__seg--broken::before { border-top: 2px dashed var(--danger) !important; }
  .wt__seg--broken::after { content: ''; position: absolute; right: calc(100% + 0.7rem); top: calc(50% - 0.5rem); width: 1rem; height: 1rem; background: var(--danger); clip-path: polygon(20% 0, 50% 30%, 80% 0, 100% 20%, 70% 50%, 100% 80%, 80% 100%, 50% 70%, 20% 100%, 0 80%, 30% 50%, 0 20%); }
  .wt__seg--after { border: 1px dashed var(--rule-strong); background: transparent; color: var(--ink-3); }
  .wt__seg--after::before { border-top: 2px dashed var(--rule-strong) !important; }
  @media (max-width: 39.99rem) {
    .wt__route { flex-direction: column; align-items: flex-start; row-gap: 0; }
    .wt__seg + .wt__seg { margin-left: 0; margin-top: 1.75rem; }
    .wt__seg + .wt__seg::before { right: auto; left: 1rem; top: auto; bottom: 100%; width: 0; height: 1.75rem; border-top: 0; border-left: 2px solid var(--ink); }
    .wt__seg--broken::before { border-top: 0 !important; border-left: 2px dashed var(--danger) !important; }
    .wt__seg--after::before { border-top: 0 !important; border-left: 2px dashed var(--rule-strong) !important; }
    .wt__seg--broken::after { right: auto; left: 1.6rem; top: -1.4rem; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .wt[data-instrument-ready] .wt__seg { animation: wt-in 320ms var(--ease-out) both; animation-delay: calc(var(--i, 0) * 90ms); }
    .wt[data-instrument-ready] .wt__seg--broken::after { animation: wt-snap 420ms var(--ease-out) both; animation-delay: calc(var(--i, 0) * 90ms + 200ms); }
  }
  @keyframes wt-in { from { opacity: 0; transform: translateX(-8px); } }
  @keyframes wt-snap { from { opacity: 0; transform: scale(0.6) rotate(-45deg); } }

  .wt__suggest { display: grid; gap: var(--s-2); padding-top: var(--s-4); border-top: 1px solid var(--rule); }
  .wt__suggest[hidden] { display: none; }
  .wt__suggest-link { display: inline-flex; flex-wrap: wrap; align-items: baseline; gap: 0.25rem 0.75rem; min-height: 44px; align-content: center; text-decoration: none; font-size: 1.25rem; font-weight: 700; font-stretch: 112%; }
  .wt__suggest-link > span:first-child { text-decoration: underline; text-decoration-color: var(--accent); text-decoration-thickness: 2px; text-underline-offset: 0.2em; }
  .wt__suggest-path { font-size: 0.875rem; font-weight: 550; color: var(--ink-2); overflow-wrap: anywhere; }

  /* ---- Finder ---- */
  .wt__find { display: grid; gap: var(--s-3); }
  .wt__field { position: relative; display: block; }
  .wt__icon { position: absolute; left: 0.9rem; top: 50%; translate: 0 -50%; color: var(--ink-2); pointer-events: none; }
  .wt__input { padding-left: 2.75rem; font-size: 1.0625rem; }
  .wt__input::-webkit-search-cancel-button { filter: grayscale(1); }
  .wt__results-head { display: flex; justify-content: space-between; gap: var(--s-3); padding-top: var(--s-2); }
  .wt__count { color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .wt__results { list-style: none; padding: 0; border-top: 1px solid var(--rule-strong); min-height: 18rem; }
  .wt__result { border-bottom: 1px solid var(--rule); }
  .wt__result-link {
    position: relative;
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 0.15rem var(--s-4);
    align-items: baseline;
    padding: 0.7rem 0.75rem;
    text-decoration: none;
    transition: background-color var(--t-ui) ease, color var(--t-ui) ease;
  }
  .wt__result-group { grid-row: 1 / span 2; color: var(--ink-3); font-size: 0.6875rem; padding-top: 0.25rem; }
  .wt__result-title { font-weight: 650; font-stretch: 112%; line-height: 1.25; }
  .wt__result-title mark { background: none; color: inherit; text-decoration: underline; text-decoration-color: var(--accent); text-decoration-thickness: 2px; text-underline-offset: 0.18em; }
  .wt__result-body { grid-column: 2; font-size: 0.8125rem; color: var(--ink-2); overflow-wrap: anywhere; }
  .wt__result[aria-selected='true'] .wt__result-link { background: var(--field); color: var(--field-ink); --ink-2: var(--field-ink-2); --ink-3: var(--field-ink-2); --accent: var(--field-ink); }
  @media (hover: hover) and (pointer: fine) { .wt__result:not([aria-selected='true']) .wt__result-link:hover { background: var(--plate); } }
  @media (max-width: 30rem) {
    .wt__result-link { grid-template-columns: 1fr; }
    .wt__result-group { grid-row: auto; padding-top: 0; }
    .wt__result-body { grid-column: 1; }
  }
  .wt__empty { padding: var(--s-4) 0.75rem; color: var(--ink-2); }
  .wt__keys { display: flex; gap: 0.35rem; align-items: center; }
  .wt__keys kbd { display: inline-grid; place-items: center; min-width: 1.5rem; height: 1.5rem; padding: 0 0.3rem; border: 1px solid var(--rule-strong); font: inherit; font-size: 0.75rem; font-weight: 650; }
  html:not(.js) .wt__keys { display: none; }
  @media (hover: none) { .wt__keys { display: none; } }
</style>
