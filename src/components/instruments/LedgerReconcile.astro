---
/**
 * Accounting hero instrument: a mini bank reconciliation on sample data. Bank feed lines on the
 * left, ledger entries on the right, in different orders and wording. "Reconcile next" (or a
 * line's own Match button) pairs a bank line with its ledger entry; the unreconciled difference
 * counts down to $0.00 and a five-day close calendar advances as reconciliation completes.
 * Server-rendered with three lines matched, so it reads without JavaScript.
 */
interface Line {
  id: string;
  date: string;
  text: string;
  amount: number;
}

const bank: Line[] = [
  { id: 'B1', date: 'Apr 01', text: 'PROCESSOR PAYOUT 0401', amount: 4812.5 },
  { id: 'B2', date: 'Apr 03', text: 'ACH PAYROLL PROVIDER', amount: -3240 },
  { id: 'B3', date: 'Apr 05', text: 'CLOUD HOSTING SVCS', amount: -186.42 },
  { id: 'B4', date: 'Apr 09', text: 'DEPOSIT REF INV-1042', amount: 2150 },
  { id: 'B5', date: 'Apr 15', text: 'OFFICE RENT ACH', amount: -1900 },
  { id: 'B6', date: 'Apr 22', text: 'CORP CARD SETTLEMENT', amount: -611.88 },
  { id: 'B7', date: 'Apr 30', text: 'MONTHLY SERVICE FEE', amount: -25 },
];

/** Ledger entries, in the ledger's own order; `pair` is the bank line each one matches. */
const ledger: (Line & { pair: string })[] = [
  { id: 'L1', date: 'Apr 01', text: 'Sales receipts, card processor', amount: 4812.5, pair: 'B1' },
  { id: 'L2', date: 'Apr 02', text: 'Payroll, April 1–15', amount: -3240, pair: 'B2' },
  { id: 'L3', date: 'Apr 05', text: 'Rent, April', amount: -1900, pair: 'B5' },
  { id: 'L4', date: 'Apr 05', text: 'Hosting expense', amount: -186.42, pair: 'B3' },
  { id: 'L5', date: 'Apr 08', text: 'Invoice 1042, customer payment', amount: 2150, pair: 'B4' },
  { id: 'L6', date: 'Apr 21', text: 'Corporate card, March statement', amount: -611.88, pair: 'B6' },
  { id: 'L7', date: 'Apr 30', text: 'Bank charges', amount: -25, pair: 'B7' },
];

const matched = new Set(['B1', 'B2', 'B3']);
const partnerOfBank = (id: string) => ledger.find((l) => l.pair === id)?.id ?? '';

const money = (n: number) => n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const signed = (n: number) => `${n < 0 ? '−' : '+'}${money(Math.abs(n))}`;
const open = bank.filter((b) => !matched.has(b.id)).reduce((s, b) => s + Math.abs(b.amount), 0);

const days = [
  { day: 'Day 1', title: 'Payouts booked' },
  { day: 'Day 2', title: 'Bank and cards reconciled' },
  { day: 'Day 3', title: 'Accruals and prepaids' },
  { day: 'Day 4', title: 'Controller review' },
  { day: 'Day 5', title: 'Reports sent' },
];
---

<div class="lg" data-instrument="ledger" data-matched={[...matched].join(',')}>
  <div class="lg__top">
    <p class="lg__title">
      <span class="label">Sample data</span>
      <span class="small muted">Operating account, April close</span>
    </p>
    <div class="lg__actions">
      <button type="button" class="btn btn--primary btn--small" data-next>Reconcile next</button>
      <button type="button" class="lg__reset small" data-reset>Start over</button>
    </div>
  </div>

  <div class="lg__diff" aria-live="polite">
    <p class="lg__diff-key label">Unreconciled difference</p>
    <p class="lg__fig" data-out="diff">${money(open)}</p>
    <p class="lg__progress small">
      <span class="lg__segs" aria-hidden="true">{bank.map((b) => <i class:list={{ 'is-on': matched.has(b.id) }} data-seg={b.id} />)}</span>
      <span><b data-out="matched">{matched.size}</b> of {bank.length} lines matched</span>
    </p>
  </div>

  <div class="lg__cols">
    <section class="lg__col" aria-label="Bank feed">
      <h2 class="lg__col-head"><span class="label">Bank feed</span><span class="small muted">Imported</span></h2>
      <ol class="lg__lines" role="list">
        {
          bank.map((b) => (
            <li class:list={['lg__line', { 'is-matched': matched.has(b.id) }]} data-bank={b.id} data-amount={b.amount}>
              <span class="lg__meta">
                <b>{b.id}</b> {b.date}
              </span>
              <span class="lg__text lg__text--bank">{b.text}</span>
              <span class="lg__amt tabular">{signed(b.amount)}</span>
              <span class="lg__state">
                <button type="button" class="lg__match" data-match={b.id} aria-label={`Match ${b.id}, ${b.text}`}>
                  Match
                </button>
                <span class="lg__tick" aria-hidden="true" />
                <span class="lg__pair">
                  <span class="sr-only">Matched to</span> {partnerOfBank(b.id)}
                </span>
              </span>
            </li>
          ))
        }
      </ol>
    </section>
    <section class="lg__col" aria-label="Ledger">
      <h2 class="lg__col-head"><span class="label">Ledger</span><span class="small muted">Booked</span></h2>
      <ol class="lg__lines" role="list">
        {
          ledger.map((l) => (
            <li class:list={['lg__line', { 'is-matched': matched.has(l.pair) }]} data-ledger={l.id} data-pair={l.pair}>
              <span class="lg__meta">
                <b>{l.id}</b> {l.date}
              </span>
              <span class="lg__text">{l.text}</span>
              <span class="lg__amt tabular">{signed(l.amount)}</span>
              <span class="lg__state">
                <button type="button" class="lg__match" data-match={l.pair} aria-label={`Match ${l.id}, ${l.text}`}>
                  Match
                </button>
                <span class="lg__tick" aria-hidden="true" />
                <span class="lg__pair">
                  <span class="sr-only">Matched to</span> {l.pair}
                </span>
              </span>
            </li>
          ))
        }
      </ol>
    </section>
  </div>

  <ol class="lg__close" role="list" aria-label="Five-day close calendar">
    {
      days.map((d, i) => (
        <li class:list={['lg__day', { 'is-done': i === 0, 'is-now': i === 1 }]} data-day={i}>
          <span class="label lg__day-n">{d.day}</span>
          <span class="lg__day-title">{d.title}</span>
          <span class="lg__day-state small" data-day-state>
            {i === 0 ? 'Done' : i === 1 ? 'In progress' : 'Next'}
          </span>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .lg { display: grid; gap: var(--s-4); }
  .lg__top { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--s-3) var(--s-5); }
  .lg__title { display: grid; gap: 2px; }
  .lg__actions { display: flex; align-items: center; gap: var(--s-4); }
  .lg__reset { min-height: 44px; font-weight: 650; color: var(--ink); text-decoration: underline; text-underline-offset: 0.25em; text-decoration-color: var(--rule-strong); }
  @media (hover: hover) and (pointer: fine) { .lg__reset:hover { text-decoration-color: currentColor; } }

  /* ---- The difference ---- */
  .lg__diff {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: var(--s-2) var(--s-5);
    padding: var(--s-4) var(--s-5);
    background: var(--plate);
    border: 1px solid var(--rule);
    transition: background-color 400ms ease, color 400ms ease;
  }
  .lg__diff-key { grid-column: 1 / -1; color: var(--ink-2); }
  .lg__fig { font-size: clamp(2.5rem, 1.6rem + 3vw, 4.25rem); font-weight: 750; font-stretch: 125%; line-height: 0.86; letter-spacing: -0.035em; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .lg__progress { display: grid; gap: var(--s-2); justify-items: end; color: var(--ink-2); font-variant-numeric: tabular-nums; }
  .lg__progress b { color: var(--ink); }
  .lg__segs { display: flex; gap: 3px; }
  .lg__segs i { width: 0.9rem; height: 0.5rem; background: var(--plate-3); transition: background-color var(--t-ui) ease; }
  .lg__segs i.is-on { background: var(--accent-text); }
  .lg.is-done .lg__diff { background: var(--field); color: var(--field-ink); --ink: var(--field-ink); --ink-2: var(--field-ink-2); --accent-text: var(--carbon-950); --plate-3: rgb(11 12 10 / 0.15); border-color: var(--field); }

  /* ---- Two columns ---- */
  .lg__cols { display: grid; gap: 1px; background: var(--rule); border: 1px solid var(--rule); }
  @media (min-width: 40rem) { .lg__cols { grid-template-columns: 1fr 1fr; } }
  .lg__col { background: var(--ground); min-width: 0; }
  .lg__col-head { display: flex; justify-content: space-between; align-items: baseline; padding: var(--s-2) var(--s-3) var(--s-2) var(--s-4); border-bottom: 1px solid var(--rule-strong); font-weight: inherit; }
  .lg__line {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto 3.25rem;
    grid-template-rows: auto auto;
    column-gap: var(--s-3);
    align-items: center;
    padding: 0.35rem var(--s-2) 0.35rem var(--s-4);
    min-height: 3.5rem;
    transition: background-color var(--t-ui) ease;
  }
  .lg__line + .lg__line { border-top: 1px solid var(--rule); }
  .lg__meta { grid-column: 1; font-size: 0.6875rem; letter-spacing: 0.04em; color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .lg__meta b { color: var(--ink-2); font-weight: 700; margin-right: 0.25rem; }
  .lg__text { grid-column: 1; font-size: 0.875rem; line-height: 1.25; font-weight: 550; overflow-wrap: anywhere; }
  .lg__text--bank { font-size: 0.8125rem; letter-spacing: 0.02em; font-stretch: 112%; }
  .lg__amt { grid-column: 2; grid-row: 1 / span 2; font-size: 0.9375rem; font-weight: 650; text-align: right; white-space: nowrap; }
  .lg__state { grid-column: 3; grid-row: 1 / span 2; display: grid; place-items: center; position: relative; min-height: 44px; }
  .lg__match {
    width: 100%;
    min-height: 44px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    border: 1px solid var(--rule-strong);
    transition: background-color var(--t-ui) ease, border-color var(--t-ui) ease, transform var(--t-press) var(--ease-out);
  }
  .lg__match:active { transform: scale(0.94); }
  @media (hover: hover) and (pointer: fine) { .lg__match:hover { border-color: var(--ink); background: var(--plate-2); } }
  .lg__tick, .lg__pair { display: none; }
  .lg__line.is-matched { background: var(--plate); }
  .lg__line.is-matched .lg__text, .lg__line.is-matched .lg__amt { color: var(--ink-2); }
  .lg__line.is-matched .lg__match { display: none; }
  .lg__line.is-matched .lg__tick {
    display: block;
    width: 1.5rem;
    height: 1.5rem;
    background: var(--lime-400);
    position: relative;
  }
  .lg__line.is-matched .lg__tick::after {
    content: '';
    position: absolute;
    inset: 0.3rem;
    background: var(--carbon-950);
    clip-path: polygon(0 50%, 35% 85%, 100% 10%, 100% 30%, 35% 100%, 0 68%);
  }
  .lg__line.is-matched .lg__pair { display: block; font-size: 0.6875rem; font-weight: 700; color: var(--ink-2); letter-spacing: 0.04em; }
  .lg__line.is-matched .lg__state { align-content: center; gap: 2px; }
  .lg__line.just-matched .lg__tick { animation: lg-tick 260ms var(--ease-out); }
  @keyframes lg-tick { from { transform: scale(0.6); opacity: 0; } to { transform: none; opacity: 1; } }

  /* ---- Five-day close ---- */
  .lg__close { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 1px; background: var(--rule); border: 1px solid var(--rule); }
  .lg__day { display: grid; align-content: start; gap: 2px; padding: var(--s-3); background: var(--ground); min-width: 0; transition: background-color 300ms ease, color 300ms ease; }
  .lg__day-n { color: var(--ink-3); }
  .lg__day-title { font-size: 0.8125rem; font-weight: 650; line-height: 1.25; font-stretch: 112%; }
  .lg__day-state { font-size: 0.75rem; color: var(--ink-3); margin-top: var(--s-2); }
  .lg__day.is-now { background: var(--plate-2); }
  .lg__day.is-now .lg__day-state { color: var(--accent-text); font-weight: 650; }
  .lg__day.is-done { background: var(--field); color: var(--field-ink); }
  .lg__day.is-done .lg__day-n, .lg__day.is-done .lg__day-state { color: var(--field-ink-2); }

  @media (max-width: 39.99rem) {
    .lg__close { grid-template-columns: 1fr; }
    .lg__day { grid-template-columns: 4rem minmax(0, 1fr) auto; align-items: baseline; gap: var(--s-3); padding-block: var(--s-2); }
    .lg__day-state { margin-top: 0; }
    .lg__diff { grid-template-columns: 1fr; }
    .lg__progress { justify-items: start; }
  }

  :global(html:not(.js)) .lg__actions, :global(html:not(.js)) .lg__match { display: none; }
</style>
