---
/**
 * Legal hero instrument: contract abstraction. A sample agreement excerpt sits beside an
 * abstraction sheet. Choosing a field highlights the clause it comes from and fills that row;
 * "Abstract all" walks through every field. When renewal and notice are both abstracted, the
 * sheet derives the renewal-calendar entry. Generic sample text, no real parties.
 * Server-rendered with two fields abstracted and the term clause selected.
 */
interface Clause {
  id: string;
  section: string;
  field: string;
  heading: string;
  pre: string;
  span: string;
  post: string;
  value: string;
}

const clauses: Clause[] = [
  {
    id: 'parties',
    section: '1.1',
    field: 'Parties',
    heading: 'Parties',
    pre: 'This Master Services Agreement is entered into as of the Effective Date between ',
    span: 'the customer named in the Order Form (“Customer”) and the service provider named in the Order Form (“Provider”)',
    post: '.',
    value: 'Customer and Provider, as named in the Order Form',
  },
  {
    id: 'term',
    section: '2.1',
    field: 'Initial term',
    heading: 'Term',
    pre: 'The initial term begins on the Effective Date and continues for ',
    span: 'twelve (12) months',
    post: ', unless terminated earlier under Section 9.',
    value: '12 months from the Effective Date',
  },
  {
    id: 'renewal',
    section: '2.2',
    field: 'Auto-renewal',
    heading: 'Renewal',
    pre: 'Thereafter, this Agreement ',
    span: 'renews automatically for successive twelve (12) month periods',
    post: ' unless either party gives notice of non-renewal under Section 9.1.',
    value: 'Yes, successive 12-month terms',
  },
  {
    id: 'notice',
    section: '9.1',
    field: 'Termination notice',
    heading: 'Notice of non-renewal',
    pre: 'Either party may give notice of non-renewal ',
    span: 'no less than sixty (60) days before the end of the then-current term',
    post: '. Either party may terminate for a material breach not cured within thirty (30) days of written notice.',
    value: '60 days before term end; 30-day cure for breach',
  },
  {
    id: 'liability',
    section: '11.2',
    field: 'Limitation of liability',
    heading: 'Limitation of liability',
    pre: 'Except for breaches of confidentiality, each party’s total liability under this Agreement ',
    span: 'is capped at the fees paid in the twelve (12) months before the claim',
    post: '.',
    value: 'Capped at 12 months of fees; confidentiality excluded',
  },
  {
    id: 'law',
    section: '14.1',
    field: 'Governing law',
    heading: 'Governing law',
    pre: 'This Agreement is governed by ',
    span: 'the laws of the State of Delaware',
    post: ', and the parties submit to the exclusive jurisdiction of the state and federal courts located in Delaware.',
    value: 'Delaware law; Delaware courts',
  },
];

const done = new Set(['parties', 'term']);
const selected = 'term';
const derived = 'Non-renewal notice due 60 days before each anniversary';
---

<div class="ca" data-instrument="clauses" data-done={[...done].join(',')} data-selected={selected}>
  <div class="ca__top">
    <p class="ca__title">
      <span class="label">Sample agreement</span>
      <span class="small muted">Master services agreement, excerpt</span>
    </p>
    <div class="ca__actions">
      <button type="button" class="btn btn--primary btn--small" data-all>Abstract all</button>
      <button type="button" class="ca__reset small" data-reset>Clear sheet</button>
    </div>
  </div>

  <div class="ca__grid">
    <article class="ca__doc has-selection" aria-label="Sample agreement excerpt" data-doc>
      <h2 class="ca__doc-title">Master Services Agreement</h2>
      {
        clauses.map((c) => (
          <section class:list={['ca__clause', { 'is-selected': c.id === selected, 'is-done': done.has(c.id) }]} id={`ca-${c.id}`} data-clause={c.id}>
            <h3 class="ca__clause-h">
              <span class="ca__sec tabular">{c.section}</span> {c.heading}
            </h3>
            <p class="ca__clause-p">
              {c.pre}<mark class="ca__span">{c.span}</mark>{c.post}
            </p>
          </section>
        ))
      }
    </article>

    <div class="ca__sheet">
      <div class="ca__sheet-head">
        <h2 class="label">Abstraction sheet</h2>
        <p class="small muted" aria-live="polite">
          <b data-out="done">{done.size}</b> of {clauses.length} fields
        </p>
      </div>
      <ol class="ca__fields" role="list" data-fields>
        {
          clauses.map((c) => (
            <li>
              <button
                type="button"
                class:list={['ca__field', { 'is-done': done.has(c.id) }]}
                aria-pressed={c.id === selected ? 'true' : 'false'}
                aria-controls={`ca-${c.id}`}
                data-field={c.id}
                data-value={c.value}
                tabindex={c.id === selected ? 0 : -1}
              >
                <span class="ca__field-key">
                  <span class="ca__field-name">{c.field}</span>
                  <span class="ca__field-ref tabular">§ {c.section}</span>
                </span>
                <span class="ca__field-val" data-val>
                  {done.has(c.id) ? c.value : 'Not abstracted'}
                </span>
              </button>
            </li>
          ))
        }
      </ol>
      <div class="ca__derived" data-derived hidden>
        <p class="label">Added to the renewal calendar</p>
        <p class="ca__derived-text">{derived}</p>
      </div>
      <p class="ca__hint small muted">Choose a field to find its clause. Arrow keys move between fields.</p>
    </div>
  </div>
  <p class="ca__note small muted">Prepared for attorney review. Abstracts are work product for counsel to verify, not legal advice.</p>
</div>

<style>
  .ca { display: grid; gap: var(--s-4); }
  .ca__top { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--s-3) var(--s-5); }
  .ca__title { display: grid; gap: 2px; }
  .ca__actions { display: flex; align-items: center; gap: var(--s-4); }
  .ca__reset { min-height: 44px; font-weight: 650; color: var(--ink); text-decoration: underline; text-underline-offset: 0.25em; text-decoration-color: var(--rule-strong); }
  @media (hover: hover) and (pointer: fine) { .ca__reset:hover { text-decoration-color: currentColor; } }

  .ca__grid { display: grid; gap: 1px; background: var(--rule); border: 1px solid var(--rule); }
  @media (min-width: 40rem) { .ca__grid { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); } }

  /* ---- The document ---- */
  .ca__doc { background: var(--plate); padding: var(--s-4) var(--s-5) var(--s-5); display: grid; gap: var(--s-1); align-content: start; }
  .ca__doc-title { font-size: 0.8125rem; font-weight: 750; font-stretch: 125%; letter-spacing: 0.06em; text-transform: uppercase; padding-bottom: var(--s-3); margin-bottom: var(--s-2); border-bottom: 1px solid var(--rule-strong); }
  .ca__clause { padding: var(--s-2) var(--s-3); margin-inline: calc(var(--s-3) * -1); transition: opacity var(--t-ui) ease, background-color var(--t-ui) ease; }
  .ca__clause-h { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; font-stretch: 112%; color: var(--ink-2); display: flex; gap: var(--s-2); }
  .ca__sec { color: var(--ink-3); min-width: 2.25rem; }
  .ca__clause-p { font-size: 0.875rem; line-height: 1.5; color: var(--ink-2); }
  .ca__span { background: none; color: inherit; transition: background-color var(--t-ui) ease, color var(--t-ui) ease; }
  .ca__clause.is-done .ca__span { color: var(--ink); text-decoration: underline; text-decoration-color: var(--accent-text); text-decoration-thickness: 2px; text-underline-offset: 0.2em; }
  /* Isolate the selected clause, dim the rest */
  .ca__doc.has-selection .ca__clause:not(.is-selected) { color: var(--ink-3); }
  .ca__clause.is-selected { background: var(--ground); outline: 1px solid var(--rule-strong); }
  .ca__clause.is-selected .ca__clause-p { color: var(--ink); }
  .ca__clause.is-selected .ca__span { background: var(--field); color: var(--field-ink); text-decoration: none; box-decoration-break: clone; -webkit-box-decoration-break: clone; padding: 0.05em 0.15em; }

  /* ---- The sheet ---- */
  .ca__sheet { background: var(--ground); display: grid; align-content: start; }
  .ca__sheet-head { display: flex; justify-content: space-between; align-items: baseline; gap: var(--s-3); padding: var(--s-3) var(--s-4); border-bottom: 1px solid var(--rule-strong); }
  .ca__sheet-head h2 { font-weight: 600; }
  .ca__sheet-head b { color: var(--ink); }
  .ca__fields li + li { border-top: 1px solid var(--rule); }
  .ca__field {
    width: 100%;
    display: grid;
    gap: 2px;
    padding: var(--s-3) var(--s-4);
    min-height: 3.75rem;
    text-align: left;
    transition: background-color var(--t-ui) ease, color var(--t-ui) ease;
  }
  .ca__field:focus-visible { outline-offset: -3px; }
  .ca__field-key { display: flex; justify-content: space-between; gap: var(--s-3); }
  .ca__field-name { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; font-stretch: 112%; color: var(--ink-2); }
  .ca__field-ref { font-size: 0.75rem; color: var(--ink-3); }
  .ca__field-val { font-size: 0.9375rem; font-weight: 600; line-height: 1.3; color: var(--ink-3); }
  .ca__field.is-done .ca__field-val { color: var(--ink); }
  .ca__field.is-filling .ca__field-val { animation: ca-fill 260ms var(--ease-out); }
  @keyframes ca-fill { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }
  .ca__field[aria-pressed='true'] { background: var(--field); color: var(--field-ink); }
  .ca__field[aria-pressed='true'] .ca__field-name, .ca__field[aria-pressed='true'] .ca__field-ref { color: var(--field-ink-2); }
  .ca__field[aria-pressed='true'] .ca__field-val { color: var(--field-ink); }
  .ca__field[aria-pressed='true']:focus-visible { outline-color: var(--carbon-950); }
  @media (hover: hover) and (pointer: fine) { .ca__field:hover:not([aria-pressed='true']) { background: var(--plate-2); } }

  .ca__derived { margin: var(--s-3) var(--s-4) 0; padding: var(--s-3) var(--s-4); border: 1px solid var(--accent-text); display: grid; gap: var(--s-1); }
  .ca__derived .label { color: var(--accent-text); }
  .ca__derived-text { font-weight: 650; font-size: 0.9375rem; line-height: 1.3; }
  .ca__hint { padding: var(--s-3) var(--s-4) var(--s-4); }
  .ca__note { max-width: 60ch; }

  :global(html:not(.js)) .ca__actions, :global(html:not(.js)) .ca__hint { display: none; }
  :global(html:not(.js)) .ca__field { pointer-events: none; }
</style>
