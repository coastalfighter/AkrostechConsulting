---
/**
 * Guide finder (blog body): a live search and service filter over the guide grid that follows
 * it. A large query field, service chips with their counts, and a register of one cell per
 * guide that lights when it matches. The grid items carry the searchable text
 * ([data-filter-item], [data-cat], [data-text]); matched words in their titles are marked.
 * Without JavaScript the console is hidden and the grid is simply complete.
 */
import Icon from '../Icon.astro';
import { CATEGORIES } from '@/content.config';
import { categorySlug, type Post } from '@/lib/blog';

interface Props {
  posts: Post[];
  /** Id of the grid the filter drives (for aria-controls). */
  controls: string;
}
const { posts, controls } = Astro.props;
const total = posts.length;
const cats = CATEGORIES.map((c) => ({ name: c, slug: categorySlug(c), count: posts.filter((p) => p.data.category === c).length })).filter((c) => c.count > 0);
---

<div class="as ink-plate" data-instrument="search" data-total={total}>
  <div class="as__top">
    <search class="as__search">
      <form class="as__form" role="search" action="/blog" method="get" data-search-form>
        <label class="as__label" for="article-query">Search {total} guides</label>
        <div class="as__box">
          <Icon name="search" class="icon as__glass" />
          <input
            class="as__input"
            id="article-query"
            type="search"
            name="q"
            autocomplete="off"
            spellcheck="false"
            enterkeyhint="search"
            placeholder="Bookkeeping, SOPs, cost…"
            aria-describedby="article-count"
            aria-controls={controls}
            data-query
          />
          <button class="as__clear" type="button" aria-label="Clear the search" hidden data-clear>
            <Icon name="plus" class="icon as__x" />
          </button>
        </div>
      </form>
    </search>

    <div class="as__meter">
      <p class="as__count" id="article-count">
        <span class="as__shown" data-shown>{total}</span>
        <span class="as__of">of {total} guides<br />shown</span>
      </p>
      <ol class="as__register" role="list" aria-hidden="true">
        {posts.map((p) => <li class="as__cell is-on" data-cell={p.id} />)}
      </ol>
    </div>
  </div>

  <div class="as__cats">
    <p class="as__cats-label" id="as-cats-label">Filter by service</p>
    <div class="as__chips" role="group" aria-labelledby="as-cats-label">
      <button class="chip as__cat" type="button" aria-pressed="true" aria-controls={controls} data-cat="all">
        <span>All guides</span><span class="as__n">{total}</span>
      </button>
      {
        cats.map((c) => (
          <button class="chip as__cat" type="button" aria-pressed="false" aria-controls={controls} data-cat={c.slug}>
            <span>{c.name}</span>
            <span class="as__n">{c.count}</span>
          </button>
        ))
      }
    </div>
  </div>
  <p class="sr-only" role="status" aria-live="polite" data-status></p>
</div>

<style>
  .as {
    display: grid;
    gap: var(--s-6);
    min-width: 0;
    padding: clamp(1.25rem, 0.8rem + 2.4vw, 3rem);
    border-radius: calc(var(--radius) * 1.6);
  }
  .as__top { display: grid; gap: var(--s-6); align-items: end; }
  @media (min-width: 64rem) { .as__top { grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: var(--s-8); } }
  .as__search { min-width: 0; }
  .as__form { display: grid; gap: var(--s-3); }
  .as__label { font-size: var(--t-small); font-weight: 600; color: var(--ink-2); }
  .as__box {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--s-2);
    padding: 0.25rem 0.4rem 0.25rem 1.1rem;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-pill);
    background: var(--plate);
    transition: border-color var(--t-ui) ease, background-color var(--t-ui) ease;
  }
  .as__box:focus-within { border-color: var(--accent); }
  .as__box:has(.as__input:focus-visible) { outline: 2px solid var(--focus); outline-offset: 3px; }
  .as__glass { width: 1.5rem; height: 1.5rem; color: var(--ink-2); flex: none; }
  .as__input {
    flex: 1;
    min-width: 0;
    min-height: 3.75rem;
    padding: 0.4rem 0.4rem;
    background: transparent;
    border: 0;
    border-radius: 0;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1rem + 1vw, 1.875rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--ink);
    appearance: none;
  }
  .as__input::placeholder { color: var(--ink-3); font-weight: 400; }
  .as__input::-webkit-search-cancel-button { display: none; }
  .as__input:focus-visible { outline: none; }
  .as__clear { display: grid; place-items: center; width: 44px; height: 44px; flex: none; border-radius: 50%; color: var(--ink); border: 1px solid var(--rule-strong); transition: transform var(--t-press) var(--ease-out), border-color var(--t-ui) ease; }
  .as__clear:active { transform: scale(0.94); }
  .as__x { rotate: 45deg; width: 1.15rem; height: 1.15rem; }
  @media (hover: hover) and (pointer: fine) { .as__clear:hover { border-color: var(--ink); } }

  .as__meter { display: grid; gap: var(--s-3); }
  .as__count { display: flex; align-items: end; gap: var(--s-3); }
  .as__shown { font-family: var(--font-display); font-size: clamp(3rem, 2.2rem + 2.4vw, 4.5rem); font-weight: 700; line-height: 0.85; letter-spacing: -0.04em; font-variant-numeric: tabular-nums; min-width: 2ch; }
  .as__of { font-size: var(--t-small); line-height: 1.3; color: var(--ink-2); padding-bottom: 0.2rem; }
  .as__register { display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; gap: 4px; height: 2.25rem; }
  .as__cell { border-radius: 999px; background: var(--plate-3); transform-origin: 50% 100%; transform: scaleY(0.3); transition: transform var(--t-ui) var(--ease-out), background-color var(--t-ui) ease; }
  .as__cell.is-on { background: var(--accent); transform: none; }

  .as__cats { display: grid; gap: var(--s-3); padding-top: var(--s-5); border-top: 1px solid var(--rule); }
  .as__cats-label { font-size: var(--t-small); font-weight: 600; color: var(--ink-2); }
  .as__chips { display: flex; flex-wrap: wrap; gap: var(--s-2); }
  .as__cat { gap: var(--s-3); padding-inline: 1rem 0.45rem; font-weight: 600; }
  .as__n { display: inline-grid; place-items: center; min-width: 1.75rem; height: 1.75rem; padding-inline: 0.35rem; border-radius: 999px; font-size: 0.8125rem; font-variant-numeric: tabular-nums; background: var(--plate-3); color: var(--ink); }
  .as__cat[aria-pressed='true'] .as__n { background: var(--carbon-950); color: var(--lime-400); }
  .as__cat:disabled { opacity: 0.4; cursor: not-allowed; }

  :global(html:not(.js)) .as { display: none; }
</style>
