---
/**
 * Branded preloader, once per browser session on the first page a visitor opens.
 * The M-wave mark draws itself, the tagline rises, then the plate lifts away.
 * CSS only, so it always finishes even if JavaScript fails; skipped under reduced motion.
 */
import Logo from './Logo.astro';
---

<div class="preloader" aria-hidden="true">
  <div class="preloader__inner">
    <Logo wordmark={false} draw class="preloader__mark" />
    <p class="preloader__line"><span>Your team in India.</span></p>
    <p class="preloader__line preloader__line--lime"><span>Working your U.S. hours.</span></p>
  </div>
  <span class="preloader__rule"></span>
</div>

<style>
  .preloader {
    display: none;
    position: fixed;
    inset: 0;
    z-index: var(--z-preloader);
    background: var(--ground);
    color: var(--ink);
    pointer-events: none;
  }
  :global(html.is-preloading) .preloader {
    display: block;
    animation: lift 700ms var(--ease-in-out) 1250ms forwards;
  }
  /* Fixed coordinates so font loading can never shift it. */
  .preloader__inner { position: absolute; left: var(--margin); bottom: 18svh; display: grid; gap: 0.1em; }
  .preloader :global(.preloader__mark) { font-size: clamp(2.25rem, 6vw, 4rem); margin-bottom: 0.35em; }
  .preloader :global(.preloader__mark .logo__mark) { color: var(--ink); }
  .preloader__line {
    overflow: clip;
    font-size: clamp(2.25rem, 1rem + 5vw, 6rem);
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.035em;
  }
  .preloader__line span { display: block; animation: rise 700ms var(--ease-out) 450ms both; }
  .preloader__line--lime { color: var(--ink-3); }
  .preloader__line--lime span { animation-delay: 540ms; }
  .preloader__rule {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    height: 6px;
    background: var(--mark);
    transform-origin: 0 50%;
    animation: grow 1200ms var(--ease-in-out) both;
  }
  @keyframes rise { from { translate: 0 105%; } }
  @keyframes grow { from { scale: 0 1; } }
  @keyframes lift { to { clip-path: inset(0 0 100% 0); visibility: hidden; } }
</style>
