---
/**
 * Page hero frame. Every page opens the same way: the 12-column construction lines, the page's
 * own words on the left columns, and the page's own working instrument on the right columns
 * (named slot "instrument"). An optional "strip" slot carries ruled modules under the fold line.
 * Each instrument is server-rendered in a meaningful state; its script only adds interaction.
 */
import Breadcrumbs from './Breadcrumbs.astro';
import type { Crumb } from '@/lib/seo';

interface Props {
  crumbs?: Crumb[];
  /** Column split between words and instrument on desktop. */
  split?: '5-7' | '6-6' | '7-5' | '4-8';
  /** Accessible name for the hero region (usually the h1 id). */
  labelledby: string;
  class?: string;
}

const { crumbs, split = '5-7', labelledby, class: className } = Astro.props;
const [a, b] = split.split('-').map(Number) as [number, number];
---

<section class:list={['hero', className]} aria-labelledby={labelledby} style={`--a:${a};--b:${b}`}>
  <div class="gridlines" aria-hidden="true"><div>{Array.from({ length: 12 }, () => <span />)}</div></div>
  <div class="wrap hero__wrap">
    {crumbs && <div class="hero__crumbs"><Breadcrumbs items={crumbs} /></div>}
    <div class="hero__grid grid">
      <div class="hero__words">
        <slot />
      </div>
      <div class="hero__instrument">
        <slot name="instrument" />
      </div>
    </div>
  </div>
  {Astro.slots.has('strip') && <div class="wrap hero__strip"><slot name="strip" /></div>}
</section>

<style>
  .hero { position: relative; isolation: isolate; padding-top: calc(var(--header-h) + var(--s-5)); padding-bottom: var(--s-8); }
  .hero__wrap { position: relative; z-index: 1; }
  .hero__crumbs { margin-bottom: var(--s-4); }
  .hero__grid { row-gap: var(--s-7); align-items: center; }
  .hero__words { display: grid; gap: var(--s-6); align-content: center; padding-top: var(--s-5); }
  .hero__instrument { min-width: 0; }
  @media (min-width: 64rem) {
    .hero__grid { min-height: calc(100svh - var(--header-h) - var(--s-9) - 4rem); max-height: 60rem; }
    .hero__words { grid-column: 1 / span var(--a); }
    .hero__instrument { grid-column: calc(var(--a) + 1) / -1; }
  }
  .hero__strip { position: relative; z-index: 1; margin-top: var(--s-7); }
  .hero :global(.hero__title) { max-width: 14ch; }
  .hero :global(.hero__lead) { font-size: var(--t-lead); line-height: 1.45; color: var(--ink-2); max-width: 40ch; }
  .hero :global(.hero__title .accent) { display: block; }
</style>
