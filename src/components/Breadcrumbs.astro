---
import type { Crumb } from '@/lib/seo';

interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
---

<nav class="crumbs" aria-label="Breadcrumb">
  <ol role="list">
    {
      items.map((c, i) => (
        <li>
          {i < items.length - 1 ? (
            <a class="link link--quiet" href={c.path}>
              {c.name}
            </a>
          ) : (
            <span aria-current="page">{c.name}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .crumbs ol { display: flex; flex-wrap: wrap; gap: 0 0.6rem; font-size: 0.875rem; font-weight: 550; color: var(--ink-2); }
  .crumbs li { display: inline-flex; align-items: center; gap: 0.6rem; }
  .crumbs li + li::before { content: '/'; color: var(--ink-3); }
  .crumbs a { display: inline-flex; min-height: 44px; align-items: center; color: var(--ink); }
  .crumbs span { display: inline-flex; min-height: 44px; align-items: center; }
</style>
