---
/**
 * FAQ on native <details>: searchable with Find-in-page, indexable, keyboard-ready.
 * The FAQPage JSON-LD for the same questions is emitted by the page.
 */
import type { Faq } from '@/data/services';

interface Props {
  faqs: Faq[];
  name: string;
  heading?: string;
  intro?: string;
}

const { faqs, name, heading = 'Questions, answered', intro } = Astro.props;
const headingId = `${name}-faq-heading`;
---

<section class="faq section" aria-labelledby={headingId}>
  <div class="wrap grid">
    <div class="faq__head c-4">
      <h2 class="h2" id={headingId} data-split>{heading}</h2>
      {intro && <p class="faq__intro" data-reveal>{intro}</p>}
    </div>
    <div class="faq__list c-7 s-6" data-reveal-group>
      {
        faqs.map((f, i) => (
          <details class="faq__item" name={name} data-reveal open={i === 0}>
            <summary class="faq__q">
              <span>{f.q}</span>
              <span class="faq__icon" aria-hidden="true" />
            </summary>
            <div class="faq__a">
              <p>{f.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq .grid { row-gap: var(--s-7); }
  .faq__head { display: grid; gap: var(--s-5); align-content: start; }
  @media (min-width: 64rem) { .faq__head { position: sticky; top: calc(var(--header-h) + var(--s-6)); } }
  .faq__intro { color: var(--ink-2); max-width: 34ch; }
  .faq__list { border-top: 1px solid var(--rule-strong); }
  .faq__item { border-bottom: 1px solid var(--rule); }
  .faq__q {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-5);
    min-height: 4.5rem;
    padding-block: var(--s-4);
    cursor: pointer;
    list-style: none;
    font-size: 1.1875rem;
    font-weight: 650;
    font-stretch: 112%;
    line-height: 1.3;
  }
  .faq__q::-webkit-details-marker { display: none; }
  .faq__icon { position: relative; width: 1.75rem; height: 1.75rem; flex: none; border: 1px solid var(--rule-strong); transition: background-color var(--t-ui) ease, border-color var(--t-ui) ease; }
  .faq__icon::before, .faq__icon::after { content: ''; position: absolute; inset: 50% 25% auto; height: 2px; margin-top: -1px; background: currentColor; transition: rotate var(--t-ui) var(--ease-out); }
  .faq__icon::after { rotate: 90deg; }
  .faq__item[open] .faq__icon { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
  .faq__item[open] .faq__icon::after { rotate: 0deg; }
  @media (hover: hover) and (pointer: fine) { .faq__q:hover .faq__icon { border-color: var(--ink); } }
  .faq__a { padding-bottom: var(--s-6); color: var(--ink-2); max-width: 62ch; }
  .faq__item::details-content { block-size: 0; overflow: clip; transition: block-size 260ms var(--ease-out), content-visibility 260ms allow-discrete; }
  .faq__item[open]::details-content { block-size: auto; }
  @supports (interpolate-size: allow-keywords) { .faq { interpolate-size: allow-keywords; } }
</style>
