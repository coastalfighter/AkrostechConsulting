---
/**
 * Static SVG poster of the hero globe, computed at build time with the same projection and
 * orientation as the WebGL scene. Shows instantly, stays for reduced motion and no-WebGL
 * visitors, and cross-fades to the live canvas when it is ready.
 */
const N = 620;
const golden = Math.PI * (3 - Math.sqrt(5));
// Orientation matching hero3d.ts (rotation x 0.95, y -1.46).
const rx = 0.95;
const ry = -1.46;

type V = [number, number, number];
const rotate = ([x, y, z]: V): V => {
  const cy = Math.cos(ry), sy = Math.sin(ry);
  const x1 = x * cy + z * sy;
  const z1 = -x * sy + z * cy;
  const cx = Math.cos(rx), sx = Math.sin(rx);
  return [x1, y * cx - z1 * sx, y * sx + z1 * cx];
};
const latLon = (lat: number, lon: number): V => {
  const phi = ((90 - lat) * Math.PI) / 180;
  const theta = ((lon + 180) * Math.PI) / 180;
  return [-Math.sin(phi) * Math.cos(theta), Math.cos(phi), Math.sin(phi) * Math.sin(theta)];
};

const dots: { x: number; y: number; o: number; r: number }[] = [];
for (let i = 0; i < N; i++) {
  const y = 1 - (i / (N - 1)) * 2;
  const rad = Math.sqrt(1 - y * y);
  const t = golden * i;
  const [px, py, pz] = rotate([Math.cos(t) * rad, y, Math.sin(t) * rad]);
  if (pz < -0.15) continue;
  dots.push({ x: 50 + px * 46, y: 50 - py * 46, o: Math.max(0.12, (pz + 0.15) / 1.15), r: 0.42 });
}

const a = rotate(latLon(39.75, -75.55));
const b = rotate(latLon(21.15, 79.09));
const mid: V = [(a[0] + b[0]) / 2, (a[1] + b[1]) / 2, (a[2] + b[2]) / 2];
const len = Math.hypot(...mid);
const lift: V = [(mid[0] / len) * 1.55, (mid[1] / len) * 1.55, (mid[2] / len) * 1.55];
const P = (v: V) => `${(50 + v[0] * 46).toFixed(2)} ${(50 - v[1] * 46).toFixed(2)}`;
const arc = `M${P(a)} Q${P(lift)} ${P(b)}`;
---

<svg class="globe-poster" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
  <g class="globe-poster__dots">
    {dots.map((d) => <circle cx={d.x.toFixed(2)} cy={d.y.toFixed(2)} r={d.r} opacity={d.o.toFixed(2)} />)}
  </g>
  <path class="globe-poster__arc" d={arc} fill="none" stroke-width="0.35"></path>
  <circle class="globe-poster__pin" cx={P(a).split(' ')[0]} cy={P(a).split(' ')[1]} r="1.1"></circle>
  <circle class="globe-poster__pin" cx={P(b).split(' ')[0]} cy={P(b).split(' ')[1]} r="1.1"></circle>
</svg>

<style>
  .globe-poster { width: 100%; height: 100%; }
  .globe-poster__dots { fill: light-dark(var(--sand-800), var(--sand-500)); }
  .globe-poster__arc { stroke: var(--accent); }
  .globe-poster__pin { fill: var(--accent); }
</style>
