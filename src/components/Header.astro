---
/**
 * Site header: logo, primary navigation, a live two-city clock (Wilmington / India),
 * theme switch and the primary action. Below 64rem the navigation moves into a native
 * <dialog> menu (focus trap and Esc for free).
 */
import { site } from '@/config/site';
import { services, serviceHref } from '@/data/services';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: '/services', label: 'Services' },
  { href: '/services/website-development', label: 'Websites' },
  { href: '/work', label: 'Work' },
  { href: '/about', label: 'About' },
  { href: '/blog', label: 'Insights' },
  { href: '/contact', label: 'Contact' },
];
const isCurrent = (href: string) => {
  if (href === '/services') return path === '/services' || (path.startsWith('/services/') && path !== '/services/website-development');
  return path === href || path.startsWith(`${href}/`);
};
---

<header class="header" data-header>
  <div class="header__bar wrap">
    <a class="header__logo" href="/" aria-label={`${site.name}, home`}>
      <Logo />
    </a>

    <nav class="header__nav" aria-label="Primary">
      <ul role="list">
        {
          nav.map((item) => (
            <li>
              <a class="header__link" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header__actions">
      <p class="header__clock tabular" aria-hidden="true" data-clock>
        <span><b>DE</b> <span data-clock-us>--:--</span></span>
        <span><b>IN</b> <span data-clock-in>--:--</span></span>
      </p>
      <button class="header__icon" type="button" data-theme-toggle aria-label="Switch to light theme">
        <Icon name="sun" class="icon header__sun" />
        <Icon name="moon" class="icon header__moon" />
      </button>
      <a class="btn btn--primary btn--small header__cta" href={site.calendly} target="_blank" rel="noopener">
        Book a call <Icon name="arrow-up-right" class="btn__arrow" />
      </a>
      <button class="header__menu" type="button" aria-haspopup="dialog" aria-controls="site-menu" data-menu-open>
        <span class="header__menu-lines" aria-hidden="true"><span></span><span></span></span>
        <span>Menu</span>
      </button>
    </div>
  </div>
</header>

<dialog class="menu" id="site-menu" aria-label="Site menu" data-menu>
  <div class="menu__inner wrap">
    <div class="menu__top">
      <a class="header__logo" href="/" aria-label={`${site.name}, home`}><Logo /></a>
      <button class="header__menu" type="button" data-menu-close>
        <span>Close</span>
        <Icon name="plus" class="icon menu__x" />
      </button>
    </div>
    <nav class="menu__nav" aria-label="Menu">
      <ul role="list">
        <li style="--i:0"><a href="/" aria-current={path === '/' ? 'page' : undefined}>Home</a></li>
        {
          nav.map((item, i) => (
            <li style={`--i:${i + 1}`}>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="menu__foot">
      <ul role="list" class="menu__services">
        {
          services.map((s) => (
            <li>
              <a class="link link--quiet" href={serviceHref(s.slug)}>{s.name}</a>
            </li>
          ))
        }
      </ul>
      <div class="menu__contact">
        <a class="link" href={`tel:${site.phoneE164}`}>{site.phone}</a>
        <a class="link" href={`mailto:${site.email}`}>{site.email}</a>
      </div>
      <a class="btn btn--primary btn--block" href={site.calendly} target="_blank" rel="noopener">
        Book a 30-minute call <Icon name="arrow-up-right" class="btn__arrow" />
      </a>
    </div>
  </div>
</dialog>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-header);
    height: var(--header-h);
    border-bottom: 1px solid transparent;
    transition: transform 300ms var(--ease-out), background-color var(--t-ui) ease, border-color var(--t-ui) ease;
  }
  .header.is-scrolled { background: var(--ground); border-bottom-color: var(--rule); }
  .header.is-hidden { transform: translateY(-100%); }
  .header__bar { height: 100%; display: flex; align-items: center; gap: var(--s-6); }
  .header__logo { display: inline-flex; min-height: 44px; align-items: center; text-decoration: none; font-size: 0.95rem; flex: none; }

  .header__nav { display: none; margin-inline: auto; }
  .header__nav ul { display: flex; gap: clamp(0.75rem, 1.6vw, 2rem); }
  .header__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.9375rem;
    font-weight: 550;
    text-decoration: none;
    color: var(--ink-2);
    transition: color var(--t-ui) ease;
  }
  .header__link::after {
    content: '';
    position: absolute;
    left: 0; right: 0; bottom: 8px;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform var(--t-ui) var(--ease-out);
  }
  .header__link[aria-current='page'] { color: var(--ink); }
  .header__link[aria-current='page']::after { transform: scaleX(1); }
  @media (hover: hover) and (pointer: fine) {
    .header__link:hover { color: var(--ink); }
  }

  .header__actions { display: flex; align-items: center; gap: var(--s-3); margin-left: auto; }
  .header__clock { display: none; gap: var(--s-4); font-size: 0.8125rem; color: var(--ink-2); font-stretch: 112%; }
  .header__clock b { font-weight: 650; color: var(--ink); letter-spacing: 0.06em; margin-right: 0.15em; }
  .header__icon {
    display: grid;
    place-items: center;
    width: 44px; height: 44px;
    border: 1px solid var(--rule);
    color: var(--ink);
    transition: transform var(--t-press) var(--ease-out), border-color var(--t-ui) ease;
  }
  .header__icon:active { transform: scale(0.94); }
  .header__icon .icon { grid-area: 1 / 1; width: 1.15rem; height: 1.15rem; }
  .header__moon { display: none; }
  :global(:root[data-theme='light']) .header__sun { display: none; }
  :global(:root[data-theme='light']) .header__moon { display: block; }
  @media (hover: hover) and (pointer: fine) {
    .header__icon:hover { border-color: var(--ink); }
  }
  .header__cta { display: none; }
  .header__menu {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    min-height: 44px;
    padding-inline: var(--s-4);
    border: 1px solid var(--rule-strong);
    font-weight: 650;
    font-size: 0.9375rem;
    font-stretch: 112%;
    transition: transform var(--t-press) var(--ease-out), border-color var(--t-ui) ease;
  }
  .header__menu:active { transform: scale(0.97); }
  .header__menu-lines { display: grid; gap: 5px; width: 18px; }
  .header__menu-lines span { height: 2px; background: currentColor; }
  .header__menu-lines span:last-child { width: 60%; }

  @media (min-width: 40rem) {
    .header__cta { display: inline-flex; }
  }
  @media (min-width: 64rem) {
    .header__nav { display: block; }
    .header__menu { display: none; }
  }
  @media (min-width: 90rem) {
    .header__clock { display: flex; }
  }

  /* ---- Menu dialog ---- */
  .menu {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    padding: 0;
    border: 0;
    background: var(--ground);
    color: var(--ink);
    overflow-y: auto;
  }
  .menu::backdrop { background: var(--scrim); }
  .menu[open] { animation: menu-in 340ms var(--ease-drawer); }
  @keyframes menu-in { from { transform: translateY(-2%); opacity: 0; } }
  .menu__inner { min-height: 100%; display: flex; flex-direction: column; gap: var(--s-6); padding-bottom: var(--s-7); }
  .menu__top { height: var(--header-h); display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--rule); }
  .menu__x { rotate: 45deg; }
  .menu__nav ul { display: grid; }
  .menu__nav li { border-bottom: 1px solid var(--rule); }
  .menu__nav a {
    display: flex;
    align-items: center;
    min-height: 3.75rem;
    font-size: clamp(1.75rem, 7vw, 2.75rem);
    font-weight: 700;
    font-stretch: 125%;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .menu__nav a[aria-current='page'] { color: var(--accent-text); }
  @media (prefers-reduced-motion: no-preference) {
    .menu[open] .menu__nav li { animation: menu-item 420ms var(--ease-out) both; animation-delay: calc(var(--i) * 40ms + 60ms); }
  }
  @keyframes menu-item { from { opacity: 0; transform: translateY(12px); } }
  .menu__foot { display: grid; gap: var(--s-6); margin-top: auto; }
  .menu__services { display: grid; gap: var(--s-2); color: var(--ink-2); }
  .menu__services a { display: inline-flex; min-height: 44px; align-items: center; }
  .menu__contact { display: grid; gap: var(--s-2); font-weight: 600; }
  .menu__contact a { justify-self: start; }
</style>
