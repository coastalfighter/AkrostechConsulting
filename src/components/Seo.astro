---
/**
 * Document head metadata: title, description, canonical, robots, Open Graph, Twitter Card,
 * icons and the page's JSON-LD graph.
 */
import { site, absoluteUrl } from '@/config/site';
import { canonical, pageTitle, type PageMeta } from '@/lib/seo';

interface Props {
  meta: PageMeta;
  schema: string;
}

const { meta, schema } = Astro.props;
const title = pageTitle(meta.title);
const url = canonical(meta.path);
const image = absoluteUrl(meta.image ?? '/og/default.png');
const imageAlt = meta.imageAlt ?? `${site.name}: ${site.tagline}`;
---

<title>{title}</title>
<meta name="description" content={meta.description} />
<link rel="canonical" href={url} />
<meta name="robots" content={meta.noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />

<meta property="og:type" content={meta.type ?? 'website'} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.locale} />
<meta property="og:title" content={title} />
<meta property="og:description" content={meta.description} />
<meta property="og:url" content={url} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
{meta.publishedTime && <meta property="article:published_time" content={meta.publishedTime} />}
{meta.modifiedTime && <meta property="article:modified_time" content={meta.modifiedTime} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={meta.description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={imageAlt} />

<meta name="geo.region" content={`${site.address.country}-${site.address.region}`} />
<meta name="geo.placename" content={site.address.locality} />
<meta name="geo.position" content={`${site.geo.latitude};${site.geo.longitude}`} />
<meta name="ICBM" content={`${site.geo.latitude}, ${site.geo.longitude}`} />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="alternate" type="application/rss+xml" title={`${site.name} Insights`} href="/rss.xml" />
<link rel="sitemap" href="/sitemap-index.xml" />

<script type="application/ld+json" set:html={schema} />
