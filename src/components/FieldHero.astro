---
/**
 * Page hero: the page's words on the left, and on the right a generative field (an
 * interactive graphic, drawn on a canvas) in a night panel: ink in the light theme,
 * violet in the dark theme. Each page passes its own formation (`scene`).
 * The field is decorative for assistive technology; the words carry the meaning.
 */
import Breadcrumbs from './Breadcrumbs.astro';
import Icon from './Icon.astro';
import type { Crumb } from '@/lib/seo';

interface Props {
  scene: 'wave' | 'orbits' | 'lanes' | 'funnel' | 'ledger' | 'document' | 'wireframe' | 'network' | 'flow' | 'flow-article' | 'relay' | 'shield' | 'index' | 'lost';
  /** Accessible name for the hero region (the h1 id). */
  labelledby: string;
  crumbs?: Crumb[];
  /** Extra seed so pages sharing a scene still differ (e.g. an article slug). */
  seed?: string;
  /** Short instruction shown in the field panel. */
  hint?: string;
  /** Wider words column for long headlines. */
  wide?: boolean;
  class?: string;
}

const { scene, labelledby, crumbs, seed, hint = 'Move through the field. Press to send a ripple.', wide = false, class: className } = Astro.props;
---

<section class:list={['fhero', className, { 'fhero--wide': wide }]} aria-labelledby={labelledby} data-field={scene} data-field-seed={seed}>
  <div class="wrap">
    {crumbs && <div class="fhero__crumbs"><Breadcrumbs items={crumbs} /></div>}
    <div class="fhero__grid">
      <div class="fhero__words">
        <slot />
      </div>
      <div class="fhero__stage">
        <canvas class="fhero__canvas" aria-hidden="true"></canvas>
        <div class="fhero__bar">
          <p class="fhero__hint">{hint}</p>
          <button class="fhero__pause" type="button" aria-pressed="false" data-field-pause>
            <span class="fhero__pause-icon" aria-hidden="true"><Icon name="pause" class="icon fhero__i-pause" /><Icon name="play" class="icon fhero__i-play" /></span>
            <span class="sr-only">Pause the moving graphic</span>
          </button>
        </div>
      </div>
    </div>
    {Astro.slots.has('after') && <div class="fhero__after"><slot name="after" /></div>}
  </div>
</section>

<style>
  .fhero {
    --field-bg: var(--carbon-950);
    --field-dot: var(--carbon-50);
    --field-dot-hi: var(--lime-400);
    --field-dot-2: var(--violet-300);
    position: relative;
    padding-top: calc(var(--header-h) + var(--s-5));
    padding-bottom: var(--s-8);
  }
  :global(:root[data-theme='dark']) .fhero {
    --field-bg: var(--violet-600);
    --field-dot: var(--carbon-50);
    --field-dot-hi: var(--lime-400);
    --field-dot-2: var(--violet-200);
  }
  .fhero__crumbs { margin-bottom: var(--s-3); }
  .fhero__grid { display: grid; gap: var(--s-7); align-items: center; }
  .fhero__words { display: grid; gap: var(--s-6); align-content: center; }
  .fhero__stage {
    position: relative;
    min-height: clamp(20rem, 72vw, 26rem);
    border-radius: calc(var(--radius) * 1.6);
    background: var(--field-bg);
    overflow: hidden;
    isolation: isolate;
    touch-action: pan-y;
    cursor: crosshair;
  }
  .fhero__canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .fhero__bar {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    padding: var(--s-3) var(--s-3) var(--s-3) var(--s-5);
    pointer-events: none;
  }
  .fhero__hint { font-size: 0.8125rem; font-weight: 500; color: color-mix(in srgb, var(--field-dot) 78%, transparent); }
  .fhero__pause {
    pointer-events: auto;
    display: grid;
    place-items: center;
    width: 44px; height: 44px;
    border-radius: 50%;
    color: var(--field-dot);
    border: 1px solid color-mix(in srgb, var(--field-dot) 35%, transparent);
    transition: transform var(--t-press) var(--ease-out), background-color var(--t-ui) ease;
  }
  .fhero__pause:active { transform: scale(0.94); }
  .fhero__pause:focus-visible { outline-color: var(--field-dot-hi); }
  @media (hover: hover) and (pointer: fine) { .fhero__pause:hover { background: color-mix(in srgb, var(--field-dot) 12%, transparent); } }
  .fhero__pause-icon { display: grid; }
  .fhero__pause-icon :global(.icon) { grid-area: 1 / 1; width: 1rem; height: 1rem; }
  .fhero__pause :global(.fhero__i-play) { display: none; }
  .fhero__pause[aria-pressed='true'] :global(.fhero__i-play) { display: block; }
  .fhero__pause[aria-pressed='true'] :global(.fhero__i-pause) { display: none; }
  @media (prefers-reduced-motion: reduce) { .fhero__bar { display: none; } .fhero__stage { cursor: default; } }
  :global(html:not(.js)) .fhero__bar { display: none; }
  .fhero__after { margin-top: var(--s-7); }

  @media (min-width: 64rem) {
    .fhero__grid { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: var(--s-8); min-height: min(calc(100svh - var(--header-h) - var(--s-8)), 46rem); }
    .fhero--wide .fhero__grid { grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); }
    .fhero__stage { align-self: stretch; min-height: 34rem; }
  }

  .fhero :global(.fhero__title) { font-size: var(--t-h1); line-height: var(--lh-display); letter-spacing: var(--track-display); max-width: 13ch; }
  .fhero--wide :global(.fhero__title) { max-width: 18ch; font-size: clamp(2.4rem, 1.2rem + 3.4vw, 4.25rem); }
  .fhero :global(.fhero__lead) { font-size: var(--t-lead); line-height: 1.5; color: var(--ink-2); max-width: 42ch; }
</style>
