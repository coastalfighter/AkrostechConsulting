---
/**
 * Service-area hero instrument: the route strip. A schematic strip map from the city to the
 * Wilmington office (for Wilmington itself, the downtown run from the train station), stops
 * evenly spaced like a transit diagram. A lime marker can be dragged down the strip, or moved
 * with the keys or the stop buttons; the readout gives the distance and time still to go,
 * scaled from the journey time in the location's own copy. Server-rendered at the start.
 */
import Icon from '../Icon.astro';
import type { Location } from '@/data/locations';
import { routes } from '@/data/routes';
import { cumulativeMiles, formatMiles, formatMinutes, minutesInText } from '@/lib/geo';

interface Props {
  loc: Location;
}
const { loc } = Astro.props;
const route = routes[loc.slug];
if (!route) throw new Error(`CityRoute: no route for "${loc.slug}" in data/routes.`);
const minutes = minutesInText(loc.distance) ?? 0;
const cum = cumulativeMiles(route.waypoints);
const total = cum[cum.length - 1] ?? 0;
const n = route.waypoints.length;
const stops = route.waypoints.map((w, i) => {
  const left = total - (cum[i] ?? 0);
  return { ...w, at: i / (n - 1), miles: cum[i] ?? 0, leftMiles: left, leftMin: total > 0 ? (minutes * left) / total : 0 };
});
const first = stops[0]!;
const second = stops[1]!;
---

<div
  class="rt"
  data-hero="route"
  data-total-miles={total.toFixed(3)}
  data-minutes={minutes}
  data-cum={cum.map((c) => c.toFixed(3)).join(',')}
  style="--p:0"
>
  <dl class="rt__head ruled">
    <div class="module"><dt class="label">From</dt><dd>{route.from}</dd></div>
    <div class="module"><dt class="label">To</dt><dd>{route.to}</dd></div>
    <div class="module"><dt class="label">How</dt><dd>{route.mode}</dd></div>
  </dl>

  <div class="rt__main">
    <div class="rt__readout lime" aria-live="off">
      <p class="label">Still to go</p>
      <p class="rt__fig"><span data-out="min">{Math.round(first.leftMin)}</span><span class="rt__fig-unit">min</span></p>
      <dl class="rt__spec">
        <div><dt class="label">Distance left</dt><dd data-out="mi">{formatMiles(first.leftMiles)}</dd></div>
        <div><dt class="label">Position</dt><dd data-out="where">At {first.name}</dd></div>
        <div><dt class="label">Next stop</dt><dd data-out="next">{second.name}</dd></div>
      </dl>
      <p class="rt__source small">Journey time from our own note: “{loc.distance}”</p>
    </div>

    <div class="rt__strip" data-strip>
      <div class="rt__track" data-track>
        <span class="rt__line" aria-hidden="true"></span>
        <span class="rt__fill" aria-hidden="true"></span>
        <div class="rt__rail">
          <div
            class="rt__marker"
            role="slider"
            tabindex="0"
            aria-orientation="vertical"
            aria-label={`Position on the route from ${route.from} to ${route.to}`}
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow="0"
            aria-valuetext={`At ${first.name}. ${formatMinutes(first.leftMin)} and ${formatMiles(first.leftMiles)} to go.`}
            data-marker
          >
            <span class="rt__marker-dot" aria-hidden="true"></span>
          </div>
        </div>
      </div>
      <ol class="rt__stops" role="list">
        {
          stops.map((s, i) => (
            <li class:list={['rt__stop', { 'is-here': i === 0, 'is-end': i === n - 1 }]} style={`--at:${s.at}`} data-at={s.at.toFixed(4)}>
              <button class="rt__stop-btn" type="button" data-goto={i}>
                <span class="rt__node" aria-hidden="true" />
                <span class="rt__stop-name">{s.name}</span>
                <span class="rt__stop-note">{s.note}</span>
                <span class="rt__stop-left">
                  {i === n - 1 ? 'Arrive' : `${formatMiles(s.leftMiles)} · ${formatMinutes(s.leftMin)} to go`}
                </span>
              </button>
            </li>
          ))
        }
      </ol>
    </div>
  </div>

  <p class="rt__foot small muted">
    <Icon name="route" class="icon rt__foot-icon" />
    <span>{route.footnote} Distances are straight-line legs between stops; times are scaled from the journey time above.</span>
  </p>
  <p class="sr-only" role="status" data-status></p>
</div>

<style>
  .rt { --p: 0; display: grid; border: 1px solid var(--rule-strong); background: var(--plate); }
  .rt__head { grid-template-columns: repeat(3, minmax(0, 1fr)); border: 0; border-bottom: 1px solid var(--rule); }
  .rt__head > .module { background: var(--plate); padding: var(--s-3) var(--s-4); display: grid; gap: var(--s-1); align-content: start; }
  .rt__head dt { color: var(--ink-2); }
  .rt__head dd { font-weight: 650; font-stretch: 112%; font-size: var(--t-small); line-height: 1.3; }

  .rt__main { display: grid; grid-template-columns: 1fr; }
  @media (min-width: 40rem) { .rt__main { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); } }

  .rt__readout { display: flex; flex-direction: column; gap: var(--s-4); padding: var(--s-5); }
  .rt__fig { display: flex; align-items: flex-end; gap: var(--s-2); font-size: clamp(4rem, 3rem + 3.5vw, 6rem); font-weight: 750; font-stretch: 125%; line-height: 0.8; letter-spacing: -0.035em; font-variant-numeric: tabular-nums; }
  .rt__fig-unit { font-size: 1rem; letter-spacing: 0.06em; text-transform: uppercase; line-height: 1; padding-bottom: 0.2rem; }
  .rt__spec { display: grid; border-top: 1px solid var(--rule); }
  .rt__spec > div { display: grid; gap: 2px; padding-block: var(--s-2); border-bottom: 1px solid var(--rule); }
  .rt__spec dt { color: var(--field-ink-2); font-size: 0.6875rem; }
  .rt__spec dd { font-weight: 650; font-size: var(--t-small); line-height: 1.3; font-variant-numeric: tabular-nums; }
  .rt__source { margin-top: auto; color: var(--field-ink-2); font-size: 0.8125rem; }

  /* The strip: a vertical track on the left of the stop list. */
  .rt__strip { position: relative; display: grid; grid-template-columns: 3.5rem minmax(0, 1fr); padding: var(--s-6) var(--s-5) var(--s-8) 0; user-select: none; }
  .rt__track { position: relative; grid-column: 1; grid-row: 1; margin-block: 0.7rem; cursor: pointer; touch-action: none; overflow: clip; overflow-clip-margin: 2rem; }
  .rt__line, .rt__fill { position: absolute; left: 50%; top: 0; bottom: 0; width: 2px; margin-left: -1px; }
  .rt__line { background: repeating-linear-gradient(to bottom, var(--ink-3) 0 6px, transparent 6px 10px); }
  .rt__fill { width: 6px; margin-left: -3px; background: var(--field); transform-origin: 50% 0; transform: scaleY(var(--p)); }
  .rt__rail { position: absolute; left: 0; right: 0; top: 0; height: 100%; transform: translateY(calc(var(--p) * 100%)); pointer-events: none; z-index: 2; }
  .rt.is-gliding .rt__rail { transition: transform 260ms var(--ease-out); }
  .rt.is-gliding .rt__fill { transition: transform 260ms var(--ease-out); }
  .rt__marker { position: absolute; left: 50%; top: 0; width: 44px; height: 44px; margin: -22px 0 0 -22px; display: grid; place-items: center; pointer-events: auto; cursor: grab; outline: none; touch-action: none; }
  .rt__marker:active { cursor: grabbing; }
  .rt__marker-dot { width: 26px; height: 26px; background: var(--carbon-950); border: 5px solid var(--lime-400); transition: transform var(--t-press) var(--ease-out); }
  .rt__marker:focus-visible .rt__marker-dot { outline: 2px solid var(--focus); outline-offset: 3px; }
  .rt.is-dragging .rt__marker-dot { transform: scale(1.15); }
  @media (hover: hover) and (pointer: fine) { .rt__marker:hover .rt__marker-dot { transform: scale(1.1); } }

  .rt__stops { grid-column: 1 / -1; grid-row: 1; position: relative; min-height: 22rem; }
  .rt__stop { position: absolute; left: 0; right: 0; top: calc(var(--at) * (100% - 1.4rem)); }
  .rt__stop-btn {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr) auto;
    column-gap: var(--s-3);
    align-items: baseline;
    width: 100%;
    min-height: 44px;
    text-align: left;
    color: var(--ink-2);
    transition: color var(--t-ui) ease;
  }
  .rt__node { grid-row: 1 / span 2; justify-self: center; align-self: start; margin-top: 0.27rem; width: 14px; height: 14px; background: var(--plate); border: 2px solid var(--ink-2); transition: background-color var(--t-ui) ease, border-color var(--t-ui) ease; }
  .rt__stop-name { grid-column: 2; font-weight: 700; font-stretch: 112%; font-size: 1rem; line-height: 1.25; color: var(--ink); }
  .rt__stop-note { grid-column: 2; font-size: 0.8125rem; color: var(--ink-3); }
  .rt__stop-left { grid-column: 3; grid-row: 1; font-size: 0.8125rem; font-weight: 600; color: var(--ink-2); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .rt__stop.is-passed .rt__node { background: var(--field); border-color: var(--field); }
  .rt__stop.is-here .rt__stop-name { color: var(--accent-text); }
  .rt__stop.is-end .rt__node { width: 18px; height: 18px; margin-top: 0.14rem; border-color: var(--ink); }
  .rt__stop.is-end .rt__stop-name { font-stretch: 125%; text-transform: uppercase; }
  .rt__stop-btn:active { transform: none; }
  .rt__stop-btn:active .rt__node { transform: scale(0.9); }
  @media (hover: hover) and (pointer: fine) { .rt__stop-btn:hover .rt__stop-name { text-decoration: underline; text-decoration-color: var(--accent); text-decoration-thickness: 2px; text-underline-offset: 0.2em; } }
  .rt__stop-btn:focus-visible { outline-offset: 2px; }

  .rt__foot { display: flex; gap: var(--s-2); padding: var(--s-3) var(--s-5); border-top: 1px solid var(--rule); }
  .rt__foot-icon { margin-top: 0.15rem; color: var(--ink); }

  :global(html:not(.js)) .rt__rail, :global(html:not(.js)) .rt__fill { display: none; }
  @media (max-width: 39.99rem) {
    .rt__head { grid-template-columns: 1fr 1fr; }
    .rt__head > .module:last-child { grid-column: 1 / -1; }
    .rt__stop-btn { grid-template-columns: 3.5rem minmax(0, 1fr); }
    .rt__stop-left { grid-column: 2; grid-row: auto; }
    .rt__stops { min-height: 26rem; }
    .rt__stop-note { display: none; }
  }
</style>
