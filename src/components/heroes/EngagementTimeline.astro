---
/**
 * Blueprint hero instrument: the engagement as a timeline the visitor scrubs. A ruled track of
 * the blueprint's approach phases, from day 0 to the end of its duration; a lime scrubber
 * (drag, arrow keys, or the step buttons) moves along it, and the readout shows the current
 * phase and the deliverables unlocked so far. Server-rendered on the second phase.
 */
import type { WorkItem } from '@/data/work';
import Icon from '@/components/Icon.astro';
import { lengthOf, lengthLabel, unlockPhases } from '@/lib/engagement';

interface Props {
  item: WorkItem;
}
const { item } = Astro.props;
const phases = item.approach;
const n = phases.length;
const len = lengthOf(item.duration);
const endLabel = lengthLabel(len);
const unlocks = unlockPhases(item.deliverables.length, n);
const start = Math.min(1, n - 1);
const pos = (start + 0.5) / n;
const current = phases[start]!;
---

<div class="tl" data-hero="timeline" data-phase={start} style={`--pos:${pos};--n:${n}`}>
  <div class="tl__track" data-track>
    <ol class="tl__phases" role="list">
      {
        phases.map((p, i) => (
          <li class:list={['tl__phase', { 'is-done': i < start, 'is-current': i === start }]} data-phase-cell={i}>
            <button type="button" class="tl__phase-btn" data-goto={i} aria-label={`Go to phase ${i + 1}: ${p.title}`}>
              <span class="tl__num">{String(i + 1)}</span>
              <span class="tl__phase-title">{p.title}</span>
            </button>
          </li>
        ))
      }
    </ol>
    <div class="tl__rail" aria-hidden="true">
      <span class="tl__fill"></span>
      {len.weeks === null || len.thenOngoing ? <span class="tl__beyond" /> : null}
    </div>
    <div
      class="tl__handle"
      role="slider"
      tabindex="0"
      aria-label="Position in the engagement"
      aria-valuemin="1"
      aria-valuemax={n}
      aria-valuenow={start + 1}
      aria-valuetext={`Phase ${start + 1} of ${n}: ${current.title}`}
      data-handle
    >
      <span class="tl__knob"><span></span><span></span></span>
    </div>
    <div class="tl__scale" aria-hidden="true">
      <span>Day 0</span>
      <span>{endLabel}</span>
    </div>
  </div>

  <div class="tl__readout ruled" aria-live="polite">
    <div class="module tl__now">
      <p class="label tl__count"><span data-out="count">Phase {start + 1} of {n}</span> <span>{item.format}</span></p>
      <p class="tl__title" data-out="title">{current.title}</p>
      <p class="tl__body" data-out="body">{current.body}</p>
    </div>
    <div class="module tl__unlocked">
      <p class="label tl__key">Deliverables so far <span class="tl__tally" data-out="tally">{unlocks.filter((u) => u <= start).length} / {item.deliverables.length}</span></p>
      <ul class="tl__list" role="list">
        {
          item.deliverables.map((d, j) => (
            <li class:list={['tl__deliverable', { 'is-on': unlocks[j]! <= start }]} data-unlock={unlocks[j]}>
              <span class="tl__mark" aria-hidden="true">
                <Icon name="check" />
              </span>
              <span>{d}</span>
              <span class="sr-only" data-state>{unlocks[j]! <= start ? ', delivered' : ', not yet'}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="tl__controls">
    <button type="button" class="btn btn--ghost btn--small" data-step="-1"><Icon name="arrow-left" /> Previous phase</button>
    <button type="button" class="btn btn--ghost btn--small" data-step="1">Next phase <Icon name="arrow-right" class="btn__arrow btn__arrow--right" /></button>
    <p class="tl__hint small">Drag the lime scrubber or use the arrow keys.</p>
  </div>
  <script type="application/json" data-phases set:html={JSON.stringify(phases).replace(/</g, '\\u003c')} />
</div>

<style>
  .tl { display: grid; gap: var(--s-5); }
  .tl__track { position: relative; padding-bottom: 2.25rem; touch-action: pan-y; user-select: none; }
  .tl__phases {
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
  }
  .tl__phase { background: var(--ground); transition: background-color var(--t-ui) ease, color var(--t-ui) ease; }
  .tl__phase-btn {
    display: grid;
    align-content: space-between;
    gap: var(--s-4);
    width: 100%;
    min-height: 12rem;
    padding: var(--s-4);
    text-align: left;
    border-top: 3px solid transparent;
    transition: border-color var(--t-ui) ease;
  }
  .tl__phase-btn:focus-visible { outline-offset: -3px; }
  .tl__num { font-size: clamp(1.75rem, 1.2rem + 1.4vw, 2.5rem); font-weight: 750; font-stretch: var(--wide); line-height: 1; font-variant-numeric: tabular-nums; color: var(--ink-3); transition: color var(--t-ui) ease; }
  .tl__phase-title { font-size: 0.875rem; font-weight: 600; line-height: 1.3; color: var(--ink-2); }
  .tl__phase.is-done { background: var(--field); color: var(--field-ink); --ink-2: var(--field-ink-2); --ink-3: var(--field-ink-2); }
  .tl__phase.is-current { background: var(--plate-2); }
  .tl__phase.is-current .tl__phase-btn { border-top-color: var(--ink); }
  .tl__phase.is-current .tl__num { color: var(--ink); }
  .tl__phase.is-current .tl__phase-title { color: var(--ink); }
  @media (hover: hover) and (pointer: fine) {
    .tl__phase:not(.is-done, .is-current):hover { background: var(--plate); }
  }
  @media (max-width: 40rem) {
    .tl__phase-title { display: none; }
    .tl__phase-btn { min-height: 4.5rem; padding: var(--s-3); }
  }

  .tl__rail { position: relative; height: 6px; margin-top: var(--s-3); background: var(--plate-3); }
  .tl__fill { position: absolute; inset: 0; background: var(--lime-400); transform-origin: 0 50%; scale: var(--pos) 1; transition: scale 320ms var(--ease-out); }
  .tl__beyond { position: absolute; right: 0; top: 0; bottom: 0; width: 2.5rem; background: repeating-linear-gradient(90deg, var(--ground) 0 4px, transparent 4px 9px); }
  :global(:root[data-theme='light']) .tl__fill { background: var(--lime-600); }

  .tl__handle {
    position: absolute;
    height: 2.75rem;
    bottom: 1.55rem;
    left: clamp(22px, var(--pos) * 100%, 100% - 22px);
    width: 44px;
    margin-left: -22px;
    display: grid;
    justify-items: center;
    align-items: end;
    cursor: grab;
    touch-action: none;
    outline: none;
    transition: left 320ms var(--ease-out);
  }
  .tl__handle::before { content: ''; position: absolute; top: 0; bottom: 1.5rem; left: 50%; width: 2px; margin-left: -1px; background: var(--lime-400); }
  .tl__knob {
    position: relative;
    display: flex;
    gap: 3px;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 1.75rem;
    background: var(--lime-400);
    border: 2px solid var(--carbon-950);
    transition: transform var(--t-press) var(--ease-out);
  }
  .tl__knob span { width: 2px; height: 0.7rem; background: var(--carbon-950); }
  .tl.is-dragging .tl__handle, .tl.is-dragging .tl__fill { transition: none; }
  .tl.is-dragging .tl__handle { cursor: grabbing; }
  .tl.is-dragging .tl__knob { transform: scale(1.08); }
  .tl__handle:focus-visible .tl__knob { outline: 2px solid var(--focus); outline-offset: 3px; }
  :global(:root[data-theme='light']) .tl__handle::before { background: var(--carbon-950); }

  .tl__scale { position: absolute; left: 0; right: 0; bottom: 0; display: flex; justify-content: space-between; font-size: 0.75rem; font-weight: 650; font-stretch: var(--semi-wide); letter-spacing: var(--track-label); text-transform: uppercase; color: var(--ink-2); }

  .tl__readout { grid-template-columns: 1fr; }
  @media (min-width: 40rem) { .tl__readout { grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); } }
  .tl__readout .module { padding: var(--s-5); display: grid; gap: var(--s-3); align-content: start; }
  .tl__count, .tl__key { color: var(--ink-2); display: flex; justify-content: space-between; gap: var(--s-3); }
  .tl__title { font-size: clamp(1.25rem, 1rem + 0.8vw, 1.625rem); font-weight: 750; font-stretch: var(--wide); line-height: 1.1; letter-spacing: -0.015em; }
  .tl__body { color: var(--ink-2); }
  .tl__tally { color: var(--accent-text); font-variant-numeric: tabular-nums; }
  .tl__list { display: grid; gap: var(--s-2); }
  .tl__deliverable { display: grid; grid-template-columns: 1.25rem 1fr; gap: var(--s-3); align-items: start; font-size: var(--t-small); color: var(--ink-3); transition: color var(--t-ui) ease; }
  .tl__mark { display: grid; place-items: center; width: 1.25rem; height: 1.25rem; margin-top: 0.1rem; border: 1px dashed var(--rule-strong); transition: background-color var(--t-ui) ease, border-color var(--t-ui) ease; }
  .tl__mark :global(.icon) { width: 0.9rem; height: 0.9rem; opacity: 0; color: var(--carbon-950); transition: opacity var(--t-ui) ease; }
  .tl__deliverable.is-on { color: var(--ink); font-weight: 550; }
  .tl__deliverable.is-on .tl__mark { background: var(--lime-400); border: 1px solid var(--lime-400); }
  .tl__deliverable.is-on .tl__mark :global(.icon) { opacity: 1; }

  .tl__controls { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-3); }
  .tl__hint { color: var(--ink-2); margin-left: auto; }
  :global(html:not(.js)) .tl__controls, :global(html:not(.js)) .tl__handle { display: none; }
</style>
