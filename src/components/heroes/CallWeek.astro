---
/**
 * Contact hero instrument: the call week. Monday to Friday by the hour, in the visitor's U.S.
 * time zone, with the Wilmington office hours (site.hours, Eastern) translated into that zone
 * as lime cells. The current day and hour are marked live; selecting a cell reads out the same
 * moment in Wilmington and in India. Server-rendered in Eastern time with Monday 10 am selected.
 */
import { site } from '@/config/site';
import Icon from '@/components/Icon.astro';
import { US_ZONES, INDIA_ZONE, formatClock, wallClock, zonedTimeToUtc } from '@/lib/time';

const DAYS = [
  { n: 1, short: 'Mon', long: 'Monday' },
  { n: 2, short: 'Tue', long: 'Tuesday' },
  { n: 3, short: 'Wed', long: 'Wednesday' },
  { n: 4, short: 'Thu', long: 'Thursday' },
  { n: 5, short: 'Fri', long: 'Friday' },
];
/** Rows from 6 am to 7 pm cover the office day in every U.S. zone, Pacific to Eastern. */
const FIRST = 6;
const LAST = 19;
const hours = Array.from({ length: LAST - FIRST + 1 }, (_, i) => FIRST + i);
const hourLabel = (h: number) => `${h % 12 === 0 ? 12 : h % 12} ${h < 12 ? 'am' : 'pm'}`;

const office = site.hours[0]!;
const toMin = (t: string) => {
  const [h = '0', m = '0'] = t.split(':');
  return Number(h) * 60 + Number(m);
};
const opens = toMin(office.opens);
const closes = toMin(office.closes);
const zone = US_ZONES[0];

// Server render: Eastern time, so the office hours are the hours themselves.
const isOpen = (h: number) => h * 60 >= opens && h * 60 < closes;

// The SSR readout: next Monday 10 am Eastern from the build date.
const now = new Date();
const today = wallClock(zone.id, now);
const d = new Date(Date.UTC(today.year, today.month - 1, today.day + ((8 - today.weekday) % 7 || 7)));
const sample = zonedTimeToUtc(zone.id, d.getUTCFullYear(), d.getUTCMonth() + 1, d.getUTCDate(), 10, 0);
const sampleWilmington = formatClock(sample, site.timezone);
const sampleIndia = formatClock(sample, INDIA_ZONE);
const SEL = { day: 1, hour: 10 };
---

<div class="week" data-hero="week" data-zone={zone.id} data-opens={opens} data-closes={closes} data-first={FIRST} data-last={LAST}>
  <div class="week__top">
    <div class="week__zones" role="group" aria-label="Show the week in your time zone">
      {
        US_ZONES.map((z, i) => (
          <button type="button" class="chip week__zone" aria-pressed={i === 0 ? 'true' : 'false'} data-zone-id={z.id} data-short={z.short} data-label={z.label}>
            <b>{z.short}</b> {z.label}
          </button>
        ))
      }
    </div>
    <p class="week__status live is-off" data-status>Office hours: {site.hoursLabel}</p>
  </div>

  <div class="week__frame">
    <p class="sr-only" id="week-caption">
      Wilmington office hours for the week, shown in <span data-zone-long>{zone.label}</span> time. Use the arrow keys to move between hours.
    </p>
    <div class="week__grid" role="grid" aria-labelledby="week-caption" data-grid>
      <div role="row" class="week__row week__row--head">
        <span role="columnheader" class="week__corner"><span data-zone-short>{zone.short}</span></span>
        {
          DAYS.map((day) => (
            <span role="columnheader" class="week__day" data-day-head={day.n}>
              <abbr title={day.long}>{day.short}</abbr> <span class="week__date" data-date />
            </span>
          ))
        }
      </div>
      {
        hours.map((h, r) => (
          <div role="row" class="week__row">
            <span role="rowheader" class="week__hour" data-hour-head={h}>
              {hourLabel(h)}
            </span>
            {DAYS.map((day) => {
              const open = isOpen(h);
              const selected = day.n === SEL.day && h === SEL.hour;
              return (
                <span role="gridcell" class="week__gc">
                  <button
                    type="button"
                    class:list={['week__cell', { 'is-open': open, 'is-selected': selected }]}
                    tabindex={selected ? 0 : -1}
                    aria-pressed={selected ? 'true' : 'false'}
                    data-day={day.n}
                    data-hour={h}
                    data-row={r}
                    aria-label={`${day.long} ${hourLabel(h)} ${zone.short}, ${open ? 'office open' : 'office closed'}`}
                  />
                </span>
              );
            })}
          </div>
        ))
      }
      <span class="week__now" aria-hidden="true" data-now hidden></span>
    </div>
    <p class="week__legend" aria-hidden="true">
      <span><i class="week__key week__key--open"></i>Wilmington office open</span>
      <span><i class="week__key week__key--now"></i>Now</span>
    </p>
  </div>

  <div class="week__readout ruled" aria-live="polite">
    <div class="module week__read">
      <p class="label week__read-key" data-out="when">Monday, {hourLabel(SEL.hour)} {zone.short}</p>
      <p class="week__sentence" data-out="sentence">That is {sampleWilmington} in Wilmington and {sampleIndia} in India.</p>
    </div>
    <div class="module week__book">
      <a class="btn btn--primary btn--block" href={site.calendly} target="_blank" rel="noopener">
        Book a call <Icon name="calendar" class="btn__arrow" />
      </a>
      <p class="small week__book-note">30 minutes with a client partner.</p>
    </div>
  </div>
</div>

<style>
  .week { display: grid; gap: var(--s-4); }
  .week__top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--s-3) var(--s-5); }
  .week__zones { display: flex; flex-wrap: wrap; gap: var(--s-2); }
  .week__zone b { font-weight: 750; font-stretch: var(--semi-wide); }
  .week__status { font-size: var(--t-small); font-weight: 600; font-variant-numeric: tabular-nums; }

  .week__frame { display: grid; gap: var(--s-3); }
  .week__grid {
    --row: 2.25rem;
    position: relative;
    display: grid;
    grid-template-columns: 4rem repeat(5, minmax(0, 1fr));
    grid-template-rows: auto;
    grid-auto-rows: var(--row);
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
  }
  @media (pointer: coarse) { .week__grid { --row: 2.75rem; } }
  .week__row { display: contents; }
  .week__corner, .week__day, .week__hour { background: var(--plate); display: flex; align-items: center; font-variant-numeric: tabular-nums; }
  .week__corner { justify-content: center; font-size: 0.75rem; font-weight: 750; font-stretch: var(--wide); color: var(--accent-text); }
  .week__day { justify-content: center; gap: 0.35rem; padding: var(--s-3) var(--s-1); font-weight: 700; font-stretch: var(--semi-wide); font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.04em; }
  .week__day abbr { text-decoration: none; }
  .week__date { color: var(--ink-3); font-weight: 600; }
  .week__day.is-today { background: var(--ink); color: var(--ground); }
  .week__day.is-today .week__date { color: inherit; opacity: 0.7; }
  .week__hour { justify-content: flex-end; padding-inline: var(--s-2) var(--s-3); font-size: 0.75rem; font-weight: 600; color: var(--ink-2); white-space: nowrap; }
  .week__hour.is-now { color: var(--ink); font-weight: 800; }
  .week__gc { display: block; background: var(--ground); }
  .week__cell {
    display: block;
    width: 100%;
    height: 100%;
    background: transparent;
    transition: background-color var(--t-ui) ease, box-shadow var(--t-ui) ease;
  }
  .week__cell.is-open { background: var(--lime-400); }
  /* Each open block reads as one field: a faint rule between open hours. */
  .week__cell.is-open { box-shadow: inset 0 -1px 0 rgb(11 12 10 / 0.12); }
  .week__cell:focus-visible { outline: 2px solid var(--focus); outline-offset: -2px; }
  .week__cell.is-selected { box-shadow: inset 0 0 0 3px var(--ink); }
  .week__cell.is-open.is-selected { box-shadow: inset 0 0 0 3px var(--carbon-950); }
  .week__cell:active { transform: scale(0.97); }
  @media (hover: hover) and (pointer: fine) {
    .week__cell:hover:not(.is-selected) { box-shadow: inset 0 0 0 1px var(--ink-2); }
  }
  :global(:root[data-theme='light']) .week__cell.is-open { background: var(--lime-400); }
  .week__now {
    grid-column: var(--col, 2);
    grid-row: var(--r, 2);
    align-self: start;
    position: relative;
    height: 2px;
    margin-inline: -3px;
    background: var(--ink);
    transform: translateY(calc(var(--f, 0) * var(--row)));
    pointer-events: none;
    z-index: 1;
  }
  .week__now::before { content: ''; position: absolute; left: -2px; top: -4px; width: 10px; height: 10px; background: var(--ink); border-radius: 50%; }
  .week__legend { display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-5); font-size: 0.8125rem; color: var(--ink-2); }
  .week__key { display: inline-block; width: 1.25rem; height: 0.75rem; margin-right: 0.5rem; vertical-align: -0.05rem; }
  .week__key--open { background: var(--lime-400); }
  .week__key--now { height: 2px; vertical-align: 0.2rem; background: var(--ink); }

  .week__readout { grid-template-columns: 1fr; }
  @media (min-width: 40rem) { .week__readout { grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); } }
  .week__readout .module { padding: var(--s-4) var(--s-5); display: grid; gap: var(--s-2); align-content: center; }
  .week__read-key { color: var(--ink-2); }
  .week__sentence { font-size: clamp(1.0625rem, 0.95rem + 0.4vw, 1.25rem); font-weight: 650; font-stretch: var(--semi-wide); line-height: 1.3; font-variant-numeric: tabular-nums; }
  .week__book-note { color: var(--ink-2); }
  @media (max-width: 30rem) {
    .week__grid { grid-template-columns: 3.25rem repeat(5, minmax(0, 1fr)); }
    .week__date { display: none; }
    .week__day { font-size: 0.75rem; }
    .week__hour { font-size: 0.6875rem; padding-inline: 2px var(--s-2); }
  }
  :global(html:not(.js)) .week__zones { display: none; }
</style>
