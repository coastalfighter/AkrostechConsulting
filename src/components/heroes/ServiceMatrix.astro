---
/**
 * Services hero instrument: "what do you want off your plate?" The visitor toggles task chips;
 * a ruled matrix of the five practices shows which practices cover the chosen tasks, how many
 * each covers, and the smallest team shape that covers all of them. Server-rendered with three
 * tasks chosen, so it reads correctly without JavaScript.
 */
import Icon from '@/components/Icon.astro';
import { services, serviceHref, type ServiceSlug } from '@/data/services';
import { DEFAULT_SELECTION, matrixTasks, planMatrix } from '@/lib/matrix';

const plan = planMatrix(DEFAULT_SELECTION);
const nameOf = (slug: ServiceSlug) => services.find((s) => s.slug === slug)?.name ?? slug;
const labelOf = (id: string) => matrixTasks.find((t) => t.id === id)?.label ?? id;
const total = DEFAULT_SELECTION.length;
const shapeTitle = plan.shape === 'pod' ? `A pod across ${plan.team.length} practices` : plan.shape === 'specialist' ? 'One specialist' : 'Choose a task';
const shapeBody =
  plan.shape === 'pod'
    ? `${plan.team.map(nameOf).join(' + ')}, under one team lead and one weekly report.`
    : plan.shape === 'specialist'
      ? `A dedicated ${nameOf(plan.team[0]!)} professional on your hours, with a team lead reviewing the work.`
      : 'Pick the work you want handed over and the matrix shows who covers it.';
---

<div class="mx" data-hero="matrix">
  <fieldset class="mx__pick">
    <legend class="mx__legend">
      <span class="label">What do you want off your plate?</span>
      <span class="mx__chosen small"><b data-out="chosen">{total}</b> of {matrixTasks.length} tasks chosen</span>
    </legend>
    <div class="chips mx__chips">
      {
        matrixTasks.map((t) => (
          <button type="button" class="chip mx__chip" aria-pressed={DEFAULT_SELECTION.includes(t.id) ? 'true' : 'false'} data-task={t.id}>
            <span class="mx__box" aria-hidden="true" />
            {t.label}
          </button>
        ))
      }
    </div>
  </fieldset>

  <div class="mx__matrix">
    <div class="mx__head" aria-hidden="true">
      <span class="label">Practice</span>
      <span class="mx__ticks">{matrixTasks.map((t) => <i class:list={{ 'is-on': DEFAULT_SELECTION.includes(t.id) }} data-tick={t.id} />)}</span>
      <span class="label mx__head-n">Covers</span>
    </div>
    <ol class="mx__rows" role="list" aria-label="Practices that cover the chosen tasks">
      {
        plan.rows.map((r) => {
          const state = r.inTeam ? 'team' : r.covered.length ? 'also' : 'none';
          return (
            <li class:list={['mx__row', { lime: state === 'team' }]} data-row={r.slug} data-state={state}>
              <div class="mx__name">
                <a class="mx__link" href={serviceHref(r.slug)}>
                  {nameOf(r.slug)}
                  <Icon name="arrow-up-right" class="icon mx__arrow" />
                </a>
                <span class="mx__covers small" data-covers>
                  <span class="mx__tag" data-tag>{state === 'team' ? 'In your team' : state === 'also' ? 'Also covers' : 'Not needed'}</span>
                  <span data-covers-list>{r.covered.length ? r.covered.map(labelOf).join(', ') : 'None of the chosen tasks'}</span>
                </span>
              </div>
              <span class="mx__cells" aria-hidden="true">
                {matrixTasks.map((t) => (
                  <i class:list={{ 'is-scope': t.covers.includes(r.slug), 'is-on': DEFAULT_SELECTION.includes(t.id) }} data-cell={t.id} />
                ))}
              </span>
              <p class="mx__n" aria-label={`Covers ${r.covered.length} of ${total} chosen tasks`} data-n-label>
                <span class="mx__n-big" data-n>{r.covered.length}</span>
                <span class="mx__n-of">/<span data-total>{total}</span></span>
              </p>
            </li>
          );
        })
      }
    </ol>
  </div>

  <div class="mx__shape" aria-live="polite">
    <div class="mx__shape-text">
      <p class="label mx__shape-key">Suggested team shape</p>
      <p class="mx__shape-title" data-out="shape">{shapeTitle}</p>
      <p class="mx__shape-body small" data-out="shape-body">{shapeBody}</p>
    </div>
    <ul class="mx__go" role="list">
      {
        services.map((s) => (
          <li hidden={!plan.team.includes(s.slug)} data-go={s.slug}>
            <a class="more" href={serviceHref(s.slug)}>
              {s.name} <Icon name="arrow-right" />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
  <p class="mx__hint small muted">Toggle the tasks above. Lime rows are the practices in your suggested team; each square is a task in that practice’s written scope.</p>
</div>

<style>
  .mx { display: grid; gap: var(--s-5); }

  /* ---- Task chips ---- */
  .mx__pick { border: 0; padding: 0; min-width: 0; display: grid; gap: var(--s-4); }
  .mx__legend { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: var(--s-2) var(--s-5); width: 100%; padding: 0; margin-bottom: var(--s-4); }
  .mx__legend .label { color: var(--ink); }
  .mx__chosen { color: var(--ink-2); font-variant-numeric: tabular-nums; }
  .mx__chosen b { color: var(--ink); font-weight: 700; }
  .mx__chips { gap: 6px; }
  .mx__chip { gap: 0.55rem; padding-inline: 0.7rem 0.85rem; font-size: 0.9375rem; }
  .mx__box { position: relative; width: 0.75rem; height: 0.75rem; border: 1px solid currentColor; flex: none; }
  .mx__chip[aria-pressed='true'] .mx__box { background: currentColor; }
  .mx__chip[aria-pressed='true'] .mx__box::after {
    content: '';
    position: absolute;
    inset: 1px;
    background: var(--accent);
    clip-path: polygon(14% 52%, 38% 76%, 88% 20%, 96% 30%, 38% 92%, 6% 62%);
  }

  /* ---- Matrix ---- */
  .mx__matrix { border-top: 1px solid var(--rule-strong); }
  .mx__head,
  .mx__row { display: grid; grid-template-columns: minmax(0, 1fr) auto 4.5rem; gap: var(--s-2) var(--s-5); align-items: center; }
  .mx__head { padding: var(--s-3) var(--s-4); color: var(--ink-2); }
  .mx__head-n { text-align: right; }
  .mx__ticks,
  .mx__cells { display: grid; grid-template-columns: repeat(16, 0.875rem); gap: 3px; }
  .mx__ticks i { display: block; height: 0.5rem; border-left: 1px solid var(--rule-strong); margin-left: calc(0.4375rem - 0.5px); transition: border-color var(--t-ui) ease, transform var(--t-ui) var(--ease-out); transform-origin: 50% 100%; }
  .mx__ticks i.is-on { border-left: 2px solid var(--accent-text); transform: scaleY(1.6); }

  .mx__rows { display: grid; gap: 1px; background: var(--rule); border-block: 1px solid var(--rule); }
  .mx__row {
    position: relative;
    padding: var(--s-4);
    min-height: 5.25rem;
    background: var(--ground);
    transition: background-color var(--t-ui) ease, color var(--t-ui) ease;
  }
  .mx__row.lime { background: var(--field); }
  .mx__name { display: grid; gap: var(--s-1); min-width: 0; }
  .mx__link {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 44px;
    margin-block: -0.5rem;
    font-size: clamp(1.0625rem, 0.95rem + 0.5vw, 1.375rem);
    font-weight: 750;
    font-stretch: 125%;
    letter-spacing: -0.01em;
    line-height: 1.05;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink);
    justify-self: start;
  }
  .mx__arrow { width: 1rem; height: 1rem; opacity: 0.6; transition: transform var(--t-ui) var(--ease-out), opacity var(--t-ui) ease; }
  @media (hover: hover) and (pointer: fine) {
    .mx__link:hover .mx__arrow { transform: translate(3px, -3px); opacity: 1; }
  }
  .mx__covers { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 var(--s-3); color: var(--ink-2); }
  .mx__tag { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; font-stretch: 112%; color: var(--ink); }
  .mx__row[data-state='none'] .mx__tag { color: var(--ink-3); }
  .mx__row[data-state='none'] .mx__link { color: var(--ink-2); }

  .mx__cells i { display: block; aspect-ratio: 1; border: 1px solid transparent; background: var(--plate-2); transition: background-color var(--t-ui) ease, border-color var(--t-ui) ease; }
  .mx__cells i.is-scope { border-color: var(--rule-strong); background: transparent; }
  .mx__cells i.is-on:not(.is-scope) { background: var(--plate-3); }
  .mx__cells i.is-scope.is-on { background: var(--ink-2); border-color: var(--ink-2); }
  .mx__row.lime .mx__cells i { background: rgb(11 12 10 / 0.08); }
  .mx__row.lime .mx__cells i.is-scope { background: transparent; border-color: rgb(11 12 10 / 0.45); }
  .mx__row.lime .mx__cells i.is-scope.is-on { background: var(--field-ink); border-color: var(--field-ink); }

  .mx__n { display: flex; justify-content: flex-end; align-items: baseline; gap: 2px; font-variant-numeric: tabular-nums; font-stretch: 125%; font-weight: 750; line-height: 1; }
  .mx__n-big { font-size: clamp(1.75rem, 1.3rem + 1.4vw, 2.5rem); letter-spacing: -0.03em; }
  .mx__n-of { font-size: 1rem; color: var(--ink-2); }
  .mx__row[data-state='none'] .mx__n-big { color: var(--ink-3); }

  /* ---- Team shape readout ---- */
  .mx__shape {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-4) var(--s-6);
    padding: var(--s-5) var(--s-4) var(--s-4);
    border: 1px solid var(--rule-strong);
    background: var(--plate);
  }
  @media (min-width: 40rem) { .mx__shape { grid-template-columns: minmax(0, 1fr) auto; align-items: end; } }
  .mx__shape-text { display: grid; gap: var(--s-2); }
  .mx__shape-key { color: var(--ink-2); }
  .mx__shape-title { font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.25rem); font-weight: 750; font-stretch: 125%; letter-spacing: -0.02em; line-height: 1; text-transform: uppercase; }
  .mx__shape-body { color: var(--ink-2); max-width: 46ch; }
  .mx__go { display: grid; gap: 0; }
  .mx__go .more { min-height: 2.25rem; font-size: 0.9375rem; color: var(--accent-text); }
  .mx__hint { max-width: 60ch; }

  /* ---- Phones: name and count share a line, the cells run beneath ---- */
  @media (max-width: 39.99rem) {
    .mx__head { display: none; }
    .mx__row { grid-template-columns: minmax(0, 1fr) auto; }
    .mx__cells { grid-column: 1 / -1; grid-row: 2; grid-template-columns: repeat(16, minmax(0, 1fr)); max-width: 20rem; }
    .mx__n { grid-column: 2; grid-row: 1; align-self: start; }
  }

  :global(html:not(.js)) .mx__hint { display: none; }
  :global(html:not(.js)) .mx__chip { pointer-events: none; }
</style>
