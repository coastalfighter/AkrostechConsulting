---
/**
 * Locations hero instrument: the I-95 corridor as a line diagram. Wilmington, Philadelphia and
 * New York are placed by their real coordinates on a hairline graticule; the lime line runs up
 * the corridor from headquarters, and the stretch between HQ and the selected city is drawn
 * heavy. Each stop is a button on the map (arrow keys move between them); the readout below
 * gives the straight-line distance, the published travel note, the headline and industries.
 * Server-rendered with headquarters selected.
 */
import Icon from '../Icon.astro';
import { site } from '@/config/site';
import { locations } from '@/data/locations';
import { cumulativeMiles, milesBetween, projector } from '@/lib/geo';

const W = 800;
const H = 500;
const frame = { west: -75.8, east: -73.8, south: 39.58, north: 40.86, width: W, height: H };
const project = projector(frame);
const hq = { latitude: site.geo.latitude, longitude: site.geo.longitude };

const stops = locations.map((l) => ({ ...l, pt: project(l.geo), toHq: milesBetween(l.geo, hq) }));
const along = cumulativeMiles(locations.map((l) => l.geo));
const totalMiles = along[along.length - 1] ?? 1;
const linePoints = stops.map((s) => `${s.pt.x},${s.pt.y}`).join(' ');
const pathD = `M${stops.map((s) => `${s.pt.x} ${s.pt.y}`).join(' L')}`;
const pct = (v: number, of: number) => `${Math.round((v / of) * 10000) / 100}%`;

/** A point a given number of miles up the line from headquarters, with the local direction. */
function atMile(mile: number): { x: number; y: number; dx: number; dy: number } {
  for (let i = 1; i < stops.length; i++) {
    const a = stops[i - 1]!;
    const b = stops[i]!;
    const m0 = along[i - 1] ?? 0;
    const m1 = along[i] ?? 0;
    if (mile <= m1 || i === stops.length - 1) {
      const t = (mile - m0) / Math.max(0.001, m1 - m0);
      const dx = b.pt.x - a.pt.x;
      const dy = b.pt.y - a.pt.y;
      const len = Math.hypot(dx, dy) || 1;
      return { x: a.pt.x + dx * t, y: a.pt.y + dy * t, dx: dx / len, dy: dy / len };
    }
  }
  return { x: 0, y: 0, dx: 1, dy: 0 };
}
const ticks = Array.from({ length: Math.floor(totalMiles / 10) }, (_, i) => (i + 1) * 10).map((mile) => {
  const p = atMile(mile);
  const major = mile % 50 === 0;
  const len = major ? 11 : 6;
  // Perpendicular to the line, on its south-east side.
  return { mile, major, x1: p.x, y1: p.y, x2: p.x - p.dy * len, y2: p.y + p.dx * len, lx: p.x - p.dy * 26, ly: p.y + p.dx * 26 };
});

const lats = [39.75, 40, 40.25, 40.5, 40.75].map((lat) => ({ lat, y: project({ latitude: lat, longitude: frame.west }).y }));
const lngs = [-75.5, -75.25, -75, -74.75, -74.5, -74.25, -74].map((lng) => ({ lng, x: project({ latitude: frame.south, longitude: lng }).x }));
const states = [
  { name: 'Pennsylvania', ...project({ latitude: 40.45, longitude: -75.45 }) },
  { name: 'New Jersey', ...project({ latitude: 39.78, longitude: -74.4 }) },
  { name: 'Delaware', ...project({ latitude: 39.63, longitude: -75.68 }) },
];
// The corridor label sits beside the Philadelphia–New York stretch, along its angle.
const mid = atMile((along[1] ?? 0) + ((along[2] ?? 0) - (along[1] ?? 0)) * 0.55);
const angle = (Math.atan2(mid.dy, mid.dx) * 180) / Math.PI;
// 25 miles of latitude, in drawing units, for the scale bar.
const scaleUnits = project({ latitude: 40, longitude: -75 }).y - project({ latitude: 40 + 25 / 69.05, longitude: -75 }).y;

const side: Record<string, string> = { 'wilmington-de': 'right', 'philadelphia-pa': 'right', 'new-york-ny': 'left' };
const initial = stops.findIndex((s) => s.isHeadquarters);
const sel = initial < 0 ? 0 : initial;
---

<div class="cor" data-hero="corridor" data-total={totalMiles.toFixed(2)} style={`--reach:${(along[sel] ?? 0) / totalMiles}`}>
  <div class="cor__map" style={`aspect-ratio:${W} / ${H}`}>
    <svg class="cor__svg" viewBox={`0 0 ${W} ${H}`} aria-hidden="true" focusable="false">
      <g class="cor__grat">
        {lats.map((l) => <line class:list={{ 'is-major': Number.isInteger(l.lat * 2) }} x1="0" x2={W} y1={l.y} y2={l.y} />)}
        {lngs.map((l) => <line class:list={{ 'is-major': Number.isInteger(l.lng * 2) }} x1={l.x} x2={l.x} y1="0" y2={H} />)}
      </g>
      <g class="cor__grat-labels">
        {lats.filter((l) => Number.isInteger(l.lat * 2)).map((l) => <text x="8" y={l.y - 6}>{l.lat.toFixed(1)}°N</text>)}
        {lngs.filter((l) => Number.isInteger(l.lng * 2)).map((l) => <text x={l.x + 6} y={H - 8}>{Math.abs(l.lng).toFixed(1)}°W</text>)}
      </g>
      <g class="cor__states">{states.map((s) => <text x={s.x} y={s.y}>{s.name}</text>)}</g>

      <polyline class="cor__line" points={linePoints} />
      <path class="cor__reach" d={pathD} pathLength="1000" data-reach />
      <g class="cor__ticks">
        {ticks.map((t) => <line class:list={{ 'is-major': t.major }} x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} />)}
        {
          ticks
            .filter((t) => t.major)
            .map((t) => (
              <text x={t.lx} y={t.ly}>
                {t.mile} mi
              </text>
            ))
        }
      </g>
      <text class="cor__corridor" transform={`translate(${mid.x - mid.dy * -18} ${mid.y + mid.dx * -18}) rotate(${angle})`}>I-95 · NORTHEAST CORRIDOR</text>
    </svg>

    <div class="cor__scale" style={`width:${pct(scaleUnits, W)}`} aria-hidden="true">
      <span class="cor__scale-bar"></span>
      <span class="cor__scale-label">0</span><span class="cor__scale-label">25 mi</span>
    </div>
    <p class="cor__north" aria-hidden="true">N</p>

    <div class="cor__stops" role="group" aria-label="Stops on the corridor. Use the arrow keys to move between them." data-stops>
      {
        stops.map((s, i) => (
          <button
            type="button"
            class:list={['cor__stop', `cor__stop--${side[s.slug] ?? 'right'}`, { 'is-hq': s.isHeadquarters }]}
            style={`left:${pct(s.pt.x, W)};top:${pct(s.pt.y, H)}`}
            aria-pressed={i === sel ? 'true' : 'false'}
            aria-controls="corridor-readout"
            tabindex={i === sel ? 0 : -1}
            data-stop={s.slug}
            data-reach={((along[i] ?? 0) / totalMiles).toFixed(4)}
          >
            <span class="cor__node" aria-hidden="true" />
            <span class="cor__name">
              {s.city}
              {s.isHeadquarters && <span class="cor__hq">HQ</span>}
            </span>
          </button>
        ))
      }
    </div>
  </div>

  <div class="cor__readout" id="corridor-readout" aria-live="polite">
    {
      stops.map((s, i) => (
        <div class="cor__panel ruled" data-panel={s.slug} hidden={i !== sel}>
          <div class="module lime cor__fig-mod">
            <p class="label">{s.isHeadquarters ? 'Headquarters' : 'Straight line to HQ'}</p>
            <p class="cor__fig">
              {s.isHeadquarters ? (
                <>
                  {site.address.street.split(' ')[0]}
                  <span class="cor__fig-unit">{site.address.street.split(' ').slice(1).join(' ')} · you are here</span>
                </>
              ) : (
                <>
                  {Math.round(s.toHq)}
                  <span class="cor__fig-unit">mi to Wilmington</span>
                </>
              )}
            </p>
          </div>
          <div class="module cor__copy">
            <p class="cor__city">
              {s.city}, {s.region}
            </p>
            <p class="cor__headline">{s.headline.join(' ')}</p>
            <p class="cor__travel">
              <Icon name="route" class="icon cor__travel-icon" />
              <span>{s.distance}</span>
            </p>
          </div>
          <div class="module module--flex cor__inds">
            <p class="label">Who we support</p>
            <ul class="cor__ind-list" role="list">
              {s.industries.map((ind) => <li>{ind.name}</li>)}
            </ul>
            <a class="more cor__open" href={`/locations/${s.slug}`}>
              {s.isHeadquarters ? 'Visit the Wilmington office' : `${s.city} service area`} <Icon name="arrow-right" />
            </a>
          </div>
        </div>
      ))
    }
  </div>
  <p class="cor__hint small muted">Select a stop, or focus one and use the arrow keys. Distances are straight-line to {site.address.street}; the marks run every 10 miles up the line from headquarters.</p>
</div>

<style>
  .cor { --reach: 0; display: grid; gap: var(--s-4); }
  .cor__map { position: relative; border: 1px solid var(--rule-strong); background: var(--plate); overflow: hidden; }
  .cor__svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .cor__grat line { stroke: var(--rule); stroke-width: 1; vector-effect: non-scaling-stroke; stroke-dasharray: 2 4; }
  .cor__grat line.is-major { stroke-dasharray: none; }
  .cor__grat-labels text { font-size: 12px; font-weight: 600; fill: var(--ink-3); font-variant-numeric: tabular-nums; letter-spacing: 0.04em; }
  .cor__states text { font-size: 12px; font-weight: 650; fill: var(--ink-3); letter-spacing: 0.24em; text-transform: uppercase; text-anchor: middle; opacity: 0.8; }
  .cor__line { fill: none; stroke: var(--field); stroke-width: 2; vector-effect: non-scaling-stroke; opacity: 0.6; }
  .cor__reach { fill: none; stroke: var(--field); stroke-width: 9; stroke-linecap: square; stroke-dasharray: 1000 1000; stroke-dashoffset: calc((1 - var(--reach)) * 1000px); transition: stroke-dashoffset 280ms var(--ease-out); }
  :global(:root[data-theme='light']) .cor__line, :global(:root[data-theme='light']) .cor__reach { stroke: var(--lime-600); }
  :global(:root[data-theme='light']) .cor__line { opacity: 1; }
  .cor__ticks line { stroke: var(--ink-2); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .cor__ticks line.is-major { stroke: var(--ink); stroke-width: 1.5; }
  .cor__ticks text { font-size: 12px; font-weight: 650; fill: var(--ink-2); text-anchor: middle; dominant-baseline: central; font-variant-numeric: tabular-nums; }
  .cor__corridor { font-size: 11px; font-weight: 700; letter-spacing: 0.2em; fill: var(--accent-text); text-anchor: middle; }

  .cor__scale { position: absolute; left: var(--s-4); top: var(--s-4); display: grid; grid-template-columns: 1fr auto; row-gap: 4px; font-size: 0.75rem; font-weight: 650; color: var(--ink-2); font-variant-numeric: tabular-nums; }
  .cor__scale-bar { grid-column: 1 / -1; height: 6px; border: 1px solid var(--ink-2); border-top: 0; }
  .cor__north { position: absolute; right: var(--s-4); top: var(--s-3); display: grid; place-items: center; width: 2rem; height: 2.5rem; font-size: 0.8125rem; font-weight: 750; color: var(--ink-2); border-top: 2px solid var(--ink-2); }

  .cor__stop { position: absolute; display: flex; align-items: center; gap: var(--s-2); min-height: 44px; translate: -22px -22px; padding: 0 var(--s-2) 0 0; color: var(--ink-2); transition: color var(--t-ui) ease; -webkit-tap-highlight-color: transparent; }
  .cor__node { position: relative; display: grid; place-items: center; width: 44px; height: 44px; flex: none; }
  .cor__node::before { content: ''; width: 14px; height: 14px; background: var(--plate); border: 2px solid var(--ink-2); transition: transform var(--t-ui) var(--ease-out), background-color var(--t-ui) ease, border-color var(--t-ui) ease; }
  .cor__name { font-size: 0.9375rem; font-weight: 700; font-stretch: 112%; white-space: nowrap; display: inline-flex; align-items: center; gap: var(--s-2); padding: 0.15rem 0.4rem; background: var(--plate); }
  .cor__hq { font-size: 0.6875rem; letter-spacing: 0.08em; padding: 0.1rem 0.35rem; border: 1px solid currentColor; }
  .cor__stop--left { flex-direction: row-reverse; translate: calc(-100% + 22px) -22px; padding: 0 0 0 var(--s-2); }
  .cor__stop--below { flex-direction: column; align-items: flex-start; gap: 0; }
  .cor__stop--below .cor__name { margin-left: 4px; }
  .cor__stop[aria-pressed='true'] { color: var(--ink); z-index: 1; }
  .cor__stop[aria-pressed='true'] .cor__node::before { background: var(--field); border-color: var(--field); transform: scale(1.45); }
  .cor__stop[aria-pressed='true'] .cor__name { background: var(--field); color: var(--field-ink); }
  .cor__stop:focus-visible { outline: none; }
  .cor__stop:focus-visible .cor__node { outline: 2px solid var(--focus); outline-offset: -6px; }
  .cor__stop:active .cor__node::before { transform: scale(0.97); }
  @media (hover: hover) and (pointer: fine) {
    .cor__stop:hover { color: var(--ink); }
    .cor__stop:hover:not([aria-pressed='true']) .cor__node::before { border-color: var(--ink); }
  }

  .cor__panel { grid-template-columns: 1fr; }
  @media (min-width: 40rem) { .cor__panel { grid-template-columns: minmax(0, 4fr) minmax(0, 5fr); } .cor__inds { grid-column: 1 / -1; } }
  @media (min-width: 80rem) { .cor__panel { grid-template-columns: minmax(0, 3fr) minmax(0, 5fr) minmax(0, 4fr); } .cor__inds { grid-column: auto; } }
  .cor__panel .module { padding: var(--s-4) var(--s-5); }
  .cor__fig-mod { display: flex; flex-direction: column; justify-content: space-between; gap: var(--s-4); }
  .cor__fig { white-space: nowrap; font-size: clamp(2.5rem, 1.6rem + 1.6vw, 3.25rem); font-weight: 750; font-stretch: 125%; line-height: 0.85; letter-spacing: -0.03em; font-variant-numeric: tabular-nums; }
  .cor__fig-unit { display: block; white-space: normal; margin-top: var(--s-2); font-size: 0.8125rem; font-weight: 650; letter-spacing: 0.06em; text-transform: uppercase; line-height: 1.2; }
  .cor__copy { display: grid; gap: var(--s-2); align-content: start; }
  .cor__city { font-size: 1.375rem; font-weight: 750; font-stretch: 125%; line-height: 1.05; text-transform: uppercase; }
  .cor__headline { color: var(--accent-text); font-weight: 650; font-stretch: 112%; }
  .cor__travel { display: flex; gap: var(--s-2); color: var(--ink-2); font-size: var(--t-small); }
  .cor__travel-icon { margin-top: 0.15rem; color: var(--ink); }
  .cor__inds { gap: var(--s-2); }
  .cor__inds .label { color: var(--ink-2); }
  .cor__ind-list { display: grid; font-size: var(--t-small); font-weight: 550; }
  .cor__ind-list li { padding-block: 0.3rem; border-bottom: 1px solid var(--rule); }
  .cor__open { margin-top: auto; }
  .cor__hint { max-width: 60ch; }

  :global(html:not(.js)) .cor__hint { display: none; }
  @media (max-width: 39.99rem) {
    .cor__grat-labels, .cor__states, .cor__ticks text, .cor__corridor { display: none; }
    .cor__name { font-size: 0.8125rem; }
    .cor__scale { left: var(--s-2); top: var(--s-2); }
  }
</style>
