---
/**
 * Infinite marquee. Pure CSS loop (content duplicated for a seamless wrap); the motion layer
 * adds scroll-velocity skew. Pauses on hover, on focus, and when the visitor presses pause.
 */
interface Props {
  items: string[];
  label: string;
  speed?: number;
}
const { items, label, speed = 48 } = Astro.props;
---

<section class="marquee" aria-label={label}>
  <ul class="sr-only">{items.map((i) => <li>{i}</li>)}</ul>
  <div class="marquee__viewport" aria-hidden="true">
    <div class="marquee__track" style={`--speed:${speed}s`} data-marquee>
      {
        [0, 1].map(() => (
          <div class="marquee__group">
            {items.map((item) => (
              <span class="marquee__item">
                {item}
                <span class="marquee__sep" />
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </div>
  <button class="marquee__toggle" type="button" aria-pressed="false" data-marquee-toggle>
    <span class="sr-only">Pause scrolling text</span>
    <svg viewBox="0 0 24 24" aria-hidden="true" class="marquee__pause"><path d="M8 5v14M16 5v14" stroke="currentColor" stroke-width="2.5"></path></svg>
    <svg viewBox="0 0 24 24" aria-hidden="true" class="marquee__play"><path d="M7 5v14l12-7z" fill="currentColor"></path></svg>
  </button>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-marquee-toggle]').forEach((btn) => {
    const section = btn.closest('.marquee');
    btn.addEventListener('click', () => {
      const paused = btn.getAttribute('aria-pressed') !== 'true';
      btn.setAttribute('aria-pressed', String(paused));
      section?.classList.toggle('is-paused', paused);
      const label = btn.querySelector('.sr-only');
      if (label) label.textContent = paused ? 'Play scrolling text' : 'Pause scrolling text';
    });
  });
</script>

<style>
  .marquee {
    position: relative;
    background: var(--inverse);
    color: var(--inverse-ink);
    padding-block: clamp(1.25rem, 2.5vw, 2.25rem);
    overflow: hidden;
  }
  .marquee__viewport { overflow: hidden; }
  .marquee__track { display: flex; width: max-content; }
  .marquee__group {
    display: flex;
    flex: none;
    animation: marquee var(--speed) linear infinite;
  }
  .marquee:hover .marquee__group,
  .marquee:focus-within .marquee__group,
  .marquee.is-paused .marquee__group { animation-play-state: paused; }
  .marquee__item {
    display: inline-flex;
    align-items: center;
    gap: clamp(1.25rem, 3vw, 2.75rem);
    padding-right: clamp(1.25rem, 3vw, 2.75rem);
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
    white-space: nowrap;
  }
  .marquee__sep {
    width: 0.55em;
    height: 0.22em;
    background: var(--inverse-accent);
  }
  .marquee__toggle {
    position: absolute;
    right: var(--gutter);
    bottom: 0.4rem;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    color: var(--inverse-ink);
    opacity: 0.55;
    transition: opacity var(--dur-fast);
  }
  .marquee__toggle:hover, .marquee__toggle:focus-visible { opacity: 1; }
  .marquee__toggle svg { width: 1rem; height: 1rem; }
  .marquee__play { display: none; }
  .marquee.is-paused .marquee__play { display: block; }
  .marquee.is-paused .marquee__pause { display: none; }
  @keyframes marquee { to { translate: -100% 0; } }
  @media (prefers-reduced-motion: reduce) {
    .marquee__group { animation: none; }
    .marquee__toggle { display: none; }
    .marquee__viewport { overflow-x: auto; }
  }
</style>
