---
/**
 * Footer (Sample-3 structure): brand column with the short description, Services, Company and
 * Contact columns, then the legal line. An ink panel in both themes.
 */
import { site, fullAddress, mapsDirectionsUrl } from '@/config/site';
import { services, serviceHref } from '@/data/services';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap">
    <div class="footer__panel ink-plate">
      <div class="footer__brand">
        <a class="footer__logo" href="/" aria-label={`${site.name}, home`}><Logo /></a>
        <p class="footer__desc">
          Dedicated, vetted offshore teams in India for U.S. businesses: virtual assistance, recruitment, accounting, legal support and website
          development, working your hours.
        </p>
        <p class="footer__tag">Built for startups, scaled by enterprises, trusted by leaders.</p>
        <a class="btn btn--primary btn--small" href={site.calendly} target="_blank" rel="noopener">
          Book a call <Icon name="arrow-up-right" class="btn__arrow" />
        </a>
      </div>
      <div class="footer__col">
        <h2 class="footer__head">Services</h2>
        <ul role="list" class="footer__list">
          {
            services.map((s) => (
              <li>
                <a class="link link--quiet" href={serviceHref(s.slug)}>
                  {s.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="footer__col">
        <h2 class="footer__head">Company</h2>
        <ul role="list" class="footer__list">
          <li><a class="link link--quiet" href="/">Home</a></li>
          <li><a class="link link--quiet" href="/about">About</a></li>
          <li><a class="link link--quiet" href="/blog">Blog</a></li>
          <li><a class="link link--quiet" href="/contact">Contact</a></li>
        </ul>
      </div>
      <div class="footer__col">
        <h2 class="footer__head">Contact</h2>
        <ul role="list" class="footer__list">
          <li><a class="link link--quiet" href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><a class="link link--quiet" href={`tel:${site.phoneE164}`}>{site.phone}</a></li>
          <li>
            <a class="footer__addr" href={mapsDirectionsUrl} target="_blank" rel="noopener">
              <address>{site.address.street}, {site.address.locality}, {site.address.region} {site.address.postalCode}</address>
            </a>
          </li>
          <li><a class="link link--quiet" href={site.socials.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
        </ul>
        <p class="footer__note">{site.hoursLabel}</p>
      </div>
    </div>
    <div class="footer__legal">
      <p>© {year} {site.legalName}. {fullAddress}.</p>
      <ul role="list">
        <li><a class="link link--quiet" href="/privacy">Privacy Policy</a></li>
        <li><a class="link link--quiet" href="/terms">Terms & Conditions</a></li>
        <li><a class="link link--quiet" href="/sitemap-index.xml">Sitemap</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer { padding-block: var(--s-8) var(--s-5); }
  .footer__panel {
    display: grid;
    gap: var(--s-7) var(--gutter);
    padding: clamp(1.75rem, 1rem + 3vw, 4rem);
    border-radius: calc(var(--radius) * 1.6);
  }
  @media (min-width: 40rem) { .footer__panel { grid-template-columns: repeat(3, minmax(0, 1fr)); } .footer__brand { grid-column: 1 / -1; } }
  @media (min-width: 64rem) { .footer__panel { grid-template-columns: 1.6fr 1fr 0.7fr 1.1fr; } .footer__brand { grid-column: auto; } }
  .footer__brand { display: grid; gap: var(--s-5); align-content: start; justify-items: start; }
  .footer__logo { text-decoration: none; font-size: 1.05rem; }
  .footer__desc { color: var(--ink-2); max-width: 40ch; }
  .footer__tag { font-family: var(--font-display); font-size: 1.25rem; line-height: 1.3; letter-spacing: -0.015em; max-width: 24ch; }
  .footer__col { display: grid; gap: var(--s-4); align-content: start; }
  .footer__head { font-family: var(--font); font-size: var(--t-label); font-weight: 600; letter-spacing: var(--track-label); text-transform: uppercase; color: var(--ink-3); }
  .footer__list { display: grid; gap: var(--s-1); }
  .footer__list a { display: inline-flex; min-height: 36px; align-items: center; }
  .footer__note { font-size: var(--t-small); color: var(--ink-2); }
  .footer__addr { text-decoration: none; }
  @media (hover: hover) and (pointer: fine) { .footer__addr:hover { text-decoration: underline; text-underline-offset: 0.2em; } }
  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-2) var(--s-6);
    padding: var(--s-5) var(--s-2) 0;
    font-size: 0.875rem;
    color: var(--ink-2);
  }
  .footer__legal ul { display: flex; flex-wrap: wrap; gap: var(--s-5); }
  .footer__legal a { display: inline-flex; min-height: 44px; align-items: center; }
</style>
