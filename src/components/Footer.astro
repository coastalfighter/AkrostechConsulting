---
/**
 * Footer: the manual's back cover. Four ruled columns (visit, services, company, contact),
 * the tagline set large, and the legal line.
 */
import { site, fullAddress, mapsDirectionsUrl } from '@/config/site';
import { services, serviceHref } from '@/data/services';
import { locations } from '@/data/locations';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

const year = new Date().getFullYear();
---

<footer class="footer ink-plate">
  <div class="wrap">
    <div class="footer__top grid">
      <a class="footer__logo c-4" href="/" aria-label={`${site.name}, home`}><Logo /></a>
      <p class="footer__tag c-8">
        <span>Offshore talent.</span>
        <span class="accent">Onshore quality.</span>
      </p>
    </div>

    <div class="footer__cols ruled">
      <div class="module">
        <h2 class="label footer__head">Visit</h2>
        <address class="footer__text">
          {site.legalName}<br />
          {site.address.street}<br />
          {site.address.locality}, {site.address.region} {site.address.postalCode}
        </address>
        <a class="more" href={mapsDirectionsUrl} target="_blank" rel="noopener">Get directions <Icon name="arrow-up-right" /></a>
        <p class="footer__note">Delivery teams in {site.deliveryCountry}, working U.S. hours.</p>
      </div>
      <div class="module">
        <h2 class="label footer__head">Services</h2>
        <ul role="list" class="footer__list">
          {services.map((s) => <li><a class="link link--quiet" href={serviceHref(s.slug)}>{s.name}</a></li>)}
        </ul>
      </div>
      <div class="module">
        <h2 class="label footer__head">Company</h2>
        <ul role="list" class="footer__list">
          <li><a class="link link--quiet" href="/about">About</a></li>
          <li><a class="link link--quiet" href="/work">Work</a></li>
          <li><a class="link link--quiet" href="/blog">Insights</a></li>
          <li><a class="link link--quiet" href="/locations">Service areas</a></li>
          {locations.map((l) => <li><a class="link link--quiet" href={`/locations/${l.slug}`}>{l.city}, {l.region}</a></li>)}
        </ul>
      </div>
      <div class="module">
        <h2 class="label footer__head">Talk to us</h2>
        <ul role="list" class="footer__list">
          <li><a class="link link--quiet" href={`tel:${site.phoneE164}`}>{site.phone}</a></li>
          <li><a class="link link--quiet" href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><a class="link link--quiet" href={site.socials.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
        </ul>
        <p class="footer__note">{site.hoursLabel}</p>
        <a class="btn btn--primary btn--small footer__cta" href={site.calendly} target="_blank" rel="noopener">
          Book a call <Icon name="arrow-up-right" class="btn__arrow" />
        </a>
      </div>
    </div>

    <div class="footer__legal">
      <p>© {year} {site.legalName}. {fullAddress}.</p>
      <ul role="list">
        <li><a class="link link--quiet" href="/privacy">Privacy</a></li>
        <li><a class="link link--quiet" href="/terms">Terms</a></li>
        <li><a class="link link--quiet" href="/sitemap-index.xml">Sitemap</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer { padding-top: var(--s-9); padding-bottom: var(--s-6); border-top: 1px solid var(--rule); }
  .footer__top { row-gap: var(--s-6); align-items: start; margin-bottom: var(--s-8); }
  .footer__logo { justify-self: start; text-decoration: none; font-size: 1.1rem; }
  .footer__tag {
    display: grid;
    font-size: clamp(2.25rem, 1rem + 4.4vw, 5.5rem);
    font-weight: 750;
    font-stretch: 125%;
    line-height: 0.92;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }
  .footer__cols { grid-template-columns: 1fr; }
  @media (min-width: 40rem) { .footer__cols { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 64rem) { .footer__cols { grid-template-columns: repeat(4, 1fr); } }
  .footer__cols > .module { display: flex; flex-direction: column; gap: var(--s-4); align-items: flex-start; }
  .footer__head { color: var(--ink-2); }
  .footer__text { line-height: 1.6; }
  .footer__list { display: grid; gap: var(--s-1); }
  .footer__list a { display: inline-flex; min-height: 36px; align-items: center; }
  .footer__note { font-size: var(--t-small); color: var(--ink-2); }
  .footer__cta { margin-top: auto; }
  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-3) var(--s-6);
    padding-top: var(--s-6);
    font-size: 0.875rem;
    color: var(--ink-2);
  }
  .footer__legal ul { display: flex; gap: var(--s-5); }
  .footer__legal a { display: inline-flex; min-height: 44px; align-items: center; }
</style>
