---
/** Blueprint module: photo, practice and format, title, one-line summary. Labelled as a blueprint. */
import Photo from './Photo.astro';
import { photoFor } from '@/data/photos';
import { services } from '@/data/services';
import type { WorkItem } from '@/data/work';

interface Props {
  item: WorkItem;
  headingLevel?: 'h2' | 'h3';
  sizes?: string;
  ratio?: string;
}
const { item, headingLevel: H = 'h3', sizes = '(min-width: 64rem) 33vw, (min-width: 40rem) 50vw, 100vw', ratio = '4 / 3' } = Astro.props;
const service = services.find((s) => s.slug === item.service);
---

<article class="work-card">
  <Photo name={photoFor(item.art, item.variant)} alt="" ratio={ratio} sizes={sizes} caption={item.kind === 'blueprint' ? 'Blueprint' : 'Case study'} />
  <div class="work-card__body">
    <p class="work-card__meta small">{service?.shortName} · {item.format} · {item.industry}</p>
    <H class="work-card__title"><a class="stretch" href={`/work/${item.slug}`}>{item.title}</a></H>
    <p class="work-card__summary">{item.summary}</p>
  </div>
</article>

<style>
  .work-card { position: relative; display: grid; align-content: start; gap: var(--s-4); }
  .work-card :global(.photo img) { transition: scale 600ms var(--ease-out); }
  @media (hover: hover) and (pointer: fine) {
    .work-card:hover :global(.photo img) { scale: 1.03; }
    .work-card:hover .work-card__title a { text-decoration: underline; text-decoration-color: var(--accent); text-decoration-thickness: 2px; }
  }
  .work-card__body { display: grid; gap: var(--s-3); }
  .work-card__meta { color: var(--ink-2); }
  .work-card__title { font-size: 1.375rem; font-stretch: 112%; line-height: 1.15; letter-spacing: -0.01em; }
  .work-card__title a { text-decoration: none; }
  .work-card__title a:focus-visible { outline: none; }
  .work-card:has(a:focus-visible) { outline: 2px solid var(--focus); outline-offset: 6px; }
  .work-card__summary { color: var(--ink-2); font-size: var(--t-small); }
</style>
