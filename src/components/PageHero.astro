---
/**
 * Inner-page hero: breadcrumbs, a masked-line H1 (authored as one or two lines),
 * a lede, optional actions and optional generated art that wipes in.
 */
import Breadcrumbs from './Breadcrumbs.astro';
import Media from './Media.astro';
import type { Crumb } from '@/lib/seo';

interface Props {
  title: string | [string, string];
  lede: string;
  crumbs: Crumb[];
  art?: string;
  artAlt?: string;
  tone?: 'default' | 'field' | 'inverse';
  size?: 'xl' | 'l';
}

const { title, lede, crumbs, art, artAlt = '', tone = 'default', size = 'xl' } = Astro.props;
const lines = Array.isArray(title) ? title : [title];
---

<section class:list={['phero', `phero--${tone}`, `phero--${size}`, { 'phero--art': art }]} aria-labelledby="page-title">
  {tone !== 'default' && <div class="mesh phero__mesh" aria-hidden="true" />}
  <div class="phero__inner wrap">
    <Breadcrumbs items={crumbs} />
    <h1 class="phero__title" id="page-title">
      {
        lines.map((l, i) => (
          <span class="phero__line" style={`--i:${i}`}>
            <span>{l}</span>
          </span>
        ))
      }
    </h1>
    <div class="phero__foot">
      <p class="phero__lede">{lede}</p>
      <div class="phero__actions"><slot name="actions" /></div>
    </div>
    <slot />
  </div>
  {
    art && (
      <div class="phero__art">
        <Media id={art} alt={artAlt} priority sizes="(min-width: 1024px) 40vw, 100vw" widths={[640, 960, 1280, 1600]} ratio="4 / 5" />
      </div>
    )
  }
</section>

<style>
  .phero {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    padding-top: calc(var(--header-h) + var(--space-l));
    padding-bottom: var(--space-2xl);
    overflow: clip;
  }
  .phero--field { background: var(--field); color: var(--field-ink); }
  .phero--inverse { background: var(--inverse); color: var(--inverse-ink); }
  .phero__mesh { z-index: -1; opacity: 0.5; }
  .phero--field .phero__inner :global(.crumbs ol), .phero--inverse .phero__inner :global(.crumbs ol) { color: inherit; opacity: 0.85; }
  .phero--field .phero__inner :global(.crumbs a), .phero--inverse .phero__inner :global(.crumbs a),
  .phero--field .phero__inner :global(.crumbs span), .phero--inverse .phero__inner :global(.crumbs span),
  .phero--field .phero__inner :global(.crumbs li::before), .phero--inverse .phero__inner :global(.crumbs li::before) { color: inherit; }

  .phero__inner { display: grid; align-content: start; gap: var(--space-xl); min-height: min(78svh, 46rem); }
  .phero__title {
    display: grid;
    align-content: start;
    margin-top: var(--space-xl);
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 0.92;
    color: var(--ink-strong);
  }
  .phero--field .phero__title, .phero--inverse .phero__title { color: inherit; }
  .phero--xl .phero__title { font-size: clamp(3rem, 0.8rem + 8.6vw, 10.5rem); }
  .phero--l .phero__title { font-size: clamp(2.5rem, 0.8rem + 6vw, 7.5rem); }
  .phero__line { display: block; overflow: clip; padding-bottom: 0.06em; margin-bottom: -0.06em; }
  .phero__line > span { display: block; }
  @media (prefers-reduced-motion: no-preference) {
    .phero__line > span { animation: phero-rise 1s var(--ease-out) calc(var(--i) * 110ms + 120ms) both; }
    .phero__foot { animation: phero-fade 0.8s var(--ease-out) 450ms both; }
    :global(html.is-preloading) .phero__line > span { animation-delay: calc(var(--i) * 110ms + 1.45s); }
    :global(html.is-preloading) .phero__foot { animation-delay: 1.8s; }
  }
  @keyframes phero-rise { from { translate: 0 105%; } }
  @keyframes phero-fade { from { opacity: 0; translate: 0 16px; } }

  .phero__foot { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: var(--space-l); margin-top: auto; }
  .phero__lede { max-width: 46ch; font-size: clamp(1.0625rem, 0.95rem + 0.5vw, 1.375rem); line-height: 1.45; }
  .phero__actions { display: flex; flex-wrap: wrap; gap: var(--space-xs); }
  .phero__actions:empty { display: none; }

  .phero--art { grid-template-columns: minmax(0, 1fr) minmax(0, 0.62fr); }
  .phero--art .phero__inner { padding-right: 0; }
  .phero__art { align-self: end; padding-right: var(--gutter); }
  @media (max-width: 1023px) {
    .phero--art { grid-template-columns: minmax(0, 1fr); }
    .phero__art { padding-inline: var(--gutter); max-width: 34rem; }
    .phero__inner { min-height: auto; }
  }
</style>
