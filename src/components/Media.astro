---
/**
 * Responsive art image: AVIF + WebP srcsets from Astro's image pipeline, explicit dimensions
 * (no CLS), lazy by default, and a blur-up placeholder from the generated manifest.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import manifest from '@/assets/art/manifest.json';

interface Props {
  id: string;
  alt: string;
  sizes?: string;
  widths?: number[];
  class?: string;
  priority?: boolean;
  /** Optional crop ratio for the frame, e.g. "4 / 5". Image covers the frame. */
  ratio?: string;
  wipe?: 'left' | 'up';
  parallax?: number;
}

const {
  id,
  alt,
  sizes = '(min-width: 1024px) 50vw, 100vw',
  widths = [480, 800, 1200, 1600, 2000],
  class: className,
  priority = false,
  ratio,
  wipe,
  parallax,
} = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/art/*.webp', { eager: true });
const image = images[`/src/assets/art/${id}.webp`]?.default;
if (!image) throw new Error(`Media: no generated art named "${id}". Run "npm run art".`);

const meta = (manifest as Record<string, { lqip: string; color: string }>)[id];
const usable = widths.filter((w) => w <= image.width);
const style = [
  meta ? `background-image:url(${meta.lqip});background-color:${meta.color}` : '',
  ratio ? `aspect-ratio:${ratio}` : `aspect-ratio:${image.width} / ${image.height}`,
]
  .filter(Boolean)
  .join(';');
---

<div
  class:list={['media', className]}
  style={style}
  data-media
  data-loaded={priority ? 'true' : 'false'}
  data-wipe={wipe}
>
  <Picture
    src={image}
    alt={alt}
    formats={['avif', 'webp']}
    fallbackFormat="webp"
    widths={usable.length ? usable : [image.width]}
    sizes={sizes}
    loading={priority ? 'eager' : 'lazy'}
    decoding={priority ? 'sync' : 'async'}
    fetchpriority={priority ? 'high' : 'auto'}
    quality={78}
    data-parallax={parallax}
  />
</div>
