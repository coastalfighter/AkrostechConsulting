---
/**
 * Closing call to action (Sample-3 copy): the page's one deliberate chartreuse block, with
 * the two routes (book a call, or email) and a photograph module.
 */
import { site } from '@/config/site';
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import type { PhotoName } from './Photo.astro';

interface Props {
  heading?: string;
  line?: string;
  photo?: PhotoName;
  photoAlt?: string;
}

const {
  heading = 'Build your offshore team in 48 hours.',
  line = 'Tell us what you need. We will match vetted talent to your workflow and time zone.',
  photo = 'people-developers',
  photoAlt,
} = Astro.props;
const mailto = `mailto:${site.email}?subject=${encodeURIComponent('Interested in your services')}`;
---

<section class="cta section" aria-labelledby="cta-heading">
  <div class="wrap">
    <div class="cta__panel lime">
      <div class="cta__copy">
        <h2 class="cta__heading" id="cta-heading" data-split>{heading}</h2>
        <p class="cta__line" data-reveal>{line}</p>
        <div class="actions" data-reveal>
          <a class="btn btn--primary" href={site.calendly} target="_blank" rel="noopener">
            Book a call <Icon name="arrow-up-right" class="btn__arrow" />
          </a>
          <a class="more" href={mailto}>Email {site.email}</a>
        </div>
      </div>
      <div class="cta__photo">
        <Photo name={photo} alt={photoAlt} fill sizes="(min-width: 64rem) 36vw, 100vw" reveal="clip" />
      </div>
    </div>
  </div>
</section>

<style>
  .cta__panel {
    display: grid;
    gap: var(--s-6);
    padding: clamp(1.5rem, 1rem + 3vw, 4rem);
    border-radius: calc(var(--radius) * 1.6);
    overflow: hidden;
  }
  @media (min-width: 64rem) { .cta__panel { grid-template-columns: 1.3fr 1fr; align-items: stretch; } }
  .cta__copy { display: grid; gap: var(--s-6); align-content: center; }
  .cta__heading { font-size: var(--t-h1); line-height: var(--lh-display); letter-spacing: var(--track-display); max-width: 13ch; }
  .cta__line { font-size: var(--t-lead); line-height: 1.5; max-width: 40ch; color: var(--field-ink-2); }
  .cta__photo { min-height: 18rem; }
  .cta__photo :global(.photo) { border-radius: var(--radius); }
</style>
