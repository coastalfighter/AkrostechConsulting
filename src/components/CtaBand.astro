---
/** The closing band: the whole field is one link, a single verb fills the width. */
import { site } from '@/config/site';

interface Props {
  word?: string;
  line?: string;
  href?: string;
  external?: boolean;
}

const {
  word = 'Talk',
  line = 'Thirty minutes with a client partner. You leave with a shortlist plan and a monthly price.',
  href = site.calendly,
  external = true,
} = Astro.props;
---

<section class="cta" aria-label="Book a discovery call">
  <a class="cta__link" href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined} data-cursor-label="Book">
    <div class="mesh cta__mesh" aria-hidden="true"></div>
    <p class="cta__line">{line}</p>
    <svg class="cta__arrow" viewBox="0 0 48 48" aria-hidden="true"><path d="M12 36 36 12M16 12h20v20" fill="none" stroke="currentColor" stroke-width="3"></path></svg>
    <span class="cta__word" aria-hidden="true">{word}</span>
    <span class="sr-only">{word} to us: book a 30-minute discovery call{external ? ' (opens in a new tab)' : ''}</span>
  </a>
</section>

<style>
  .cta { padding: 0; }
  .cta__link {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto 1fr auto;
    min-height: 62svh;
    padding: clamp(1rem, 2vw, 1.5rem) var(--gutter) 0;
    overflow: hidden;
    background: var(--field);
    color: var(--field-ink);
    text-decoration: none;
    transition: background-color var(--dur-base) var(--ease-out), color var(--dur-base) var(--ease-out);
  }
  .cta__mesh { z-index: -1; opacity: 0.55; mix-blend-mode: soft-light; }
  .cta__link:hover, .cta__link:focus-visible { background: var(--field-ink); color: var(--field); }
  .cta__link:focus-visible { outline-offset: -6px; }
  .cta__line { grid-column: 1; max-width: 34ch; font-size: var(--step-1); line-height: 1.3; letter-spacing: -0.015em; }
  .cta__arrow { grid-column: 2; width: clamp(2rem, 4vw, 3rem); height: clamp(2rem, 4vw, 3rem); transition: translate var(--dur-slow) var(--ease-out); }
  .cta__link:hover .cta__arrow { translate: 0.35rem -0.35rem; }
  .cta__word {
    grid-column: 1 / -1;
    grid-row: 3;
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(6rem, 29vw, 34rem);
    line-height: 0.74;
    letter-spacing: -0.07em;
    margin-left: -0.04em;
    transform-origin: 0 100%;
    transition: letter-spacing var(--dur-slow) var(--ease-out);
  }
  .cta__link:hover .cta__word { letter-spacing: -0.05em; }
  @media (max-width: 767px) {
    .cta__link { min-height: 46svh; }
    .cta__word { font-size: 30vw; }
  }
</style>
