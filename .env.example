# Canonical production origin, no trailing slash. Used for canonical URLs, sitemap and Open Graph.
PUBLIC_SITE_URL=https://www.akrosstech.com

# Contact form delivery (https://resend.com). Without RESEND_API_KEY the form returns a friendly
# "email us directly" message instead of failing silently.
RESEND_API_KEY=
# Inbox that receives enquiries.
CONTACT_TO_EMAIL=contact@akrostech.info
# Verified sender on your Resend domain.
CONTACT_FROM_EMAIL=Akrostech Website <website@akrosstech.com>

# Comma-separated origins allowed to POST to /api/contact (CORS + CSRF origin check).
ALLOWED_ORIGINS=https://www.akrosstech.com,https://akrosstech.com
