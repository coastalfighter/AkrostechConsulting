{
  "schema": 1,
  "source": "DESIGN.md",
  "world": "v3: paper and ink, chartreuse highlighter, lavender/violet fields",
  "theme": {
    "default": "light",
    "alternate": "dark",
    "attribute": "data-theme"
  },
  "motion": {
    "easeOut": "cubic-bezier(0.23, 1, 0.32, 1)",
    "easeInOut": "cubic-bezier(0.77, 0, 0.175, 1)",
    "easeDrawer": "cubic-bezier(0.32, 0.72, 0, 1)",
    "press": {
      "duration": "160ms",
      "transform": "scale(0.97)"
    },
    "ui": "220ms",
    "reveal": "900ms",
    "stagger": "60ms",
    "reducedMotion": "content visible and static; instruments fully operable"
  },
  "focus": {
    "outline": "2px solid var(--focus)",
    "offset": "3px",
    "light": "#6327c5",
    "dark": "#dbde2e",
    "onChartreuse": "#161110"
  },
  "selection": {
    "background": "#dbde2e",
    "text": "#161110"
  },
  "shadows": {
    "float": "0 24px 60px -28px rgb(22 17 16 / .35), 0 2px 8px rgb(22 17 16 / .08)",
    "usage": "floating UI only (services menu); never cards"
  },
  "grid": {
    "columns": {
      "phone": 4,
      "tablet": 8,
      "desktop": 12
    },
    "breakpoints": {
      "tablet": "40rem",
      "desktop": "64rem"
    },
    "maxWidth": "1600px"
  },
  "heroes": {
    "type": "real-time 3D signature object (three.js, full-bleed, GPU only)",
    "scenes": {
      "/": "globe",
      "/services": "orbits",
      "/services/virtual-assistance": "va",
      "/services/recruitment": "funnel",
      "/services/accounting": "ledger",
      "/services/legal": "document",
      "/services/website-development": "wireframe",
      "/about": "network",
      "/blog": "pages",
      "/blog/[slug]": "pages (seeded by slug)",
      "/contact": "twin",
      "/privacy": "shield",
      "/terms": "index",
      "/404": "lost"
    }
  },
  "photography": {
    "source": "Unsplash License",
    "credits": "src/assets/photos/credits.json",
    "rule": "generic people at work; never presented as Akrostech staff, clients or offices"
  },
  "instruments": {
    "/": [
      "dial",
      "compare",
      "service index",
      "audience tabs"
    ],
    "/services": [
      "matrix"
    ],
    "/services/virtual-assistance": [
      "inbox"
    ],
    "/services/recruitment": [
      "funnel"
    ],
    "/services/accounting": [
      "ledger"
    ],
    "/services/legal": [
      "clauses"
    ],
    "/services/website-development": [
      "builder"
    ],
    "/about": [
      "org"
    ],
    "/contact": [
      "week"
    ],
    "/blog": [
      "search"
    ],
    "/blog/[slug]": [
      "toc"
    ],
    "/privacy": [
      "flow"
    ],
    "/terms": [
      "index-cards"
    ],
    "/404": [
      "lost"
    ]
  }
}
